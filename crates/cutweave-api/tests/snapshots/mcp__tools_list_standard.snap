        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "job_wait",
      "description": "Wait for a background job to finish, at most timeout_ms (max 60000); returns its state. Call again while it is running. E.g. {\"job_id\":\"job_…\",\"timeout_ms\":30000}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "job_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "keyframe_set",
      "description": "Animate one property of an item: add or replace keys at sequence times (`at`) or item times (`t`), with an easing to the next key. E.g. {\"item\":\"itm_…\",\"prop\":\"opacity\",\"keys\":[{\"at\":\"6s\",\"value\":0,\"easing\":\"ease_out\"},{\"at\":\"8s\",\"value\":1}]}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "prop": {
            "enum": [
              "transform.position",
              "transform.scale",
              "transform.rotation",
              "transform.anchor",
              "opacity",
              "crop.left",
              "crop.top",
              "crop.right",
              "crop.bottom",
              "flip.horizontal",
              "flip.vertical",
              "audio_gain",
              "audio_pan"
            ],
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "t": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "required": [
                        "x",
                        "y"
                      ],
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "interp": {
                  "anyOf": [
                    {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "hold"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "linear"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "required": [
                            "kind",
                            "x1",
                            "y1",
                            "x2",
                            "y2"
                          ],
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "bezier"
                            },
                            "x1": {
                              "type": "number"
                            },
                            "y1": {
                              "type": "number"
                            },
                            "x2": {
                              "type": "number"
                            },
                            "y2": {
                              "type": "number"
                            },
                            "preset": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "required": [
                            "kind",
                            "stiffness",
                            "damping",
                            "mass"
                          ],
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "spring"
                            },
                            "stiffness": {
                              "type": "number"
                            },
                            "damping": {
                              "type": "number"
                            },
                            "mass": {
                              "type": "number"
                            },
                            "bounce": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "preset": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "easing": {
                  "enum": [
                    "hold",
                    "linear",
                    "ease_in",
                    "ease_out",
                    "ease_in_out",
                    "sine_in",
                    "sine_out",
                    "sine_in_out",
                    "cubic_in",
                    "cubic_out",
                    "cubic_in_out",
                    "expo_in",
                    "expo_out",
                    "expo_in_out",
                    "back_in",
                    "back_out",
                    "back_in_out",
                    "spring",
                    "spring_gentle",
                    "spring_wobbly",
                    "spring_stiff",
                    "elastic",
                    "bounce",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "preset": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "replace": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "prop",
          "keys"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "media_import",
      "description": "Import media files by absolute path. Returns media_ids at once; analysis runs as jobs (job_ids) that job_wait waits for. E.g. {\"paths\":[\"C:/footage/a.mp4\"]}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "folder": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^fld_[0-9a-f]{32}$"
          },
          "keep_structure": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "copy_to_project": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "paths"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "media_list",
      "description": "List the project's media with ids, kinds and durations; filter, sort and page. E.g. {\"filter\":{\"kinds\":[\"video\"],\"used\":false},\"limit\":20}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^med_[0-9a-f]{32}$"
          },
          "filter": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kinds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "video",
                    "audio",
                    "image",
                    "image_sequence",
                    "sequence_ref"
                  ]
                }
              },
              "min_duration": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/shared1"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_duration": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/shared1"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "used": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "problems": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "folder": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^fld_[0-9a-f]{32}$"
              },
              "recursive": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "tags": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "min_rating": {
                "type": [
                  "integer",
                  "null"
                ],
                "maximum": 5,
                "minimum": 1
              },
              "collection": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^col_[0-9a-f]{32}$"
              }
            }
          },
          "sort": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "by": {
                "type": "string",
                "enum": [
                  "imported",
                  "name",
                  "duration",
                  "kind"
                ]
              },
              "order": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "default": "asc"
              }
            },
            "required": [
              "by"
            ]
          },
          "include": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "oneOf": [
                {
                  "const": "note",
                  "type": "string"
                }
              ]
            }
          }
        },
        "$defs": {
          "shared1": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "project_info",
      "description": "Get the project's name, default format and its sequences with their ids. Start here. E.g. {}",
