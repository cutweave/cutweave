            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "t": {
            "$ref": "#/$defs/time"
          },
          "duration": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
