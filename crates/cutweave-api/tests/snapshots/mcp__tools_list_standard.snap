          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ]
          },
          "audio_track": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^trk_[0-9a-f]{32}$"
          },
          "ripple_all_tracks": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "sequence",
          "track",
          "media",
          "at"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "track_add",
      "description": "Add an empty track to a sequence; returns its id. E.g. {\"sequence\":\"seq_…\",\"kind\":\"video\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^seq_[0-9a-f]{32}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "text",
              "caption",
              "adjustment"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "sequence",
          "kind"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "view_get",
      "description": "Read what the user sees in the app: playhead, selection, zoom, active sequence, source in/out marks. E.g. {}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "view_set",
      "description": "Show the user something in the app: move the playhead, select items, zoom or switch sequence. Changes only the view; not undoable. E.g. {\"patch\":{\"playhead\":\"12s\",\"selection\":[{\"kind\":\"item\",\"id\":\"itm_…\"}]}}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "playhead": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "zoom": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "scroll": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "selection": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "oneOf": [
                    {
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "item"
                        },
                        "id": {
                          "pattern": "^itm_[0-9a-f]{32}$",
                          "type": "string"
                        }
                      }
                    },
                    {
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "track"
                        },
                        "id": {
                          "pattern": "^trk_[0-9a-f]{32}$",
                          "type": "string"
                        }
                      }
                    },
                    {
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "media"
                        },
                        "id": {
                          "pattern": "^med_[0-9a-f]{32}$",
                          "type": "string"
                        }
                      }
                    },
                    {
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "sequence"
                        },
                        "id": {
                          "pattern": "^seq_[0-9a-f]{32}$",
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "panel_layout": {},
              "preview_quality": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "full",
                  "half",
                  "quarter",
                  null
                ]
              },
              "master_gain": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "active_sequence": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^seq_[0-9a-f]{32}$"
              },
              "source_marks": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "patternProperties": {
                  "^med_[0-9a-f]{32}$": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "in": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "out": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "patch"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_search_commands",
      "description": "Find commands and queries by keyword, including ones not listed as tools",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words matched against names and summaries; \"\" lists all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Default 20"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_describe_command",
      "description": "Get one command's docs, annotations and full input/output JSON Schemas",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. clip.split"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_execute",
      "description": "Run commands as one all-or-nothing transaction and one undo step",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "cmd": {
                  "type": "string",
                  "description": "e.g. clip.split"
                },
                "args": {
                  "type": "object",
                  "description": "Params; {\"$ref\":\"steps[0].output.left\"} inserts an earlier step's output"
                }
              },
              "required": [
                "cmd"
              ],
              "additionalProperties": false
            }
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate and list the predicted ops; change nothing"
          },
          "expected_rev": {
            "type": "integer",
            "minimum": 0,
            "description": "Fail unless the document is at this revision"
          },
          "checkpoint": {
            "type": "boolean",
            "description": "Save a checkpoint first; edit.restore brings it back"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_query",
      "description": "Run a read-only query by name, e.g. item.get or edit.history",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
