    {
      "name": "item_set_props",
      "description": "Set some of an item's properties: name, enabled, opacity, audio gain and pan, transform, crop, flip, blend mode. The rest stay. E.g. {\"item\":\"itm_…\",\"props\":{\"opacity\":0.5,\"transform\":{\"scale\":{\"x\":1.2,\"y\":1.2}}}}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "props": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enabled": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "opacity": {
                "$ref": "#/$defs/d"
              },
              "audio_gain": {
                "type": [
                  "number",
                  "null"
                ],
                "maximum": 48.0,
                "minimum": -144.0
              },
              "audio_pan": {
                "type": [
                  "number",
                  "null"
                ],
                "maximum": 1.0,
                "minimum": -1.0
              },
              "transform": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "position": {
                    "$ref": "#/$defs/vec2"
                  },
                  "scale": {
                    "$ref": "#/$defs/vec2"
                  },
                  "rotation": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "anchor": {
                    "$ref": "#/$defs/vec2"
                  }
                }
              },
              "crop": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "left": {
                    "$ref": "#/$defs/d"
                  },
                  "top": {
                    "$ref": "#/$defs/d"
                  },
                  "right": {
                    "$ref": "#/$defs/d"
                  },
                  "bottom": {
                    "$ref": "#/$defs/d"
                  }
                }
              },
              "flip": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "horizontal": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "vertical": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "blend_mode": {
                "enum": [
                  "normal",
                  "multiply",
                  "screen",
                  "overlay",
                  "darken",
                  "lighten",
                  "add",
                  "soft_light",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "auto_key": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "props"
        ],
        "$defs": {
          "vec2": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "d": {
            "type": [
              "number",
              "null"
            ],
            "maximum": 1.0,
            "minimum": 0.0
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "job_status",
      "description": "Get a background job's state, progress and error (media analysis, export). E.g. {\"id\":\"job_…\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
