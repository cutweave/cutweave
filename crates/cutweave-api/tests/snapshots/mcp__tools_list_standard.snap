            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "frame_rate": {
                "additionalProperties": false,
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "num": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "den": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "num",
                  "den"
                ]
              },
              "sample_rate": {
                "maximum": 352800000,
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "background": {
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "type": [
                  "string",
                  "null"
                ]
              }
