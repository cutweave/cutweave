---
source: crates/cutweave-api/tests/mcp.rs
expression: catalog.tools_json()
---
{
  "tools": [
    {
      "name": "audio_set",
      "description": "Set a clip's fades, volume (dB) or pan",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$",
            "description": "The item (or `items`)."
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "set": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "fade"
                  },
                  "in": {
                    "$ref": "#/$defs/d",
                    "description": "Length of the fade in, `0` removes it. Seconds (`\"0.5s\"`), flicks or a timecode."
                  },
                  "out": {
                    "$ref": "#/$defs/d",
                    "description": "Length of the fade out, `0` removes it."
                  },
                  "curve": {
                    "description": "The shape of the fades being set (both when neither `in` nor `out` is given): `linear`\n(default), `log`, `equal_power`, `s_curve`.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "linear",
                      "log",
                      "equal_power",
                      "s_curve",
                      null
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "volume"
                  },
                  "db": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "db"
                ],
                "description": "Clip volume in dB (`-144..=12`; at or below `-144` is silence). Keyed at `at` when the\nvolume is animated."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pan"
                  },
                  "pan": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "pan"
                ],
                "description": "Stereo position, `-1` (left) to `1` (right); centre is `0`. Keyed at `at` when animated."
              }
            ]
          },
          "auto_key": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Key an animated volume or pan at `at` (default true)."
          },
          "at": {
            "$ref": "#/$defs/d",
            "description": "Sequence time (the playhead) to key at."
          }
        },
        "required": [
          "set"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          "d": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "clip_split",
      "description": "Split a clip (and its linked partners) at a timeline time",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$",
            "description": "The clip (or `items`)."
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "at": {
            "description": "Timeline time to split at: strictly inside the clip.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "at"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "clip_trim",
      "description": "Trim the start or end edge of a clip (linked partners follow; the main track closes up)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "edge": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ]
          },
          "to": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timeline time of the edge afterwards (frame-snapped)."
          },
          "delta": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Offset of the edge from where it is now (negative: earlier). Use seconds or flicks for\nnegative values."
          },
          "unlink": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Trim only this clip and remove it from its linked group (default `false`)."
          },
          "clamp": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Stop at the nearest limit instead of failing (default `false`)."
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Snap to the audio sample grid (audio clips only)."
          },
          "prune_keyframes": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Drop keyframes the trim leaves outside the clip, keeping the ones that bracket it\n(default `false`: trims keep every key)."
          }
        },
        "required": [
          "item",
          "edge"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "edit_undo",
      "description": "Undo your last change, or another actor's (`actor`; `*` = anyone's latest)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Whose change: `user`, `agent:<label>`, `plugin:<id>`, `system`, or `*` for the most\nrecent change by anyone. Default: the caller's own.",
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many changes to undo in one go, newest first, each its own history record (1..=100,\ndefault 1). A refused step stops the run; the output's `done` says how many applied.",
            "minimum": 0
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "export_start",
      "description": "Export a sequence to a video file (H.264, HEVC, AV1, ProRes) as a background job; returns job_id",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^seq_[0-9a-f]{32}$",
            "description": "Sequence; optional when the project has one."
          },
          "path": {
            "type": "string",
            "description": "Absolute path of the output file (`.mp4`; `.mov` for ProRes presets)."
          },
          "range": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "description": "\"sequence\", \"in_out\", \"custom\" or \"markers\" (default: from the other fields).",
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "sequence",
                  "in_out",
                  "custom",
                  "markers",
                  null
                ]
              },
              "in": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Custom start: flicks, \"2.5s\", \"f:60\" or a timecode."
              },
              "out": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Custom end, exclusive: at most the sequence end."
              },
              "markers": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "pattern": "^mrk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "description": "Marker kind: the markers to export (default: all of the sequence's markers)."
              },
              "pair_mode": {
                "description": "Marker kind: \"duration\" (default; each marker's own duration) or \"pairs\" (each marker to\nthe next).",
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "duration",
                  "pairs",
                  null
                ]
              }
            },
            "description": "Part of the sequence to export (default: all of it): {kind: \"sequence\" | \"in_out\" |\n\"custom\" | \"markers\", in, out, markers: [ids], pair_mode: \"duration\" | \"pairs\"}."
          },
          "preset": {
            "anyOf": [
              {
                "type": "string",
                "const": "h264-mp4-1080p",
                "description": "MP4, H.264 + AAC, fit into 1920x1080 (1080x1920 portrait), not upscaled, high quality."
              },
              {
                "type": "object",
                "properties": {
                  "custom": {
                    "description": "Custom output settings; absent fields take the sequence's value (quality: high).",
                    "type": "object",
                    "properties": {
                      "width": {
                        "description": "Frame width in pixels: even, 16-8192.",
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "height": {
                        "description": "Frame height in pixels: even, 16-8192.",
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "fps": {
                        "description": "Frame rate, e.g. {\"num\": 30, \"den\": 1}: at most 240 fps, a whole number of flicks per\nframe.",
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "num": {
                            "maximum": 4294967295,
                            "type": "integer",
                            "minimum": 1
                          },
                          "den": {
                            "maximum": 4294967295,
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "additionalProperties": false
                      },
                      "quality": {
                        "description": "\"low\", \"medium\" or \"high\".",
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          null
                        ]
                      },
                      "preset": {
                        "description": "Base preset id; the other fields replace its values.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "custom"
                ],
                "additionalProperties": false,
                "description": "MP4, H.264 + AAC at a custom size, frame rate and quality."
              },
              {
                "type": "string",
                "description": "A preset id (export.list_presets)."
              },
              {
                "type": "null"
              }
            ],
            "description": "\"h264-mp4-1080p\" (default), a preset id (\"youtube-1080p\") or {\"custom\": {width, height,\nfps, quality, preset}}."
          },
          "hw": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string",
                    "const": "auto"
                  },
                  {
                    "type": "string",
                    "const": "off"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "force": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "force"
                    ],
                    "additionalProperties": false,
                    "description": "This hardware encoder and no other, e.g. \"hevc_nvenc\" (the `implementation` names of\nthe machine's hardware encoders, `export.list_encoders`); fails instead of falling back."
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Hardware encoder: \"auto\" (default), \"off\", or {\"force\": \"hevc_nvenc\"}."
          },
          "overwrite": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Replace an existing file at `path` (default false); same as `collision: \"overwrite\"`."
          },
          "collision": {
            "description": "An existing file: \"fail\" (default), \"rename\" or \"overwrite\".",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rename",
              "overwrite",
              "fail",
              null
            ]
          },
          "allow_offline": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Export although media files are missing: their clips show a \"media offline\" slate and\nare silent (default false: fails with `Invalid` at `/media/<id>` naming them)."
          },
          "advanced": {
            "type": [
              "object",
              "null"
            ],
            "description": "Fine control (export.describe_options{codec} gives a codec's options as a JSON Schema):\nvideo{rate_control{mode crf|cbr|vbr|cq, crf, bitrate_kbps, max_bitrate_kbps, buffer_kbit},\ngop{keyint|keyint_seconds, keyint_min, bframes, closed_gop, scenecut}, preset, tune,\nprofile, level, pix_fmt, threads}, color{primaries, transfer, matrix, range, tag_only},\naudio{codec, bitrate_kbps, sample_rate, channels}. Impossible combinations fail with\nInvalid and a hint.",
            "properties": {
              "video": {
                "type": "object"
              },
              "color": {
                "type": "object"
              },
              "audio": {
                "type": "object"
              }
            }
          }
        },
        "required": [
          "path"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "item_delete",
      "description": "Delete items and their linked partners (the main track closes up)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "item_move",
      "description": "Move items in time and/or to another track (linked partners follow)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$",
            "description": "The item (or `items`)."
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "start": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ],
            "description": "New start, `>= 0` (or `delta`)."
          },
          "delta": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_track": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^trk_[0-9a-f]{32}$",
            "description": "Target track (default: stay)."
          },
          "unlink": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "overlap": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "reject",
              "new_track",
              null
            ],
            "description": "Alias of `mode`."
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ],
            "description": "Default: `insert` on the main track, else `reject`."
          },
          "ripple_all_tracks": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "item_set_props",
      "description": "Set an item's name, enabled, opacity, audio, transform, crop, flip or blend mode (partial)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$",
            "description": "The item (or `items`)."
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "props": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Display name; an empty string clears it (the media name is shown again)."
              },
              "enabled": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Rendered and heard (`true`) or kept but skipped (`false`)."
              },
              "opacity": {
                "$ref": "#/$defs/d",
                "description": "Opacity `0.0..=1.0`."
              },
              "audio_gain": {
                "type": [
                  "number",
                  "null"
                ],
                "maximum": 48.0,
                "description": "Clip gain in dB, `-144..=48` (0 = unchanged).",
                "minimum": -144.0
              },
              "audio_pan": {
                "type": [
                  "number",
                  "null"
                ],
                "maximum": 1.0,
                "description": "Stereo position, `-1` (left) to `1` (right).",
                "minimum": -1.0
              },
              "transform": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "position": {
                    "$ref": "#/$defs/vec2",
                    "description": "Offset of the anchor from the canvas center, in canvas units (+y is down)."
                  },
                  "scale": {
                    "$ref": "#/$defs/vec2",
                    "description": "Size multiplier per axis (1.0 = aspect-fit); finite and `>= 0`."
                  },
                  "rotation": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "anchor": {
                    "$ref": "#/$defs/vec2",
                    "description": "The item point `position` places and rotation turns around, in item units."
                  }
                },
                "description": "Placement on the canvas (partial)."
              },
              "crop": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "left": {
                    "$ref": "#/$defs/d"
                  },
                  "top": {
                    "$ref": "#/$defs/d"
                  },
                  "right": {
                    "$ref": "#/$defs/d"
                  },
                  "bottom": {
                    "$ref": "#/$defs/d"
                  }
                },
                "description": "Edges of the source picture cut away (partial)."
              },
              "flip": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "horizontal": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "vertical": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "description": "Mirroring (partial)."
              },
              "blend_mode": {
                "description": "How the item combines with what is below.",
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "normal",
                  "multiply",
                  "screen",
                  "overlay",
                  "darken",
                  "lighten",
                  "add",
                  "soft_light",
                  null
                ]
              }
            }
          },
          "auto_key": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Key animated properties at `at` (default true)."
          },
          "at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sequence time (the playhead) to key animated properties at."
          }
        },
        "required": [
          "props"
        ],
        "$defs": {
          "vec2": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number",
                "description": "Vertical component (down is positive)."
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "d": {
            "type": [
              "number",
              "null"
            ],
            "maximum": 1.0,
            "minimum": 0.0
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "job_status",
      "description": "Get a background job's state, progress and error (analysis, export)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$",
            "description": "The job (from `media.import`'s `job_ids`, `export.start`, …)."
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "job_wait",
      "description": "Wait up to timeout_ms (max 60 s) for a background job to finish; returns its state",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How long to wait in milliseconds (default 30000; values above 60000 are capped; 0\nreturns the current state).",
            "minimum": 0
          }
        },
        "required": [
          "job_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "keyframe_set",
      "description": "Add or replace keys on one property of an item",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$",
            "description": "The item (or `items`)."
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "prop": {
            "enum": [
              "transform.position",
              "transform.scale",
              "transform.rotation",
              "transform.anchor",
              "opacity",
              "crop.left",
              "crop.top",
              "crop.right",
              "crop.bottom",
              "flip.horizontal",
              "flip.vertical",
              "audio_gain",
              "audio_pan"
            ],
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "t": {
                  "description": "Item time (flicks, seconds like \"1.5s\", or \"f:N\" frames from the item's start).",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "description": "Sequence time. Give `t` or `at`; both snap to frames.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "value": {
                  "description": "The value; omitted: the property's current value there.",
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "description": "A 2D vector.",
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "description": "Vertical component (down is positive).",
                          "type": "number"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "interp": {
                  "description": "Shapes the move to the next key; or use `easing`.",
                  "anyOf": [
                    {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "hold"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "linear"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "description": "CSS cubic Bezier: `x1`, `x2` in 0..1, `y1`, `y2` in -10..10.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "bezier"
                            },
                            "x1": {
                              "description": "Control point 1 x.",
                              "type": "number"
                            },
                            "y1": {
                              "description": "Control point 1 y.",
                              "type": "number"
                            },
                            "x2": {
                              "description": "Control point 2 x.",
                              "type": "number"
                            },
                            "y2": {
                              "description": "Control point 2 y.",
                              "type": "number"
                            },
                            "preset": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "x1",
                            "y1",
                            "x2",
                            "y2"
                          ]
                        },
                        {
                          "description": "Damped spring: stiffness 1..10000, damping 0..1000, mass 0.1..100.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "spring"
                            },
                            "stiffness": {
                              "type": "number"
                            },
                            "damping": {
                              "type": "number"
                            },
                            "mass": {
                              "type": "number"
                            },
                            "bounce": {
                              "description": "Hard stop at the target (default false).",
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "preset": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "stiffness",
                            "damping",
                            "mass"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "easing": {
                  "description": "A preset name, `linear` or `hold`.",
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "hold",
                    "linear",
                    "ease_in",
                    "ease_out",
                    "ease_in_out",
                    "sine_in",
                    "sine_out",
                    "sine_in_out",
                    "cubic_in",
                    "cubic_out",
                    "cubic_in_out",
                    "expo_in",
                    "expo_out",
                    "expo_in_out",
                    "back_in",
                    "back_out",
                    "back_in_out",
                    "spring",
                    "spring_gentle",
                    "spring_wobbly",
                    "spring_stiff",
                    "elastic",
                    "bounce",
                    null
                  ]
                },
                "preset": {
                  "description": "Preset name hint for `interp`.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "description": "The keys, 1 to 10,000."
          },
          "replace": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Snap to audio samples (audio properties)."
          }
        },
        "required": [
          "prop",
          "keys"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "media_import",
      "description": "Import media files: probe and register them now, return media ids and analysis job ids",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Absolute paths of files or folders (1..=256, no repeats)."
          },
          "folder": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^fld_[0-9a-f]{32}$",
            "description": "Bin folder (default: top level)."
          },
          "keep_structure": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "For folders in `paths`: mirror their directories as bin folders (default true); false\nputs every file straight into `folder`."
          },
          "copy_to_project": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Copy each new file into the project's `media/` folder first (default false)."
          }
        },
        "required": [
          "paths"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "media_list",
      "description": "List the project's media (filter, sort, paged; default by id)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Page size, `1..=500` (default 50).",
            "minimum": 0
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^med_[0-9a-f]{32}$",
            "description": "`next_cursor` of the previous page."
          },
          "filter": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Terms that must all occur in the name, tags or note, ignoring case and accents."
              },
              "kinds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "video",
                    "audio",
                    "image",
                    "image_sequence",
                    "sequence_ref"
                  ]
                }
              },
              "min_duration": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/shared1"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Shortest length (flicks), inclusive; stills never match a bound."
              },
              "max_duration": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/shared1"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Longest length (flicks), inclusive."
              },
              "used": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Placed on a timeline of any sequence (`true`) or not (`false`)."
              },
              "problems": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "`true`: only files nothing can be read from (no streams)."
              },
              "folder": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^fld_[0-9a-f]{32}$"
              },
              "recursive": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "With subfolders (default: true without folder)."
              },
              "tags": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "min_rating": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Rated at least this (1-5).",
                "minimum": 1,
                "maximum": 5
              },
              "collection": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^col_[0-9a-f]{32}$"
              }
            }
          },
          "sort": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "by": {
                "type": "string",
                "enum": [
                  "imported",
                  "name",
                  "duration",
                  "kind"
                ]
              },
              "order": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "default": "asc"
              }
            },
            "required": [
              "by"
            ]
          },
          "include": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "oneOf": [
                {
                  "const": "note",
                  "type": "string"
                }
              ]
            },
            "description": "Extra fields per asset: `note`."
          }
        },
        "$defs": {
          "shared1": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "project_info",
      "description": "Get project name, default format and a summary of its sequences",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "project_open",
      "description": "Open a project folder or .cutweave file (closes the current project)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path of the project folder or of its `.cutweave` document."
          },
          "discard_unsaved": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Drop the open document's unsaved changes (`true`); otherwise they make the open fail."
          }
        },
        "required": [
          "path"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "sequence_create",
      "description": "Add a sequence from an aspect preset or a format",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Name (1..=200 characters)."
          },
          "preset": {
            "type": [
              "string",
              "null"
            ],
            "description": "Aspect preset ID: `16:9`, `16:9-4k`, `9:16`, `1:1`, `4:5` or `21:9`."
          },
          "format": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Canvas width in pixels, `1..=16384`.",
                "minimum": 0
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Canvas height in pixels, `1..=16384`.",
                "minimum": 0
              },
              "frame_rate": {
                "description": "The edit grid, `1..=1000` fps and a whole number of flicks per frame.",
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "num": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "den": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "additionalProperties": false
              },
              "sample_rate": {
                "description": "The mix rate in Hz, `8000..=384000`.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 352800000
              },
              "background": {
                "description": "The canvas color behind all tracks, `#rrggbb`.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              }
            }
          }
        },
        "required": [
          "name"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "sequence_set_format",
      "description": "Change a sequence's size, frame rate, sample rate or background",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^seq_[0-9a-f]{32}$"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Canvas width in pixels, `1..=16384`.",
            "minimum": 0
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Canvas height in pixels, `1..=16384`.",
            "minimum": 0
          },
          "frame_rate": {
            "additionalProperties": false,
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "num": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "den": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "required": [
              "num",
              "den"
            ]
          },
          "sample_rate": {
            "maximum": 352800000,
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "background": {
            "description": "Canvas color, `#rrggbb`.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "reframe": {
            "description": "How clips follow a new canvas size (default `fit`).",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "keep_scale",
              "fit",
              "fill",
              "none",
              null
            ]
          }
        },
        "required": [
          "sequence"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "timeline_get",
      "description": "Get a sequence: summary (depth 0), tracks (1) or tracks with items (2)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^seq_[0-9a-f]{32}$"
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Detail level `0..=2` (default 1).",
            "minimum": 0,
            "maximum": 255
          },
          "fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Sections to include: any of `name`, `format`, `duration`, `tracks` (default all)."
          }
        },
        "required": [
          "sequence"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "timeline_insert",
      "description": "Insert a media clip at a time on a track (adds linked audio for video with sound)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^seq_[0-9a-f]{32}$"
          },
          "track": {
            "type": "string",
            "pattern": "^trk_[0-9a-f]{32}$",
            "description": "The target track: video for pictures, audio for sound."
          },
          "media": {
            "type": "string",
            "pattern": "^med_[0-9a-f]{32}$"
          },
          "at": {
            "description": "Timeline position of the clip's first frame, `>= 0`.",
            "$ref": "#/$defs/time"
          },
          "source_in": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Position in the media to start from (default 0)."
          },
          "duration": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Clip length, `> 0` (default: the rest of the media)."
          },
          "overlap": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "reject",
              "new_track",
              null
            ],
            "description": "Alias of `mode`."
          },
          "link": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Also place a video's sound, linked (default `true`)."
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ],
            "description": "Default: `insert` on the main track, else `reject`."
          },
          "audio_track": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^trk_[0-9a-f]{32}$"
          },
          "ripple_all_tracks": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`insert` ripples every track."
          }
        },
        "required": [
          "sequence",
          "track",
          "media",
          "at"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_search_commands",
      "description": "Find commands and queries by keyword, including ones not listed as tools",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words matched against names and summaries; \"\" lists all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Default 20"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_describe_command",
      "description": "Get one command's docs, annotations and full input/output JSON Schemas",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. clip.split"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_execute",
      "description": "Run commands as one all-or-nothing transaction and one undo step",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "cmd": {
                  "type": "string",
                  "description": "e.g. clip.split"
                },
                "args": {
                  "type": "object",
                  "description": "Params; {\"$ref\":\"steps[0].output.left\"} inserts an earlier step's output"
                }
              },
              "required": [
                "cmd"
              ],
              "additionalProperties": false
            }
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate and list the predicted ops; change nothing"
          },
          "expected_rev": {
            "type": "integer",
            "minimum": 0,
            "description": "Fail unless the document is at this revision"
          },
          "checkpoint": {
            "type": "boolean",
            "description": "Save a checkpoint first; edit.restore brings it back"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_query",
      "description": "Run a read-only query by name, e.g. item.get or edit.history",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
