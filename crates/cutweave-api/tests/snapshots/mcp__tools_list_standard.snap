    {
      "name": "timeline_add_marker",
      "description": "Add a marker at a time of a sequence, or on one of its items (`item`; then `t` is from the item's start). `duration` makes it a range. E.g. {\"sequence\":\"seq_…\",\"t\":\"12s\",\"label\":\"Cut here\"}",
      "inputSchema": {
        "type": "object",
