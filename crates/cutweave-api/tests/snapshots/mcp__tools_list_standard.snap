          "source_in": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
