---
source: crates/cutweave-api/tests/mcp.rs
expression: catalog.tools_json()
---
{
  "tools": [
    {
      "name": "audio_set",
      "description": "Set a clip's fades, volume (dB) or pan; `set.kind` picks which. E.g. {\"item\":\"itm_…\",\"set\":{\"kind\":\"fade\",\"in\":\"0.5s\",\"out\":\"1s\"}}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "set": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "fade"
                  },
                  "in": {
                    "$ref": "#/$defs/d"
                  },
                  "out": {
                    "$ref": "#/$defs/d"
                  },
                  "curve": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "linear",
                      "log",
                      "equal_power",
                      "s_curve",
                      null
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "volume"
                  },
                  "db": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "db"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pan"
                  },
                  "pan": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "pan"
                ]
              }
            ]
          },
          "auto_key": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "at": {
            "$ref": "#/$defs/d"
          }
        },
        "required": [
          "set"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          "d": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "clip_set_speed",
      "description": "Change a clip's playback speed, 0.1x to 100x; its length changes unless keep is \"duration\". Linked partners follow. E.g. {\"item\":\"itm_…\",\"speed\":\"2x\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "num": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "den": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "num",
                  "den"
                ]
              }
            ]
          },
          "keep": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "in_point",
              "duration",
              null
            ]
          },
          "ripple": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "keyframes": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "keep",
              "scale",
              null
            ]
          }
        },
        "required": [
          "speed"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "clip_split",
      "description": "Split a clip and its linked partners at a timeline time inside it; returns the left and right ids. E.g. {\"item\":\"itm_…\",\"at\":\"2.5s\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "at"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "clip_trim",
      "description": "Move a clip's start or end edge to a time (`to`) or by an amount (`delta`). Linked partners follow; the main track closes up. E.g. {\"item\":\"itm_…\",\"edge\":\"end\",\"delta\":\"-0.5s\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "edge": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ]
          },
          "to": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "delta": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "unlink": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "clamp": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "prune_keyframes": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "item",
          "edge"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "edit_checkpoint",
      "description": "Save a restore point of the document before risky edits; cheap. Returns its id. E.g. {\"name\":\"before-recut\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "edit_redo",
      "description": "Redo your last undone change (`steps` for more). E.g. {}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "edit_restore",
      "description": "Bring the document back to a checkpoint (id or name) as one undoable change; refuses to revert other actors' edits unless force is true. E.g. {\"checkpoint\":\"before-recut\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkpoint": {
            "type": "string"
          },
          "force": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "checkpoint"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "edit_undo",
      "description": "Undo your last change (`steps` for more); other actors' later edits are kept. E.g. {\"steps\":2}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"
          },
          "steps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "export_start",
      "description": "Export a sequence to a video file as a background job; returns job_id for job_wait. Presets: export.list_presets. E.g. {\"path\":\"C:/out/cut.mp4\",\"preset\":\"youtube-1080p\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^seq_[0-9a-f]{32}$"
          },
          "path": {
            "type": "string"
          },
          "range": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "sequence",
                  "in_out",
                  "custom",
                  "markers",
                  null
                ]
              },
              "in": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "out": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "markers": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "pattern": "^mrk_[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "pair_mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "duration",
                  "pairs",
                  null
                ]
              }
            }
          },
          "preset": {
            "anyOf": [
              {
                "type": "string",
                "const": "h264-mp4-1080p"
              },
              {
                "type": "object",
                "properties": {
                  "custom": {
                    "additionalProperties": false,
                    "type": "object",
                    "properties": {
                      "width": {
                        "minimum": 0,
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "height": {
                        "minimum": 0,
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "fps": {
                        "additionalProperties": false,
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "num": {
                            "maximum": 4294967295,
                            "type": "integer",
                            "minimum": 1
                          },
                          "den": {
                            "maximum": 4294967295,
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ]
                      },
                      "quality": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          null
                        ]
                      },
                      "preset": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "custom"
                ],
                "additionalProperties": false
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "hw": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "string",
                    "const": "auto"
                  },
                  {
                    "type": "string",
                    "const": "off"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "force": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "force"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "overwrite": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "collision": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rename",
              "overwrite",
              "fail",
              null
            ]
          },
          "allow_offline": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "advanced": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "video": {
                "type": "object"
              },
              "color": {
                "type": "object"
              },
              "audio": {
                "type": "object"
              }
            }
          }
        },
        "required": [
          "path"
        ],
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "item_delete",
      "description": "Delete items and their linked partners; the main track closes up, other tracks keep the gap. E.g. {\"items\":[\"itm_…\"]}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "item_move",
      "description": "Move items to a time (`start`) or by `delta`, and/or to another track (`to_track`). Linked partners follow. E.g. {\"item\":\"itm_…\",\"start\":\"6s\"}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "items": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          "start": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "delta": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_track": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^trk_[0-9a-f]{32}$"
          },
          "unlink": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "overlap": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "reject",
              "new_track",
              null
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ]
          },
          "ripple_all_tracks": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fine": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "$defs": {
          "time": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
