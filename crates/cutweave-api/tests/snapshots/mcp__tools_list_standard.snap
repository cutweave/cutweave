    {
      "name": "timeline_insert",
      "description": "Place a media clip on a track at a time; video with sound also gets a linked audio clip. Returns the new clip ids. E.g. {\"sequence\":\"seq_…\",\"track\":\"trk_…\",\"media\":\"med_…\",\"at\":\"0s\"}",
      "inputSchema": {
        "type": "object",
