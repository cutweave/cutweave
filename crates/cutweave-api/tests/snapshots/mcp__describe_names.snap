{"commands":[{"name":"edit.redo","summary":"Redo the last undone change of yours, or of another actor (`actor`; `*` = anyone)","kind":"engine","call":"tool edit_redo","transactional":false,"description":"Redoes the most recently undone change of an actor (default: yours). A new change by that\nactor clears its redo stack. Refused with `Conflict` when the same things changed since the\nundo.","undoable":false,"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"input_schema":{"type":"object","additionalProperties":false,"properties":{"actor":{"type":["string","null"],"description":"Whose change (see `edit.undo`). Default: the caller's own.","pattern":"^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$","default":null},"steps":{"type":["integer","null"],"format":"uint32","minimum":0,"description":"How many changes to redo in one go, newest first, each its own history record (1..=100,\ndefault 1). A refused step stops the run; the output's `done` says how many applied.","default":null}},"description":"Redoes the most recently undone change of an actor (default: yours). A new change by that\nactor clears its redo stack. Refused with `Conflict` when the same things changed since the\nundo.","title":"Redo"},"output_schema":{"type":"object","properties":{"tx":{"type":"string","pattern":"^tx_[0-9]+$","description":"The new transaction that undid or redid it."},"entry":{"type":"string","pattern":"^tx_[0-9]+$","description":"The entry undone or redone (its original transaction)."},"actor":{"type":"string","description":"Whose entry it is.","pattern":"^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"},"label":{"type":"string","description":"Its label."},"rev":{"type":"integer","format":"uint64","minimum":0,"description":"The live revision afterwards."},"committed_rev":{"type":"integer","format":"uint64","minimum":0,"description":"The committed revision afterwards."},"done":{"type":"integer","format":"uint32","minimum":0,"description":"How many steps were applied (1 without `steps`). The other fields describe the last one.","default":1},"stopped":{"type":["string","null"],"description":"With `steps`: why the run stopped before `steps` (the engine's message, naming the later\nchange and its actor); absent when every step applied."}},"required":["tx","entry","actor","label","rev","committed_rev","done"],"description":"The result of `edit.undo` / `edit.redo`.","title":"HistoryMoved"}},{"name":"edit.undo","summary":"Undo your last change, or another actor's (`actor`; `*` = anyone's latest)","kind":"engine","call":"tool edit_undo","transactional":false,"description":"Undoes the latest change of an actor (default: yours) as a new transaction. History is per\nactor: undoing the agent's change leaves your later edits alone. Refused with\n`Conflict{reason: history_target_modified}` when someone changed the same things since (the\ndetail names them) or the result would be invalid; nothing changes then.","undoable":false,"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"input_schema":{"type":"object","additionalProperties":false,"properties":{"actor":{"type":["string","null"],"description":"Whose change: `user`, `agent:<label>`, `plugin:<id>`, `system`, or `*` for the most\nrecent change by anyone. Default: the caller's own.","pattern":"^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$","default":null},"steps":{"type":["integer","null"],"format":"uint32","minimum":0,"description":"How many changes to undo in one go, newest first, each its own history record (1..=100,\ndefault 1). A refused step stops the run; the output's `done` says how many applied.","default":null}},"description":"Undoes the latest change of an actor (default: yours) as a new transaction. History is per\nactor: undoing the agent's change leaves your later edits alone. Refused with\n`Conflict{reason: history_target_modified}` when someone changed the same things since (the\ndetail names them) or the result would be invalid; nothing changes then.","title":"Undo"},"output_schema":{"type":"object","properties":{"tx":{"type":"string","pattern":"^tx_[0-9]+$","description":"The new transaction that undid or redid it."},"entry":{"type":"string","pattern":"^tx_[0-9]+$","description":"The entry undone or redone (its original transaction)."},"actor":{"type":"string","description":"Whose entry it is.","pattern":"^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"},"label":{"type":"string","description":"Its label."},"rev":{"type":"integer","format":"uint64","minimum":0,"description":"The live revision afterwards."},"committed_rev":{"type":"integer","format":"uint64","minimum":0,"description":"The committed revision afterwards."},"done":{"type":"integer","format":"uint32","minimum":0,"description":"How many steps were applied (1 without `steps`). The other fields describe the last one.","default":1},"stopped":{"type":["string","null"],"description":"With `steps`: why the run stopped before `steps` (the engine's message, naming the later\nchange and its actor); absent when every step applied."}},"required":["tx","entry","actor","label","rev","committed_rev","done"],"description":"The result of `edit.undo` / `edit.redo`.","title":"HistoryMoved"}}]}
