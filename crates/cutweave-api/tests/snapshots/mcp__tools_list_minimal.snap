---
source: crates/cutweave-api/tests/mcp.rs
expression: catalog.tools_json()
---
{
  "tools": [
    {
      "name": "edit_undo",
      "description": "Undo your last change, or another actor's (`actor`; `*` = anyone's latest)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Whose change: `user`, `agent:<label>`, `plugin:<id>`, `system`, or `*` for the most\nrecent change by anyone. Default: the caller's own.",
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "job_wait",
      "description": "Wait up to timeout_ms (max 60 s) for a background job to finish; returns its state",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$",
            "description": "The job."
          },
          "timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0,
            "description": "How long to wait in milliseconds (default 30000; values above 60000 are capped; 0\nreturns the current state)."
          }
        },
        "required": [
          "job_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "media_list",
      "description": "List the project's media (paged, ordered by id)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0,
            "description": "Page size, `1..=500` (default 50)."
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^med_[0-9a-f]{32}$",
            "description": "`next_cursor` of the previous page; the page starts after this ID."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "project_info",
      "description": "Get project name, default format and a summary of its sequences",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "timeline_get",
      "description": "Get a sequence: summary (depth 0), tracks (1) or tracks with items (2)",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^seq_[0-9a-f]{32}$",
            "description": "The sequence."
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint8",
            "minimum": 0,
            "maximum": 255,
            "description": "Detail level `0..=2` (default 1)."
          },
          "fields": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Sections to include: any of `name`, `format`, `duration`, `tracks` (default all)."
          }
        },
        "required": [
          "sequence"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_search_commands",
      "description": "Find commands and queries by keyword, including ones not listed as tools",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words matched against names and summaries; \"\" lists all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Default 20"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_describe_command",
      "description": "Get one command's docs, annotations and full input/output JSON Schemas",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. clip.split"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_execute",
      "description": "Run commands as one all-or-nothing transaction and one undo step",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "cmd": {
                  "type": "string",
                  "description": "e.g. clip.split"
                },
                "args": {
                  "type": "object",
                  "description": "Params; {\"$ref\":\"steps[0].output.left\"} inserts an earlier step's output"
                }
              },
              "required": [
                "cmd"
              ],
              "additionalProperties": false
            }
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate and list the predicted ops; change nothing"
          },
          "expected_rev": {
            "type": "integer",
            "minimum": 0,
            "description": "Fail unless the document is at this revision"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cutweave_query",
      "description": "Run a read-only query by name, e.g. item.get or edit.history",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
