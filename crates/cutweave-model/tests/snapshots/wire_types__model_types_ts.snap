// This file has been generated by Specta. Do not edit this file manually.
/**  A reference to a text animation (3C fills this in; always `None` until then). */
export type AnimRef = {
	/**  The animation's ID. */
	id: string,
} & { [key in string]: unknown };

/**  A static value or keyed values (keyframes §3.1); the wire form for TypeScript. */
export type Animatable<T> = T | Keyframes<T>;

/**  Format of the main audio stream. */
export type AudioInfo = {
	/**  Samples per second. */
	rate: SampleRate,
	/**  Channel count. */
	channels: number,
};

/**  Audio properties of an item (arch §4.2 `audio{…}`, v1 subset). */
export type AudioProps = {
	/**  Gain in decibels (0.0 = unchanged). */
	gain: Animatable<number>,
	/**  Stereo position, -1.0 (left) to 1.0 (right), 0.0 = centre. */
	pan: Animatable<number>,
	/**
	 *  Fade from silence at the start of the clip (WP-2E.01). Absent in documents written
	 *  before it: no fade.
	 */
	fade_in?: Fade,
	/**  Fade to silence at the end of the clip (WP-2E.01). Absent in older documents: no fade. */
	fade_out?: Fade,
} & { [key in string]: unknown };

/**  What happens when the text does not fit the box. */
export type AutoFit = 
/**  Nothing: the text may overflow. */
"none" | 
/**  The font size shrinks until it fits. */
"shrink" | 
/**  The box grows to hold the text. */
"grow_box";

/**  A coloured box behind the text. */
export type Background = {
	/**  Colour. */
	color: Color,
	/**  Space between text and box edge, in reference pixels, 0 to 4000. */
	padding: number,
	/**  Corner radius in reference pixels, 0 to 4000. */
	radius: number,
	/**  One box or one per line. */
	mode: BackgroundMode,
};

/**
 *  What fills a sequence's canvas behind all tracks, over its `background` color (WP-2B.02).
 *  It is static: a background has no keyframes.
 */
export type BackgroundFill = 
/**
 *  A blurred copy of a picture of the sequence, scaled to cover the canvas. Where no such
 *  picture shows, the color does.
 */
{ kind: "blur"; 
/**  Which picture is blurred. */
source?: BlurSource; 
/**
 *  The blur's standard deviation as a fraction of the canvas height, `0..=1`, so
 *  preview and export blur alike at any size.
 */
radius: number | null; 
/**  How much of the blurred picture's light is taken away, `0..=1` (0: none, 1: black). */
dim?: number | null } | 
/**  A still image of the project. An image that no longer exists draws nothing. */
{ kind: "image"; 
/**  The image asset. */
media: MediaId; 
/**  How the image is sized to the canvas. */
fit?: BackgroundFit } | 
/**
 *  Nothing: the canvas starts fully transparent and the color is not drawn. Only exports
 *  that keep alpha show it; the others see black.
 */
{ kind: "transparent" };

/**  How a [`BackgroundFill::Image`] is sized to the canvas. */
export type BackgroundFit = 
/**  Fills the canvas, cropping what does not fit. */
"cover" | 
/**  The whole image inside the canvas; the color shows around it. */
"contain" | 
/**  Stretched to the canvas, changing its shape. */
"stretch";

/**  Whether a background box wraps the whole text or each line. */
export type BackgroundMode = 
/**  One rectangle behind all lines. */
"block" | 
/**  One rectangle per line (a "pill" behind each). */
"per_line";

/**  How an item's picture combines with what is below it (arch §8's core set). Not animatable. */
export type BlendMode = 
/**  The picture covers what is below, by its opacity. */
"normal" | 
/**  Darkens: the product of both. */
"multiply" | 
/**  Lightens: the inverse of the product of the inverses. */
"screen" | 
/**  Multiply in the shadows, screen in the highlights, by what is below. */
"overlay" | 
/**  The darker of both, per channel. */
"darken" | 
/**  The lighter of both, per channel. */
"lighten" | 
/**  The sum of both, clipped. */
"add" | 
/**  A gentle overlay. */
"soft_light";

/**  The picture a [`BackgroundFill::Blur`] blurs. */
export type BlurSource = 
/**  The lowest picture showing at that time. */
"below" | 
/**
 *  The picture on the main track (the magnetic track; without one, the lowest video
 *  track).
 */
"main_track";

/**  Letter case applied when laying out (the stored text is unchanged). */
export type CaseTransform = 
/**  As typed. */
"none" | 
/**  ALL CAPS. */
"upper" | 
/**  all lower. */
"lower" | 
/**  Each Word Capitalised. */
"title";

/**
 *  A media clip: a range of a `MediaAsset` placed on a track.
 * 
 *  The clip occupies `[start, start + duration)` on the timeline and plays the source range
 *  `[source_in, source_in + duration × speed)`, backwards when `reverse`, or one frame of it for
 *  its whole length when it is a `freeze` frame (WP-2D.01; the mapping is `SourceMap`).
 */
export type Clip = {
	/**  The item ID (also its key in the track's `items`). */
	id: ItemId,
	/**  Display name; `None` shows the media name. */
	name: string | null,
	/**  Timeline position of the first frame. */
	start: Time,
	/**  Length on the timeline (positive). */
	duration: Duration,
	/**  Disabled items are kept but neither rendered nor heard. */
	enabled: boolean,
	/**  Items with the same group move, trim and delete together (e.g. linked video and audio). */
	linked_group: GroupId | null,
	/**
	 *  The item this one follows when it moves (schema v2, timeline spec §1.4): an overlay
	 *  attached to a main-track clip. `None` when free.
	 */
	attached_to: ItemId | null,
	/**  Markers in item-relative time; they move with the item. */
	markers: { [key in MarkerId]: Marker },
	/**
	 *  The color label (arch §4.2 `color_label`, issue #222): a display color that marks the
	 *  item on the timeline, set with `item.set_label_color`. It changes nothing in the picture
	 *  or the sound. Absent: no label; left out of the file while absent, so documents written
	 *  before the field read the same.
	 */
	color_label?: Color | null,
	/**  The media this clip plays. */
	media: MediaId,
	/**
	 *  Source position (from the start of the media) of the first frame (of the last frame
	 *  shown, when reversed).
	 */
	source_in: Time,
	/**
	 *  Playback speed (WP-2D.01): a timeline span `d` plays `d × speed` of media (INV-47).
	 *  Absent in documents written before it (the v2 fill-in adds it): normal speed.
	 */
	speed?: Speed,
	/**  Plays its source range backwards (WP-2D.01). Absent in older documents: forwards. */
	reverse?: boolean,
	/**
	 *  A freeze frame (WP-2D.01): shows the frame at `at_source` for its whole length, silent.
	 *  Absent in older documents: not a freeze frame.
	 */
	freeze?: Freeze | null,
	/**  Audio properties. */
	audio: AudioProps,
	/**  Visual properties. */
	visual: VisualProps,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**
 *  A collection of media (ADR-0036): a named list an asset can be on without leaving its
 *  folder.
 */
export type Collection = {
	/**  The collection ID (also its key in `Project::collections`). */
	id: CollectionId,
	/**
	 *  The name shown in the bin: 1 to 255 characters without control characters, unique
	 *  among collections ignoring case.
	 */
	name: string,
	/**  Manual (stored members) or smart (a stored filter). */
	kind: CollectionKind,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**
 *  The ID of a collection of media (ADR-0036): `col_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type CollectionId = string;

/**  What a collection holds (ADR-0036). */
export type CollectionKind = 
/**  A list of assets, kept in the order they were added. */
{ type: "manual"; 
/**
 *  The members, without repeats. One that names no asset is skipped by queries and
 *  dropped by the next edit of the collection.
 */
media?: MediaId[] } | 
/**  A saved search: the assets that pass the filter, computed when asked. */
{ type: "smart"; 
/**  The filter. It may not name a collection. */
filter: MediaFilter };

/**  An sRGB color with straight alpha, written `#rrggbb` (opaque) or `#rrggbbaa`. */
export type Color = string;

/**
 *  Color primaries (H.273).
 * 
 *  Serialized as its name (e.g. `"bt709"`); unknown names are kept as `Other`.
 */
export type ColorPrimaries = string;

/**  Sample range of a video stream. */
export type ColorRange = 
/**  Limited ("TV", 16–235 for 8-bit luma). */
"limited" | 
/**  Full ("PC", 0–255). */
"full";

/**  The working color space of a sequence. Schema v1 has only Rec.709 SDR. */
export type ColorSpace = 
/**  Rec.709 primaries, SDR. */
"rec709";

/**
 *  Color description of a video stream (H.273 code points by FFmpeg name). `None` means
 *  unspecified in the file.
 */
export type ColorTags = {
	/**  Color primaries. */
	primaries: ColorPrimaries | null,
	/**  Transfer characteristics. */
	transfer: TransferCharacteristics | null,
	/**  YUV matrix coefficients. */
	matrix: MatrixCoefficients | null,
	/**  Sample range. */
	range: ColorRange | null,
};

/**
 *  How much of each edge of the upright source picture is cut away, as fractions of the
 *  source frame (`0.0..=1.0` each; keyframes §7). Each edge animates on its own, so each is
 *  validated on its own: when `left + right >= 1` or `top + bottom >= 1` nothing is visible.
 */
export type Crop = {
	/**  Fraction removed from the left edge. */
	left: Animatable<number>,
	/**  Fraction removed from the top edge. */
	top: Animatable<number>,
	/**  Fraction removed from the right edge. */
	right: Animatable<number>,
	/**  Fraction removed from the bottom edge. */
	bottom: Animatable<number>,
} & { [key in string]: unknown };

/**
 *  A non-negative span of time in flicks (item durations, media durations).
 * 
 *  Always within `0..=`[`MAX_SAFE_FLICKS`]. Serialized as a JSON integer, exported to TypeScript
 *  as `number`.
 */
export type Duration = number;

/**  The kind of entity an ID names. */
export type EntityKind = 
/**  A `MediaAsset` (`med_`). */
"media" | 
/**  A `Sequence` (`seq_`). */
"sequence" | 
/**  A `Track` (`trk_`). */
"track" | 
/**  A timeline `Item` (`itm_`). */
"item" | 
/**  A linked group of items that edit together (`grp_`). */
"group" | 
/**  A timeline or item marker (`mrk_`). */
"marker" | 
/**  A folder of the media bin (`fld_`, ADR-0020). */
"folder" | 
/**  A collection of media (`col_`, ADR-0036). */
"collection";

/**
 *  A fade at one end of a clip. A zero duration is no fade. Fades are measured on the clip as
 *  placed (after trimming), so trimming keeps their length unless the clip becomes shorter than
 *  both fades together, when they are scaled down at playback (the stored values stay).
 */
export type Fade = {
	/**  Length of the fade. */
	duration: Duration,
	/**  Its shape. */
	curve: FadeCurve,
};

/**
 *  The shape of a fade: how the gain goes from 0 to 1 over the fade's duration (a fade out runs
 *  it backwards).
 */
export type FadeCurve = 
/**  Gain rises in a straight line (the default). */
"linear" | 
/**  Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in. */
"log" | 
/**  Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`. */
"equal_power" | 
/**  Gentle at both ends: `(1 - cos(x*pi)) / 2`. */
"s_curve";

/**  How the glyphs are filled. Gradients run over the text box. */
export type Fill = 
/**  One colour (animatable). */
{ kind: "solid"; 
/**  The colour, `#rrggbb` or `#rrggbbaa`. */
color: Animatable<Color> } | 
/**  A straight gradient. */
{ kind: "linear"; 
/**  Direction in degrees, clockwise from "left to right" (0) . */
angle: number; 
/**  Two to sixteen stops, ascending by `at`. */
stops: GradientStop[] } | 
/**  A circular gradient. */
{ kind: "radial"; 
/**  Centre in box units (0.5, 0.5 is the middle). */
center: Vec2; 
/**  Radius as a fraction of the box's larger side. */
radius: number; 
/**  Two to sixteen stops, ascending by `at`. */
stops: GradientStop[] };

/**
 *  Mirroring of an item about its centre, after the crop (keyframes §7). Hold-only: a keyed
 *  flip switches at its keys.
 */
export type Flip = {
	/**  Mirror left-right. */
	horizontal: Animatable<boolean>,
	/**  Mirror top-bottom. */
	vertical: Animatable<boolean>,
} & { [key in string]: unknown };

/**
 *  The ID of a folder of the media bin (ADR-0020): `fld_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type FolderId = string;

/**  One variable-font axis setting (`wght`, `wdth`, `opsz`, ...). */
export type FontAxis = {
	/**  The four-letter axis tag. */
	tag: string,
	/**  Its value. */
	value: number,
};

/**
 *  A font as the document names it: a family, weight and slant, plus variable-font axes. The
 *  font manager (WP-3A.02) resolves it to a file, falling back deterministically.
 */
export type FontSpec = {
	/**  Family name, e.g. `"Inter"`. */
	family: string,
	/**  Weight, 1 to 1000 (400 regular, 700 bold). */
	weight: number,
	/**  Italic or oblique. */
	italic: boolean,
	/**  Variable-font axes, sorted by tag. */
	axes?: FontAxis[],
};

/**
 *  A video frame rate as an exact rational `num/den` frames per second (`30000/1001` is
 *  29.97 fps), always in lowest terms.
 * 
 *  Serialized as `{"num": 30000, "den": 1001}`; unreduced input is reduced on parse.
 */
export type FrameRate = {
	num: number,
	den: number,
};

/**
 *  A freeze frame (WP-2D.01): the clip shows one frame of its media for its whole length, and is
 *  silent.
 */
export type Freeze = {
	/**  The media position of the frame shown. */
	at_source: Time,
};

/**  A soft halo around the glyphs. */
export type Glow = {
	/**  Radius in reference pixels, 0 to 4000. */
	radius: number,
	/**  Colour. */
	color: Color,
	/**  Strength, 0 to 4 (1 is a plain halo). */
	intensity: number,
};

/**  One stop of a gradient. */
export type GradientStop = {
	/**  Position along the gradient, 0.0 to 1.0. */
	at: number,
	/**  The colour there. */
	color: Color,
};

/**
 *  The ID of a linked group (items that move and delete together, e.g. the video and audio
 *  of one imported file): `grp_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type GroupId = string;

/**
 *  A numbered run of pictures imported as one asset (ADR-0035): frame `n` (from 0) is the file
 *  `pattern` with the number `first + n`. Files are referenced, never copied.
 */
export type ImageSequence = {
	/**
	 *  The file name with the counter as `%0Nd` (zero-padded to `N` digits) or `%d`
	 *  (`shot_%04d.exr`); a literal `%` is written `%%`. A name, not a path: the files are in
	 *  the directory of `path_abs`.
	 */
	pattern: string,
	/**  The number of the first file. */
	first: number,
	/**  How many numbers the run covers, from `first` (missing ones included); at least 2. */
	count: number,
	/**  The frame rate chosen at import; changing the app setting never changes it. */
	fps: FrameRate,
	/**
	 *  The numbers with no file at import time, ascending. A missing frame shows the last
	 *  picture before it.
	 */
	missing: number[],
} & { [key in string]: unknown };

/**
 *  The sequence's in and out points: the half-open range `[start, end)` that lift, extract and
 *  three-point edits use. Both ends or neither (`Sequence::in_out` is `None` when unset).
 */
export type InOut = {
	/**  The in point (`>= 0`). */
	start: Time,
	/**  The out point (`> start`). */
	end: Time,
} & { [key in string]: unknown };

/**
 *  How the segment that starts at a key moves to the next key (keyframes §4). It is a closed
 *  set: a new kind is a schema change.
 * 
 *  Every kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,
 *  fed into one lerp per value type (§5). On the wire it is an object tagged by `kind`
 *  (`{"kind": "bezier", "x1": 0.42, "y1": 0, "x2": 0.58, "y2": 1, "preset": "ease_in_out"}`)
 *  with exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).
 */
export type Interp = 
/**  The key's value until the next key, then a jump (§4.2). */
{ kind: "hold" } | 
/**  `p = u` (§4.3). */
{ kind: "linear" } | 
/**
 *  A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).
 *  (`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the
 *  next one.
 */
{ kind: "bezier"; 
/**  First control point, time axis, in `[0, 1]`. */
x1: number; 
/**  First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots). */
y1: number; 
/**  Second control point, time axis, in `[0, 1]`. */
x2: number; 
/**  Second control point, progress axis, in `[−10, 10]`. */
y2: number; 
/**
 *  The preset these numbers came from, a hint for the UI and agents (§4.6). Never read
 *  by evaluation.
 */
preset?: string | null } | 
/**
 *  A damped spring in real seconds, released from rest, plus a residual that lands it
 *  exactly on the next key (§4.5).
 */
{ kind: "spring"; 
/**  Stiffness, N/m, in `[1, 10000]`. */
stiffness: number; 
/**  Damping, N·s/m, in `[0, 1000]` (0 never settles). */
damping: number; 
/**  Mass, kg, in `[0.1, 100]`. */
mass: number; 
/**  A hard stop at the target: the motion reflects instead of passing it. */
bounce: boolean; 
/**  The preset these numbers came from (§4.6). Never read by evaluation. */
preset?: string | null };

/**  A broken document invariant: what [`Project::validate`] reports. */
export type Invariant = 
/**
 *  The document is not at the schema version this build edits (open it through
 *  `open`/`migrate_to_current`, which migrate older documents).
 */
{ invariant: "schema_version"; 
/**  The document's `meta.schema_version`. */
found: number; 
/**  `CURRENT_SCHEMA_VERSION`. */
expected: number } | 
/**  A map key differs from the ID inside the entity. */
{ invariant: "key_mismatch"; 
/**  The map (`/media`, `/sequences/<id>/tracks`, …). */
path: string; 
/**  The key. */
key: string; 
/**  The entity's own ID. */
id: string } | 
/**  A reference to an entity that does not exist. */
{ invariant: "dangling_reference"; 
/**  Where the reference is. */
path: string; 
/**  The kind of entity referred to. */
kind: EntityKind; 
/**  The missing ID. */
id: string } | 
/**  A media asset whose fields contradict its kind. */
{ invariant: "invalid_media"; 
/**  The media. */
media: MediaId; 
/**  What is wrong. */
reason: string } | 
/**  A sequence format (or the default format) outside the supported range. */
{ invariant: "invalid_format"; 
/**  The format. */
path: string; 
/**  What is wrong. */
reason: string } | 
/**  `track_order` is not exactly the keys of `tracks`. */
{ invariant: "track_order"; 
/**  The sequence. */
sequence: SequenceId; 
/**  What is wrong. */
reason: string } | 
/**  A clip whose media cannot play on its track (e.g. audio on a video track). */
{ invariant: "incompatible_media"; 
/**  The item. */
item: ItemId; 
/**  Its track. */
track: TrackId; 
/**  The track kind. */
track_kind: TrackKind; 
/**  The media. */
media: MediaId; 
/**  The media kind. */
media_kind: MediaKind } | 
/**
 *  An item with a non-positive duration, a negative start or source position, or an end
 *  past the largest representable time.
 */
{ invariant: "invalid_timing"; 
/**  The item. */
item: ItemId; 
/**  What is wrong. */
reason: string } | 
/**
 *  A clip that reads past the end of its media (`source_in + duration × speed > media
 *  duration`, or a freeze frame at or past the end).
 */
{ invariant: "source_out_of_bounds"; 
/**  The item. */
item: ItemId; 
/**  The media. */
media: MediaId; 
/**  `source_in + duration × speed` (a freeze frame's position). */
source_end: Time; 
/**  The media duration. */
media_duration: Duration } | 
/**  Two items of one track overlap (arch §4.3: never). */
{ invariant: "overlap"; 
/**  The sequence. */
sequence: SequenceId; 
/**  The track. */
track: TrackId; 
/**  The earlier item. */
first: ItemId; 
/**  The item starting inside it. */
second: ItemId } | 
/**  Sequences that contain each other through compound clips (arch §4.3). */
{ invariant: "compound_cycle"; 
/**  The sequences on the cycle; the first is repeated at the end. */
cycle: SequenceId[] } | 
/**  A linked group with items in two sequences. */
{ invariant: "linked_group_spans_sequences"; 
/**  The group. */
group: GroupId; 
/**  One sequence. */
first: SequenceId; 
/**  Another sequence. */
second: SequenceId } | 
/**  A number that is not finite or outside its range (e.g. opacity above 1). */
{ invariant: "invalid_value"; 
/**  The value. */
path: string; 
/**  What is wrong. */
reason: string } | 
/**
 *  The magnetic main track rules (spec INV-6, INV-7): at most one per sequence, a video
 *  track, gap-free from 0.
 */
{ invariant: "magnetic_track"; 
/**  The sequence. */
sequence: SequenceId; 
/**  The offending track. */
track: TrackId; 
/**  What is wrong. */
reason: string } | 
/**  A linked group with fewer than two members (spec INV-8). */
{ invariant: "linked_group_too_small"; 
/**  The group. */
group: GroupId; 
/**  How many items carry it. */
members: number } | 
/**  Linked items that are not aligned: members differ in `start` or `duration` (spec INV-8). */
{ invariant: "linked_group_misaligned"; 
/**  The group. */
group: GroupId; 
/**  The first member (lowest ID). */
first: ItemId; 
/**  A member that differs from it. */
second: ItemId } | 
/**  An attachment that breaks spec INV-9. */
{ invariant: "attachment"; 
/**  The child. */
item: ItemId; 
/**  The item it is attached to. */
parent: ItemId; 
/**  What is wrong. */
reason: string } | 
/**  Media folders whose parents form a cycle (ADR-0020). */
{ invariant: "folder_cycle"; 
/**
 *  The folders on the cycle, each followed by its parent; the first is repeated at the
 *  end.
 */
cycle: FolderId[] } | 
/**  A media folder nested deeper than `MAX_FOLDER_DEPTH` levels (ADR-0020). */
{ invariant: "folder_too_deep"; 
/**  The folder. */
folder: FolderId; 
/**  Its depth (1 at the top level). */
depth: number } | 
/**
 *  A media folder name that is empty, too long, or holds `/` or control characters
 *  (ADR-0020).
 */
{ invariant: "invalid_folder_name"; 
/**  The folder. */
folder: FolderId; 
/**  What is wrong. */
reason: string } | 
/**  Two folders of one parent whose names are equal ignoring case (ADR-0020). */
{ invariant: "duplicate_folder_name"; 
/**  The parent; absent at the top level. */
parent: FolderId | null; 
/**  The folder with the lower ID. */
first: FolderId; 
/**  Another folder with the same name. */
second: FolderId; 
/**  The name of `second`. */
name: string } | 
/**
 *  A collection that breaks ADR-0036: a bad name, too many members or a repeated one, a
 *  smart filter that cannot be used or that names a collection, or more collections than
 *  allowed. (A member that names no asset is allowed.)
 */
{ invariant: "invalid_collection"; 
/**  The collection. */
collection: CollectionId; 
/**  What is wrong. */
reason: string } | 
/**  Two collections whose names are equal ignoring case (ADR-0036). */
{ invariant: "duplicate_collection_name"; 
/**  The collection with the lower ID. */
first: CollectionId; 
/**  Another collection with the same name. */
second: CollectionId; 
/**  The name of `second`. */
name: string } | 
/**  Plugin data under a key that is not a namespace (arch §4.3). */
{ invariant: "custom_namespace"; 
/**  The custom map. */
path: string; 
/**  The key. */
key: string };

/**
 *  Anything placed on a track (arch §4.2): a media [`Clip`] or a [`TextItem`] (WP-3A.01).
 *  Matching code outside this crate needs a wildcard arm for the kinds still to come.
 * 
 *  Serialized as the variant's object plus a `"kind"` tag (`{"kind": "clip", …}`).
 */
export type Item = 
/**  A media clip. */
{
	kind: "clip",
} & Clip | 
/**  Text on a text track. */
{
	kind: "text",
} & TextItem;

/**
 *  The ID of a timeline `Item`: `itm_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type ItemId = string;

/**
 *  TypeScript shape of any JSON value (numbers are plain `number`s). Only its type
 *  definition is used.
 */
export type JsonValue = null | boolean | number | string | JsonValue[] | { [key in string]: JsonValue };

export type Keyframe<T> = {
	/**  Item-relative flicks. */
	t: Time,
	value: T,
	interp: Interp,
};

export type Keyframes<T> = {
	keyframes: Keyframe<T>[],
};

/**  A marker on a sequence (sequence time) or an item (item-relative time). */
export type Marker = {
	/**  The marker ID (also its key in the owner's `markers`). */
	id: MarkerId,
	/**  Where the marker is (`>= 0`). */
	t: Time,
	/**  The length of a range marker; `None` for a point marker. */
	duration: Duration | null,
	/**  Text shown with the marker (may be empty). */
	label: string,
	/**  Display color. */
	color: Color,
	/**  What the marker means. */
	kind: MarkerKind,
} & { [key in string]: unknown };

/**
 *  The ID of a marker on a sequence or an item: `mrk_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type MarkerId = string;

/**  What a marker means. */
export type MarkerKind = 
/**  Placed by a person or an agent. */
"user" | 
/**  A beat found by analysis (snaps like a marker, spec §6). */
"beat" | 
/**  A chapter start (exported to chaptered formats). */
"chapter";

/**
 *  YUV matrix coefficients (H.273).
 * 
 *  Serialized as its name (e.g. `"bt709"`); unknown names are kept as `Other`.
 */
export type MatrixCoefficients = string;

/**
 *  Media imported into (or generated for) a project, referenced by path and content hash
 *  (arch §17), or a sequence of this project used as a compound clip.
 */
export type MediaAsset = {
	/**  The media ID (also its key in `Project::media`). */
	id: MediaId,
	/**  What the media is. */
	kind: MediaKind,
	/**
	 *  The name shown in the bin (ADR-0020); absent: the file name. 1 to 255 characters
	 *  without control characters.
	 */
	name: string | null,
	/**  The folder of the bin it is in (ADR-0020); absent: the top level. */
	folder: FolderId | null,
	/**  Absolute path of the file when it was last found (file kinds only). */
	path_abs: string | null,
	/**  Path relative to the project folder, used for relinking moved projects (file kinds only). */
	path_rel: string | null,
	/**  Content hash used to relink and to key caches (file kinds only). */
	content_hash: string | null,
	/**  The referenced sequence (`sequence_ref` only). */
	sequence: SequenceId | null,
	/**
	 *  The run of pictures (`image_sequence` only, ADR-0035); left out of the file otherwise.
	 *  `path_abs` and `path_rel` name the first file of the run.
	 */
	image_sequence?: ImageSequence | null,
	/**
	 *  Whether it gets a proxy (ADR-0027): as the project's policy decides, always or never.
	 *  `auto` is left out of the file, so documents written before the field read the same.
	 */
	proxy_mode?: ProxyMode,
	/**
	 *  Tags (ADR-0036): each 1 to 64 characters without commas or control characters, at most
	 *  64, sorted ignoring case and accents, without repeats. Left out of the file while
	 *  empty.
	 */
	tags?: string[],
	/**
	 *  Rating in whole stars, 1 to 5 (ADR-0036); absent: unrated. Left out of the file while
	 *  absent.
	 */
	rating?: number | null,
	/**
	 *  A note in plain text, at most 2,000 characters (ADR-0036). Left out of the file while
	 *  absent.
	 */
	note?: string | null,
	/**  Probe results. */
	probe: ProbeInfo,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**
 *  Which media to list; every part that is absent or empty lets everything through. The filter
 *  of `media.list`, and what a smart collection stores (ADR-0036).
 */
export type MediaFilter = {
	/**  Terms that must all occur in the name, tags or note, ignoring case and accents. */
	text?: string | null,
	/**  Only these kinds. */
	kinds?: MediaKind[] | null,
	/**  Shortest length (flicks), inclusive; stills never match a bound. */
	min_duration?: Duration | null,
	/**  Longest length (flicks), inclusive. */
	max_duration?: Duration | null,
	/**  Placed on a timeline of any sequence (`true`) or not (`false`). */
	used?: boolean | null,
	/**  `true`: only files nothing can be read from (no streams). */
	problems?: boolean | null,
	/**  Only this bin folder. */
	folder?: FolderId | null,
	/**  With subfolders (default: true without folder). */
	recursive?: boolean | null,
	/**  Has all these tags. */
	tags?: string[] | null,
	/**  Rated at least this (1-5). */
	min_rating?: number | null,
	/**  On this collection. */
	collection?: CollectionId | null,
};

/**  A folder of the media bin (ADR-0020). */
export type MediaFolder = {
	/**  The folder ID (also its key in `Project::folders`). */
	id: FolderId,
	/**
	 *  The name shown in the bin: 1 to 255 characters, no `/` or control characters, unique
	 *  among its siblings ignoring case.
	 */
	name: string,
	/**  The folder it is in; absent at the top level. */
	parent: FolderId | null,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**
 *  The ID of a `MediaAsset`: `med_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type MediaId = string;

/**  What a [`MediaAsset`] is. */
export type MediaKind = 
/**  A video file (may also carry audio). */
"video" | 
/**  An audio-only file. */
"audio" | 
/**  A still image (no duration). */
"image" | 
/**
 *  A numbered run of pictures that plays like video (ADR-0035); the asset's
 *  `image_sequence` field describes the run.
 */
"image_sequence" | 
/**  Another sequence of this project, used as a compound clip (arch §4.3). */
"sequence_ref";

/**  What the media backend found in a file (WP-1D.02 fills it). */
export type ProbeInfo = {
	/**  Streams in container order. */
	streams: StreamInfo[],
	/**  Playable length, if known (images have none). */
	duration: Duration | null,
	/**  Frame rate of the main video stream, if constant or nominal. */
	fps: FrameRate | null,
	/**  Variable frame rate: times map through the frame index, never through `fps` (arch §4.1). */
	vfr: boolean,
	/**  Display rotation in degrees clockwise: 0, 90, 180 or 270. */
	rotation: number,
	/**  Color tags of the main video stream. */
	color: ColorTags,
	/**  Main audio stream format, if any. */
	audio: AudioInfo | null,
} & { [key in string]: unknown };

/**
 *  The project document: everything saved in `<Name>.cutweave` (arch §17).
 * 
 *  Entities are addressed by ID, never by index (arch §4.3). All collections are persistent
 *  (`imbl`), so `clone()` is O(1) and snapshots share structure (ADR-0005). Mutate only through
 *  commands (`cutweave-ops`); readers get immutable snapshots.
 * 
 *  The JSON form has a stable layout (fields in declaration order, maps sorted by key), so
 *  saved files diff cleanly.
 */
export type Project = {
	/**  Document metadata. */
	meta: ProjectMeta,
	/**  Project-wide settings. */
	settings: ProjectSettings,
	/**  Media, keyed by ID. */
	media: { [key in MediaId]: MediaAsset },
	/**  The folder tree of the media bin, keyed by ID (ADR-0020). */
	folders: { [key in FolderId]: MediaFolder },
	/**
	 *  Collections of media, keyed by ID (ADR-0036). Left out of the file while empty, so
	 *  documents written before the field read the same.
	 */
	collections?: { [key in CollectionId]: Collection },
	/**  Sequences, keyed by ID. */
	sequences: { [key in SequenceId]: Sequence },
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**  Document metadata. */
export type ProjectMeta = {
	/**
	 *  Version of the document format (`CURRENT_SCHEMA_VERSION` when saved by this build).
	 *  Older documents are migrated on open; newer ones open read-only (arch §4.3).
	 */
	schema_version: number,
	/**  Project name. */
	name: string,
	/**
	 *  When the project was created (RFC 3339 UTC, e.g. `2026-11-22T10:00:00Z`), set by the
	 *  engine (frozen under `--deterministic-ids`).
	 */
	created: string | null,
	/**  Version of the Cutweave build that last saved the document. */
	app_version: string | null,
} & { [key in string]: unknown };

/**  Project-wide settings (arch §4.2 `settings`, v1 subset). */
export type ProjectSettings = {
	/**  Format of new sequences. */
	default_format: SequenceFormat,
	/**
	 *  How long a still image is when it is placed without a length (ADR-0035). Absent: five
	 *  seconds ([`DEFAULT_STILL_DURATION_SECS`]); left out of the file while absent, so
	 *  documents written before the field read the same. Changing it never alters clips that
	 *  already exist.
	 */
	still_duration?: Duration | null,
	/**
	 *  Which video gets proxies automatically (ADR-0027). `auto` is left out of the file, so
	 *  documents written before the field read the same.
	 */
	proxy_policy?: ProxyPolicy,
} & { [key in string]: unknown };

/**  Whether one asset gets a proxy (ADR-0027), next to the project's policy. */
export type ProxyMode = 
/**  As the project's policy decides. The default. */
"auto" | 
/**  One is made whatever the policy. */
"force" | 
/**  None is made, and the preview does not use one that exists. */
"off";

/**
 *  When a project's video gets proxies automatically (ADR-0027). Proxies themselves are cache
 *  state of each computer; the policy is the editor's intent and travels with the project.
 */
export type ProxyPolicy = 
/**  Never automatically (`media.generate_proxy` still makes one). */
"off" | 
/**
 *  For video that is slow to scrub: long-GOP H.264 or HEVC larger than 1920 pixels, faster
 *  than 60 fps, or 10-bit HEVC. The default.
 */
"auto" | 
/**  For every video file. */
"all";

/**  The words of a text item: runs, in order. */
export type RichText = {
	/**  The runs. Adjacent runs with equal overrides are kept merged. */
	runs: Run[],
};

/**  How a time that falls between two frame (or sample) boundaries is mapped to a unit index. */
export type Rounding = 
/**  The unit that contains the time (the latest boundary at or before it). */
"floor" | 
/**  The nearest boundary; exact halves round up (towards the later unit). */
"nearest";

/**  A stretch of text with one style override. */
export type Run = {
	/**  The characters (may hold `\n` line breaks). */
	text: string,
	/**  Overrides of the item's style for this run; absent: the item's style. */
	style?: RunStyle | null,
};

/**
 *  A style override for a run: only the fields given replace the item's style for those
 *  characters. Static values only (no keys).
 */
export type RunStyle = {
	/**  Font. */
	font?: FontSpec | null,
	/**  Size in reference pixels. */
	size?: number | null,
	/**  Fill. */
	fill?: Fill | null,
	/**  Outlines (replace the style's). */
	strokes?: Stroke[] | null,
	/**  Shadows (replace the style's). */
	shadows?: Shadow[] | null,
	/**  Letter spacing in em. */
	letter_spacing?: number | null,
	/**  Case. */
	case_transform?: CaseTransform | null,
};

/**
 *  An audio sample rate in Hz.
 * 
 *  Serialized as a JSON integer (`48000`).
 */
export type SampleRate = number;

/**
 *  A timeline (arch §4.2). A project may hold several (e.g. a long cut and its shorts); the v1
 *  UI shows one.
 */
export type Sequence = {
	/**  The sequence ID (also its key in `Project::sequences`). */
	id: SequenceId,
	/**  Display name. */
	name: string,
	/**  Canvas, rates and color. */
	format: SequenceFormat,
	/**  The tracks, keyed by ID. */
	tracks: { [key in TrackId]: Track },
	/**
	 *  Display order, top to bottom: every key of `tracks` exactly once. Upper video tracks
	 *  are composited over lower ones.
	 */
	track_order: TrackId[],
	/**  Markers in sequence time, keyed by ID. They never move with a ripple (spec INV-34). */
	markers: { [key in MarkerId]: Marker },
	/**  The in and out points; both ends or neither. */
	in_out: InOut | null,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**  Canvas size, frame rate, audio rate and color of a sequence (arch §4.2 `format`). */
export type SequenceFormat = {
	/**  Canvas width in pixels. */
	width: number,
	/**  Canvas height in pixels. */
	height: number,
	/**  The edit grid: timecodes and `"f:N"` inputs resolve against it. */
	frame_rate: FrameRate,
	/**  The mix rate. */
	sample_rate: SampleRate,
	/**  Working color space. */
	color_space: ColorSpace,
	/**  Canvas color behind all tracks. */
	background: Color,
	/**
	 *  What fills the canvas over that color, behind all tracks (WP-2B.02). Absent: the color
	 *  alone. Left out of the file while absent, so documents without one read as before.
	 */
	background_fill?: BackgroundFill | null,
} & { [key in string]: unknown };

/**
 *  The ID of a `Sequence`: `seq_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type SequenceId = string;

/**  A drop shadow. */
export type Shadow = {
	/**  Offset in reference pixels (+y is down). */
	offset: Vec2,
	/**  Blur radius in reference pixels, 0 to 4000. */
	blur: number,
	/**  Colour (alpha is the strength). */
	color: Color,
};

/**
 *  A constant playback speed: `num/den` times normal, from 1/10 to 100, in lowest terms.
 * 
 *  Serialized as `{"num": 2, "den": 1}`; unreduced input is reduced on parse.
 */
export type Speed = {
	num: number,
	den: number,
};

/**  One stream of a media file. */
export type StreamInfo = {
	/**  Index in the container. */
	index: number,
	/**  Stream kind. */
	kind: StreamKind,
	/**  Codec name (FFmpeg naming, e.g. `h264`, `aac`). */
	codec: string | null,
	/**  Codec profile (e.g. `High`, `Main 10`). */
	profile: string | null,
	/**  Coded width in pixels (video). */
	width: number | null,
	/**  Coded height in pixels (video). */
	height: number | null,
	/**  Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video). */
	pixel_format: string | null,
	/**  Sample rate (audio). */
	sample_rate: SampleRate | null,
	/**  Channel count (audio). */
	channels: number | null,
	/**  Language tag (e.g. `eng`). */
	language: string | null,
} & { [key in string]: unknown };

/**  The kind of a container stream. */
export type StreamKind = 
/**  Pictures. */
"video" | 
/**  Sound. */
"audio" | 
/**  Subtitles or captions. */
"subtitle" | 
/**  Timed metadata or other data. */
"data" | 
/**  Attached files (fonts, cover art). */
"attachment";

/**  One outline. A style may stack several; they are drawn in list order. */
export type Stroke = {
	/**  Width in reference pixels, 0 to 4000. */
	width: number,
	/**  Corner style. */
	join: StrokeJoin,
	/**  Colour. */
	color: Color,
	/**  Behind or over the fill. */
	order: StrokeOrder,
};

/**  How an outline's corners are drawn. */
export type StrokeJoin = 
/**  Sharp corners. */
"miter" | 
/**  Rounded corners. */
"round" | 
/**  Cut-off corners. */
"bevel";

/**  Whether an outline is drawn behind the fill or over it. */
export type StrokeOrder = 
/**  Under the fill: the outline grows outward only. */
"behind" | 
/**  Over the fill: it also eats into the letter. */
"over";

/**  Horizontal alignment of lines in the box. */
export type TextAlign = 
/**  Flush left (flush start in right-to-left text is `start` in a later version). */
"left" | 
/**  Centred. */
"center" | 
/**  Flush right. */
"right" | 
/**  Stretched to both edges (the last line stays flush left). */
"justify";

/**
 *  In, out and loop animations of a text item. WP-3A.01 never sets one; the field is `None`
 *  until WP-3C.
 */
export type TextAnimation = {
	/**  Plays as the item appears. */
	in?: AnimRef | null,
	/**  Plays as the item leaves. */
	out?: AnimRef | null,
	/**  Plays all the while. */
	loop?: AnimRef | null,
};

/**
 *  The rectangle text lays out in: it wraps at `width` and aligns inside `width` x `height`.
 *  Sizes are canvas units; `None` is automatic (as wide or high as the text).
 */
export type TextBox = {
	/**  Width in canvas widths, above 0 and at most 4; `None`: no wrapping. */
	width?: number | null,
	/**  Height in canvas heights, above 0 and at most 4; `None`: as high as the text. */
	height?: number | null,
};

/**  The base direction of the text. */
export type TextDirection = 
/**  From the first strong character. */
"auto" | 
/**  Left to right. */
"ltr" | 
/**  Right to left. */
"rtl";

/**  A text item on a text track (arch §4.2). */
export type TextItem = {
	/**  The item ID (also its key in the track's `items`). */
	id: ItemId,
	/**  Display name; `None` shows the start of the text. */
	name: string | null,
	/**  Timeline position of the first frame. */
	start: Time,
	/**  Length on the timeline (positive). */
	duration: Duration,
	/**  Disabled items are kept but not rendered. */
	enabled: boolean,
	/**  Items with the same group move, trim and delete together. */
	linked_group: GroupId | null,
	/**  The item this one follows when it moves. */
	attached_to: ItemId | null,
	/**  Markers in item-relative time. */
	markers: { [key in MarkerId]: Marker },
	/**  The color label. */
	color_label?: Color | null,
	/**  The words. */
	content: RichText,
	/**  The look: a built-in style by name, or one of its own. */
	style: TextStyleRef,
	/**  The layout rectangle. */
	box: TextBox,
	/**  In, out and loop animations; `None` until WP-3C. */
	animation?: TextAnimation | null,
	/**  Placement and opacity (the same properties a clip has). */
	visual: VisualProps,
	/**  Plugin data. */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**  The look of a text item (WP-3A.01). */
export type TextStyle = {
	/**  The font. */
	font: FontSpec,
	/**  Font size in reference pixels, 1 to 4000 (animatable: `text.size`). */
	size: Animatable<number>,
	/**  The glyph fill. */
	fill: Fill,
	/**  Outlines, drawn in order (at most 8). */
	strokes?: Stroke[],
	/**  Drop shadows (at most 8). */
	shadows?: Shadow[],
	/**  A halo, if any. */
	glow?: Glow | null,
	/**  A box behind the text, if any. */
	background?: Background | null,
	/**  Extra space between letters in em, -1 to 10 (animatable: `text.letter_spacing`). */
	letter_spacing: Animatable<number>,
	/**  Line height as a multiple of the size, 0.1 to 10 (animatable: `text.line_height`). */
	line_height: Animatable<number>,
	/**  Horizontal alignment. */
	align: TextAlign,
	/**  Vertical alignment in the box. */
	v_align: VerticalAlign,
	/**  Case applied at layout. */
	case_transform: CaseTransform,
	/**  What to do when the text does not fit. */
	auto_fit: AutoFit,
	/**  Base direction. */
	direction: TextDirection,
} & { [key in string]: unknown };

/**  Where an item's style comes from. */
export type TextStyleRef = 
/**  A built-in style by name (see [`builtin_styles`]). */
{ source: "named"; 
/**  `title`, `subtitle` or `body`. */
name: string } | 
/**  A style of its own. */
{ source: "inline"; 
/**  The style. */
style: TextStyle };

/**
 *  A position on a timeline or in a source, in flicks (1/705,600,000 s).
 * 
 *  Always within ±[`MAX_SAFE_FLICKS`]; may be negative (relative offsets). Serialized as a JSON
 *  integer, exported to TypeScript as `number`.
 */
export type Time = number;

/**
 *  A time argument as clients send it (arch §4.1): flicks, seconds, a frame or a timecode.
 * 
 *  Integers and seconds resolve on their own; frames and timecodes need the frame rate of the
 *  sequence that owns the command's target ([`TimeInput::resolve`]). On the wire it is a JSON
 *  integer or one of the strings `"62.5s"`, `"123"`, `"f:1500"`, `"00:01:02:03"`,
 *  `"00:01:02;03"`; in TypeScript `number | string`.
 */
export type TimeInput = number | string;

/**  A track of a sequence (arch §4.2): items that never overlap (arch §4.3). */
export type Track = {
	/**  The track ID (also its key in `Sequence::tracks`). */
	id: TrackId,
	/**  What the track holds. */
	kind: TrackKind,
	/**  Display name. */
	name: string,
	/**  The items, keyed by ID. */
	items: { [key in ItemId]: Item },
	/**  Silenced (audio). */
	muted: boolean,
	/**  Not rendered (video). */
	hidden: boolean,
	/**  Commands that would change the track's items fail with `Locked`. */
	locked: boolean,
	/**  Solo (audio): when any track is solo, only solo tracks are heard. */
	solo: boolean,
	/**
	 *  The magnetic main track: ripple-by-default editing, gap-free from 0 (timeline spec
	 *  §1.2). At most one video track per sequence has it (`Project::validate`).
	 */
	magnetic: boolean,
	/**
	 *  Row height in the timeline, in pixels: a persisted UI hint (`None` = the default).
	 *  Changing it never touches items.
	 */
	height: number | null,
	/**  Track gain in decibels (0.0 = unchanged). */
	gain: number,
	/**  Plugin data (arch §4.3). */
	custom: { [key in string]: JsonValue },
} & { [key in string]: unknown };

/**
 *  The ID of a `Track`: `trk_…`.
 * 
 *  Serialized as a string, exported to TypeScript as `string`.
 */
export type TrackId = string;

/**
 *  What a track holds. Schema v1 edits only video and audio tracks; the other kinds exist so
 *  documents and commands can name them (ops answer `Unsupported`).
 */
export type TrackKind = 
/**  Picture layers. */
"video" | 
/**  Sound. */
"audio" | 
/**  Titles (later versions). */
"text" | 
/**  Captions (later versions). */
"caption" | 
/**  Adjustment layers (later versions). */
"adjustment";

/**
 *  Transfer characteristics (H.273).
 * 
 *  Serialized as its name (e.g. `"bt709"`); unknown names are kept as `Other`.
 */
export type TransferCharacteristics = string;

/**
 *  Where and how a visual item is placed on the sequence canvas.
 * 
 *  Coordinates are resolution-independent: `position` is the offset of the item's anchor from
 *  the canvas center in canvas units (1.0 = the canvas width horizontally and the canvas height
 *  vertically; +y is down); `anchor` is a point of the item in item units ((0, 0) top-left,
 *  (0.5, 0.5) center); `scale` multiplies the aspect-fit size; `rotation` is in degrees,
 *  clockwise.
 */
export type Transform = {
	/**  Offset of the anchor from the canvas center, in canvas units. */
	position: Animatable<Vec2>,
	/**  Size multiplier per axis (1.0 = aspect-fit). */
	scale: Animatable<Vec2>,
	/**  Clockwise rotation in degrees. */
	rotation: Animatable<number>,
	/**  The item point that `position` places and rotation turns around, in item units. */
	anchor: Animatable<Vec2>,
} & { [key in string]: unknown };

/**  A 2D vector (positions, scales, anchors). */
export type Vec2 = {
	/**  Horizontal component. */
	x: number,
	/**  Vertical component (down is positive). */
	y: number,
};

/**  Vertical alignment of the text block in the box. */
export type VerticalAlign = 
/**  Against the top edge. */
"top" | 
/**  In the middle. */
"middle" | 
/**  Against the bottom edge. */
"bottom";

/**  Visual properties of an item (arch §4.2 `VisualProps`; keyframes §7). */
export type VisualProps = {
	/**  Placement on the canvas. */
	transform: Transform,
	/**  Opacity, 0.0 (transparent) to 1.0 (opaque). */
	opacity: Animatable<number>,
	/**  Edges of the source picture cut away. */
	crop: Crop,
	/**  Mirroring. */
	flip: Flip,
	/**  How the item combines with what is below. */
	blend_mode: BlendMode,
} & { [key in string]: unknown };
