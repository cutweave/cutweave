---
source: crates/cutweave-model/tests/wire_types.rs
expression: "cutweave_model::canonical_json_pretty(&schema)"
---
{
  "$defs": {
    "Animatable_Vec2": {
      "description": "A static value, or keyed values over item time (keyframes §3.1).",
      "oneOf": [
        {
          "$ref": "#/$defs/Vec2"
        },
        {
          "$ref": "#/$defs/Keyframes_Vec2"
        }
      ]
    },
    "Animatable_boolean": {
      "description": "A static value, or keyed values over item time (keyframes §3.1).",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Keyframes_boolean"
        }
      ]
    },
    "Animatable_double": {
      "description": "A static value, or keyed values over item time (keyframes §3.1).",
      "oneOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "$ref": "#/$defs/Keyframes_double"
        }
      ]
    },
    "AudioInfo": {
      "additionalProperties": false,
      "description": "Format of the main audio stream.",
      "properties": {
        "channels": {
          "description": "Channel count.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "description": "Samples per second.",
          "maximum": 352800000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "rate",
        "channels"
      ],
      "type": "object"
    },
    "AudioProps": {
      "description": "Audio properties of an item (arch §4.2 `audio{…}`, v1 subset).",
      "properties": {
        "gain": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Gain in decibels (0.0 = unchanged)."
        },
        "pan": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Stereo position, -1.0 (left) to 1.0 (right), 0.0 = centre."
        }
      },
      "required": [
        "gain",
        "pan"
      ],
      "type": "object"
    },
    "BlendMode": {
      "description": "How an item combines with what is below it (arch §8's core set).",
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "add",
        "soft_light"
      ],
      "type": "string"
    },
    "Clip": {
      "description": "A media clip: a range of a `MediaAsset` placed on a track.\n\nThe clip occupies `[start, start + duration)` on the timeline and plays the source range\n`[source_in, source_in + duration)` (speed 1 in schema v1).",
      "properties": {
        "attached_to": {
          "description": "The item this one follows when it moves (schema v2, timeline spec §1.4): an overlay\nattached to a main-track clip. `None` when free.",
          "pattern": "^itm_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "audio": {
          "$ref": "#/$defs/AudioProps",
          "description": "Audio properties."
        },
        "custom": {
          "additionalProperties": true,
          "description": "Plugin data (arch §4.3).",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          },
          "type": "object"
        },
        "duration": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "Length on the timeline (positive)."
        },
        "enabled": {
          "description": "Disabled items are kept but neither rendered nor heard.",
          "type": "boolean"
        },
        "id": {
          "description": "The item ID (also its key in the track's `items`).",
          "pattern": "^itm_[0-9a-f]{32}$",
          "type": "string"
        },
        "linked_group": {
          "description": "Items with the same group move, trim and delete together (e.g. linked video and audio).",
          "pattern": "^grp_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "markers": {
          "additionalProperties": false,
          "description": "Markers in item-relative time; they move with the item.",
          "patternProperties": {
            "^mrk_[0-9a-f]{32}$": {
              "$ref": "#/$defs/Marker"
            }
          },
          "type": "object"
        },
        "media": {
          "description": "The media this clip plays.",
          "pattern": "^med_[0-9a-f]{32}$",
          "type": "string"
        },
        "name": {
          "description": "Display name; `None` shows the media name.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_in": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "Source position (from the start of the media) of the first frame."
        },
        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "Timeline position of the first frame."
        },
        "visual": {
          "$ref": "#/$defs/VisualProps",
          "description": "Visual properties."
        }
      },
      "required": [
        "id",
        "start",
        "duration",
        "enabled",
        "markers",
        "media",
        "source_in",
        "audio",
        "visual",
        "custom"
      ],
      "type": "object"
    },
    "ColorRange": {
      "description": "Sample range of a video stream.",
      "oneOf": [
        {
          "const": "limited",
          "description": "Limited (\"TV\", 16–235 for 8-bit luma).",
          "type": "string"
        },
        {
          "const": "full",
          "description": "Full (\"PC\", 0–255).",
          "type": "string"
        }
      ]
    },
    "ColorSpace": {
      "description": "The working color space of a sequence. Schema v1 has only Rec.709 SDR.",
      "oneOf": [
        {
          "const": "rec709",
          "description": "Rec.709 primaries, SDR.",
          "type": "string"
        }
      ]
    },
    "ColorTags": {
      "additionalProperties": false,
      "description": "Color description of a video stream (H.273 code points by FFmpeg name). `None` means\nunspecified in the file.",
      "properties": {
        "matrix": {
          "description": "YUV matrix coefficients.",
          "examples": [
            "gbr",
            "bt709",
            "fcc",
            "bt470bg",
            "smpte170m",
            "smpte240m",
            "ycgco",
            "bt2020nc",
            "bt2020c",
            "ictcp"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "primaries": {
          "description": "Color primaries.",
          "examples": [
            "bt709",
            "bt470m",
            "bt470bg",
            "smpte170m",
            "smpte240m",
            "film",
            "bt2020",
            "smpte428",
            "smpte431",
            "smpte432",
            "ebu3213"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sample range."
        },
        "transfer": {
          "description": "Transfer characteristics.",
          "examples": [
            "bt709",
            "gamma22",
            "gamma28",
            "smpte170m",
            "smpte240m",
            "linear",
            "iec61966-2-1",
            "bt2020-10",
            "bt2020-12",
            "smpte2084",
            "arib-std-b67"
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Crop": {
      "description": "How much of each edge of the upright source picture is cut away, as fractions of the\nsource frame (`0.0..=1.0` each; keyframes §7). Each edge animates on its own, so each is\nvalidated on its own: when `left + right >= 1` or `top + bottom >= 1` nothing is visible.",
      "properties": {
        "bottom": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Fraction removed from the bottom edge."
        },
        "left": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Fraction removed from the left edge."
        },
        "right": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Fraction removed from the right edge."
        },
        "top": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Fraction removed from the top edge."
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "type": "object"
    },
    "Flip": {
      "description": "Mirroring of an item about its centre, after the crop (keyframes §7). Hold-only: a keyed\nflip switches at its keys.",
      "properties": {
        "horizontal": {
          "$ref": "#/$defs/Animatable_boolean",
          "description": "Mirror left-right."
        },
        "vertical": {
          "$ref": "#/$defs/Animatable_boolean",
          "description": "Mirror top-bottom."
        }
      },
      "required": [
        "horizontal",
        "vertical"
      ],
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "description": "A frame rate as an exact fraction of frames per second, e.g. {\"num\": 30000, \"den\": 1001} for 29.97 fps.",
      "properties": {
        "den": {
          "description": "Seconds.",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "num": {
          "description": "Frames.",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "InOut": {
      "description": "The sequence's in and out points: the half-open range `[start, end)` that lift, extract and\nthree-point edits use. Both ends or neither (`Sequence::in_out` is `None` when unset).",
      "properties": {
        "end": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "The out point (`> start`)."
        },
        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "The in point (`>= 0`)."
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Interp": {
      "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The key's value until the next key, then a jump (§4.2).",
          "properties": {
            "kind": {
              "const": "hold",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`p = u` (§4.3).",
          "properties": {
            "kind": {
              "const": "linear",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
          "properties": {
            "kind": {
              "const": "bezier",
              "type": "string"
            },
            "preset": {
              "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            },
            "x1": {
              "description": "First control point, time axis, in `[0, 1]`.",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "x2": {
              "description": "Second control point, time axis, in `[0, 1]`.",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "y1": {
              "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
              "format": "double",
              "maximum": 10.0,
              "minimum": -10.0,
              "type": "number"
            },
            "y2": {
              "description": "Second control point, progress axis, in `[−10, 10]`.",
              "format": "double",
              "maximum": 10.0,
              "minimum": -10.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
          "properties": {
            "bounce": {
              "description": "A hard stop at the target: the motion reflects instead of passing it.",
              "type": "boolean"
            },
            "damping": {
              "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
              "format": "double",
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "number"
            },
            "kind": {
              "const": "spring",
              "type": "string"
            },
            "mass": {
              "description": "Mass, kg, in `[0.1, 100]`.",
              "format": "double",
              "maximum": 100.0,
              "minimum": 0.1,
              "type": "number"
            },
            "preset": {
              "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            },
            "stiffness": {
              "description": "Stiffness, N/m, in `[1, 10000]`.",
              "format": "double",
              "maximum": 10000.0,
              "minimum": 1.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "stiffness",
            "damping",
            "mass",
            "bounce"
          ],
          "type": "object"
        }
      ]
    },
    "Item": {
      "description": "Anything placed on a track (arch §4.2). Schema v1 has only [`Clip`]; matching code outside\nthis crate needs a wildcard arm for the kinds still to come.\n\nSerialized as the variant's object plus a `\"kind\"` tag (`{\"kind\": \"clip\", …}`).",
      "oneOf": [
        {
          "$ref": "#/$defs/Clip",
          "description": "A media clip.",
          "properties": {
            "kind": {
              "const": "clip",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Keyframe_Vec2": {
      "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
      "properties": {
        "interp": {
          "$ref": "#/$defs/Interp"
        },
        "t": {
          "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/Vec2"
        }
      },
      "required": [
        "t",
        "value",
        "interp"
      ],
      "type": "object"
    },
    "Keyframe_boolean": {
      "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
      "properties": {
        "interp": {
          "$ref": "#/$defs/Interp"
        },
        "t": {
          "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "value",
        "interp"
      ],
      "type": "object"
    },
    "Keyframe_double": {
      "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
      "properties": {
        "interp": {
          "$ref": "#/$defs/Interp"
        },
        "t": {
          "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "t",
        "value",
        "interp"
      ],
      "type": "object"
    },
    "Keyframes_Vec2": {
      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
      "properties": {
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe_Vec2"
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "keyframes"
      ],
      "type": "object"
    },
    "Keyframes_boolean": {
      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
      "properties": {
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe_boolean"
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "keyframes"
      ],
      "type": "object"
    },
    "Keyframes_double": {
      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
      "properties": {
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe_double"
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "keyframes"
      ],
      "type": "object"
    },
    "Marker": {
      "description": "A marker on a sequence (sequence time) or an item (item-relative time).",
      "properties": {
        "color": {
          "description": "Display color.",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                  "type": "string"
                }
              ],
              "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
            },
            {
              "type": "null"
            }
          ],
          "description": "The length of a range marker; `None` for a point marker."
        },
        "id": {
          "description": "The marker ID (also its key in the owner's `markers`).",
          "pattern": "^mrk_[0-9a-f]{32}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MarkerKind",
          "description": "What the marker means."
        },
        "label": {
          "description": "Text shown with the marker (may be empty).",
          "type": "string"
        },
        "t": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
              "type": "string"
            }
          ],
          "description": "Where the marker is (`>= 0`)."
        }
      },
      "required": [
        "id",
        "t",
        "label",
        "color",
        "kind"
      ],
      "type": "object"
    },
    "MarkerKind": {
      "description": "What a marker means.",
      "oneOf": [
        {
          "const": "user",
          "description": "Placed by a person or an agent.",
          "type": "string"
        },
        {
          "const": "beat",
          "description": "A beat found by analysis (snaps like a marker, spec §6).",
          "type": "string"
        },
        {
          "const": "chapter",
          "description": "A chapter start (exported to chaptered formats).",
          "type": "string"
        }
      ]
    },
    "MediaAsset": {
      "description": "Media imported into (or generated for) a project, referenced by path and content hash\n(arch §17), or a sequence of this project used as a compound clip.",
      "properties": {
        "content_hash": {
          "description": "Content hash used to relink and to key caches (file kinds only).",
          "type": [
            "string",
            "null"
          ]
        },
        "custom": {
          "additionalProperties": true,
          "description": "Plugin data (arch §4.3).",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          },
          "type": "object"
        },
        "folder": {
          "description": "The folder of the bin it is in (ADR-0020); absent: the top level.",
          "pattern": "^fld_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The media ID (also its key in `Project::media`).",
          "pattern": "^med_[0-9a-f]{32}$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind",
          "description": "What the media is."
        },
        "name": {
          "description": "The name shown in the bin (ADR-0020); absent: the file name. 1 to 255 characters\nwithout control characters.",
          "type": [
            "string",
            "null"
          ]
        },
        "path_abs": {
          "description": "Absolute path of the file when it was last found (file kinds only).",
          "type": [
            "string",
            "null"
          ]
        },
        "path_rel": {
          "description": "Path relative to the project folder, used for relinking moved projects (file kinds only).",
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "$ref": "#/$defs/ProbeInfo",
          "description": "Probe results."
        },
        "sequence": {
          "description": "The referenced sequence (`sequence_ref` only).",
          "pattern": "^seq_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "probe",
        "custom"
      ],
      "type": "object"
    },
    "MediaFolder": {
      "description": "A folder of the media bin (ADR-0020).",
      "properties": {
        "custom": {
          "additionalProperties": true,
          "description": "Plugin data (arch §4.3).",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          },
          "type": "object"
        },
        "id": {
          "description": "The folder ID (also its key in `Project::folders`).",
          "pattern": "^fld_[0-9a-f]{32}$",
          "type": "string"
        },
        "name": {
          "description": "The name shown in the bin: 1 to 255 characters, no `/` or control characters, unique\namong its siblings ignoring case.",
          "type": "string"
        },
        "parent": {
          "description": "The folder it is in; absent at the top level.",
          "pattern": "^fld_[0-9a-f]{32}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "custom"
      ],
      "type": "object"
    },
    "MediaKind": {
      "description": "What a [`MediaAsset`] is.",
      "oneOf": [
        {
          "const": "video",
          "description": "A video file (may also carry audio).",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "An audio-only file.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "A still image (no duration).",
          "type": "string"
        },
        {
          "const": "sequence_ref",
          "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
          "type": "string"
        }
      ]
    },
    "ProbeInfo": {
      "description": "What the media backend found in a file (WP-1D.02 fills it).",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Main audio stream format, if any."
        },
        "color": {
          "$ref": "#/$defs/ColorTags",
          "description": "Color tags of the main video stream."
        },
        "duration": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                  "type": "string"
                }
              ],
              "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
            },
            {
              "type": "null"
            }
          ],
          "description": "Playable length, if known (images have none)."
        },
        "fps": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Frame rate of the main video stream, if constant or nominal."
        },
        "rotation": {
          "description": "Display rotation in degrees clockwise: 0, 90, 180 or 270.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "streams": {
          "description": "Streams in container order.",
          "items": {
            "$ref": "#/$defs/StreamInfo"
          },
          "type": "array"
        },
        "vfr": {
          "description": "Variable frame rate: times map through the frame index, never through `fps` (arch §4.1).",
          "type": "boolean"
        }
      },
      "required": [
        "streams",
        "vfr",
        "rotation",
        "color"
      ],
      "type": "object"
    },
    "ProjectMeta": {
      "description": "Document metadata.",
      "properties": {
        "app_version": {
          "description": "Version of the Cutweave build that last saved the document.",
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "description": "When the project was created (RFC 3339 UTC, e.g. `2026-11-22T10:00:00Z`), set by the\nengine (frozen under `--deterministic-ids`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Project name.",
          "type": "string"
        },
        "schema_version": {
          "description": "Version of the document format (`CURRENT_SCHEMA_VERSION` when saved by this build).\nOlder documents are migrated on open; newer ones open read-only (arch §4.3).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name"
      ],
      "type": "object"
    },
    "ProjectSettings": {
      "description": "Project-wide settings (arch §4.2 `settings`, v1 subset).",
      "properties": {
        "default_format": {
          "$ref": "#/$defs/SequenceFormat",
          "description": "Format of new sequences."
        }
      },
      "required": [
        "default_format"
      ],
      "type": "object"
    },
    "Sequence": {
      "description": "A timeline (arch §4.2). A project may hold several (e.g. a long cut and its shorts); the v1\nUI shows one.",
      "properties": {
        "custom": {
          "additionalProperties": true,
          "description": "Plugin data (arch §4.3).",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          },
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/SequenceFormat",
          "description": "Canvas, rates and color."
        },
        "id": {
          "description": "The sequence ID (also its key in `Project::sequences`).",
          "pattern": "^seq_[0-9a-f]{32}$",
          "type": "string"
        },
        "in_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/InOut"
            },
            {
              "type": "null"
            }
          ],
          "description": "The in and out points; both ends or neither."
        },
        "markers": {
          "additionalProperties": false,
          "description": "Markers in sequence time, keyed by ID. They never move with a ripple (spec INV-34).",
          "patternProperties": {
            "^mrk_[0-9a-f]{32}$": {
              "$ref": "#/$defs/Marker"
            }
          },
          "type": "object"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "track_order": {
          "description": "Display order, top to bottom: every key of `tracks` exactly once. Upper video tracks\nare composited over lower ones.",
          "items": {
            "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "tracks": {
          "additionalProperties": false,
          "description": "The tracks, keyed by ID.",
          "patternProperties": {
            "^trk_[0-9a-f]{32}$": {
              "$ref": "#/$defs/Track"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "format",
        "tracks",
        "track_order",
        "markers",
        "custom"
      ],
      "type": "object"
    },
    "SequenceFormat": {
      "description": "Canvas size, frame rate, audio rate and color of a sequence (arch §4.2 `format`).",
      "properties": {
        "background": {
          "description": "Canvas color behind all tracks.",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "type": "string"
        },
        "color_space": {
          "$ref": "#/$defs/ColorSpace",
          "description": "Working color space."
        },
        "frame_rate": {
          "$ref": "#/$defs/FrameRate",
          "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it."
        },
        "height": {
          "description": "Canvas height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sample_rate": {
          "description": "The mix rate.",
          "maximum": 352800000,
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "description": "Canvas width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "frame_rate",
        "sample_rate",
        "color_space",
        "background"
      ],
      "type": "object"
    },
    "StreamInfo": {
      "description": "One stream of a media file.",
      "properties": {
        "channels": {
          "description": "Channel count (audio).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "codec": {
          "description": "Codec name (FFmpeg naming, e.g. `h264`, `aac`).",
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "description": "Coded height in pixels (video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "description": "Index in the container.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StreamKind",
          "description": "Stream kind."
        },
        "language": {
          "description": "Language tag (e.g. `eng`).",
          "type": [
            "string",
            "null"
          ]
        },
        "pixel_format": {
          "description": "Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video).",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "Codec profile (e.g. `High`, `Main 10`).",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_rate": {
          "description": "Sample rate (audio).",
          "maximum": 352800000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "width": {
          "description": "Coded width in pixels (video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "kind"
      ],
      "type": "object"
    },
    "StreamKind": {
      "description": "The kind of a container stream.",
      "oneOf": [
        {
          "const": "video",
          "description": "Pictures.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound.",
          "type": "string"
        },
        {
          "const": "subtitle",
          "description": "Subtitles or captions.",
          "type": "string"
        },
        {
          "const": "data",
          "description": "Timed metadata or other data.",
          "type": "string"
        },
        {
          "const": "attachment",
          "description": "Attached files (fonts, cover art).",
          "type": "string"
        }
      ]
    },
    "Track": {
      "description": "A track of a sequence (arch §4.2): items that never overlap (arch §4.3).",
      "properties": {
        "custom": {
          "additionalProperties": true,
          "description": "Plugin data (arch §4.3).",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
          },
          "type": "object"
        },
        "gain": {
          "description": "Track gain in decibels (0.0 = unchanged).",
          "format": "double",
          "type": "number"
        },
        "height": {
          "description": "Row height in the timeline, in pixels: a persisted UI hint (`None` = the default).\nChanging it never touches items.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hidden": {
          "description": "Not rendered (video).",
          "type": "boolean"
        },
        "id": {
          "description": "The track ID (also its key in `Sequence::tracks`).",
          "pattern": "^trk_[0-9a-f]{32}$",
          "type": "string"
        },
        "items": {
          "additionalProperties": false,
          "description": "The items, keyed by ID.",
          "patternProperties": {
            "^itm_[0-9a-f]{32}$": {
              "$ref": "#/$defs/Item"
            }
          },
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/TrackKind",
          "description": "What the track holds."
        },
        "locked": {
          "description": "Commands that would change the track's items fail with `Locked`.",
          "type": "boolean"
        },
        "magnetic": {
          "description": "The magnetic main track: ripple-by-default editing, gap-free from 0 (timeline spec\n§1.2). At most one video track per sequence has it (`Project::validate`).",
          "type": "boolean"
        },
        "muted": {
          "description": "Silenced (audio).",
          "type": "boolean"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "solo": {
          "description": "Solo (audio): when any track is solo, only solo tracks are heard.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "items",
        "muted",
        "hidden",
        "locked",
        "solo",
        "magnetic",
        "gain",
        "custom"
      ],
      "type": "object"
    },
    "TrackKind": {
      "description": "What a track holds. Schema v1 edits only video and audio tracks; the other kinds exist so\ndocuments and commands can name them (ops answer `Unsupported`).",
      "oneOf": [
        {
          "const": "video",
          "description": "Picture layers.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Titles (later versions).",
          "type": "string"
        },
        {
          "const": "caption",
          "description": "Captions (later versions).",
          "type": "string"
        },
        {
          "const": "adjustment",
          "description": "Adjustment layers (later versions).",
          "type": "string"
        }
      ]
    },
    "Transform": {
      "description": "Where and how a visual item is placed on the sequence canvas.\n\nCoordinates are resolution-independent: `position` is the offset of the item's anchor from\nthe canvas center in canvas units (1.0 = the canvas width horizontally and the canvas height\nvertically; +y is down); `anchor` is a point of the item in item units ((0, 0) top-left,\n(0.5, 0.5) center); `scale` multiplies the aspect-fit size; `rotation` is in degrees,\nclockwise.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Animatable_Vec2",
          "description": "The item point that `position` places and rotation turns around, in item units."
        },
        "position": {
          "$ref": "#/$defs/Animatable_Vec2",
          "description": "Offset of the anchor from the canvas center, in canvas units."
        },
        "rotation": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Clockwise rotation in degrees."
        },
        "scale": {
          "$ref": "#/$defs/Animatable_Vec2",
          "description": "Size multiplier per axis (1.0 = aspect-fit)."
        }
      },
      "required": [
        "position",
        "scale",
        "rotation",
        "anchor"
      ],
      "type": "object"
    },
    "Vec2": {
      "additionalProperties": false,
      "description": "A 2D vector (positions, scales, anchors).",
      "properties": {
        "x": {
          "description": "Horizontal component.",
          "format": "double",
          "type": "number"
        },
        "y": {
          "description": "Vertical component (down is positive).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "VisualProps": {
      "description": "Visual properties of an item (arch §4.2 `VisualProps`; keyframes §7).",
      "properties": {
        "blend_mode": {
          "$ref": "#/$defs/BlendMode",
          "description": "How the item combines with what is below."
        },
        "crop": {
          "$ref": "#/$defs/Crop",
          "description": "Edges of the source picture cut away."
        },
        "flip": {
          "$ref": "#/$defs/Flip",
          "description": "Mirroring."
        },
        "opacity": {
          "$ref": "#/$defs/Animatable_double",
          "description": "Opacity, 0.0 (transparent) to 1.0 (opaque)."
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "description": "Placement on the canvas."
        }
      },
      "required": [
        "transform",
        "opacity",
        "crop",
        "flip",
        "blend_mode"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The project document: everything saved in `<Name>.cutweave` (arch §17).\n\nEntities are addressed by ID, never by index (arch §4.3). All collections are persistent\n(`imbl`), so `clone()` is O(1) and snapshots share structure (ADR-0005). Mutate only through\ncommands (`cutweave-ops`); readers get immutable snapshots.\n\nThe JSON form has a stable layout (fields in declaration order, maps sorted by key), so\nsaved files diff cleanly.",
  "properties": {
    "custom": {
      "additionalProperties": true,
      "description": "Plugin data (arch §4.3).",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
      },
      "type": "object"
    },
    "folders": {
      "additionalProperties": false,
      "description": "The folder tree of the media bin, keyed by ID (ADR-0020).",
      "patternProperties": {
        "^fld_[0-9a-f]{32}$": {
          "$ref": "#/$defs/MediaFolder"
        }
      },
      "type": "object"
    },
    "media": {
      "additionalProperties": false,
      "description": "Media, keyed by ID.",
      "patternProperties": {
        "^med_[0-9a-f]{32}$": {
          "$ref": "#/$defs/MediaAsset"
        }
      },
      "type": "object"
    },
    "meta": {
      "$ref": "#/$defs/ProjectMeta",
      "description": "Document metadata."
    },
    "sequences": {
      "additionalProperties": false,
      "description": "Sequences, keyed by ID.",
      "patternProperties": {
        "^seq_[0-9a-f]{32}$": {
          "$ref": "#/$defs/Sequence"
        }
      },
      "type": "object"
    },
    "settings": {
      "$ref": "#/$defs/ProjectSettings",
      "description": "Project-wide settings."
    }
  },
  "required": [
    "meta",
    "settings",
    "media",
    "folders",
    "sequences",
    "custom"
  ],
  "title": "Project",
  "type": "object"
}
