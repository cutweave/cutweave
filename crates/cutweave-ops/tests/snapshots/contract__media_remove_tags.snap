---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.remove_tags",
    "summary": "Remove tags from media assets (idempotent)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "items": {
            "description": "A Media id: `^med_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^med_[0-9a-f]{32}$"
          },
          "description": "The assets (1..=256, no repeats)."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The tags to remove (1..=16)."
        }
      },
      "required": [
        "media",
        "tags"
      ],
      "description": "Removes tags from media assets, matching them ignoring case and accents. Removing a tag an\nasset does not have changes nothing, so the call can be repeated.",
      "title": "MediaRemoveTags"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "description": "A Media id: `^med_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^med_[0-9a-f]{32}$"
          },
          "description": "The assets that changed (those that already were as asked are left out)."
        }
      },
      "required": [
        "changed"
      ],
      "description": "Result of the tag and rating commands.",
      "title": "MediaTagged"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media": {
        "type": "array",
        "items": {
          "description": "A Media id: `^med_[0-9a-f]{32}$`.",
          "type": "string",
          "pattern": "^med_[0-9a-f]{32}$"
        },
        "description": "The assets (1..=256, no repeats)."
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The tags to remove (1..=16)."
      }
    },
    "required": [
      "media",
      "tags"
    ],
    "description": "Removes tags from media assets, matching them ignoring case and accents. Removing a tag an\nasset does not have changes nothing, so the call can be repeated.",
    "title": "MediaRemoveTags"
  },
  "output": {
    "type": "object",
