            "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "Position in the media to start from (default 0).",
        "default": null
      },
      "duration": {
        "anyOf": [
          {
            "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "Clip length, `> 0`.",
        "default": null
      },
      "overlap": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "string",
                "const": "reject",
                "description": "Fail with `Invalid{path:\"/at\"}` (default)."
              },
              {
                "type": "string",
                "const": "new_track",
                "description": "Create a new track of the same kind directly above the target and insert there."
              }
            ],
            "description": "What to do when the clip would overlap another clip on the target track."
          },
          {
            "type": "null"
          }
        ],
        "description": "Overlap handling (default `reject`).",
        "default": null
      },
      "link": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Also insert the audio of a video file as a linked clip (default `true`).",
        "default": null
      }
    },
    "required": [
      "sequence",
      "track",
      "media",
      "at"
    ],
    "description": "Inserts a media clip on a track at a time. `source_in` is the position in the media the clip\nstarts from and `duration` its length (defaults: the start of the media and the rest of it;\nstills default to five seconds). Times accept flicks, `\"1.5s\"`, `\"f:45\"` and timecodes,\nresolved against the sequence's frame rate. See the module docs for overlap and linked\naudio behaviour. Fails with `Locked` if the target track is locked.",
    "title": "TimelineInsert"
  },
