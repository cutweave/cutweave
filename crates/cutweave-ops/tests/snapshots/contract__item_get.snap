                              "maximum": 9007199254740991
                            },
                            "value": {
                              "type": "boolean"
                            },
                            "interp": {
                              "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                              "oneOf": [
                                {
                                  "description": "The key's value until the next key, then a jump (§4.2).",
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "hold"
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "description": "`p = u` (§4.3).",
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "linear"
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "bezier"
                                    },
                                    "x1": {
                                      "description": "First control point, time axis, in `[0, 1]`.",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": 0.0,
                                      "maximum": 1.0
                                    },
                                    "y1": {
                                      "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": -10.0,
                                      "maximum": 10.0
                                    },
                                    "x2": {
                                      "description": "Second control point, time axis, in `[0, 1]`.",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": 0.0,
                                      "maximum": 1.0
                                    },
                                    "y2": {
                                      "description": "Second control point, progress axis, in `[−10, 10]`.",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": -10.0,
                                      "maximum": 10.0
                                    },
                                    "preset": {
                                      "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                      "type": [
                                        "string",
                                        "null"
                                      ],
                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                    }
                                  },
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "x1",
                                    "y1",
                                    "x2",
                                    "y2"
                                  ]
                                },
                                {
                                  "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "spring"
                                    },
                                    "stiffness": {
                                      "description": "Stiffness, N/m, in `[1, 10000]`.",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": 1.0,
                                      "maximum": 10000.0
                                    },
                                    "damping": {
                                      "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": 0.0,
                                      "maximum": 1000.0
                                    },
                                    "mass": {
                                      "description": "Mass, kg, in `[0.1, 100]`.",
                                      "type": "number",
                                      "format": "double",
                                      "minimum": 0.1,
                                      "maximum": 100.0
                                    },
                                    "bounce": {
                                      "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                      "type": "boolean"
                                    },
                                    "preset": {
                                      "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                      "type": [
                                        "string",
                                        "null"
                                      ],
                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                    }
                                  },
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "stiffness",
                                    "damping",
                                    "mass",
                                    "bounce"
                                  ]
                                }
                              ]
                            }
                          },
                          "required": [
                            "t",
                            "value",
                            "interp"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 100000
                      }
                    },
                    "required": [
                      "keyframes"
                    ]
                  }
                ]
              }
            },
            "required": [
              "horizontal",
              "vertical"
            ],
            "description": "Mirroring."
          },
          "blend_mode": {
            "oneOf": [
              {
                "type": "string",
                "const": "normal",
                "description": "The picture covers what is below, by its opacity."
              },
              {
                "type": "string",
                "const": "multiply",
                "description": "Darkens: the product of both."
              },
              {
                "type": "string",
                "const": "screen",
                "description": "Lightens: the inverse of the product of the inverses."
              },
              {
                "type": "string",
                "const": "overlay",
                "description": "Multiply in the shadows, screen in the highlights, by what is below."
              },
              {
                "type": "string",
                "const": "darken",
                "description": "The darker of both, per channel."
              },
              {
                "type": "string",
                "const": "lighten",
                "description": "The lighter of both, per channel."
              },
              {
                "type": "string",
                "const": "add",
                "description": "The sum of both, clipped."
              },
              {
                "type": "string",
                "const": "soft_light",
                "description": "A gentle overlay."
              }
            ],
            "description": "How the item combines with what is below."
          }
        },
        "required": [
          "transform",
          "opacity",
          "crop",
          "flip",
          "blend_mode"
        ],
        "description": "Visual properties (unless `fields` leaves them out)."
      },
      "linked": {
        "type": "array",
        "items": {
          "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$"
        },
        "description": "The other items of the linked group, if any."
      }
    },
    "required": [
      "sequence",
      "track",
      "item",
      "linked"
    ],
    "description": "Result of `item.get`.",
    "title": "ItemGetOutput"
  }
}
