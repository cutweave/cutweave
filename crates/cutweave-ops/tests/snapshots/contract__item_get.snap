---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "item.get",
    "summary": "Get one item: summary, track, source, audio and visual properties",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item."
        },
        "fields": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Sections to include: any of `name`, `source`, `audio`, `visual` (default all).",
          "default": null
        }
      },
      "required": [
        "item"
      ],
      "description": "Reads one item: the `timeline.get` item summary plus its track, source, audio and visual\nproperties. `fields` limits the extra sections (`name`, `source`, `audio`, `visual`).",
      "title": "ItemGet"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence holding the item."
        },
        "track": {
          "type": "string",
          "pattern": "^trk_[0-9a-f]{32}$",
          "description": "The track holding the item."
        },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^itm_[0-9a-f]{32}$",
              "description": "The item."
            },
            "kind": {
              "type": "string",
              "description": "Item kind (`clip`)."
            },
            "start": {
              "description": "Timeline position of the first frame.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "duration": {
              "description": "Length on the timeline.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "media": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^med_[0-9a-f]{32}$",
              "description": "The media a clip plays."
            },
            "linked_group": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^grp_[0-9a-f]{32}$",
              "description": "The linked group, if any."
            },
            "enabled": {
              "type": "boolean",
              "description": "Whether the item is rendered and heard."
            }
          },
          "required": [
            "id",
            "kind",
            "start",
            "duration",
            "media",
            "linked_group",
            "enabled"
          ],
          "description": "The same projection `timeline.get` returns at depth 2."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The display name, if it has one (unless `fields` leaves it out)."
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "media": {
              "type": "string",
              "pattern": "^med_[0-9a-f]{32}$",
              "description": "The media."
            },
            "source_in": {
              "description": "Position in the media of the clip's first frame.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "media",
            "source_in"
          ],
          "description": "Media and source position (unless `fields` leaves it out)."
        },
        "audio": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "gain": {
              "description": "Gain in decibels (0.0 = unchanged).",
              "oneOf": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                  "type": "object",
                  "properties": {
                    "keyframes": {
                      "type": "array",
                      "items": {
                        "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                        "type": "object",
                        "properties": {
                          "t": {
                            "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "value": {
                            "type": "number",
                            "format": "double"
                          },
                          "interp": {
                            "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                            "oneOf": [
                              {
                                "description": "The key's value until the next key, then a jump (§4.2).",
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "hold"
                                  }
                                },
                                "required": [
                                  "kind"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "description": "`p = u` (§4.3).",
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "linear"
                                  }
                                },
                                "required": [
                                  "kind"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "bezier"
                                  },
                                  "x1": {
                                    "description": "First control point, time axis, in `[0, 1]`.",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": 0.0,
                                    "maximum": 1.0
                                  },
                                  "y1": {
                                    "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": -10.0,
                                    "maximum": 10.0
                                  },
                                  "x2": {
                                    "description": "Second control point, time axis, in `[0, 1]`.",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": 0.0,
                                    "maximum": 1.0
                                  },
                                  "y2": {
                                    "description": "Second control point, progress axis, in `[−10, 10]`.",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": -10.0,
                                    "maximum": 10.0
                                  },
                                  "preset": {
                                    "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                    "type": [
                                      "string",
                                      "null"
                                    ],
                                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                  }
                                },
                                "additionalProperties": false,
                                "required": [
                                  "kind",
                                  "x1",
                                  "y1",
                                  "x2",
                                  "y2"
                                ]
                              },
                              {
                                "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "spring"
                                  },
                                  "stiffness": {
                                    "description": "Stiffness, N/m, in `[1, 10000]`.",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": 1.0,
                                    "maximum": 10000.0
                                  },
                                  "damping": {
                                    "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": 0.0,
                                    "maximum": 1000.0
                                  },
                                  "mass": {
                                    "description": "Mass, kg, in `[0.1, 100]`.",
                                    "type": "number",
                                    "format": "double",
                                    "minimum": 0.1,
                                    "maximum": 100.0
                                  },
                                  "bounce": {
                                    "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                    "type": "boolean"
                                  },
                                  "preset": {
                                    "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                    "type": [
                                      "string",
                                      "null"
                                    ],
                                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                  }
                                },
                                "additionalProperties": false,
                                "required": [
                                  "kind",
                                  "stiffness",
                                  "damping",
                                  "mass",
                                  "bounce"
                                ]
                              }
                            ]
                          }
                        },
                        "required": [
                          "t",
                          "value",
                          "interp"
                        ]
                      },
                      "minItems": 1,
                      "maxItems": 100000
                    }
                  },
                  "required": [
                    "keyframes"
                  ]
                }
              ]
            },
            "pan": {
              "description": "Stereo position, -1.0 (left) to 1.0 (right), 0.0 = centre.",
              "oneOf": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                  "type": "object",
                  "properties": {
