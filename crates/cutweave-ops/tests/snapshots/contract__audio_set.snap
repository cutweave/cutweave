{
  "meta": {
    "name": "audio.set",
    "summary": "Set a clip's fades, volume (dB) or pan",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
