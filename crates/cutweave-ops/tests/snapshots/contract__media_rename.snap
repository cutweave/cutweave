          "description": "The asset."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The display name: 1 to 255 characters without control characters (trimmed); absent:\nthe file name.",
          "default": null
        }
      },
      "required": [
        "media"
      ],
      "description": "Sets the name the media bin shows for an asset (the file on disk keeps its name). Without\na name the bin shows the file name again. Display names need not be unique.",
