                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "prop",
              "t"
            ]
          },
          "description": "The keys, by property and exact item time."
        },
