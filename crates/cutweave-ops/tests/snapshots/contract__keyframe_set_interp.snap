                  "crop.right",
                  "crop.bottom",
                  "flip.horizontal",
                  "flip.vertical",
                  "audio_gain",
                  "audio_pan"
                ]
              },
              "t": {
                "description": "The key's stored item time in flicks, as `item.get` returns it.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "required": [
              "prop",
              "t"
            ]
          },
          "description": "The keys whose segment changed."
        }
      },
      "required": [
        "changed"
      ],
      "description": "Result of `keyframe.set_interp`.",
      "title": "KeyframeSetInterpOutput"
    }
  },
