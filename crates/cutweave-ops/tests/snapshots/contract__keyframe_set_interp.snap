---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "keyframe.set_interp",
    "summary": "Set the easing of the segments starting at keys",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item."
        },
        "keys": {
          "type": "array",
          "items": {
            "description": "A key to address: its property and exact item time.",
            "type": "object",
            "properties": {
              "prop": {
                "description": "The property.",
                "type": "string",
                "enum": [
                  "transform.position",
                  "transform.scale",
                  "transform.rotation",
                  "transform.anchor",
                  "opacity",
                  "crop.left",
                  "crop.top",
                  "crop.right",
                  "crop.bottom",
                  "flip.horizontal",
                  "flip.vertical",
                  "audio_gain",
                  "audio_pan"
                ]
              },
              "t": {
                "description": "The key's stored item time in flicks, as `item.get` returns it.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "prop",
              "t"
            ]
          },
          "description": "The keys, by property and exact item time."
        },
        "interp": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "hold"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "description": "Jump at the next key."
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "linear"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "description": "Constant speed."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "bezier"
                    },
                    "x1": {
                      "type": "number",
                      "format": "double",
                      "description": "Control point 1 x."
                    },
                    "y1": {
                      "type": "number",
                      "format": "double",
                      "description": "Control point 1 y."
                    },
                    "x2": {
                      "type": "number",
                      "format": "double",
                      "description": "Control point 2 x."
                    },
                    "y2": {
                      "type": "number",
                      "format": "double",
                      "description": "Control point 2 y."
                    },
                    "preset": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Preset name hint.",
                      "default": null
                    }
                  },
                  "required": [
                    "kind",
                    "x1",
                    "y1",
                    "x2",
                    "y2"
                  ],
                  "description": "CSS cubic Bezier: `x1`, `x2` in 0..1, `y1`, `y2` in -10..10."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "spring"
                    },
                    "stiffness": {
                      "type": "number",
                      "format": "double",
                      "description": "Stiffness."
                    },
                    "damping": {
                      "type": "number",
                      "format": "double",
                      "description": "Damping."
                    },
                    "mass": {
                      "type": "number",
                      "format": "double",
                      "description": "Mass."
                    },
                    "bounce": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "Hard stop at the target (default false).",
                      "default": null
                    },
                    "preset": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Preset name hint.",
                      "default": null
                    }
                  },
                  "required": [
                    "kind",
                    "stiffness",
                    "damping",
                    "mass"
                  ],
                  "description": "Damped spring: stiffness 1..10000, damping 0..1000, mass 0.1..100."
                }
              ],
              "description": "How a key's segment moves to the next key (stored form; `bounce` may be omitted). Prefer\n`easing` for the presets."
            },
            {
              "type": "null"
            }
          ],
          "description": "The interpolation (stored form).",
          "default": null
        },
        "easing": {
          "description": "A preset name, `linear` or `hold`.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "hold",
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "sine_in",
            "sine_out",
            "sine_in_out",
            "cubic_in",
            "cubic_out",
            "cubic_in_out",
            "expo_in",
            "expo_out",
            "expo_in_out",
            "back_in",
            "back_out",
            "back_in_out",
            "spring",
            "spring_gentle",
            "spring_wobbly",
            "spring_stiff",
            "elastic",
            "bounce",
            null
          ],
          "default": null
        }
      },
      "required": [
        "item",
        "keys"
      ],
      "description": "Sets how the segments that start at the given keys move to the next key: `interp` (stored\nform) or `easing` (a preset name, `linear` or `hold`), not both. An explicit `interp`\ncarries no preset hint unless it gives one. Flips accept only hold. `NotFound` if a key does\nnot exist; `Locked` if the item's track is locked.",
      "title": "KeyframeSetInterp"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "array",
          "items": {
