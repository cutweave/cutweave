{
  "meta": {
    "name": "keyframe.set_interp",
    "summary": "Set the easing of the segments starting at keys",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
