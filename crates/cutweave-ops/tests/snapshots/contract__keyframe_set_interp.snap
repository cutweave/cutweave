                  "description": "Bezier (0.36, 0, 0.66, −0.56): pulls back before leaving."
                },
                {
                  "type": "string",
                  "const": "back_out",
                  "description": "Bezier (0.34, 1.56, 0.64, 1): overshoots, then settles."
                },
                {
                  "type": "string",
                  "const": "back_in_out",
                  "description": "Bezier (0.68, −0.6, 0.32, 1.6)."
                },
                {
                  "type": "string",
                  "const": "spring",
                  "description": "Spring 170 / 26 / 1 (ζ ≈ 1.00)."
                },
                {
                  "type": "string",
                  "const": "spring_gentle",
                  "description": "Spring 120 / 14 / 1 (ζ ≈ 0.64)."
