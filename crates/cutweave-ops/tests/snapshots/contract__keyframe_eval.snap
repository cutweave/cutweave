---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "keyframe.eval",
    "summary": "Evaluate an item's property at a time or over a range",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item."
        },
        "prop": {
          "oneOf": [
            {
              "type": "string",
              "const": "transform.position",
              "description": "`visual.transform.position`: offset of the anchor from the canvas centre, canvas units."
            },
            {
              "type": "string",
              "const": "transform.scale",
              "description": "`visual.transform.scale`: multiplier of the aspect-fit size, per axis."
            },
            {
              "type": "string",
              "const": "transform.rotation",
              "description": "`visual.transform.rotation`: degrees, clockwise, accumulating."
            },
            {
              "type": "string",
              "const": "transform.anchor",
              "description": "`visual.transform.anchor`: a point of the item in item units."
            },
            {
              "type": "string",
              "const": "opacity",
              "description": "`visual.opacity`: 0 transparent to 1 opaque."
            },
            {
              "type": "string",
              "const": "crop.left",
              "description": "`visual.crop.left`: fraction of the upright source removed from the left edge."
            },
            {
              "type": "string",
              "const": "crop.top",
              "description": "`visual.crop.top`: fraction removed from the top edge."
            },
            {
              "type": "string",
              "const": "crop.right",
              "description": "`visual.crop.right`: fraction removed from the right edge."
            },
            {
              "type": "string",
              "const": "crop.bottom",
              "description": "`visual.crop.bottom`: fraction removed from the bottom edge."
            },
            {
              "type": "string",
              "const": "flip.horizontal",
              "description": "`visual.flip.horizontal`: mirror left-right (hold only)."
            },
            {
              "type": "string",
              "const": "flip.vertical",
              "description": "`visual.flip.vertical`: mirror top-bottom (hold only)."
            },
            {
              "type": "string",
              "const": "audio_gain",
              "description": "`audio.gain`: clip level in dB, interpolated in dB (UI label \"Volume\")."
            },
            {
              "type": "string",
              "const": "audio_pan",
              "description": "`audio.pan`: −1 left to 1 right, 0 centre."
            }
          ],
          "description": "The property."
        },
        "at": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "One sample at this sequence time.",
          "default": null
        },
        "from": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The first sample's sequence time.",
          "default": null
        },
        "to": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The last sample's sequence time.",
          "default": null
        },
        "samples": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "How many samples, 2 to 1,000.",
          "default": null
        }
      },
      "required": [
        "item",
        "prop"
      ],
      "description": "Evaluates one property at a sequence time `at`, or at `samples` times from `from` to `to`\n(both included; 2 to 1,000 samples, `to >= from`). Times are sequence times and are not\nsnapped. Read-only.",
      "title": "KeyframeEval"
    },
