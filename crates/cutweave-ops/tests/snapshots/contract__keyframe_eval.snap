            },
            {
              "type": "string",
              "const": "audio_pan",
              "description": "`audio.pan`: −1 left to 1 right, 0 centre."
            }
          ],
          "description": "The property."
        },
        "samples": {
          "type": "array",
          "items": {
            "description": "One evaluated sample.",
            "type": "object",
            "properties": {
              "at": {
                "description": "Sequence time.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "t": {
                "description": "Item time.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "value": {
                "description": "The value there: property-clamped, in the evaluated form.",
                "anyOf": [
                  {
                    "description": "A boolean.",
                    "type": "boolean"
                  },
                  {
                    "description": "A number.",
                    "type": "number",
                    "format": "double"
                  },
                  {
                    "description": "A 2D vector.",
                    "type": "object",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "type": "number",
                        "format": "double"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "type": "number",
                        "format": "double"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ]
                  }
                ]
              },
              "in_item": {
                "description": "`t` lies inside the item's `[0, duration)`.",
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "at",
              "t",
              "value",
              "in_item"
            ]
          },
          "description": "The samples, from the first time to the last."
        }
      },
      "required": [
        "prop",
        "samples"
      ],
      "description": "Result of `keyframe.eval`.",
      "title": "KeyframeEvalOutput"
    }
