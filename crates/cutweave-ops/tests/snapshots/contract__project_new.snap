---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "project.new",
    "summary": "Initialize an empty project with one sequence (V1 + A1)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name (1..=200 characters)."
        },
        "format": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas width in pixels, `1..=16384`."
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas height in pixels, `1..=16384`."
            },
            "frame_rate": {
              "description": "The edit grid, `1..=1000` fps and a whole number of flicks per frame.",
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "sample_rate": {
              "description": "The mix rate in Hz, `8000..=384000`.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 352800000
            }
          },
          "description": "Format of the first sequence; also the default for new sequences.",
          "default": null
        },
        "still_duration": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "How long a still image is when it is placed without a length (up to one hour); absent:\nfive seconds. The editor passes the person's \"Still image duration\" setting.",
          "default": null
        },
        "proxy_policy": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "off",
                  "description": "Never automatically (`media.generate_proxy` still makes one)."
                },
                {
                  "type": "string",
                  "const": "auto",
                  "description": "For video that is slow to scrub: long-GOP H.264 or HEVC larger than 1920 pixels, faster\nthan 60 fps, or 10-bit HEVC. The default."
                },
                {
                  "type": "string",
                  "const": "all",
                  "description": "For every video file."
                }
              ],
              "description": "When a project's video gets proxies automatically (ADR-0027). Proxies themselves are cache\nstate of each computer; the policy is the editor's intent and travels with the project."
            },
            {
              "type": "null"
            }
          ],
          "description": "Which of the project's video gets proxies automatically (`off`, `auto`, `all`; ADR-0027);\nabsent: `auto`. The editor passes the person's \"Proxies for new projects\" setting.",
          "default": null
        },
        "settings": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "default_format": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "description": "Canvas width in pixels."
                },
                "height": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "description": "Canvas height in pixels."
                },
                "frame_rate": {
                  "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295,
                      "description": "Frames."
                    },
                    "den": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295,
                      "description": "Seconds."
                    }
                  },
                  "additionalProperties": false
                },
                "sample_rate": {
                  "description": "The mix rate.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 352800000
                },
                "color_space": {
                  "oneOf": [
                    {
                      "type": "string",
                      "const": "rec709",
                      "description": "Rec.709 primaries, SDR."
                    }
                  ],
                  "description": "Working color space."
                },
                "background": {
                  "description": "Canvas color behind all tracks.",
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                }
              },
              "x-ui": {
                "group": "New sequences",
                "order": 0
              },
              "description": "Format of new sequences."
            },
            "still_duration": {
              "anyOf": [
                {
                  "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "How long a still image is when it is placed without a length (ADR-0035). Absent: five\nseconds ([`DEFAULT_STILL_DURATION_SECS`]); left out of the file while absent, so\ndocuments written before the field read the same. Changing it never alters clips that\nalready exist.",
              "x-ui": {
                "group": "Media",
                "order": 10
              }
            },
            "proxy_policy": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "off",
                  "description": "Never automatically (`media.generate_proxy` still makes one)."
                },
                {
                  "type": "string",
                  "const": "auto",
                  "description": "For video that is slow to scrub: long-GOP H.264 or HEVC larger than 1920 pixels, faster\nthan 60 fps, or 10-bit HEVC. The default."
                },
                {
                  "type": "string",
                  "const": "all",
                  "description": "For every video file."
                }
              ],
              "description": "Which video gets proxies automatically (ADR-0027). `auto` is left out of the file, so\ndocuments written before the field read the same.",
              "x-ui": {
                "group": "Media",
                "order": 11
              }
            }
          },
          "description": "Project settings to start with, as in `project.set_settings`; absent keys take their\ndefault. `default_format` here is the full form of `format`.",
          "additionalProperties": false,
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "description": "Initializes an empty project: sets the project name and settings and creates one sequence\nwith a video track `V1` on top of an audio track `A1`. Fails with `Invalid` if the project\nalready has media or sequences, or if a setting is given both in `settings` and as its own\nparam.",
      "title": "ProjectNew"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The created sequence."
        },
        "video_track": {
          "type": "string",
          "pattern": "^trk_[0-9a-f]{32}$",
          "description": "Its video track `V1`."
        },
        "audio_track": {
          "type": "string",
          "pattern": "^trk_[0-9a-f]{32}$",
          "description": "Its audio track `A1`."
        }
      },
      "required": [
        "sequence",
        "video_track",
        "audio_track"
      ],
      "description": "Result of `project.new`.",
      "title": "ProjectNewOutput"
    }
  },
