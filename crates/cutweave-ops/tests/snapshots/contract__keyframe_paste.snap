                "crop.left",
                "crop.top",
                "crop.right",
                "crop.bottom",
                "flip.horizontal",
                "flip.vertical",
                "audio_gain",
                "audio_pan"
              ]
            },
            "t": {
              "description": "Item time after snapping.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "at": {
              "description": "Sequence time after snapping.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "value": {
              "description": "The value the key holds.",
              "anyOf": [
                {
                  "description": "A boolean.",
                  "type": "boolean"
                },
                {
                  "description": "A number.",
                  "type": "number",
                  "format": "double"
                },
                {
                  "description": "A 2D vector.",
                  "type": "object",
                  "properties": {
                    "x": {
                      "description": "Horizontal component.",
                      "type": "number",
                      "format": "double"
                    },
                    "y": {
                      "description": "Vertical component (down is positive).",
                      "type": "number",
                      "format": "double"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ]
            },
            "created": {
              "description": "A new key (`false`: it replaced a key at that time).",
              "type": "boolean"
            },
            "outside": {
              "description": "The key lies outside the item's `[0, duration)`.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "item",
            "prop",
            "t",
            "at",
            "value",
            "created",
            "outside"
          ]
        },
        "description": "The keys written."
      }
    },
    "required": [
      "keys"
    ],
    "description": "Result of `keyframe.paste`.",
    "title": "KeyframePasteOutput"
  }
}
