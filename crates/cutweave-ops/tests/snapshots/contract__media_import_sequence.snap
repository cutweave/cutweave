                "description": "Frames."
              },
              "den": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295,
                "description": "Seconds."
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "description": "The numbers with no file at import time, ascending. A missing frame shows the last\npicture before it."
          }
        },
        "required": [
          "pattern",
          "first",
          "count",
          "fps",
          "missing"
        ],
        "description": "The run as stored on the asset: pattern, first number, count, frame rate and the\nnumbers that have no file."
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "One sentence per stretch of missing numbers; empty when the run has no gaps."
      },
      "job_ids": {
        "type": "array",
        "items": {
          "description": "A job id: `^job_[0-9a-f]{32}$`.",
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$"
        },
        "description": "Background analysis jobs queued for the new asset (wait with `job.wait`)."
      },
      "proxy": {
        "oneOf": [
          {
            "type": "string",
