---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.import_sequence",
    "summary": "Import a numbered run of pictures as one image sequence that plays like video",
    "kind": "engine",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path of one picture of the run, or of the folder that holds the run."
        },
        "fps": {
          "description": "Frames per second, as a fraction (`{\"num\": 24000, \"den\": 1001}`). Default: the frame\nrate of the sequence the editor shows, 30 without one.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "description": "Frames."
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "description": "Seconds."
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false,
          "default": null
        },
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "Bin folder (default: top level).",
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "description": "Imports a numbered run of pictures (`shot_0001.png`, `shot_0002.png`, …) as one asset that\nplays like video (ADR-0035). `path` is one file of the run, or the folder that holds it:\nthe run is every file of that folder whose name differs only in the number at its end.\nFewer than two pictures is `Invalid` (use `media.import` for a still; it never guesses a\nsequence). Only the first picture is read, so a long run imports at once; the files are\nreferenced, not copied.\n\nNumbers without a file are allowed: they are listed in `image_sequence.missing`, named in\n`warnings`, and each shows the picture before it. The frame rate is `fps`, else the frame\nrate of the sequence the editor shows, else 30; it is stored on the asset. The asset goes\non video tracks only (it has no sound). One undo removes it. Agents and headless callers\nmay only import from the project folder and user-approved folders.",
      "title": "MediaImportSequence"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "The asset; an existing one if the same run was imported before."
        },
        "kind": {
          "oneOf": [
            {
              "type": "string",
              "const": "video",
              "description": "A video file (may also carry audio)."
            },
            {
              "type": "string",
              "const": "audio",
              "description": "An audio-only file."
            },
            {
              "type": "string",
              "const": "image",
              "description": "A still image (no duration)."
            },
            {
              "type": "string",
              "const": "image_sequence",
              "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run."
            },
            {
              "type": "string",
              "const": "sequence_ref",
              "description": "Another sequence of this project, used as a compound clip (arch §4.3)."
            }
          ],
          "description": "`image_sequence`."
        },
        "duplicate": {
          "type": "boolean",
          "description": "`true` when the run was already in the project and nothing was added."
        },
        "path": {
          "type": "string",
          "description": "Absolute path of the first picture of the run."
        },
        "image_sequence": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "The file name with the counter as `%0Nd` (zero-padded to `N` digits) or `%d`\n(`shot_%04d.exr`); a literal `%` is written `%%`. A name, not a path: the files are in\nthe directory of `path_abs`."
            },
            "first": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "The number of the first file."
            },
            "count": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "How many numbers the run covers, from `first` (missing ones included); at least 2."
            },
            "fps": {
              "description": "The frame rate chosen at import; changing the app setting never changes it.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "description": "The numbers with no file at import time, ascending. A missing frame shows the last\npicture before it."
            }
          },
          "required": [
            "pattern",
            "first",
            "count",
            "fps",
            "missing"
          ],
          "description": "The run as stored on the asset: pattern, first number, count, frame rate and the\nnumbers that have no file."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One sentence per stretch of missing numbers; empty when the run has no gaps."
        },
        "job_ids": {
          "type": "array",
          "items": {
            "description": "A job id: `^job_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "description": "Background analysis jobs queued for the new asset (wait with `job.wait`)."
        },
        "proxy": {
          "oneOf": [
            {
              "type": "string",
              "const": "none",
              "description": "None is made (the policy does not want one, or the file cannot have one)."
            },
            {
              "type": "string",
              "const": "queued",
              "description": "Its generation is queued (after the asset's analysis); `media.proxy_status` follows it."
            },
            {
              "type": "string",
              "const": "ready",
              "description": "One is already in the cache (the same content was imported before)."
            }
          ],
          "description": "Whether a proxy was queued for it, or is already in the cache."
        }
      },
      "required": [
        "media_id",
        "kind",
        "duplicate",
        "path",
        "image_sequence",
        "warnings",
        "job_ids",
        "proxy"
      ],
      "description": "Result of `media.import_sequence`.",
      "title": "MediaImportSequenceOutput"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "description": "Absolute path of one picture of the run, or of the folder that holds the run."
      },
      "fps": {
        "description": "Frames per second, as a fraction (`{\"num\": 24000, \"den\": 1001}`). Default: the frame\nrate of the sequence the editor shows, 30 without one.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "num": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Frames."
          },
          "den": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Seconds."
          }
        },
        "required": [
          "num",
          "den"
        ],
        "additionalProperties": false,
        "default": null
      },
      "folder": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^fld_[0-9a-f]{32}$",
        "description": "Bin folder (default: top level).",
        "default": null
      }
    },
    "required": [
      "path"
    ],
    "description": "Imports a numbered run of pictures (`shot_0001.png`, `shot_0002.png`, …) as one asset that\nplays like video (ADR-0035). `path` is one file of the run, or the folder that holds it:\nthe run is every file of that folder whose name differs only in the number at its end.\nFewer than two pictures is `Invalid` (use `media.import` for a still; it never guesses a\nsequence). Only the first picture is read, so a long run imports at once; the files are\nreferenced, not copied.\n\nNumbers without a file are allowed: they are listed in `image_sequence.missing`, named in\n`warnings`, and each shows the picture before it. The frame rate is `fps`, else the frame\nrate of the sequence the editor shows, else 30; it is stored on the asset. The asset goes\non video tracks only (it has no sound). One undo removes it. Agents and headless callers\nmay only import from the project folder and user-approved folders.",
    "title": "MediaImportSequence"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media_id": {
        "type": "string",
        "pattern": "^med_[0-9a-f]{32}$",
        "description": "The asset; an existing one if the same run was imported before."
      },
      "kind": {
        "oneOf": [
          {
            "type": "string",
            "const": "video",
            "description": "A video file (may also carry audio)."
          },
          {
            "type": "string",
            "const": "audio",
            "description": "An audio-only file."
          },
          {
            "type": "string",
            "const": "image",
            "description": "A still image (no duration)."
          },
          {
            "type": "string",
            "const": "image_sequence",
            "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run."
          },
          {
            "type": "string",
            "const": "sequence_ref",
            "description": "Another sequence of this project, used as a compound clip (arch §4.3)."
          }
        ],
        "description": "`image_sequence`."
      },
      "duplicate": {
        "type": "boolean",
        "description": "`true` when the run was already in the project and nothing was added."
      },
      "path": {
        "type": "string",
        "description": "Absolute path of the first picture of the run."
      },
      "image_sequence": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "The file name with the counter as `%0Nd` (zero-padded to `N` digits) or `%d`\n(`shot_%04d.exr`); a literal `%` is written `%%`. A name, not a path: the files are in\nthe directory of `path_abs`."
          },
          "first": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "description": "The number of the first file."
          },
          "count": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "description": "How many numbers the run covers, from `first` (missing ones included); at least 2."
          },
          "fps": {
            "description": "The frame rate chosen at import; changing the app setting never changes it.",
            "type": "object",
            "properties": {
              "num": {
                "type": "integer",
