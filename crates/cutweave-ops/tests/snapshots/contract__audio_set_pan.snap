---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "audio.set_pan",
    "summary": "Set a clip's stereo pan (-1 left, 1 right; keyed at the playhead when animated)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item (or `items`).",
          "default": null
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Items to change the same way.",
          "default": null
        },
        "pan": {
          "type": "number",
          "format": "double",
          "description": "The position, `-1..=1`."
        },
        "auto_key": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Key an animated pan at `at` (default true).",
          "default": null
        },
        "at": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Sequence time (the playhead) to key at.",
          "default": null
        }
      },
      "required": [
        "pan"
      ],
      "description": "Clip pan (`audio.set` with `kind: pan`; a wrapper over `item.set_props`).",
      "title": "AudioSetPan"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The first item."
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What changed on any item (`audio.fade_in`, `audio.fade_out`, `audio.gain`, `audio.pan`);\nempty when everything was already as requested."
        },
        "fade_in": {
          "type": "object",
          "properties": {
            "duration": {
              "description": "Length of the fade.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "curve": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "linear",
                  "description": "Gain rises in a straight line (the default)."
                },
                {
                  "type": "string",
                  "const": "log",
                  "description": "Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in."
                },
                {
                  "type": "string",
                  "const": "equal_power",
                  "description": "Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`."
                },
                {
                  "type": "string",
                  "const": "s_curve",
                  "description": "Gentle at both ends: `(1 - cos(x*pi)) / 2`."
                }
              ],
              "description": "Its shape."
            }
          },
          "required": [
            "duration",
            "curve"
          ],
          "description": "The first item's fade in after the change (a fade longer than the room left is cut)."
        },
        "fade_out": {
          "type": "object",
          "properties": {
            "duration": {
              "description": "Length of the fade.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "curve": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "linear",
                  "description": "Gain rises in a straight line (the default)."
                },
                {
                  "type": "string",
                  "const": "log",
                  "description": "Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in."
                },
                {
                  "type": "string",
                  "const": "equal_power",
                  "description": "Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`."
                },
                {
                  "type": "string",
                  "const": "s_curve",
                  "description": "Gentle at both ends: `(1 - cos(x*pi)) / 2`."
                }
              ],
              "description": "Its shape."
            }
          },
          "required": [
            "duration",
            "curve"
          ],
          "description": "The first item's fade out after the change."
        },
        "clamped": {
          "type": "boolean",
          "description": "A requested fade was cut to fit the clip."
        },
        "keyed": {
          "type": "array",
          "items": {
            "description": "A key `item.set_props` wrote on an animated property.",
            "type": "object",
            "properties": {
              "item": {
                "description": "The item.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "prop": {
                "description": "The property.",
                "type": "string",
                "enum": [
                  "transform.position",
                  "transform.scale",
                  "transform.rotation",
                  "transform.anchor",
                  "opacity",
                  "crop.left",
                  "crop.top",
                  "crop.right",
                  "crop.bottom",
                  "flip.horizontal",
                  "flip.vertical",
                  "audio_gain",
                  "audio_pan"
                ]
              },
              "t": {
                "description": "Item time of the key, after snapping.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "at": {
                "description": "Sequence time of the key, after snapping.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "required": [
              "item",
              "prop",
              "t",
              "at"
            ]
          },
          "description": "The keys written on animated properties."
        }
      },
      "required": [
        "item",
        "changed",
        "fade_in",
        "fade_out",
        "clamped",
        "keyed"
      ],
      "description": "Result of the audio commands.",
      "title": "AudioSetOutput"
    }
  },
