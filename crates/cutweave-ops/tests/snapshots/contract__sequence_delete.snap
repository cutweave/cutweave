{
  "meta": {
    "name": "sequence.delete",
    "summary": "Delete a sequence (not the last one, not while a compound clip uses it)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        }
      },
      "required": [
        "sequence"
      ],
      "description": "Removes a sequence with its tracks and items; the media stays in the bin. Fails with\n`Invalid` for the last sequence and for a sequence that compound clips refer to.",
      "title": "SequenceDelete"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The removed sequence."
        },
        "removed_items": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "How many items it held (removed with it)."
        },
        "sequence_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "How many sequences the project has now."
        }
      },
      "required": [
        "sequence",
        "removed_items",
        "sequence_count"
      ],
      "description": "Result of `sequence.delete`.",
      "title": "SequenceDeleteOutput"
    }
