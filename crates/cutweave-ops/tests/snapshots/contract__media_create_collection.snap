---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.create_collection",
    "summary": "Create a manual or smart (saved filter) collection of media",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Its name: 1 to 255 characters without control characters (trimmed), unique ignoring\ncase."
        },
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "manual"
                },
                "media": {
                  "type": "array",
                  "items": {
                    "description": "A Media id: `^med_[0-9a-f]{32}$`.",
                    "type": "string",
                    "pattern": "^med_[0-9a-f]{32}$"
                  },
                  "description": "The members, without repeats. One that names no asset is skipped by queries and\ndropped by the next edit of the collection.",
                  "default": []
                }
              },
              "required": [
                "type"
              ],
              "description": "A list of assets, kept in the order they were added."
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "smart"
                },
                "filter": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Terms that must all occur in the name, tags or note, ignoring case and accents."
                    },
                    "kinds": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "description": "What a [`MediaAsset`] is.",
                        "oneOf": [
                          {
                            "description": "A video file (may also carry audio).",
                            "type": "string",
                            "const": "video"
                          },
                          {
                            "description": "An audio-only file.",
                            "type": "string",
                            "const": "audio"
                          },
                          {
                            "description": "A still image (no duration).",
                            "type": "string",
                            "const": "image"
                          },
                          {
                            "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                            "type": "string",
                            "const": "image_sequence"
                          },
                          {
                            "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                            "type": "string",
                            "const": "sequence_ref"
                          }
                        ]
                      },
                      "description": "Only these kinds."
                    },
                    "min_duration": {
                      "anyOf": [
                        {
                          "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "string",
                              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Shortest length (flicks), inclusive; stills never match a bound."
                    },
                    "max_duration": {
                      "anyOf": [
                        {
                          "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "string",
                              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Longest length (flicks), inclusive."
                    },
                    "used": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "Placed on a timeline of any sequence (`true`) or not (`false`)."
                    },
                    "problems": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "`true`: only files nothing can be read from (no streams)."
                    },
                    "folder": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^fld_[0-9a-f]{32}$",
                      "description": "Only this bin folder."
                    },
                    "recursive": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "With subfolders (default: true without folder)."
                    },
                    "tags": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "description": "Has all these tags."
                    },
                    "min_rating": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint8",
                      "minimum": 0,
                      "maximum": 255,
                      "description": "Rated at least this (1-5)."
                    },
                    "collection": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^col_[0-9a-f]{32}$",
                      "description": "On this collection."
                    }
                  },
                  "description": "The filter. It may not name a collection."
                }
              },
              "required": [
                "type",
                "filter"
              ],
              "description": "A saved search: the assets that pass the filter, computed when asked."
            }
          ],
          "description": "Manual (members) or smart (a filter)."
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "description": "Creates a collection of media: a named list an asset can be on without leaving its folder.\n`kind` is `{\"type\": \"manual\", \"media\": [...]}` (the members, in order; may be empty or left\nout) or `{\"type\": \"smart\", \"filter\": {...}}` (a saved `media.list` filter whose matches are\nthe members, always current; it cannot name a collection). The name must be new, ignoring\ncase. A project holds at most 1,000 collections and a manual one at most 10,000 members.",
      "title": "MediaCreateCollection"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_id": {
          "type": "string",
          "pattern": "^col_[0-9a-f]{32}$",
          "description": "The collection."
        },
        "name": {
          "type": "string",
          "description": "Its name (trimmed)."
        }
      },
      "required": [
        "collection_id",
        "name"
      ],
      "description": "Result of `media.create_collection` and `media.rename_collection`.",
      "title": "CollectionNamed"
    }
  },
