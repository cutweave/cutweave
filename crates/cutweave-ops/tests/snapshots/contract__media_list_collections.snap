---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.list_collections",
    "summary": "List the project's media collections with kind and member count",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lists the project's collections of media: each one's ID, name, kind (manual or smart), the\nfilter of a smart one and how many assets are on it. List the members with `media.list` and\n`filter.collection`.",
      "title": "MediaListCollections"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "description": "One collection of media.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The collection.",
                "type": "string",
                "pattern": "^col_[0-9a-f]{32}$"
              },
              "name": {
                "description": "Its name.",
                "type": "string"
              },
              "kind": {
                "description": "Manual or smart.",
                "oneOf": [
                  {
                    "description": "Stored members.",
                    "type": "string",
                    "const": "manual"
                  },
                  {
                    "description": "A stored filter; the members are computed.",
                    "type": "string",
                    "const": "smart"
                  }
                ]
              },
              "filter": {
                "description": "The filter of a smart collection; absent for a manual one.",
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "text": {
                    "description": "Terms that must all occur in the name, tags or note, ignoring case and accents.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kinds": {
                    "description": "Only these kinds.",
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "description": "What a [`MediaAsset`] is.",
                      "oneOf": [
                        {
                          "description": "A video file (may also carry audio).",
                          "type": "string",
                          "const": "video"
                        },
                        {
                          "description": "An audio-only file.",
                          "type": "string",
                          "const": "audio"
                        },
                        {
                          "description": "A still image (no duration).",
                          "type": "string",
                          "const": "image"
                        },
                        {
                          "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                          "type": "string",
                          "const": "image_sequence"
                        },
                        {
                          "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                          "type": "string",
                          "const": "sequence_ref"
                        }
                      ]
                    }
                  },
                  "min_duration": {
                    "description": "Shortest length (flicks), inclusive; stills never match a bound.",
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max_duration": {
                    "description": "Longest length (flicks), inclusive.",
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "used": {
                    "description": "Placed on a timeline of any sequence (`true`) or not (`false`).",
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "problems": {
                    "description": "`true`: only files nothing can be read from (no streams).",
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "folder": {
                    "description": "Only this bin folder.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^fld_[0-9a-f]{32}$"
                  },
                  "recursive": {
                    "description": "With subfolders (default: true without folder).",
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "tags": {
                    "description": "Has all these tags.",
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "min_rating": {
                    "description": "Rated at least this (1-5).",
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint8",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "collection": {
                    "description": "On this collection.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^col_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false
              },
              "media_count": {
                "description": "How many assets are on it now (a smart collection's filter is run; members that no\nlonger exist are not counted).",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "filter",
              "media_count"
            ]
          },
          "description": "Every collection, by name ignoring case."
        }
      },
      "required": [
        "collections"
      ],
      "description": "Result of `media.list_collections`.",
      "title": "MediaListCollectionsOutput"
    }
  },
