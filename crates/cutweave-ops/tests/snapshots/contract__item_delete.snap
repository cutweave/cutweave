{
  "meta": {
    "name": "item.delete",
    "summary": "Delete items and their linked partners (no ripple; fails if a track is locked)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
