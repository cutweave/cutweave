                {
                  "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "description": "The value; omitted: the property's current value at that time.",
              "anyOf": [
                {
                  "description": "A property value: a number (opacity, crop edges, rotation, gain, pan), `{x, y}` (position,\nscale, anchor) or a boolean (flip). The property decides which; a mismatch is `Invalid`.",
                  "anyOf": [
                    {
                      "description": "A boolean.",
                      "type": "boolean"
                    },
                    {
                      "description": "A number.",
                      "type": "number",
                      "format": "double"
                    },
                    {
                      "description": "A 2D vector.",
                      "type": "object",
                      "properties": {
                        "x": {
                          "description": "Horizontal component.",
                          "type": "number",
                          "format": "double"
                        },
                        "y": {
                          "description": "Vertical component (down is positive).",
                          "type": "number",
                          "format": "double"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "interp": {
              "description": "Shapes the move to the next key (stored form; `bounce` may be omitted).",
              "anyOf": [
                {
                  "description": "How the segment that starts at a key moves to the next key, as commands take it: the stored\nform ([`Interp`]) with `bounce` optional (default `false`).",
                  "oneOf": [
                    {
                      "description": "The key's value until the next key, then a jump.",
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "hold"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "description": "Constant speed.",
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "linear"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "description": "A CSS-style cubic Bezier from (0, 0) to (1, 1).",
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "bezier"
                        },
                        "x1": {
                          "description": "First control point, time axis, `0..=1`.",
                          "type": "number",
                          "format": "double"
                        },
                        "y1": {
                          "description": "First control point, progress axis, `-10..=10`.",
                          "type": "number",
                          "format": "double"
                        },
                        "x2": {
                          "description": "Second control point, time axis, `0..=1`.",
                          "type": "number",
                          "format": "double"
                        },
                        "y2": {
                          "description": "Second control point, progress axis, `-10..=10`.",
                          "type": "number",
                          "format": "double"
                        },
                        "preset": {
                          "description": "A hint naming the preset the numbers came from.",
                          "type": [
                            "string",
                            "null"
                          ],
                          "default": null
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "x1",
                        "y1",
                        "x2",
                        "y2"
                      ]
                    },
                    {
                      "description": "A damped spring.",
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "spring"
                        },
                        "stiffness": {
                          "description": "Stiffness, `1..=10000`.",
                          "type": "number",
                          "format": "double"
                        },
                        "damping": {
                          "description": "Damping, `0..=1000`.",
                          "type": "number",
                          "format": "double"
                        },
                        "mass": {
                          "description": "Mass, `0.1..=100`.",
                          "type": "number",
                          "format": "double"
                        },
                        "bounce": {
                          "description": "A hard stop at the target (default `false`).",
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "default": null
                        },
                        "preset": {
                          "description": "A hint naming the preset the numbers came from.",
                          "type": [
                            "string",
                            "null"
                          ],
                          "default": null
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "stiffness",
                        "damping",
                        "mass"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "easing": {
              "description": "A preset name (`ease_out`, `spring`, ...), `linear` or `hold`; not with `interp`.",
              "anyOf": [
                {
                  "description": "A named easing (keyframes §4.6): one of the 21 presets, or `linear` or `hold`. Commands\naccept it instead of an [`Interp`] (`easing: \"ease_out\"`) and expand it on write\n([`Easing::interp`]); documents never store the name alone.\n\nThe table is part of the spec: changing a preset's numbers means a new name, because\ndocuments store the expanded numbers and old projects must never change appearance.",
                  "oneOf": [
                    {
                      "description": "The key's value until the next key.",
                      "type": "string",
                      "const": "hold"
                    },
                    {
                      "description": "Constant speed.",
                      "type": "string",
                      "const": "linear"
                    },
                    {
                      "description": "CSS `ease-in`: bezier (0.42, 0, 1, 1).",
                      "type": "string",
                      "const": "ease_in"
                    },
                    {
                      "description": "CSS `ease-out`: bezier (0, 0, 0.58, 1).",
                      "type": "string",
                      "const": "ease_out"
                    },
                    {
                      "description": "CSS `ease-in-out`: bezier (0.42, 0, 0.58, 1).",
                      "type": "string",
                      "const": "ease_in_out"
                    },
                    {
                      "description": "Bezier (0.12, 0, 0.39, 0).",
                      "type": "string",
                      "const": "sine_in"
                    },
                    {
                      "description": "Bezier (0.61, 1, 0.88, 1).",
                      "type": "string",
                      "const": "sine_out"
                    },
                    {
                      "description": "Bezier (0.37, 0, 0.63, 1).",
                      "type": "string",
                      "const": "sine_in_out"
                    },
                    {
                      "description": "Bezier (0.32, 0, 0.67, 0).",
                      "type": "string",
                      "const": "cubic_in"
                    },
                    {
                      "description": "Bezier (0.33, 1, 0.68, 1).",
                      "type": "string",
                      "const": "cubic_out"
                    },
                    {
                      "description": "Bezier (0.65, 0, 0.35, 1).",
                      "type": "string",
                      "const": "cubic_in_out"
                    },
                    {
                      "description": "Bezier (0.7, 0, 0.84, 0).",
                      "type": "string",
                      "const": "expo_in"
                    },
                    {
                      "description": "Bezier (0.16, 1, 0.3, 1).",
                      "type": "string",
                      "const": "expo_out"
                    },
                    {
                      "description": "Bezier (0.87, 0, 0.13, 1).",
                      "type": "string",
                      "const": "expo_in_out"
                    },
                    {
                      "description": "Bezier (0.36, 0, 0.66, −0.56): pulls back before leaving.",
                      "type": "string",
                      "const": "back_in"
                    },
                    {
                      "description": "Bezier (0.34, 1.56, 0.64, 1): overshoots, then settles.",
                      "type": "string",
                      "const": "back_out"
                    },
                    {
                      "description": "Bezier (0.68, −0.6, 0.32, 1.6).",
                      "type": "string",
                      "const": "back_in_out"
                    },
                    {
                      "description": "Spring 170 / 26 / 1 (ζ ≈ 1.00).",
                      "type": "string",
                      "const": "spring"
                    },
                    {
                      "description": "Spring 120 / 14 / 1 (ζ ≈ 0.64).",
                      "type": "string",
                      "const": "spring_gentle"
                    },
                    {
                      "description": "Spring 180 / 12 / 1 (ζ ≈ 0.45).",
                      "type": "string",
                      "const": "spring_wobbly"
                    },
                    {
                      "description": "Spring 210 / 20 / 1 (ζ ≈ 0.69).",
                      "type": "string",
                      "const": "spring_stiff"
                    },
                    {
                      "description": "Spring 200 / 6 / 1 (ζ ≈ 0.21): several decaying oscillations.",
                      "type": "string",
                      "const": "elastic"
                    },
                    {
                      "description": "Spring 160 / 10 / 1 with `bounce` (ζ ≈ 0.40): each bounce about a quarter as high.",
                      "type": "string",
                      "const": "bounce"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "preset": {
              "description": "A hint naming the preset of `interp` (for writing `item.get` keys back).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "description": "The keys, 1 to 10,000."
      },
      "replace": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Make the result exactly these keys (default `false`).",
        "default": null
      },
      "fine": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Snap to the audio sample grid (audio properties only).",
        "default": null
      }
    },
    "required": [
      "prop",
      "keys"
    ],
    "description": "Adds or replaces keys on one property of an item (or of each of `items`). `t` is item time\nand `at` sequence time; both snap to frames (`fine`: audio samples, for audio properties).\nA key's `easing` (or `interp`) shapes the move to the next key; a new key inherits the one\nbefore it, else linear (hold for flips). A static property becomes animated with exactly\nthese keys; a key at an occupied time replaces that key; `replace: true` makes the result\nexactly these keys. Omit `value` to key the current value. Values outside the property's\nrange are `Invalid`; `Locked` if the item's track is locked.",
    "title": "KeyframeSet"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "keys": {
        "type": "array",
        "items": {
          "description": "One key `keyframe.set` wrote.",
          "type": "object",
          "properties": {
            "item": {
              "description": "The item.",
              "type": "string",
              "pattern": "^itm_[0-9a-f]{32}$"
            },
            "prop": {
              "description": "The property.",
              "oneOf": [
                {
                  "description": "`visual.transform.position`: offset of the anchor from the canvas centre, canvas units.",
                  "type": "string",
                  "const": "transform.position"
                },
                {
                  "description": "`visual.transform.scale`: multiplier of the aspect-fit size, per axis.",
                  "type": "string",
                  "const": "transform.scale"
                },
                {
                  "description": "`visual.transform.rotation`: degrees, clockwise, accumulating.",
                  "type": "string",
                  "const": "transform.rotation"
                },
                {
                  "description": "`visual.transform.anchor`: a point of the item in item units.",
                  "type": "string",
                  "const": "transform.anchor"
                },
                {
                  "description": "`visual.opacity`: 0 transparent to 1 opaque.",
                  "type": "string",
                  "const": "opacity"
                },
                {
                  "description": "`visual.crop.left`: fraction of the upright source removed from the left edge.",
                  "type": "string",
                  "const": "crop.left"
                },
                {
                  "description": "`visual.crop.top`: fraction removed from the top edge.",
                  "type": "string",
                  "const": "crop.top"
                },
                {
                  "description": "`visual.crop.right`: fraction removed from the right edge.",
                  "type": "string",
                  "const": "crop.right"
                },
                {
                  "description": "`visual.crop.bottom`: fraction removed from the bottom edge.",
                  "type": "string",
                  "const": "crop.bottom"
                },
                {
                  "description": "`visual.flip.horizontal`: mirror left-right (hold only).",
                  "type": "string",
                  "const": "flip.horizontal"
                },
                {
                  "description": "`visual.flip.vertical`: mirror top-bottom (hold only).",
                  "type": "string",
                  "const": "flip.vertical"
                },
                {
                  "description": "`audio.gain`: clip level in dB, interpolated in dB (UI label \"Volume\").",
                  "type": "string",
                  "const": "audio_gain"
                },
                {
                  "description": "`audio.pan`: −1 left to 1 right, 0 centre.",
                  "type": "string",
                  "const": "audio_pan"
                }
              ]
            },
            "t": {
              "description": "Item time after snapping.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "at": {
              "description": "Sequence time after snapping.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "value": {
              "description": "The value the key holds.",
              "anyOf": [
                {
                  "description": "A boolean.",
                  "type": "boolean"
                },
                {
                  "description": "A number.",
                  "type": "number",
                  "format": "double"
                },
                {
                  "description": "A 2D vector.",
                  "type": "object",
                  "properties": {
                    "x": {
                      "description": "Horizontal component.",
                      "type": "number",
                      "format": "double"
                    },
                    "y": {
                      "description": "Vertical component (down is positive).",
                      "type": "number",
                      "format": "double"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                }
              ]
            },
            "created": {
              "description": "A new key (`false`: an existing key's value changed).",
              "type": "boolean"
            },
            "outside": {
              "description": "The key lies outside the item's `[0, duration)`.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "item",
            "prop",
            "t",
            "at",
            "value",
            "created",
            "outside"
          ]
        },
        "description": "The keys written, per item and key in request order."
      }
    },
    "required": [
      "keys"
    ],
    "description": "Result of `keyframe.set`.",
    "title": "KeyframeSetOutput"
  }
}
