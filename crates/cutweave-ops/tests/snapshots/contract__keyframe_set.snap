                            "const": "linear"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "description": "A CSS-style cubic Bezier from (0, 0) to (1, 1).",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "bezier"
                          },
                          "x1": {
                            "description": "First control point, time axis, `0..=1`.",
                            "type": "number",
                            "format": "double"
                          },
                          "y1": {
                            "description": "First control point, progress axis, `-10..=10`.",
                            "type": "number",
                            "format": "double"
                          },
                          "x2": {
                            "description": "Second control point, time axis, `0..=1`.",
                            "type": "number",
                            "format": "double"
                          },
                          "y2": {
                            "description": "Second control point, progress axis, `-10..=10`.",
                            "type": "number",
                            "format": "double"
                          },
                          "preset": {
                            "description": "A hint naming the preset the numbers came from.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "default": null
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "x1",
                          "y1",
                          "x2",
                          "y2"
                        ]
                      },
                      {
                        "description": "A damped spring.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "spring"
                          },
                          "stiffness": {
                            "description": "Stiffness, `1..=10000`.",
                            "type": "number",
                            "format": "double"
                          },
                          "damping": {
                            "description": "Damping, `0..=1000`.",
                            "type": "number",
                            "format": "double"
                          },
                          "mass": {
                            "description": "Mass, `0.1..=100`.",
                            "type": "number",
                            "format": "double"
                          },
                          "bounce": {
                            "description": "A hard stop at the target (default `false`).",
                            "type": [
                              "boolean",
                              "null"
                            ],
                            "default": null
                          },
                          "preset": {
                            "description": "A hint naming the preset the numbers came from.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "default": null
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "stiffness",
                          "damping",
                          "mass"
                        ]
                      }
                    ]
                  },
