{
  "meta": {
    "name": "keyframe.set",
    "summary": "Add or replace keys on one property of an item",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item (or `items`).",
          "default": null
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Items to give the same keys.",
          "default": null
        },
        "prop": {
          "oneOf": [
            {
              "type": "string",
              "const": "transform.position",
              "description": "`visual.transform.position`: offset of the anchor from the canvas centre, canvas units."
            },
            {
              "type": "string",
              "const": "transform.scale",
              "description": "`visual.transform.scale`: multiplier of the aspect-fit size, per axis."
            },
            {
              "type": "string",
              "const": "transform.rotation",
              "description": "`visual.transform.rotation`: degrees, clockwise, accumulating."
            },
            {
              "type": "string",
              "const": "transform.anchor",
              "description": "`visual.transform.anchor`: a point of the item in item units."
            },
            {
              "type": "string",
              "const": "opacity",
              "description": "`visual.opacity`: 0 transparent to 1 opaque."
            },
            {
              "type": "string",
              "const": "crop.left",
              "description": "`visual.crop.left`: fraction of the upright source removed from the left edge."
            },
            {
              "type": "string",
              "const": "crop.top",
              "description": "`visual.crop.top`: fraction removed from the top edge."
            },
            {
              "type": "string",
              "const": "crop.right",
              "description": "`visual.crop.right`: fraction removed from the right edge."
            },
            {
              "type": "string",
              "const": "crop.bottom",
              "description": "`visual.crop.bottom`: fraction removed from the bottom edge."
            },
            {
              "type": "string",
              "const": "flip.horizontal",
              "description": "`visual.flip.horizontal`: mirror left-right (hold only)."
            },
            {
              "type": "string",
              "const": "flip.vertical",
              "description": "`visual.flip.vertical`: mirror top-bottom (hold only)."
            },
            {
              "type": "string",
              "const": "audio_gain",
              "description": "`audio.gain`: clip level in dB, interpolated in dB (UI label \"Volume\")."
            },
            {
              "type": "string",
              "const": "audio_pan",
              "description": "`audio.pan`: −1 left to 1 right, 0 centre."
            }
          ],
          "description": "The property: `transform.position`, `transform.scale`, `transform.rotation`,\n`transform.anchor`, `opacity`, `crop.left|top|right|bottom`, `flip.horizontal|vertical`,\n`audio_gain` or `audio_pan`."
        },
        "keys": {
          "type": "array",
          "items": {
            "description": "A key to write.",
            "type": "object",
            "properties": {
              "t": {
                "description": "Item time (flicks, seconds or frames counted from the item's start); give `t` or `at`.",
                "anyOf": [
                  {
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "at": {
                "description": "Sequence time; snapped to the frame grid.",
                "anyOf": [
                  {
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "description": "The value; omitted: the property's current value at that time.",
                "anyOf": [
                  {
                    "description": "A property value: a number (opacity, crop edges, rotation, gain, pan), `{x, y}` (position,\nscale, anchor) or a boolean (flip). The property decides which; a mismatch is `Invalid`.",
