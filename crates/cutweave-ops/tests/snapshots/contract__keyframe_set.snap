                      {
                        "description": "A boolean.",
                        "type": "boolean"
                      },
                      {
                        "description": "A number.",
                        "type": "number",
                        "format": "double"
                      },
                      {
                        "description": "A 2D vector.",
                        "type": "object",
                        "properties": {
                          "x": {
                            "description": "Horizontal component.",
                            "type": "number",
                            "format": "double"
                          },
                          "y": {
                            "description": "Vertical component (down is positive).",
                            "type": "number",
                            "format": "double"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "interp": {
                "description": "Shapes the move to the next key (stored form; `bounce` may be omitted).",
                "anyOf": [
                  {
                    "description": "How the segment that starts at a key moves to the next key, as commands take it: the stored\nform ([`Interp`]) with `bounce` optional (default `false`).",
                    "oneOf": [
                      {
                        "description": "The key's value until the next key, then a jump.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "hold"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "description": "Constant speed.",
                        "type": "object",
                        "properties": {
                          "kind": {
