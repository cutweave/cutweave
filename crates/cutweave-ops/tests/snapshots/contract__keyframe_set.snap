                        "type": "string",
                        "const": "ease_in"
                      },
                      {
                        "description": "CSS `ease-out`: bezier (0, 0, 0.58, 1).",
                        "type": "string",
                        "const": "ease_out"
                      },
                      {
                        "description": "CSS `ease-in-out`: bezier (0.42, 0, 0.58, 1).",
                        "type": "string",
                        "const": "ease_in_out"
                      },
                      {
                        "description": "Bezier (0.12, 0, 0.39, 0).",
                        "type": "string",
                        "const": "sine_in"
                      },
                      {
                        "description": "Bezier (0.61, 1, 0.88, 1).",
                        "type": "string",
                        "const": "sine_out"
                      },
                      {
                        "description": "Bezier (0.37, 0, 0.63, 1).",
                        "type": "string",
                        "const": "sine_in_out"
                      },
                      {
                        "description": "Bezier (0.32, 0, 0.67, 0).",
                        "type": "string",
                        "const": "cubic_in"
                      },
                      {
                        "description": "Bezier (0.33, 1, 0.68, 1).",
                        "type": "string",
                        "const": "cubic_out"
                      },
                      {
                        "description": "Bezier (0.65, 0, 0.35, 1).",
                        "type": "string",
                        "const": "cubic_in_out"
                      },
                      {
                        "description": "Bezier (0.7, 0, 0.84, 0).",
                        "type": "string",
                        "const": "expo_in"
                      },
                      {
                        "description": "Bezier (0.16, 1, 0.3, 1).",
                        "type": "string",
                        "const": "expo_out"
                      },
                      {
                        "description": "Bezier (0.87, 0, 0.13, 1).",
                        "type": "string",
                        "const": "expo_in_out"
                      },
                      {
                        "description": "Bezier (0.36, 0, 0.66, −0.56): pulls back before leaving.",
                        "type": "string",
                        "const": "back_in"
                      },
                      {
                        "description": "Bezier (0.34, 1.56, 0.64, 1): overshoots, then settles.",
                        "type": "string",
                        "const": "back_out"
                      },
                      {
                        "description": "Bezier (0.68, −0.6, 0.32, 1.6).",
                        "type": "string",
                        "const": "back_in_out"
                      },
                      {
                        "description": "Spring 170 / 26 / 1 (ζ ≈ 1.00).",
                        "type": "string",
                        "const": "spring"
                      },
                      {
                        "description": "Spring 120 / 14 / 1 (ζ ≈ 0.64).",
                        "type": "string",
                        "const": "spring_gentle"
                      },
                      {
                        "description": "Spring 180 / 12 / 1 (ζ ≈ 0.45).",
                        "type": "string",
                        "const": "spring_wobbly"
                      },
                      {
                        "description": "Spring 210 / 20 / 1 (ζ ≈ 0.69).",
                        "type": "string",
                        "const": "spring_stiff"
                      },
                      {
                        "description": "Spring 200 / 6 / 1 (ζ ≈ 0.21): several decaying oscillations.",
                        "type": "string",
                        "const": "elastic"
                      },
                      {
                        "description": "Spring 160 / 10 / 1 with `bounce` (ζ ≈ 0.40): each bounce about a quarter as high.",
                        "type": "string",
                        "const": "bounce"
