            "properties": {
              "t": {
                "description": "Item time (flicks, seconds like \"1.5s\", or \"f:N\" frames from the item's start).",
                "anyOf": [
                  {
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "at": {
                "description": "Sequence time. Give `t` or `at`; both snap to frames.",
                "anyOf": [
                  {
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "description": "The value; omitted: the property's current value there.",
                "anyOf": [
                  {
                    "description": "A property value: a number, `{x, y}` (position, scale, anchor) or a boolean (flip); the\nproperty decides which.",
                    "anyOf": [
                      {
                        "description": "A boolean.",
                        "type": "boolean"
                      },
                      {
                        "description": "A number.",
                        "type": "number",
                        "format": "double"
                      },
                      {
                        "description": "A 2D vector.",
                        "type": "object",
                        "properties": {
                          "x": {
                            "description": "Horizontal component.",
                            "type": "number",
                            "format": "double"
                          },
                          "y": {
                            "description": "Vertical component (down is positive).",
                            "type": "number",
                            "format": "double"
                          }
