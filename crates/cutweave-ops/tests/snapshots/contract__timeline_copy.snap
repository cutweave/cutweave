                                          "description": "Flush left (flush start in right-to-left text is `start` in a later version).",
                                          "type": "string",
                                          "const": "left"
                                        },
                                        {
                                          "description": "Centred.",
                                          "type": "string",
                                          "const": "center"
                                        },
                                        {
                                          "description": "Flush right.",
                                          "type": "string",
                                          "const": "right"
                                        },
                                        {
                                          "description": "Stretched to both edges (the last line stays flush left).",
                                          "type": "string",
                                          "const": "justify"
                                        }
                                      ]
                                    },
                                    "v_align": {
                                      "description": "Vertical alignment in the box.",
                                      "oneOf": [
                                        {
                                          "description": "Against the top edge.",
                                          "type": "string",
                                          "const": "top"
                                        },
                                        {
                                          "description": "In the middle.",
                                          "type": "string",
                                          "const": "middle"
                                        },
                                        {
                                          "description": "Against the bottom edge.",
                                          "type": "string",
                                          "const": "bottom"
                                        }
                                      ]
                                    },
                                    "case_transform": {
                                      "description": "Case applied at layout.",
                                      "oneOf": [
                                        {
                                          "description": "As typed.",
                                          "type": "string",
                                          "const": "none"
                                        },
                                        {
                                          "description": "ALL CAPS.",
                                          "type": "string",
                                          "const": "upper"
                                        },
                                        {
                                          "description": "all lower.",
                                          "type": "string",
                                          "const": "lower"
                                        },
                                        {
                                          "description": "Each Word Capitalised.",
                                          "type": "string",
                                          "const": "title"
                                        }
                                      ]
                                    },
                                    "auto_fit": {
                                      "description": "What to do when the text does not fit.",
                                      "oneOf": [
                                        {
                                          "description": "Nothing: the text may overflow.",
                                          "type": "string",
                                          "const": "none"
                                        },
                                        {
                                          "description": "The font size shrinks until it fits.",
                                          "type": "string",
                                          "const": "shrink"
                                        },
                                        {
                                          "description": "The box grows to hold the text.",
                                          "type": "string",
                                          "const": "grow_box"
                                        }
                                      ]
                                    },
                                    "direction": {
                                      "description": "Base direction.",
                                      "oneOf": [
                                        {
                                          "description": "From the first strong character.",
                                          "type": "string",
                                          "const": "auto"
                                        },
                                        {
                                          "description": "Left to right.",
                                          "type": "string",
                                          "const": "ltr"
                                        },
                                        {
                                          "description": "Right to left.",
                                          "type": "string",
                                          "const": "rtl"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "font",
                                    "size",
                                    "fill",
                                    "strokes",
                                    "shadows",
                                    "glow",
                                    "background",
                                    "letter_spacing",
                                    "line_height",
                                    "align",
                                    "v_align",
                                    "case_transform",
                                    "auto_fit",
                                    "direction"
                                  ]
                                }
                              },
                              "required": [
                                "source",
                                "style"
                              ]
                            }
                          ]
                        },
                        "box": {
                          "description": "The layout rectangle.",
                          "type": "object",
                          "properties": {
                            "width": {
                              "description": "Width in canvas widths, above 0 and at most 4; `None`: no wrapping.",
                              "type": [
                                "number",
                                "null"
                              ],
                              "format": "double",
                              "default": null
                            },
                            "height": {
                              "description": "Height in canvas heights, above 0 and at most 4; `None`: as high as the text.",
                              "type": [
                                "number",
                                "null"
                              ],
                              "format": "double",
                              "default": null
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "width",
                            "height"
                          ]
                        },
                        "animation": {
                          "description": "In, out and loop animations; `None` until WP-3C.",
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "in": {
                              "description": "Plays as the item appears.",
                              "type": [
                                "object",
                                "null"
                              ],
                              "properties": {
                                "id": {
                                  "description": "The animation's ID.",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "default": null
                            },
                            "out": {
                              "description": "Plays as the item leaves.",
                              "type": [
                                "object",
                                "null"
                              ],
                              "properties": {
                                "id": {
                                  "description": "The animation's ID.",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "default": null
                            },
                            "loop": {
                              "description": "Plays all the while.",
                              "type": [
                                "object",
                                "null"
                              ],
                              "properties": {
                                "id": {
                                  "description": "The animation's ID.",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "default": null
                            }
                          },
                          "required": [
                            "in",
                            "out",
                            "loop"
                          ],
                          "default": null
                        },
                        "visual": {
                          "description": "Placement and opacity (the same properties a clip has).",
                          "type": "object",
                          "properties": {
                            "transform": {
                              "description": "Placement on the canvas.",
                              "type": "object",
                              "properties": {
                                "position": {
                                  "description": "Offset of the anchor from the canvas center, in canvas units.",
                                  "oneOf": [
                                    {
                                      "description": "A 2D vector (positions, scales, anchors).",
                                      "type": "object",
                                      "properties": {
                                        "x": {
                                          "description": "Horizontal component.",
                                          "type": "number",
                                          "format": "double"
                                        },
                                        "y": {
                                          "description": "Vertical component (down is positive).",
                                          "type": "number",
                                          "format": "double"
                                        }
                                      },
                                      "additionalProperties": false,
                                      "required": [
                                        "x",
                                        "y"
                                      ]
                                    },
                                    {
                                      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                      "type": "object",
                                      "properties": {
                                        "keyframes": {
                                          "type": "array",
                                          "items": {
                                            "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                            "type": "object",
                                            "properties": {
                                              "t": {
                                                "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                                "type": "integer",
                                                "minimum": -9007199254740991,
                                                "maximum": 9007199254740991
                                              },
                                              "value": {
                                                "description": "A 2D vector (positions, scales, anchors).",
                                                "type": "object",
                                                "properties": {
                                                  "x": {
                                                    "description": "Horizontal component.",
                                                    "type": "number",
                                                    "format": "double"
                                                  },
                                                  "y": {
                                                    "description": "Vertical component (down is positive).",
                                                    "type": "number",
                                                    "format": "double"
                                                  }
                                                },
                                                "additionalProperties": false,
                                                "required": [
                                                  "x",
                                                  "y"
                                                ]
                                              },
                                              "interp": {
                                                "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                                "oneOf": [
                                                  {
                                                    "description": "The key's value until the next key, then a jump (§4.2).",
                                                    "type": "object",
                                                    "properties": {
                                                      "kind": {
                                                        "type": "string",
                                                        "const": "hold"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "additionalProperties": false
                                                  },
                                                  {
                                                    "description": "`p = u` (§4.3).",
                                                    "type": "object",
                                                    "properties": {
                                                      "kind": {
                                                        "type": "string",
                                                        "const": "linear"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "additionalProperties": false
                                                  },
                                                  {
                                                    "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                    "type": "object",
                                                    "properties": {
                                                      "kind": {
                                                        "type": "string",
                                                        "const": "bezier"
                                                      },
                                                      "x1": {
                                                        "description": "First control point, time axis, in `[0, 1]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 0.0,
                                                        "maximum": 1.0
                                                      },
                                                      "y1": {
                                                        "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": -10.0,
                                                        "maximum": 10.0
                                                      },
                                                      "x2": {
                                                        "description": "Second control point, time axis, in `[0, 1]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 0.0,
                                                        "maximum": 1.0
                                                      },
                                                      "y2": {
                                                        "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": -10.0,
                                                        "maximum": 10.0
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ],
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                      }
                                                    },
                                                    "additionalProperties": false,
                                                    "required": [
                                                      "kind",
                                                      "x1",
                                                      "y1",
                                                      "x2",
                                                      "y2"
                                                    ]
                                                  },
                                                  {
                                                    "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                    "type": "object",
                                                    "properties": {
                                                      "kind": {
                                                        "type": "string",
                                                        "const": "spring"
                                                      },
                                                      "stiffness": {
                                                        "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 1.0,
                                                        "maximum": 10000.0
                                                      },
                                                      "damping": {
                                                        "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 0.0,
                                                        "maximum": 1000.0
                                                      },
                                                      "mass": {
                                                        "description": "Mass, kg, in `[0.1, 100]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 0.1,
                                                        "maximum": 100.0
                                                      },
                                                      "bounce": {
                                                        "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                        "type": "boolean"
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ],
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                      }
                                                    },
                                                    "additionalProperties": false,
                                                    "required": [
                                                      "kind",
                                                      "stiffness",
                                                      "damping",
                                                      "mass",
                                                      "bounce"
                                                    ]
                                                  }
                                                ]
                                              }
