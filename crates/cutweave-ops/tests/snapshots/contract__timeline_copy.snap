                                                        "const": "spring"
                                                      },
                                                      "stiffness": {
                                                        "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                        "type": "number",
                                                        "format": "double",
                                                        "minimum": 1.0,
                                                        "maximum": 10000.0
                                                      },
