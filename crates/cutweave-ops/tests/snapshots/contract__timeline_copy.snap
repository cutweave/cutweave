                                                    },
                                                    "radius": {
                                                      "description": "Radius as a fraction of the box's larger side.",
                                                      "type": "number",
                                                      "format": "double"
                                                    },
                                                    "stops": {
                                                      "description": "Two to sixteen stops, ascending by `at`.",
