---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "timeline.copy",
    "summary": "Copy items and their linked partners into a clipboard payload",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "The items to copy, at least one, of one sequence."
        }
      },
      "required": [
        "items"
      ],
      "description": "Reads items and their linked partners into a clipboard payload (nothing changes).\n`NotFound` for an unknown item; `Invalid{path:\"/items\"}` for none or items of several\nsequences.",
      "title": "TimelineCopy"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Always 1."
            },
            "sequence": {
              "type": "string",
              "pattern": "^seq_[0-9a-f]{32}$",
              "description": "The sequence the items came from."
            },
            "frame_rate": {
              "description": "Its frame rate: pasting into a sequence with another one snaps to the frame grid.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "span": {
              "description": "Length of the copied range: the latest end minus the earliest start.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tracks": {
              "type": "array",
              "items": {
                "description": "One track of a payload: the kind it had and where it was.",
                "type": "object",
                "properties": {
                  "kind": {
                    "description": "What the track holds; pasted items go only to tracks of this kind.",
                    "oneOf": [
                      {
                        "description": "Picture layers.",
                        "type": "string",
                        "const": "video"
                      },
                      {
                        "description": "Sound.",
                        "type": "string",
                        "const": "audio"
                      },
                      {
                        "description": "Titles (later versions).",
                        "type": "string",
                        "const": "text"
                      },
                      {
                        "description": "Captions (later versions).",
                        "type": "string",
                        "const": "caption"
                      },
                      {
                        "description": "Adjustment layers (later versions).",
                        "type": "string",
                        "const": "adjustment"
                      }
                    ]
                  },
                  "row": {
                    "description": "Display-order distance from the top-most track of the payload (0 for the first).",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  "source": {
                    "description": "The track the items were copied from (where `timeline.paste` goes without `track`).",
                    "type": "string",
                    "pattern": "^trk_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "row",
                  "source"
                ]
              },
              "description": "The source tracks in display order, top first."
            },
            "items": {
              "type": "array",
              "items": {
                "description": "One copied item.",
                "type": "object",
                "properties": {
                  "track": {
                    "description": "Index into the payload's `tracks`.",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  "item": {
                    "description": "The item as copied, with its `start` relative to the earliest copied item. Its `id`,\n`linked_group` and `attached_to` only relate the items of the payload to each other.",
                    "oneOf": [
                      {
                        "description": "A media clip.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "clip"
                          },
                          "id": {
                            "description": "The item ID (also its key in the track's `items`).",
                            "type": "string",
                            "pattern": "^itm_[0-9a-f]{32}$"
                          },
                          "name": {
                            "description": "Display name; `None` shows the media name.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "start": {
                            "description": "Timeline position of the first frame.",
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "duration": {
                            "description": "Length on the timeline (positive).",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "enabled": {
                            "description": "Disabled items are kept but neither rendered nor heard.",
                            "type": "boolean"
                          },
                          "linked_group": {
                            "description": "Items with the same group move, trim and delete together (e.g. linked video and audio).",
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^grp_[0-9a-f]{32}$"
                          },
                          "attached_to": {
                            "description": "The item this one follows when it moves (schema v2, timeline spec §1.4): an overlay\nattached to a main-track clip. `None` when free.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^itm_[0-9a-f]{32}$"
                          },
                          "markers": {
                            "description": "Markers in item-relative time; they move with the item.",
                            "type": "object",
                            "additionalProperties": false,
                            "patternProperties": {
                              "^mrk_[0-9a-f]{32}$": {
                                "description": "A marker on a sequence (sequence time) or an item (item-relative time).",
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "description": "The marker ID (also its key in the owner's `markers`).",
                                    "type": "string",
                                    "pattern": "^mrk_[0-9a-f]{32}$"
                                  },
                                  "t": {
                                    "description": "Where the marker is (`>= 0`).",
                                    "type": "integer",
                                    "minimum": -9007199254740991,
                                    "maximum": 9007199254740991
                                  },
                                  "duration": {
                                    "description": "The length of a range marker; `None` for a point marker.",
                                    "type": [
                                      "integer",
                                      "null"
                                    ],
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "label": {
                                    "description": "Text shown with the marker (may be empty).",
                                    "type": "string"
                                  },
                                  "color": {
                                    "description": "Display color.",
                                    "type": "string",
                                    "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                                  },
                                  "kind": {
                                    "description": "What the marker means.",
                                    "oneOf": [
                                      {
                                        "description": "Placed by a person or an agent.",
                                        "type": "string",
                                        "const": "user"
                                      },
                                      {
                                        "description": "A beat found by analysis (snaps like a marker, spec §6).",
                                        "type": "string",
                                        "const": "beat"
                                      },
                                      {
                                        "description": "A chapter start (exported to chaptered formats).",
                                        "type": "string",
                                        "const": "chapter"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "id",
                                  "t",
                                  "duration",
                                  "label",
                                  "color",
                                  "kind"
                                ]
                              }
                            }
                          },
                          "color_label": {
                            "description": "The color label (arch §4.2 `color_label`, issue #222): a display color that marks the\nitem on the timeline, set with `item.set_label_color`. It changes nothing in the picture\nor the sound. Absent: no label; left out of the file while absent, so documents written\nbefore the field read the same.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                          },
                          "media": {
                            "description": "The media this clip plays.",
                            "type": "string",
                            "pattern": "^med_[0-9a-f]{32}$"
                          },
                          "source_in": {
                            "description": "Source position (from the start of the media) of the first frame (of the last frame\nshown, when reversed).",
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "speed": {
                            "description": "Playback speed (WP-2D.01): a timeline span `d` plays `d × speed` of media (INV-47).\nAbsent in documents written before it (the v2 fill-in adds it): normal speed.",
                            "type": "object",
                            "properties": {
                              "num": {
                                "description": "Numerator.",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100000
                              },
                              "den": {
                                "description": "Denominator.",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100000
                              }
                            },
                            "required": [
                              "num",
                              "den"
                            ],
                            "additionalProperties": false,
                            "default": {
                              "num": 1,
                              "den": 1
                            }
                          },
                          "reverse": {
                            "description": "Plays its source range backwards (WP-2D.01). Absent in older documents: forwards.",
                            "type": "boolean",
                            "default": false
                          },
                          "freeze": {
                            "description": "A freeze frame (WP-2D.01): shows the frame at `at_source` for its whole length, silent.\nAbsent in older documents: not a freeze frame.",
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "at_source": {
                                "description": "The media position of the frame shown.",
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "at_source"
                            ],
                            "default": null
                          },
                          "audio": {
                            "description": "Audio properties.",
                            "type": "object",
                            "properties": {
                              "gain": {
                                "description": "Gain in decibels (0.0 = unchanged).",
                                "oneOf": [
                                  {
                                    "type": "number",
                                    "format": "double"
                                  },
                                  {
                                    "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                    "type": "object",
                                    "properties": {
                                      "keyframes": {
                                        "type": "array",
                                        "items": {
                                          "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                          "type": "object",
                                          "properties": {
                                            "t": {
                                              "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                              "type": "integer",
                                              "minimum": -9007199254740991,
                                              "maximum": 9007199254740991
                                            },
                                            "value": {
                                              "type": "number",
                                              "format": "double"
                                            },
                                            "interp": {
                                              "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                              "oneOf": [
                                                {
                                                  "description": "The key's value until the next key, then a jump (§4.2).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "hold"
                                                    }
                                                  },
                                                  "required": [
                                                    "kind"
                                                  ],
                                                  "additionalProperties": false
                                                },
                                                {
                                                  "description": "`p = u` (§4.3).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "linear"
                                                    }
                                                  },
                                                  "required": [
                                                    "kind"
                                                  ],
                                                  "additionalProperties": false
                                                },
                                                {
                                                  "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "bezier"
                                                    },
                                                    "x1": {
                                                      "description": "First control point, time axis, in `[0, 1]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1.0
                                                    },
                                                    "y1": {
                                                      "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": -10.0,
                                                      "maximum": 10.0
                                                    },
                                                    "x2": {
                                                      "description": "Second control point, time axis, in `[0, 1]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1.0
                                                    },
                                                    "y2": {
                                                      "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": -10.0,
                                                      "maximum": 10.0
                                                    },
                                                    "preset": {
                                                      "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                      "type": [
                                                        "string",
                                                        "null"
                                                      ],
                                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                    }
                                                  },
                                                  "additionalProperties": false,
                                                  "required": [
                                                    "kind",
                                                    "x1",
                                                    "y1",
                                                    "x2",
                                                    "y2"
                                                  ]
                                                },
                                                {
                                                  "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "spring"
                                                    },
                                                    "stiffness": {
                                                      "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 1.0,
                                                      "maximum": 10000.0
                                                    },
                                                    "damping": {
                                                      "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1000.0
                                                    },
                                                    "mass": {
                                                      "description": "Mass, kg, in `[0.1, 100]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.1,
                                                      "maximum": 100.0
                                                    },
                                                    "bounce": {
                                                      "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                      "type": "boolean"
                                                    },
                                                    "preset": {
                                                      "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                      "type": [
                                                        "string",
                                                        "null"
                                                      ],
                                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                    }
                                                  },
                                                  "additionalProperties": false,
                                                  "required": [
                                                    "kind",
                                                    "stiffness",
                                                    "damping",
                                                    "mass",
                                                    "bounce"
                                                  ]
                                                }
                                              ]
                                            }
                                          },
                                          "required": [
                                            "t",
                                            "value",
                                            "interp"
                                          ]
                                        },
                                        "minItems": 1,
                                        "maxItems": 100000
                                      }
                                    },
                                    "required": [
                                      "keyframes"
                                    ]
                                  }
                                ]
                              },
                              "pan": {
                                "description": "Stereo position, -1.0 (left) to 1.0 (right), 0.0 = centre.",
                                "oneOf": [
                                  {
                                    "type": "number",
                                    "format": "double"
                                  },
                                  {
                                    "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                    "type": "object",
                                    "properties": {
                                      "keyframes": {
                                        "type": "array",
                                        "items": {
                                          "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                          "type": "object",
                                          "properties": {
                                            "t": {
                                              "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                              "type": "integer",
                                              "minimum": -9007199254740991,
                                              "maximum": 9007199254740991
                                            },
                                            "value": {
                                              "type": "number",
                                              "format": "double"
                                            },
                                            "interp": {
                                              "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                              "oneOf": [
                                                {
                                                  "description": "The key's value until the next key, then a jump (§4.2).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "hold"
                                                    }
                                                  },
                                                  "required": [
                                                    "kind"
                                                  ],
                                                  "additionalProperties": false
                                                },
                                                {
                                                  "description": "`p = u` (§4.3).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "linear"
                                                    }
                                                  },
                                                  "required": [
                                                    "kind"
                                                  ],
                                                  "additionalProperties": false
                                                },
                                                {
                                                  "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "bezier"
                                                    },
                                                    "x1": {
                                                      "description": "First control point, time axis, in `[0, 1]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1.0
                                                    },
                                                    "y1": {
                                                      "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": -10.0,
                                                      "maximum": 10.0
                                                    },
                                                    "x2": {
                                                      "description": "Second control point, time axis, in `[0, 1]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1.0
                                                    },
                                                    "y2": {
                                                      "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": -10.0,
                                                      "maximum": 10.0
                                                    },
                                                    "preset": {
                                                      "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                      "type": [
                                                        "string",
                                                        "null"
                                                      ],
                                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                    }
                                                  },
                                                  "additionalProperties": false,
                                                  "required": [
                                                    "kind",
                                                    "x1",
                                                    "y1",
                                                    "x2",
                                                    "y2"
                                                  ]
                                                },
                                                {
                                                  "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                  "type": "object",
                                                  "properties": {
                                                    "kind": {
                                                      "type": "string",
                                                      "const": "spring"
                                                    },
                                                    "stiffness": {
                                                      "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 1.0,
                                                      "maximum": 10000.0
                                                    },
                                                    "damping": {
                                                      "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.0,
                                                      "maximum": 1000.0
                                                    },
                                                    "mass": {
                                                      "description": "Mass, kg, in `[0.1, 100]`.",
                                                      "type": "number",
                                                      "format": "double",
                                                      "minimum": 0.1,
                                                      "maximum": 100.0
                                                    },
                                                    "bounce": {
                                                      "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                      "type": "boolean"
                                                    },
                                                    "preset": {
                                                      "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                      "type": [
                                                        "string",
                                                        "null"
                                                      ],
                                                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                                    }
                                                  },
                                                  "additionalProperties": false,
                                                  "required": [
                                                    "kind",
                                                    "stiffness",
                                                    "damping",
                                                    "mass",
                                                    "bounce"
                                                  ]
                                                }
                                              ]
                                            }
                                          },
                                          "required": [
                                            "t",
                                            "value",
                                            "interp"
                                          ]
                                        },
                                        "minItems": 1,
                                        "maxItems": 100000
                                      }
                                    },
                                    "required": [
                                      "keyframes"
                                    ]
                                  }
                                ]
                              },
                              "fade_in": {
                                "description": "Fade from silence at the start of the clip (WP-2E.01). Absent in documents written\nbefore it: no fade.",
                                "type": "object",
                                "properties": {
                                  "duration": {
                                    "description": "Length of the fade.",
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "curve": {
                                    "description": "Its shape.",
                                    "oneOf": [
                                      {
                                        "description": "Gain rises in a straight line (the default).",
                                        "type": "string",
                                        "const": "linear"
                                      },
                                      {
                                        "description": "Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in.",
                                        "type": "string",
                                        "const": "log"
                                      },
                                      {
                                        "description": "Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`.",
                                        "type": "string",
                                        "const": "equal_power"
                                      },
                                      {
                                        "description": "Gentle at both ends: `(1 - cos(x*pi)) / 2`.",
                                        "type": "string",
                                        "const": "s_curve"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "duration",
                                  "curve"
                                ],
                                "default": {
                                  "duration": 0,
                                  "curve": "linear"
                                }
                              },
