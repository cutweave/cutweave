---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "timeline.get",
    "summary": "Get a sequence: summary (depth 0), tracks (1) or tracks with items (2)",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "description": "Detail level `0..=2` (default 1).",
          "default": null
        },
        "fields": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Sections to include: any of `name`, `format`, `duration`, `tracks` (default all).",
          "default": null
        }
      },
      "required": [
        "sequence"
      ],
      "description": "Reads a sequence in layers: `depth` 0 is the sequence summary, 1 adds its tracks (summaries\nonly, small), 2 adds every item. `fields` limits the sections returned (`name`, `format`,\n`duration`, `tracks`); the id and the counts are always included.",
      "title": "TimelineGet"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its name (unless `fields` leaves it out)."
        },
        "format": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas width in pixels."
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas height in pixels."
            },
            "frame_rate": {
              "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "sample_rate": {
              "description": "The mix rate.",
              "type": "integer",
              "minimum": 1,
              "maximum": 352800000
            },
            "color_space": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "rec709",
                  "description": "Rec.709 primaries, SDR."
                }
              ],
              "description": "Working color space."
            },
            "background": {
              "description": "Canvas color behind all tracks.",
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "background_fill": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "blur"
                        },
                        "source": {
                          "oneOf": [
                            {
                              "type": "string",
                              "const": "below",
                              "description": "The lowest picture showing at that time."
                            },
                            {
                              "type": "string",
                              "const": "main_track",
                              "description": "The picture on the main track (the magnetic track; without one, the lowest video\ntrack)."
                            }
                          ],
                          "description": "Which picture is blurred.",
                          "default": "below"
                        },
                        "radius": {
                          "type": "number",
                          "format": "double",
                          "description": "The blur's standard deviation as a fraction of the canvas height, `0..=1`, so\npreview and export blur alike at any size."
                        },
                        "dim": {
                          "type": "number",
                          "format": "double",
                          "description": "How much of the blurred picture's light is taken away, `0..=1` (0: none, 1: black).",
                          "default": 0.0
                        }
                      },
                      "required": [
                        "kind",
                        "source",
                        "radius",
                        "dim"
                      ],
                      "description": "A blurred copy of a picture of the sequence, scaled to cover the canvas. Where no such\npicture shows, the color does."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "image"
                        },
                        "media": {
                          "type": "string",
                          "pattern": "^med_[0-9a-f]{32}$",
                          "description": "The image asset."
                        },
                        "fit": {
                          "oneOf": [
                            {
                              "type": "string",
                              "const": "cover",
                              "description": "Fills the canvas, cropping what does not fit."
                            },
                            {
                              "type": "string",
                              "const": "contain",
                              "description": "The whole image inside the canvas; the color shows around it."
                            },
                            {
                              "type": "string",
                              "const": "stretch",
                              "description": "Stretched to the canvas, changing its shape."
                            }
                          ],
                          "description": "How the image is sized to the canvas.",
                          "default": "cover"
                        }
                      },
                      "required": [
                        "kind",
                        "media",
                        "fit"
                      ],
                      "description": "A still image of the project. An image that no longer exists draws nothing."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "transparent"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "description": "Nothing: the canvas starts fully transparent and the color is not drawn. Only exports\nthat keep alpha show it; the others see black."
                    }
                  ],
                  "description": "What fills a sequence's canvas behind all tracks, over its `background` color (WP-2B.02).\nIt is static: a background has no keyframes."
                },
                {
                  "type": "null"
                }
              ],
              "description": "What fills the canvas over that color, behind all tracks (WP-2B.02). Absent: the color\nalone. Left out of the file while absent, so documents without one read as before."
            }
          },
          "required": [
            "width",
            "height",
            "frame_rate",
            "sample_rate",
            "color_space",
            "background"
          ],
          "description": "Its format (unless `fields` leaves it out)."
        },
        "duration": {
          "description": "End of the last item on any track (unless `fields` leaves it out).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "track_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Number of tracks."
        },
        "item_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Number of items on all tracks."
        },
        "tracks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "One track (depth 1 and 2).",
            "type": "object",
            "properties": {
              "id": {
                "description": "The track.",
                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "kind": {
                "description": "What it holds.",
                "oneOf": [
                  {
                    "description": "Picture layers.",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "Sound.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "Titles (later versions).",
                    "type": "string",
                    "const": "text"
                  },
                  {
                    "description": "Captions (later versions).",
                    "type": "string",
                    "const": "caption"
                  },
                  {
                    "description": "Adjustment layers (later versions).",
                    "type": "string",
                    "const": "adjustment"
                  }
                ]
              },
              "name": {
                "description": "Display name.",
                "type": "string"
              },
              "muted": {
                "description": "Silenced.",
                "type": "boolean"
              },
              "hidden": {
                "description": "Not rendered.",
                "type": "boolean"
              },
              "locked": {
                "description": "Item edits fail with `Locked`.",
                "type": "boolean"
              },
              "solo": {
                "description": "Solo.",
                "type": "boolean"
              },
              "magnetic": {
                "description": "The magnetic main track.",
                "type": "boolean"
              },
              "height": {
                "description": "Row height in pixels; `None` is the default.",
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0
              },
              "gain": {
                "description": "Gain in dB.",
                "type": "number",
                "format": "double"
              },
              "item_count": {
                "description": "Number of items.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "end": {
                "description": "End of its last item.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "items": {
                "description": "The items in start order (depth 2 only).",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "description": "One item of a track (depth 2).",
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "The item.",
                      "type": "string",
                      "pattern": "^itm_[0-9a-f]{32}$"
                    },
                    "kind": {
                      "description": "Item kind (`clip`).",
                      "type": "string"
                    },
                    "start": {
                      "description": "Timeline position of the first frame.",
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "duration": {
                      "description": "Length on the timeline.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "media": {
                      "description": "The media a clip plays.",
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^med_[0-9a-f]{32}$"
                    },
                    "linked_group": {
                      "description": "The linked group, if any.",
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^grp_[0-9a-f]{32}$"
                    },
                    "enabled": {
                      "description": "Whether the item is rendered and heard.",
                      "type": "boolean"
                    },
                    "color_label": {
                      "description": "The color label, `#rrggbb`, when it has one (`item.set_label_color`).",
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind",
                    "start",
                    "duration",
                    "media",
                    "linked_group",
                    "enabled"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "muted",
              "hidden",
              "locked",
              "solo",
              "magnetic",
              "height",
              "gain",
              "item_count",
              "end"
            ]
          },
          "description": "The tracks in display order, top to bottom (depth >= 1, unless `fields` leaves them\nout)."
        }
      },
      "required": [
        "id",
        "track_count",
        "item_count"
      ],
      "description": "Result of `timeline.get`.",
      "title": "TimelineGetOutput"
    }
