---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.list",
    "summary": "List the project's media (filter, sort, paged; default by id)",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Page size, `1..=500` (default 50).",
          "default": null
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "`next_cursor` of the previous page.",
          "default": null
        },
        "filter": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ],
              "description": "Terms that must all occur in the name, tags or note, ignoring case and accents."
            },
            "kinds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "description": "What a [`MediaAsset`] is.",
                "oneOf": [
                  {
                    "description": "A video file (may also carry audio).",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "An audio-only file.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "A still image (no duration).",
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                    "type": "string",
                    "const": "image_sequence"
                  },
                  {
                    "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                    "type": "string",
                    "const": "sequence_ref"
                  }
                ]
              },
              "description": "Only these kinds."
            },
            "min_duration": {
              "anyOf": [
                {
                  "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Shortest length (flicks), inclusive; stills never match a bound."
            },
            "max_duration": {
              "anyOf": [
                {
                  "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Longest length (flicks), inclusive."
            },
            "used": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Placed on a timeline of any sequence (`true`) or not (`false`)."
            },
            "problems": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "`true`: only files nothing can be read from (no streams)."
            },
            "folder": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^fld_[0-9a-f]{32}$",
              "description": "Only this bin folder."
            },
            "recursive": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "With subfolders (default: true without folder)."
            },
            "tags": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "description": "Has all these tags."
            },
            "min_rating": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "minimum": 1,
              "maximum": 5,
              "description": "Rated at least this (1-5)."
            },
            "collection": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^col_[0-9a-f]{32}$",
              "description": "On this collection."
            }
          },
          "description": "Keep only matching media.",
          "default": null
        },
        "sort": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string",
              "enum": [
                "imported",
                "name",
                "duration",
                "kind"
              ],
              "description": "What to order by."
            },
            "order": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "Direction.",
              "default": "asc"
            }
          },
          "required": [
            "by"
          ],
          "description": "Order.",
          "default": null
        },
        "include": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "What `media.list` adds to each asset on request.",
            "oneOf": [
              {
                "description": "The asset's note.",
                "type": "string",
                "const": "note"
              }
            ]
          },
          "description": "Extra fields per asset: `note`.",
          "default": null
        }
      },
      "description": "Lists the media of the project, filtered (also by bin folder, tags, rating and collection)\nand ordered, one page at a time. Each asset carries the name the bin shows, its folder, tags\nand rating.",
      "title": "MediaList"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "items": {
            "description": "Summary of one media asset.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The asset.",
                "type": "string",
                "pattern": "^med_[0-9a-f]{32}$"
              },
              "kind": {
                "description": "What it is.",
                "oneOf": [
                  {
                    "description": "A video file (may also carry audio).",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "An audio-only file.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "A still image (no duration).",
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                    "type": "string",
                    "const": "image_sequence"
                  },
                  {
                    "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                    "type": "string",
                    "const": "sequence_ref"
                  }
                ]
              },
              "name": {
                "description": "The name the bin shows: the display name, else the file name.",
                "type": "string"
              },
              "folder": {
                "description": "The folder of the bin it is in; absent: the top level.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^fld_[0-9a-f]{32}$"
              },
              "path": {
                "description": "Absolute path when it was last found (file kinds).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration": {
                "description": "Playable length, if known.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "has_video": {
                "description": "Whether it has pictures.",
                "type": "boolean"
              },
              "has_audio": {
                "description": "Whether it has sound.",
                "type": "boolean"
              },
              "tags": {
                "description": "Its tags, sorted ignoring case and accents.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rating": {
                "description": "Stars, 1 to 5; absent: unrated.",
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              },
              "note": {
                "description": "Its note; only with `include: [\"note\"]`, and left out otherwise.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "folder",
              "path",
              "duration",
              "has_video",
              "has_audio",
              "tags",
              "rating"
            ]
          },
          "description": "The page, in the requested order (default: by ID)."
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "Pass as `cursor` to get the next page; absent on the last page."
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Number of assets in the project."
        },
        "matched": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Number of assets that pass `filter` (all of them without one)."
        }
      },
      "required": [
        "media",
        "next_cursor",
        "total",
        "matched"
      ],
      "description": "Result of `media.list`.",
      "title": "MediaListOutput"
    }
  },
