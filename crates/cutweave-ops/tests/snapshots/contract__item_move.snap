                "type": "object",
                "properties": {
                  "left": {
                    "description": "The left half (keeps the original ID).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "right": {
                    "description": "The right half (new).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "at": {
                    "description": "The cut time.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
