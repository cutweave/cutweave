{
  "meta": {
    "name": "item.move",
    "summary": "Move items in time and/or to another track (linked partners follow)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item (or `items`).",
          "default": null
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Items; the first leads.",
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "New start, `>= 0` (or `delta`).",
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Offset of the start.",
          "default": null
        },
        "to_track": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^trk_[0-9a-f]{32}$",
          "description": "Target track (default: stay).",
          "default": null
        },
        "unlink": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Move only the given items, unlinked.",
          "default": null
        },
        "overlap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "reject",
            "new_track",
            null
          ],
          "description": "Alias of `mode`.",
          "default": null
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "insert",
            "overwrite",
            "new_track",
            "reject",
            null
          ],
          "description": "Default: `insert` on the main track, else `reject`.",
          "default": null
        },
        "ripple_all_tracks": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Ripples reach every track.",
          "default": null
        },
        "fine": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Audio sample grid.",
          "default": null
        }
      },
      "description": "Moves items to a new start (`start`, or `delta` from where the first one is), optionally\nonto another track of the same kind and sequence. Give `item`, or `items` (the first is the\nprimary; the others keep their offsets to it). Linked partners move by the same amount on\ntheir own tracks (`unlink: true` moves only the given items and takes them out of their\ngroups). On the magnetic main track the space an item leaves closes, and an item moved onto\nit is inserted (default; the start is read after the lift and clamped to the track's end).\nElsewhere an overlap is `Invalid` by default; `mode` (or its alias `overlap`) picks\n`new_track`, `overwrite` or `insert`. Children attached to a moved item follow it. Times\nsnap to the frame grid (`fine: true`: the audio sample grid, audio-only moves).",
      "title": "ItemMove"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
