                  },
                  "source_in": {
                    "description": "Its `source_in` now (`0` for items that play no media).",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "start",
                  "duration",
                  "source_in"
                ]
