---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "item.move",
    "summary": "Move items in time and/or to another track (linked partners follow; the main track stays gap-free)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item to move (give `item` or `items`).",
          "default": null
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Several items to move; the first is the primary.",
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "New start of the primary item, `>= 0` (give `start` or `delta`).",
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Offset from the primary item's start (negative: earlier; use seconds or flicks).",
          "default": null
        },
        "to_track": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^trk_[0-9a-f]{32}$",
          "description": "Target track for the primary's track's items, of the same sequence and kind (default:\nstay).",
          "default": null
        },
        "unlink": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Move only the given items and take them out of their linked groups (default `false`).",
          "default": null
        },
        "overlap": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "reject",
                  "description": "Fail with `Invalid` (default on free tracks)."
                },
                {
                  "type": "string",
                  "const": "new_track",
                  "description": "Create a new track of the same kind directly above the target and place there."
                }
              ],
              "description": "What to do when an item would overlap another one on its target track: the P1 `overlap`\nparam, an alias of the placement `mode` (spec INV-40)."
            },
            {
              "type": "null"
            }
          ],
          "description": "Overlap handling, the P1 alias of `mode` (`reject` or `new_track`).",
          "default": null
        },
        "mode": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "insert",
                  "description": "Split the item under the start, ripple the rest of the track (and its partners' tracks)\nlater by the placed length, then place (default on the magnetic main track)."
                },
                {
                  "type": "string",
                  "const": "overwrite",
                  "description": "Cut the range out of the track (trimming or splitting what is there), then place. Nothing\nripples."
                },
                {
                  "type": "string",
                  "const": "new_track",
                  "description": "Place on the target track if the range is free, otherwise on a new track of the same\nkind directly above it."
                },
                {
                  "type": "string",
                  "const": "reject",
                  "description": "Place if the range is free, otherwise fail with `Invalid` naming the item in the way\n(default on free tracks)."
                }
              ],
              "description": "How a placement treats what is already on the target range (timeline spec §3.6)."
            },
            {
              "type": "null"
            }
          ],
          "description": "Placement mode: `insert`, `overwrite`, `new_track` or `reject` (default `insert` on the\nmagnetic main track, `reject` elsewhere).",
          "default": null
        },
        "ripple_all_tracks": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Ripple every track of the sequence when the magnetic track closes or opens (default\n`false`).",
          "default": null
        },
        "fine": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Snap to the audio sample grid instead of frames; only for audio items not linked to\nvideo (default `false`).",
          "default": null
        }
      },
      "description": "Moves items to a new start (`start`, or `delta` from where the first one is), optionally\nonto another track of the same kind and sequence. Give `item`, or `items` (the first is the\nprimary; the others keep their offsets to it). Linked partners move by the same amount on\ntheir own tracks (`unlink: true` moves only the given items and takes them out of their\ngroups). On the magnetic main track the space an item leaves closes, and an item moved onto\nit is inserted (default; the start is read after the lift and clamped to the track's end).\nElsewhere an overlap is `Invalid` by default; `mode` (or its alias `overlap`) picks\n`new_track`, `overwrite` or `insert`. Children attached to a moved item follow it. Times\nsnap to the frame grid (`fine: true`: the audio sample grid, audio-only moves).",
      "title": "ItemMove"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "description": "Where one item ended up.",
            "type": "object",
            "properties": {
              "item": {
                "description": "The item.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "track": {
                "description": "The track it is on now.",
                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "start": {
                "description": "Its new start.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "required": [
              "item",
              "track",
              "start"
            ]
          },
          "description": "The moved items: the given ones in order, each followed by its linked partners."
        },
        "created_tracks": {
          "type": "array",
          "items": {
            "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^trk_[0-9a-f]{32}$"
          },
          "description": "Tracks created by the placement, in creation order."
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "New items, other than the right halves of splits."
            },
            "removed": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "Items that no longer exist."
            },
            "split": {
              "type": "array",
              "items": {
                "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                "type": "object",
                "properties": {
                  "left": {
                    "description": "The left half (keeps the original ID).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "right": {
                    "description": "The right half (new).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "at": {
                    "description": "The cut time.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "left",
                  "right",
                  "at"
                ]
              },
              "description": "Splits, sorted by `(left, at)`."
            },
            "moved": {
              "type": "array",
              "items": {
                "description": "An item whose track or start changed (duration and source did not).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "track": {
                    "description": "Its track now.",
                    "type": "string",
                    "pattern": "^trk_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "track",
                  "start"
                ]
              },
              "description": "Items whose track or start changed."
            },
            "trimmed": {
              "type": "array",
              "items": {
                "description": "An item whose duration or `source_in` changed (its start may have too).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "duration": {
                    "description": "Its duration now.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "source_in": {
                    "description": "Its `source_in` now (`0` for items that play no media).",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "start",
                  "duration",
                  "source_in"
                ]
              },
              "description": "Items whose duration or source position changed."
            },
            "relinked": {
              "type": "array",
              "items": {
                "description": "An item whose `linked_group` or `attached_to` changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "linked_group": {
                    "description": "Its linked group now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^grp_[0-9a-f]{32}$"
                  },
                  "attached_to": {
                    "description": "The item it is attached to now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^itm_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "linked_group",
                  "attached_to"
                ]
              },
              "description": "Items whose link or attachment changed."
            },
            "replaced": {
              "type": "array",
              "items": {
                "description": "An item whose media changed (`clip.replace`).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "media": {
                    "description": "Its media now.",
                    "type": "string",
                    "pattern": "^med_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "media"
                ]
              },
              "description": "Items whose media changed."
            },
            "toggled": {
              "type": "array",
              "items": {
                "description": "An item whose `enabled` flag changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "enabled": {
                    "description": "Its flag now.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "enabled"
                ]
              },
              "description": "Items whose `enabled` flag changed."
            },
            "created_tracks": {
              "type": "array",
              "items": {
                "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "description": "Tracks created, in creation order."
            }
          },
          "required": [
            "created",
            "removed",
            "split",
            "moved",
            "trimmed",
            "relinked",
            "replaced",
            "toggled",
            "created_tracks"
          ],
          "description": "What changed (timeline spec §3.1)."
        }
      },
      "required": [
        "items",
        "created_tracks",
        "report"
      ],
      "description": "Result of `item.move`.",
      "title": "ItemMoveOutput"
    }
