                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "start": {
                "description": "Its new start.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
