{
  "meta": {
    "name": "export.start",
    "summary": "Export a sequence to a video file (H.264, HEVC, AV1, ProRes) as a background job; returns job_id",
    "kind": "engine",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "journaled": false,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "Sequence; optional when the project has one.",
          "default": null
        },
        "path": {
          "type": "string",
          "description": "Absolute path of the output file (`.mp4`; `.mov` for ProRes presets)."
        },
        "range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "const": "sequence",
                      "description": "The whole sequence."
                    },
                    {
                      "type": "string",
                      "const": "in_out",
                      "description": "Between the sequence's in and out points."
                    },
                    {
                      "type": "string",
                      "const": "custom",
                      "description": "`in` to `out`."
                    },
                    {
                      "type": "string",
                      "const": "markers",
                      "description": "One file per marker."
                    }
                  ],
                  "description": "Which part of the sequence to export."
                },
                {
                  "type": "null"
                }
              ],
              "description": "\"sequence\", \"in_out\", \"custom\" or \"markers\" (default: from the other fields).",
              "default": null
            },
            "in": {
              "anyOf": [
                {
                  "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Custom start: flicks, \"2.5s\", \"f:60\" or a timecode.",
              "default": null
            },
            "out": {
              "anyOf": [
                {
                  "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Custom end, exclusive: at most the sequence end.",
              "default": null
            },
            "markers": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "description": "A Marker id: `^mrk_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^mrk_[0-9a-f]{32}$"
              },
              "description": "Marker kind: the markers to export (default: all of the sequence's markers).",
              "default": null
            },
            "pair_mode": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "string",
                      "const": "duration",
                      "description": "Each marker's own `duration` (the default)."
                    },
                    {
                      "type": "string",
                      "const": "pairs",
                      "description": "Each marker to the next one."
                    }
                  ],
                  "description": "How markers become regions."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Marker kind: \"duration\" (default; each marker's own duration) or \"pairs\" (each marker to\nthe next).",
              "default": null
            }
          },
          "description": "Part of the sequence to export (default: all of it): {kind: \"sequence\" | \"in_out\" |\n\"custom\" | \"markers\", in, out, markers: [ids], pair_mode: \"duration\" | \"pairs\"}.",
          "default": null
        },
        "preset": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "const": "h264-mp4-1080p",
                  "description": "MP4, H.264 + AAC, fit into 1920x1080 (1080x1920 portrait), not upscaled, high quality."
                },
                {
                  "type": "object",
                  "properties": {
                    "custom": {
                      "description": "Custom output settings; absent fields take the sequence's value (quality: high).",
                      "type": "object",
                      "properties": {
                        "width": {
                          "description": "Frame width in pixels: even, 16-8192.",
                          "type": [
                            "integer",
                            "null"
                          ],
                          "format": "uint32",
                          "minimum": 0,
                          "default": null
                        },
                        "height": {
                          "description": "Frame height in pixels: even, 16-8192.",
                          "type": [
                            "integer",
                            "null"
                          ],
                          "format": "uint32",
                          "minimum": 0,
                          "default": null
                        },
                        "fps": {
                          "description": "Frame rate, e.g. {\"num\": 30, \"den\": 1}: at most 240 fps, a whole number of flicks per\nframe.",
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "num": {
                              "description": "Frames.",
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 4294967295
                            },
                            "den": {
                              "description": "Seconds.",
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 4294967295
                            }
                          },
                          "required": [
                            "num",
                            "den"
                          ],
                          "additionalProperties": false,
                          "default": null
                        },
                        "quality": {
                          "description": "\"low\", \"medium\" or \"high\".",
                          "anyOf": [
                            {
                              "description": "How hard the encoder works for picture quality (and file size).",
                              "oneOf": [
                                {
                                  "description": "Small files, visible compression.",
                                  "type": "string",
                                  "const": "low"
                                },
                                {
                                  "description": "Balanced.",
                                  "type": "string",
                                  "const": "medium"
                                },
                                {
                                  "description": "Close to the original (the default).",
                                  "type": "string",
                                  "const": "high"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null
                        },
                        "preset": {
                          "description": "Base preset id; the other fields replace its values.",
                          "type": [
                            "string",
                            "null"
                          ],
                          "default": null
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "custom"
                  ],
                  "additionalProperties": false,
                  "description": "MP4, H.264 + AAC at a custom size, frame rate and quality."
                },
                {
                  "type": "string",
                  "description": "A preset id (export.list_presets)."
                }
              ],
              "description": "What to make: the preset, or custom settings."
            },
            {
              "type": "null"
            }
          ],
          "description": "\"h264-mp4-1080p\" (default), a preset id (\"youtube-1080p\") or {\"custom\": {width, height,\nfps, quality, preset}}.",
          "default": null
        },
        "hw": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "auto",
                  "description": "The first hardware encoder of the codec that works here (`export.list_encoders`), else\nsoftware; if it fails during the export, the export starts again in software."
                },
                {
                  "type": "string",
                  "const": "off",
                  "description": "Software (x264, x265, SVT-AV1) only."
                },
                {
                  "type": "object",
                  "properties": {
                    "force": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "force"
                  ],
                  "additionalProperties": false,
                  "description": "This hardware encoder and no other, e.g. \"hevc_nvenc\" (the `implementation` names of\nthe machine's hardware encoders, `export.list_encoders`); fails instead of falling back."
                }
              ],
              "description": "Whether to use a hardware video encoder."
            },
            {
              "type": "null"
            }
          ],
          "description": "Hardware encoder: \"auto\" (default), \"off\", or {\"force\": \"hevc_nvenc\"}.",
          "default": null
        },
        "overwrite": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Replace an existing file at `path` (default false); same as `collision: \"overwrite\"`.",
          "default": null
        },
        "collision": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "rename",
                  "description": "Pick a free name (`name (1).mp4`)."
                },
                {
                  "type": "string",
                  "const": "overwrite",
                  "description": "Replace the file once the export has succeeded."
                },
                {
                  "type": "string",
                  "const": "fail",
                  "description": "Refuse (the default)."
                }
              ],
              "description": "What to do when the output file exists."
            },
            {
              "type": "null"
            }
          ],
          "description": "An existing file: \"fail\" (default), \"rename\" or \"overwrite\".",
          "default": null
        },
        "allow_offline": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Export although media files are missing: their clips show a \"media offline\" slate and\nare silent (default false: fails with `Invalid` at `/media/<id>` naming them).",
          "default": null
        },
        "advanced": {
          "type": [
            "object",
            "null"
          ],
          "description": "Fine control (export.describe_options{codec} gives a codec's options as a JSON Schema):\nvideo{rate_control{mode crf|cbr|vbr|cq, crf, bitrate_kbps, max_bitrate_kbps, buffer_kbit},\ngop{keyint|keyint_seconds, keyint_min, bframes, closed_gop, scenecut}, preset, tune,\nprofile, level, pix_fmt, threads}, color{primaries, transfer, matrix, range, tag_only},\naudio{codec, bitrate_kbps, sample_rate, channels}. Impossible combinations fail with\nInvalid and a hint.",
          "properties": {
            "video": {
              "type": "object"
            },
            "color": {
              "type": "object"
            },
            "audio": {
              "type": "object"
            }
          },
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "description": "Exports a sequence (or a range of it) to a file (MP4, H.264 + AAC by default; a preset id\npicks HEVC, AV1 or ProRes) as a background job and returns the job id at once; wait with\n`job.wait`, stop with `job.cancel` (the partial file is deleted). Exports queue and run one at a time; this one\nalso resumes a paused queue (`export.queue` lists it). The export uses the project as it is\nnow; later edits do not change it. Agents and headless callers may only write inside the\nproject folder and folders the user approved. `range.kind` picks the part: \"sequence\",\n\"in_out\" (the sequence's in/out points), \"custom\" (`in`, `out`) or \"markers\" (one file per\nmarker: `path` is a folder or a name template ending in the container's extension (.mp4;\n.mov for ProRes) with {seq}, {marker_label}, {n}; the\noutput lists every job). `collision` says what happens to an existing file: \"fail\"\n(default), \"rename\" (pick a free name) or \"overwrite\" (replace it when the export\nsucceeds). Fails with `Invalid` when the drive has too little free space, and with `Invalid`\nat `/media/<id>` when a clip in the range plays a media file that is missing, unless\n`allow_offline` is true (such clips then show a \"media offline\" slate and are silent).",
      "title": "ExportStart"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$",
          "description": "The export job: follow it with `job.wait` or `job.status`, stop it with `job.cancel`."
