                          "null"
                        ],
                        "properties": {
                          "num": {
                            "description": "Frames.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          },
                          "den": {
                            "description": "Seconds.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "additionalProperties": false,
                        "default": null
                      },
                      "quality": {
                        "description": "\"low\", \"medium\" or \"high\".",
                        "anyOf": [
                          {
                            "description": "How hard the encoder works for picture quality (and file size).",
                            "oneOf": [
                              {
                                "description": "Small files, visible compression.",
                                "type": "string",
                                "const": "low"
                              },
                              {
                                "description": "Balanced.",
                                "type": "string",
                                "const": "medium"
                              },
                              {
                                "description": "Close to the original (the default).",
                                "type": "string",
                                "const": "high"
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null
                      },
                      "preset": {
                        "description": "Base preset id; the other fields replace its values.",
                        "type": [
                          "string",
                          "null"
                        ],
                        "default": null
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "custom"
                ],
                "additionalProperties": false,
                "description": "MP4, H.264 + AAC at a custom size, frame rate and quality."
              },
              {
                "type": "string",
                "description": "A preset id (export.list_presets)."
              }
            ],
            "description": "What to make: the preset, or custom settings."
          },
          {
            "type": "null"
          }
        ],
        "description": "\"h264-mp4-1080p\" (default), a preset id (\"youtube-1080p\") or {\"custom\": {width, height,\nfps, quality, preset}}.",
        "default": null
      },
      "hw": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "string",
                "const": "auto",
                "description": "The first hardware encoder of the codec that works here (`export.list_encoders`), else\nsoftware; if it fails during the export, the export starts again in software."
              },
              {
                "type": "string",
                "const": "off",
                "description": "Software (x264, x265, SVT-AV1) only."
              },
              {
                "type": "object",
                "properties": {
                  "force": {
                    "type": "string"
                  }
                },
                "required": [
                  "force"
                ],
                "additionalProperties": false,
                "description": "This hardware encoder and no other, e.g. \"hevc_nvenc\" (the `implementation` names of\nthe machine's hardware encoders, `export.list_encoders`); fails instead of falling back."
              }
            ],
            "description": "Whether to use a hardware video encoder."
          },
          {
            "type": "null"
          }
        ],
        "description": "Hardware encoder: \"auto\" (default), \"off\", or {\"force\": \"hevc_nvenc\"}.",
        "default": null
      },
      "overwrite": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Replace an existing file at `path` (default false); same as `collision: \"overwrite\"`.",
        "default": null
      },
      "collision": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "string",
                "const": "rename",
                "description": "Pick a free name (`name (1).mp4`)."
              },
              {
                "type": "string",
                "const": "overwrite",
                "description": "Replace the file once the export has succeeded."
              },
              {
                "type": "string",
                "const": "fail",
                "description": "Refuse (the default)."
              }
            ],
            "description": "What to do when the output file exists."
          },
          {
            "type": "null"
          }
        ],
        "description": "An existing file: \"fail\" (default), \"rename\" or \"overwrite\".",
        "default": null
      },
      "allow_offline": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Export although media files are missing: their clips show a \"media offline\" slate and\nare silent (default false: fails with `Invalid` at `/media/<id>` naming them).",
        "default": null
      },
      "advanced": {
        "type": [
          "object",
          "null"
        ],
        "description": "Fine control (export.describe_options{codec} gives a codec's options as a JSON Schema):\nvideo{rate_control{mode crf|cbr|vbr|cq, crf, bitrate_kbps, max_bitrate_kbps, buffer_kbit},\ngop{keyint|keyint_seconds, keyint_min, bframes, closed_gop, scenecut}, preset, tune,\nprofile, level, pix_fmt, threads}, color{primaries, transfer, matrix, range, tag_only},\naudio{codec, bitrate_kbps, sample_rate, channels}. Impossible combinations fail with\nInvalid and a hint.",
        "properties": {
          "video": {
            "type": "object"
          },
          "color": {
            "type": "object"
          },
          "audio": {
            "type": "object"
          }
        },
        "default": null
      }
    },
    "required": [
      "path"
    ],
    "description": "Exports a sequence (or a range of it) to a file (MP4, H.264 + AAC by default; a preset id\npicks HEVC, AV1 or ProRes) as a background job and returns the job id at once; wait with\n`job.wait`, stop with `job.cancel` (the partial file is deleted). Exports queue and run one at a time; this one\nalso resumes a paused queue (`export.queue` lists it). The export uses the project as it is\nnow; later edits do not change it. Agents and headless callers may only write inside the\nproject folder and folders the user approved. `range.kind` picks the part: \"sequence\",\n\"in_out\" (the sequence's in/out points), \"custom\" (`in`, `out`) or \"markers\" (one file per\nmarker: `path` is a folder or a name template ending in the container's extension (.mp4;\n.mov for ProRes) with {seq}, {marker_label}, {n}; the\noutput lists every job). `collision` says what happens to an existing file: \"fail\"\n(default), \"rename\" (pick a free name) or \"overwrite\" (replace it when the export\nsucceeds). Fails with `Invalid` when the drive has too little free space, and with `Invalid`\nat `/media/<id>` when a clip in the range plays a media file that is missing, unless\n`allow_offline` is true (such clips then show a \"media offline\" slate and are silent).",
    "title": "ExportStart"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "job_id": {
        "type": "string",
        "pattern": "^job_[0-9a-f]{32}$",
        "description": "The export job: follow it with `job.wait` or `job.status`, stop it with `job.cancel`."
      },
      "path": {
        "type": "string",
        "description": "The output file."
      },
      "sequence": {
        "type": "string",
        "pattern": "^seq_[0-9a-f]{32}$",
        "description": "The exported sequence."
      },
      "in": {
        "description": "Exported range start (sequence time, flicks).",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "out": {
        "description": "Exported range end, exclusive.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "width": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "description": "Frame width in pixels."
      },
      "height": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "description": "Frame height in pixels."
      },
      "frame_rate": {
        "description": "Frame rate of the file.",
        "type": "object",
        "properties": {
          "num": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Frames."
          },
          "den": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Seconds."
          }
        },
        "required": [
          "num",
          "den"
        ],
        "additionalProperties": false
      },
      "frames": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "description": "Video frames the file will hold."
      },
      "duration": {
        "description": "Length of the file.",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "rev": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0,
        "description": "The document revision exported (edits made later are not in the file)."
      },
      "warnings": {
        "type": "array",
        "items": {
          "description": "One warning about a preset on a sequence.",
          "type": "object",
          "properties": {
            "code": {
              "description": "What kind.",
              "oneOf": [
                {
                  "description": "The sequence's aspect is not the preset's.",
                  "type": "string",
                  "const": "AspectMismatch"
                },
                {
                  "description": "The exported part is longer than the platform accepts.",
                  "type": "string",
                  "const": "DurationOverLimit"
                },
                {
                  "description": "The estimated file is larger than the platform accepts.",
                  "type": "string",
                  "const": "SizeOverLimit"
                },
                {
                  "description": "The sequence's frame rate is above the platform's maximum, so the file uses a lower one.",
                  "type": "string",
                  "const": "FrameRateCapped"
                },
                {
                  "description": "An advanced setting needs the software encoder, so the export does not use the hardware one.",
                  "type": "string",
                  "const": "SoftwareEncoder"
                }
              ]
            },
            "message": {
              "description": "A sentence for the person.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ]
        },
        "description": "Platform-limit and fit warnings of a preset (never errors; the export runs)."
      },
      "estimated_kib": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint32",
        "minimum": 0,
        "description": "Estimated file size in KiB when the rate control fixes a bitrate (`vbr`, `cbr`, a\nbitrate preset); absent for a quality (`crf`)."
      },
      "jobs": {
        "type": "array",
        "items": {
          "description": "One file of a marker-set export.",
          "type": "object",
          "properties": {
            "job_id": {
              "description": "Its export job.",
              "type": "string",
              "pattern": "^job_[0-9a-f]{32}$"
            },
            "path": {
              "description": "The output file (after `rename`).",
              "type": "string"
            },
            "label": {
              "description": "The marker's label.",
              "type": "string"
            },
            "in": {
              "description": "Range start (sequence time, flicks).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "out": {
              "description": "Range end, exclusive.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "frames": {
              "description": "Video frames the file will hold.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "duration": {
              "description": "Length of the file.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false,
          "required": [
            "job_id",
            "path",
            "label",
            "in",
            "out",
            "frames",
            "duration"
          ]
        },
        "description": "Every export of a marker set, in time order (empty for any other range). The fields\nabove describe the first of them."
      }
    },
    "required": [
      "job_id",
      "path",
      "sequence",
      "in",
      "out",
      "width",
      "height",
      "frame_rate",
      "frames",
      "duration",
      "rev",
      "warnings"
    ],
    "description": "Result of `export.start`: the job and what it will write.",
    "title": "ExportStartOutput"
  }
}
