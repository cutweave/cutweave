---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "job.wait",
    "summary": "Wait up to timeout_ms (max 60 s) for a background job to finish; returns its state",
    "kind": "engine",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$",
          "description": "The job."
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "How long to wait in milliseconds (default 30000; values above 60000 are capped; 0\nreturns the current state).",
          "default": null
        }
      },
      "required": [
        "job_id"
      ],
      "description": "Waits for a background job to finish, at most `timeout_ms` (default 30 s, capped at 60 s),\nand returns its state: at once for a finished job, as soon as it finishes, or still\n`queued`/`running` with its progress when the time is up (call again to keep waiting).",
      "title": "JobWait"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$",
          "description": "The job."
        },
        "kind": {
          "oneOf": [
            {
              "type": "string",
              "const": "analysis",
              "description": "Background analysis of an imported asset (index, thumbnails, waveform): decodes media."
            },
            {
              "type": "string",
              "const": "export",
              "description": "Rendering and encoding a sequence to a file (WP-1E.03)."
            },
            {
              "type": "string",
              "const": "proxy",
              "description": "Making a media asset's proxy (WP-2F.01): decodes the original and encodes a smaller\nintra-frame copy."
            },
            {
              "type": "string",
              "const": "collect",
              "description": "Copying a project's files into another folder (WP-2F.04): disk work, no decoding."
            }
          ],
          "description": "What kind of work it is."
        },
        "label": {
          "type": "string",
          "description": "What it does, e.g. the analysis stage (`index`, `thumbnails`, `waveform`)."
        },
        "media_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "The media asset it works on, if any."
        },
        "state": {
          "oneOf": [
            {
              "type": "string",
              "const": "queued",
              "description": "Waiting for the jobs it depends on or for a budget slot."
            },
            {
              "type": "string",
              "const": "running",
              "description": "Running."
            },
            {
              "type": "string",
              "const": "succeeded",
              "description": "Finished its work."
            },
            {
              "type": "string",
              "const": "failed",
              "description": "Stopped with an error (see `error`), or skipped because a job it needs failed."
            },
            {
              "type": "string",
              "const": "cancelled",
              "description": "Cancelled before or while running."
            }
          ],
          "description": "Where it is in its lifecycle."
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fraction": {
              "type": "number",
              "format": "double",
              "description": "Done fraction, `0..=1` (1 once the job succeeded)."
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "description": "What it is doing, for status lines."
            },
            "frame": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Units done so far (an export: frames handed to the encoder)."
            },
            "frames": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Units in all (an export: frames in the file)."
            },
            "fps": {
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "description": "Speed in units per second."
            },
            "eta_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Estimated time left, in milliseconds."
            },
            "bytes": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "description": "Bytes written so far."
            }
          },
          "required": [
            "fraction",
            "message"
          ],
          "description": "How far it got."
        },
        "cancel_requested": {
          "type": "boolean",
          "description": "Whether cancellation was requested; a running job stops when it next checks."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it failed, was skipped or was cancelled."
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "media_id",
        "state",
        "progress",
        "cancel_requested",
        "error"
      ],
      "description": "A job as reported by `job.status`, `job.list`, `job.wait`, `job.cancel` and the\n`job.progress` event.",
      "title": "JobInfo"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "job_id": {
        "type": "string",
        "pattern": "^job_[0-9a-f]{32}$",
        "description": "The job."
      },
      "timeout_ms": {
        "type": [
          "integer",
          "null"
        ],
        "format": "uint32",
        "minimum": 0,
        "description": "How long to wait in milliseconds (default 30000; values above 60000 are capped; 0\nreturns the current state).",
        "default": null
      }
    },
    "required": [
      "job_id"
    ],
    "description": "Waits for a background job to finish, at most `timeout_ms` (default 30 s, capped at 60 s),\nand returns its state: at once for a finished job, as soon as it finishes, or still\n`queued`/`running` with its progress when the time is up (call again to keep waiting).",
    "title": "JobWait"
  },
  "output": {
