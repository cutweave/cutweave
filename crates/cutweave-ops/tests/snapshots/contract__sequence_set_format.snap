---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "sequence.set_format",
    "summary": "Change a sequence's size, frame rate, sample rate or background",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Canvas width in pixels, `1..=16384`.",
          "default": null
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Canvas height in pixels, `1..=16384`.",
          "default": null
        },
        "frame_rate": {
          "description": "The edit grid.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "description": "Frames."
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295,
              "description": "Seconds."
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false,
          "default": null
        },
        "sample_rate": {
          "description": "The mix rate in Hz.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 352800000,
          "default": null
        },
        "background": {
          "description": "Canvas color, `#rrggbb`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "default": null
        },
        "reframe": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "keep_scale",
                  "description": "Keep each clip's pixel size and pixel offset from the centre."
                },
                {
                  "type": "string",
                  "const": "fit",
                  "description": "Scale the composition to sit whole inside the new canvas."
                },
                {
                  "type": "string",
                  "const": "fill",
                  "description": "Scale the composition to cover the new canvas."
                },
                {
                  "type": "string",
                  "const": "none",
                  "description": "Leave transforms alone."
                }
              ],
              "description": "How clip transforms follow a new canvas (see the module docs)."
            },
            {
              "type": "null"
            }
          ],
          "description": "How clips follow a new canvas size (default `fit`).",
          "default": null
        }
      },
      "required": [
        "sequence"
      ],
      "description": "Changes a sequence's canvas size, frame rate, sample rate or background (absent fields stay).\nA new canvas size reframes every video clip by `reframe` (default `fit`: the whole composition\nshrinks to sit inside the new canvas; `fill` covers it; `keep_scale` keeps pixel sizes;\n`none` leaves transforms). A new frame rate moves every item edge to the nearest frame of\nthe new grid without creating overlaps or gaps. Fails with `Locked` if a locked track holds\nitems this would change.",
      "title": "SequenceSetFormat"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "format": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas width in pixels."
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas height in pixels."
            },
            "frame_rate": {
              "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "sample_rate": {
              "description": "The mix rate.",
              "type": "integer",
              "minimum": 1,
              "maximum": 352800000
            },
            "color_space": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "rec709",
                  "description": "Rec.709 primaries, SDR."
                }
              ],
              "description": "Working color space."
            },
            "background": {
              "description": "Canvas color behind all tracks.",
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "background_fill": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "blur"
                        },
                        "source": {
                          "oneOf": [
                            {
                              "type": "string",
                              "const": "below",
                              "description": "The lowest picture showing at that time."
                            },
                            {
                              "type": "string",
                              "const": "main_track",
                              "description": "The picture on the main track (the magnetic track; without one, the lowest video\ntrack)."
                            }
                          ],
                          "description": "Which picture is blurred.",
                          "default": "below"
                        },
                        "radius": {
                          "type": "number",
                          "format": "double",
                          "description": "The blur's standard deviation as a fraction of the canvas height, `0..=1`, so\npreview and export blur alike at any size."
                        },
                        "dim": {
                          "type": "number",
                          "format": "double",
                          "description": "How much of the blurred picture's light is taken away, `0..=1` (0: none, 1: black).",
                          "default": 0.0
                        }
                      },
                      "required": [
                        "kind",
                        "source",
                        "radius",
                        "dim"
                      ],
                      "description": "A blurred copy of a picture of the sequence, scaled to cover the canvas. Where no such\npicture shows, the color does."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "image"
                        },
                        "media": {
                          "type": "string",
                          "pattern": "^med_[0-9a-f]{32}$",
                          "description": "The image asset."
                        },
                        "fit": {
                          "oneOf": [
                            {
                              "type": "string",
                              "const": "cover",
                              "description": "Fills the canvas, cropping what does not fit."
                            },
                            {
                              "type": "string",
                              "const": "contain",
                              "description": "The whole image inside the canvas; the color shows around it."
                            },
                            {
                              "type": "string",
                              "const": "stretch",
                              "description": "Stretched to the canvas, changing its shape."
                            }
                          ],
                          "description": "How the image is sized to the canvas.",
                          "default": "cover"
                        }
                      },
                      "required": [
                        "kind",
                        "media",
                        "fit"
                      ],
                      "description": "A still image of the project. An image that no longer exists draws nothing."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "transparent"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "description": "Nothing: the canvas starts fully transparent and the color is not drawn. Only exports\nthat keep alpha show it; the others see black."
                    }
                  ],
                  "description": "What fills a sequence's canvas behind all tracks, over its `background` color (WP-2B.02).\nIt is static: a background has no keyframes."
                },
                {
                  "type": "null"
                }
              ],
              "description": "What fills the canvas over that color, behind all tracks (WP-2B.02). Absent: the color\nalone. Left out of the file while absent, so documents without one read as before."
            }
          },
          "required": [
            "width",
            "height",
            "frame_rate",
            "sample_rate",
            "color_space",
            "background"
          ],
          "description": "Its format now."
        },
        "reframed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Clips whose position or scale changed to follow the new canvas."
        },
        "retimed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Items whose start or length moved to the new frame grid."
        }
      },
      "required": [
        "sequence",
        "format",
        "reframed",
        "retimed"
      ],
      "description": "Result of `sequence.set_format`.",
      "title": "SequenceSetFormatOutput"
    }
  },
