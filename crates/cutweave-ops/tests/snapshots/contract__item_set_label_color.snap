            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "The items."
        },
        "color": {
          "description": "`#rrggbb`; leave out (or null) to clear the label.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "default": null
        }
      },
      "required": [
        "items"
      ],
      "description": "Sets the color label of items, or clears it when `color` is left out. Only the listed\nitems change (name linked partners to label them too). `Locked` on a locked track.",
      "title": "ItemSetLabelColor"
    },
