{
  "meta": {
    "name": "item.set_label_color",
    "summary": "Set or clear the color label of items",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
