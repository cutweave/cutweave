{
  "meta": {
    "name": "media.set_analysis_error",
    "summary": "Record or clear a background analysis failure on a media asset (internal)",
    "kind": "command",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "hidden",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "The asset."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "What failed (1..=500 characters), or absent to clear it.",
          "default": null
        }
      },
      "required": [
        "media_id"
      ],
      "description": "Records (or, with no `error`, clears) the failure of a background analysis stage on a\nmedia asset, so the UI can show a badge. Internal plumbing of the analysis jobs, applied by\nthe engine as the `system` actor; not undoable (it reports, it does not edit).",
      "title": "MediaSetAnalysisError"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "type": "string",
          "pattern": "^med_[0-9a-f]{32}$",
          "description": "The asset."
        }
      },
      "required": [
        "media_id"
      ],
      "description": "Result of `media.set_analysis_error`.",
      "title": "AnalysisErrorSet"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media_id": {
        "type": "string",
        "pattern": "^med_[0-9a-f]{32}$",
        "description": "The asset."
      },
      "error": {
        "type": [
          "string",
          "null"
        ],
        "description": "What failed (1..=500 characters), or absent to clear it.",
        "default": null
      }
    },
    "required": [
      "media_id"
    ],
    "description": "Records (or, with no `error`, clears) the failure of a background analysis stage on a\nmedia asset, so the UI can show a badge. Internal plumbing of the analysis jobs, applied by\nthe engine as the `system` actor; not undoable (it reports, it does not edit).",
    "title": "MediaSetAnalysisError"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
