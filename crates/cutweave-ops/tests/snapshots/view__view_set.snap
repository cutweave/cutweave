                  "pattern": "^seq_[0-9a-f]{32}$"
                }
              },
              "required": [
                "kind",
                "id"
              ]
            }
          ]
        },
        "description": "Selected entities, in selection order, without duplicates. Every ID existed when it was\nselected; IDs that no longer exist are dropped."
      },
      "panel_layout": {
        "description": "Dock/panel layout. Opaque to the engine (owned by the UI); `null` until the UI sets it."
      },
      "preview_quality": {
        "oneOf": [
          {
            "type": "string",
            "const": "full",
            "description": "Full resolution."
          },
          {
            "type": "string",
            "const": "half",
            "description": "Half resolution."
          },
          {
            "type": "string",
            "const": "quarter",
            "description": "Quarter resolution."
          }
        ],
        "description": "Preview resolution."
      },
      "master_gain": {
        "type": "number",
        "format": "double",
        "description": "Master output gain (linear, `0..=4`, 1 = unity)."
      },
      "active_sequence": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^seq_[0-9a-f]{32}$",
        "description": "The sequence the editor shows (WP-2B.01). `None` until one is chosen: the editor then\nshows the first sequence. Never names a sequence that no longer exists."
      },
      "source_marks": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^med_[0-9a-f]{32}$": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "in": {
                "description": "The in mark (`>= 0`); a placement starts at the start of the media without it.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "out": {
                "description": "The out mark (exclusive, `> in`); a placement runs to the end of the media without it.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "in",
              "out"
            ],
            "description": "The in and out marks of one media asset in the Source view (WP-2A.14, timeline spec §4.18):\npositions in the media's own time. At least one is set; with both, `out` is after `in`."
          }
        },
        "description": "In and out marks per media asset, set in the Source view (WP-2A.14). Only assets that\nhave a mark are listed; marks of removed assets are dropped."
      }
    },
    "required": [
      "playhead",
      "zoom",
      "scroll",
      "selection",
      "panel_layout",
      "preview_quality",
      "master_gain",
      "active_sequence",
      "source_marks"
    ],
    "description": "The UI view state of a project (arch §5.1). Persisted in `.cutweave/ui-state.json`.",
    "title": "UiState"
  }
}
