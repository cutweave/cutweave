                      "id"
                    ]
                  },
                  {
                    "description": "A media asset.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "media"
                      },
                      "id": {
                        "description": "The asset.",
                        "type": "string",
                        "pattern": "^med_[0-9a-f]{32}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  },
                  {
                    "description": "A sequence.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "sequence"
                      },
                      "id": {
                        "description": "The sequence.",
                        "type": "string",
                        "pattern": "^seq_[0-9a-f]{32}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  }
                ]
              },
              "description": "New selection (replaces the whole selection; every ID must exist).",
              "default": null
            },
