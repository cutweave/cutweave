{
  "meta": {
    "name": "view.set",
    "summary": "Update the UI view state (partial merge; not undoable)",
    "kind": "engine",
    "undoable": false,
    "view": true,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "playhead": {
              "anyOf": [
                {
                  "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "New playhead (flicks, seconds text; `>= 0`).",
              "default": null
            },
            "zoom": {
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "description": "New zoom in pixels per second.",
              "default": null
            },
            "scroll": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "format": "double",
                  "description": "Horizontal offset, `>= 0`."
                },
                "y": {
                  "type": "number",
                  "format": "double",
                  "description": "Vertical offset, `>= 0`."
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "New scroll offset.",
              "default": null
            },
            "selection": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "description": "One selected entity, by ID (never by index).",
                "oneOf": [
                  {
                    "description": "A timeline item.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "item"
                      },
                      "id": {
                        "description": "The item.",
                        "type": "string",
                        "pattern": "^itm_[0-9a-f]{32}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ]
                  },
                  {
                    "description": "A track.",
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "track"
                      },
