---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.import",
    "summary": "Import media files: probe and register them now, return media ids and analysis job ids",
    "kind": "engine",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Absolute paths of files or folders (1..=256, no repeats)."
        },
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "Bin folder (default: top level).",
          "default": null
        },
        "keep_structure": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "For folders in `paths`: mirror their directories as bin folders (default true); false\nputs every file straight into `folder`.",
          "default": null
        }
      },
      "required": [
        "paths"
      ],
      "description": "Imports media files and returns their `media_ids` at once (arch §7, R21). Each file is\nprobed synchronously (up to 4 at a time, 5 s each by default) and every readable one is\nregistered in one transaction (one undo step); files that are missing, unsupported, corrupt\nor too slow to probe are listed in `failed` and get no asset. Files whose content is\nalready in the project are returned as duplicates. Background analysis (frame index,\nthumbnails, waveform) then runs as jobs whose ids are returned in `job_ids`. Agents and\nheadless callers may only import from the project folder and user-approved folders; any\nother path fails the call with `Invalid` at `/paths/<i>`.\n\nA path may also be a folder (WP-2F.09): the engine imports the files it can read inside it\n(up to 16 levels down, no links, no hidden files, at most 2,000 files per call; more fails\nwith `Invalid`), counts the rest in `skipped`, and with `keep_structure` (default true)\ncreates a bin folder for each directory that holds new media, named after it, inside\n`folder`. One undo removes the media and those folders; files already in the project stay\nwhere they are.",
      "title": "MediaImport"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "items": {
            "description": "One imported file.",
            "type": "object",
            "properties": {
              "path": {
                "description": "The path as requested.",
                "type": "string"
              },
              "media_id": {
                "description": "The asset; an existing one if the same content was imported before.",
                "type": "string",
                "pattern": "^med_[0-9a-f]{32}$"
              },
              "kind": {
                "description": "What the asset is.",
                "oneOf": [
                  {
                    "description": "A video file (may also carry audio).",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "An audio-only file.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "A still image (no duration).",
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                    "type": "string",
                    "const": "sequence_ref"
                  }
                ]
              },
              "duplicate": {
                "description": "`true` when the content was already in the project and nothing was added.",
                "type": "boolean"
              },
              "proxy": {
                "description": "Whether a proxy (a small copy the preview scrubs, WP-2F.01) was queued for it, or is\nalready in the cache.",
                "oneOf": [
                  {
                    "description": "None is made (the policy does not want one, or the file cannot have one).",
                    "type": "string",
                    "const": "none"
                  },
                  {
                    "description": "Its generation is queued (after the asset's analysis); `media.proxy_status` follows it.",
                    "type": "string",
                    "const": "queued"
                  },
                  {
                    "description": "One is already in the cache (the same content was imported before).",
                    "type": "string",
                    "const": "ready"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "media_id",
              "kind",
              "duplicate",
              "proxy"
            ]
          },
          "description": "One entry per imported path, in request order."
        },
        "media_ids": {
          "type": "array",
          "items": {
            "description": "A Media id: `^med_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^med_[0-9a-f]{32}$"
          },
          "description": "The assets of `media`, in the same order (duplicates name the existing asset)."
        },
        "failed": {
          "type": "array",
          "items": {
            "description": "A file that was not imported (no asset was created for it).",
            "type": "object",
            "properties": {
              "path": {
                "description": "The path as requested.",
                "type": "string"
              },
              "code": {
                "description": "Machine-readable reason.",
                "oneOf": [
                  {
                    "description": "There is no readable file at the path.",
                    "type": "string",
                    "const": "not_found"
                  },
                  {
                    "description": "The file holds no playable audio or video.",
                    "type": "string",
                    "const": "unsupported"
                  },
                  {
                    "description": "Probing took longer than the per-file timeout.",
                    "type": "string",
                    "const": "timed_out"
                  },
                  {
                    "description": "Reading the file failed.",
                    "type": "string",
                    "const": "io"
                  },
                  {
                    "description": "The probe result cannot be registered (for example a zero duration).",
                    "type": "string",
                    "const": "invalid"
                  }
                ]
              },
              "error": {
                "description": "Human-readable reason.",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "code",
              "error"
            ]
          },
          "description": "The paths that could not be imported, in request order."
        },
        "job_ids": {
          "type": "array",
          "items": {
            "description": "A job id: `^job_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          },
          "description": "Background analysis jobs queued for the new assets (wait with `job.wait`); empty when\nno analysis stage is installed."
        },
        "skipped": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unsupported": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Files that hold no playable audio, video or picture."
            },
            "unreadable": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Files and folders that could not be read (or whose probe timed out)."
            },
            "too_deep": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Folders nested deeper than 16 levels below the one you gave, which were not entered."
            }
          },
          "required": [
            "unsupported",
            "unreadable",
            "too_deep"
          ],
          "description": "What was left out of the folders in the request."
        },
        "folders": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "How many bin folders were created for the directories of imported folders."
        }
      },
      "required": [
        "media",
        "media_ids",
        "failed",
        "job_ids",
        "skipped",
        "folders"
      ],
      "description": "Result of `media.import`.",
      "title": "MediaImportOutput"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Absolute paths of files or folders (1..=256, no repeats)."
      },
      "folder": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^fld_[0-9a-f]{32}$",
        "description": "Bin folder (default: top level).",
        "default": null
      },
      "keep_structure": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "For folders in `paths`: mirror their directories as bin folders (default true); false\nputs every file straight into `folder`.",
        "default": null
      }
    },
    "required": [
      "paths"
    ],
    "description": "Imports media files and returns their `media_ids` at once (arch §7, R21). Each file is\nprobed synchronously (up to 4 at a time, 5 s each by default) and every readable one is\nregistered in one transaction (one undo step); files that are missing, unsupported, corrupt\nor too slow to probe are listed in `failed` and get no asset. Files whose content is\nalready in the project are returned as duplicates. Background analysis (frame index,\nthumbnails, waveform) then runs as jobs whose ids are returned in `job_ids`. Agents and\nheadless callers may only import from the project folder and user-approved folders; any\nother path fails the call with `Invalid` at `/paths/<i>`.\n\nA path may also be a folder (WP-2F.09): the engine imports the files it can read inside it\n(up to 16 levels down, no links, no hidden files, at most 2,000 files per call; more fails\nwith `Invalid`), counts the rest in `skipped`, and with `keep_structure` (default true)\ncreates a bin folder for each directory that holds new media, named after it, inside\n`folder`. One undo removes the media and those folders; files already in the project stay\nwhere they are.",
    "title": "MediaImport"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media": {
        "type": "array",
        "items": {
          "description": "One imported file.",
          "type": "object",
          "properties": {
            "path": {
              "description": "The path as requested.",
              "type": "string"
            },
            "media_id": {
              "description": "The asset; an existing one if the same content was imported before.",
              "type": "string",
              "pattern": "^med_[0-9a-f]{32}$"
            },
            "kind": {
              "description": "What the asset is.",
              "oneOf": [
                {
                  "description": "A video file (may also carry audio).",
                  "type": "string",
                  "const": "video"
                },
                {
                  "description": "An audio-only file.",
                  "type": "string",
                  "const": "audio"
                },
                {
                  "description": "A still image (no duration).",
                  "type": "string",
                  "const": "image"
                },
                {
                  "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                  "type": "string",
                  "const": "sequence_ref"
                }
              ]
            },
            "duplicate": {
              "description": "`true` when the content was already in the project and nothing was added.",
              "type": "boolean"
            },
            "proxy": {
              "description": "Whether a proxy (a small copy the preview scrubs, WP-2F.01) was queued for it, or is\nalready in the cache.",
              "oneOf": [
                {
                  "description": "None is made (the policy does not want one, or the file cannot have one).",
                  "type": "string",
                  "const": "none"
                },
                {
                  "description": "Its generation is queued (after the asset's analysis); `media.proxy_status` follows it.",
                  "type": "string",
                  "const": "queued"
                },
                {
                  "description": "One is already in the cache (the same content was imported before).",
                  "type": "string",
                  "const": "ready"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "media_id",
            "kind",
            "duplicate",
            "proxy"
          ]
        },
        "description": "One entry per imported path, in request order."
      },
      "media_ids": {
        "type": "array",
        "items": {
          "description": "A Media id: `^med_[0-9a-f]{32}$`.",
          "type": "string",
          "pattern": "^med_[0-9a-f]{32}$"
        },
        "description": "The assets of `media`, in the same order (duplicates name the existing asset)."
      },
      "failed": {
        "type": "array",
        "items": {
          "description": "A file that was not imported (no asset was created for it).",
          "type": "object",
          "properties": {
            "path": {
              "description": "The path as requested.",
              "type": "string"
            },
            "code": {
              "description": "Machine-readable reason.",
              "oneOf": [
                {
                  "description": "There is no readable file at the path.",
                  "type": "string",
                  "const": "not_found"
                },
                {
                  "description": "The file holds no playable audio or video.",
                  "type": "string",
                  "const": "unsupported"
                },
                {
                  "description": "Probing took longer than the per-file timeout.",
                  "type": "string",
                  "const": "timed_out"
                },
                {
                  "description": "Reading the file failed.",
                  "type": "string",
