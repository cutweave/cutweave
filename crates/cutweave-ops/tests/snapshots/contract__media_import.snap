                },
                {
                  "description": "The probe result cannot be registered (for example a zero duration).",
                  "type": "string",
                  "const": "invalid"
                }
              ]
            },
            "error": {
              "description": "Human-readable reason.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
