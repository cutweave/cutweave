---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.import",
    "summary": "Import media files; probes synchronously and returns the media ids",
    "kind": "engine",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Absolute paths of the files (1..=256, no repeats)."
        }
      },
      "required": [
        "paths"
      ],
      "description": "Imports media files: probes each one synchronously and registers it, returning `media_ids`\nat once. All or nothing: if any file cannot be probed, nothing is imported and the error\nnames that file's index (`/paths/<i>`). Files whose content is already in the project are\nreturned as duplicates. Analysis (thumbnails, waveform, index) continues in background jobs.",
      "title": "MediaImport"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media": {
          "type": "array",
          "items": {
            "description": "One imported file.",
            "type": "object",
            "properties": {
              "path": {
                "description": "The path as requested.",
                "type": "string"
              },
              "media_id": {
                "description": "The asset; an existing one if the same content was imported before.",
                "type": "string",
                "pattern": "^med_[0-9a-f]{32}$"
              },
              "kind": {
                "description": "What the asset is.",
                "oneOf": [
                  {
                    "description": "A video file (may also carry audio).",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "An audio-only file.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "A still image (no duration).",
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                    "type": "string",
                    "const": "sequence_ref"
                  }
                ]
              },
              "duplicate": {
                "description": "`true` when the content was already in the project and nothing was added.",
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "media_id",
              "kind",
              "duplicate"
            ]
          },
          "description": "One entry per requested path, in request order."
        }
      },
      "required": [
        "media"
      ],
      "description": "Result of `media.import`.",
      "title": "MediaImportOutput"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Absolute paths of the files (1..=256, no repeats)."
      }
    },
    "required": [
      "paths"
    ],
    "description": "Imports media files: probes each one synchronously and registers it, returning `media_ids`\nat once. All or nothing: if any file cannot be probed, nothing is imported and the error\nnames that file's index (`/paths/<i>`). Files whose content is already in the project are\nreturned as duplicates. Analysis (thumbnails, waveform, index) continues in background jobs.",
    "title": "MediaImport"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media": {
        "type": "array",
        "items": {
          "description": "One imported file.",
          "type": "object",
          "properties": {
            "path": {
              "description": "The path as requested.",
              "type": "string"
            },
            "media_id": {
              "description": "The asset; an existing one if the same content was imported before.",
              "type": "string",
              "pattern": "^med_[0-9a-f]{32}$"
            },
            "kind": {
              "description": "What the asset is.",
              "oneOf": [
                {
                  "description": "A video file (may also carry audio).",
                  "type": "string",
                  "const": "video"
                },
                {
                  "description": "An audio-only file.",
                  "type": "string",
                  "const": "audio"
                },
                {
                  "description": "A still image (no duration).",
                  "type": "string",
                  "const": "image"
                },
                {
                  "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                  "type": "string",
                  "const": "sequence_ref"
                }
              ]
            },
            "duplicate": {
              "description": "`true` when the content was already in the project and nothing was added.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "media_id",
            "kind",
            "duplicate"
          ]
        },
        "description": "One entry per requested path, in request order."
      }
    },
    "required": [
      "media"
    ],
    "description": "Result of `media.import`.",
    "title": "MediaImportOutput"
  }
}
