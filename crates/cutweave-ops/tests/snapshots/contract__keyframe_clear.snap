---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "keyframe.clear",
    "summary": "Remove all keys of a property, keeping one value",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item (or `items`).",
          "default": null
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Items to clear the same property of.",
          "default": null
        },
        "prop": {
          "oneOf": [
            {
              "type": "string",
              "const": "transform.position",
              "description": "`visual.transform.position`: offset of the anchor from the canvas centre, canvas units."
            },
            {
              "type": "string",
              "const": "transform.scale",
              "description": "`visual.transform.scale`: multiplier of the aspect-fit size, per axis."
            },
            {
              "type": "string",
              "const": "transform.rotation",
              "description": "`visual.transform.rotation`: degrees, clockwise, accumulating."
            },
            {
              "type": "string",
              "const": "transform.anchor",
              "description": "`visual.transform.anchor`: a point of the item in item units."
            },
            {
              "type": "string",
              "const": "opacity",
              "description": "`visual.opacity`: 0 transparent to 1 opaque."
            },
            {
              "type": "string",
              "const": "crop.left",
              "description": "`visual.crop.left`: fraction of the upright source removed from the left edge."
            },
            {
              "type": "string",
              "const": "crop.top",
              "description": "`visual.crop.top`: fraction removed from the top edge."
            },
            {
              "type": "string",
              "const": "crop.right",
              "description": "`visual.crop.right`: fraction removed from the right edge."
            },
            {
              "type": "string",
              "const": "crop.bottom",
              "description": "`visual.crop.bottom`: fraction removed from the bottom edge."
            },
            {
              "type": "string",
              "const": "flip.horizontal",
              "description": "`visual.flip.horizontal`: mirror left-right (hold only)."
            },
            {
              "type": "string",
              "const": "flip.vertical",
              "description": "`visual.flip.vertical`: mirror top-bottom (hold only)."
            },
            {
              "type": "string",
              "const": "audio_gain",
              "description": "`audio.gain`: clip level in dB, interpolated in dB (UI label \"Volume\")."
            },
            {
              "type": "string",
              "const": "audio_pan",
              "description": "`audio.pan`: −1 left to 1 right, 0 centre."
            }
          ],
          "description": "The property."
        },
        "t": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Keep the value at this item time.",
          "default": null
        },
        "at": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Keep the value at this sequence time.",
          "default": null
        }
      },
      "required": [
        "prop"
      ],
      "description": "Makes an animated property static: at its value at the given time (`t` item time, `at`\nsequence time), or at its first key's value without one. Does nothing to a property that is\nalready static. `Locked` if an item's track is locked.",
      "title": "KeyframeClear"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "A boolean."
            },
            {
              "type": "number",
              "format": "double",
              "description": "A number."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "format": "double",
                  "description": "Horizontal component."
                },
                "y": {
                  "type": "number",
                  "format": "double",
                  "description": "Vertical component (down is positive)."
                }
              },
              "required": [
                "x",
                "y"
              ],
              "description": "A 2D vector."
            }
          ],
          "description": "The static value the (first) item's property has now."
        },
        "items": {
          "type": "array",
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "The items processed."
        }
      },
      "required": [
        "value",
        "items"
      ],
      "description": "Result of `keyframe.clear`.",
      "title": "KeyframeClearOutput"
    }
  },
