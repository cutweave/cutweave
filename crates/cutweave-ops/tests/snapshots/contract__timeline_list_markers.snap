---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "timeline.list_markers",
    "summary": "List the markers of a sequence (with its in/out range) or of one item",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "List this item's markers (item-relative times) instead of the sequence's.",
          "default": null
        }
      },
      "required": [
        "sequence"
      ],
      "description": "Lists a sequence's markers and its in/out range, or the markers of one item.",
      "title": "TimelineListMarkers"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^seq_[0-9a-f]{32}$",
          "description": "The sequence."
        },
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item whose markers these are; absent for the sequence's own markers."
        },
        "markers": {
          "type": "array",
          "items": {
            "description": "A marker on a sequence (sequence time) or an item (item-relative time).",
            "type": "object",
            "properties": {
              "id": {
                "description": "The marker ID (also its key in the owner's `markers`).",
                "type": "string",
                "pattern": "^mrk_[0-9a-f]{32}$"
              },
              "t": {
                "description": "Where the marker is (`>= 0`).",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "duration": {
                "description": "The length of a range marker; `None` for a point marker.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "description": "Text shown with the marker (may be empty).",
                "type": "string"
              },
              "color": {
                "description": "Display color.",
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "kind": {
                "description": "What the marker means.",
                "oneOf": [
                  {
                    "description": "Placed by a person or an agent.",
                    "type": "string",
                    "const": "user"
                  },
                  {
                    "description": "A beat found by analysis (snaps like a marker, spec §6).",
                    "type": "string",
                    "const": "beat"
                  },
                  {
                    "description": "A chapter start (exported to chaptered formats).",
                    "type": "string",
                    "const": "chapter"
                  }
                ]
              }
            },
            "required": [
              "id",
              "t",
              "duration",
              "label",
              "color",
              "kind"
            ]
          },
          "description": "The markers by time, then ID."
        },
        "in_out": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "description": "The in point (`>= 0`).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "end": {
              "description": "The out point (`> start`).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ],
          "description": "The sequence's in and out points (sequence markers only)."
        }
      },
      "required": [
        "sequence",
        "markers"
      ],
      "description": "Result of `timeline.list_markers`.",
      "title": "TimelineListMarkersOutput"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sequence": {
        "type": "string",
        "pattern": "^seq_[0-9a-f]{32}$",
        "description": "The sequence."
      },
      "item": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^itm_[0-9a-f]{32}$",
        "description": "List this item's markers (item-relative times) instead of the sequence's.",
        "default": null
      }
    },
    "required": [
      "sequence"
    ],
    "description": "Lists a sequence's markers and its in/out range, or the markers of one item.",
    "title": "TimelineListMarkers"
  },
  "output": {
