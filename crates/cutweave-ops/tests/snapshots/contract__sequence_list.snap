---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "sequence.list",
    "summary": "List the sequences (and the aspect presets on request)",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presets": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Also return the aspect and frame-rate presets.",
          "default": null
        }
      },
      "description": "Lists the sequences with their format, length and track counts; `presets: true` adds the\naspect presets and frame rates `sequence.create` and `sequence.set_format` offer.",
      "title": "SequenceList"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequences": {
          "type": "array",
          "items": {
            "description": "Summary of one sequence.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The sequence.",
                "type": "string",
                "pattern": "^seq_[0-9a-f]{32}$"
              },
              "name": {
                "description": "Its name.",
                "type": "string"
              },
              "format": {
                "description": "Its format.",
                "type": "object",
                "properties": {
                  "width": {
                    "description": "Canvas width in pixels.",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  "height": {
                    "description": "Canvas height in pixels.",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  "frame_rate": {
                    "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
                    "type": "object",
                    "properties": {
                      "num": {
                        "description": "Frames.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295
                      },
                      "den": {
                        "description": "Seconds.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295
                      }
                    },
                    "required": [
                      "num",
                      "den"
                    ],
                    "additionalProperties": false
                  },
                  "sample_rate": {
                    "description": "The mix rate.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 352800000
                  },
                  "color_space": {
                    "description": "Working color space.",
                    "oneOf": [
                      {
                        "description": "Rec.709 primaries, SDR.",
                        "type": "string",
                        "const": "rec709"
                      }
                    ]
                  },
                  "background": {
                    "description": "Canvas color behind all tracks.",
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "background_fill": {
                    "description": "What fills the canvas over that color, behind all tracks (WP-2B.02). Absent: the color\nalone. Left out of the file while absent, so documents without one read as before.",
                    "anyOf": [
                      {
                        "description": "What fills a sequence's canvas behind all tracks, over its `background` color (WP-2B.02).\nIt is static: a background has no keyframes.",
                        "oneOf": [
                          {
                            "description": "A blurred copy of a picture of the sequence, scaled to cover the canvas. Where no such\npicture shows, the color does.",
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "blur"
                              },
                              "source": {
                                "description": "Which picture is blurred.",
                                "oneOf": [
                                  {
                                    "description": "The lowest picture showing at that time.",
                                    "type": "string",
                                    "const": "below"
                                  },
                                  {
                                    "description": "The picture on the main track (the magnetic track; without one, the lowest video\ntrack).",
                                    "type": "string",
                                    "const": "main_track"
                                  }
                                ],
                                "default": "below"
                              },
                              "radius": {
                                "description": "The blur's standard deviation as a fraction of the canvas height, `0..=1`, so\npreview and export blur alike at any size.",
                                "type": "number",
                                "format": "double"
                              },
                              "dim": {
                                "description": "How much of the blurred picture's light is taken away, `0..=1` (0: none, 1: black).",
                                "type": "number",
                                "format": "double",
                                "default": 0.0
                              }
                            },
                            "required": [
                              "kind",
                              "source",
                              "radius",
                              "dim"
                            ]
                          },
                          {
                            "description": "A still image of the project. An image that no longer exists draws nothing.",
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "image"
                              },
                              "media": {
                                "description": "The image asset.",
                                "type": "string",
                                "pattern": "^med_[0-9a-f]{32}$"
                              },
                              "fit": {
                                "description": "How the image is sized to the canvas.",
                                "oneOf": [
                                  {
                                    "description": "Fills the canvas, cropping what does not fit.",
                                    "type": "string",
                                    "const": "cover"
                                  },
                                  {
                                    "description": "The whole image inside the canvas; the color shows around it.",
                                    "type": "string",
                                    "const": "contain"
                                  },
                                  {
                                    "description": "Stretched to the canvas, changing its shape.",
                                    "type": "string",
                                    "const": "stretch"
                                  }
                                ],
                                "default": "cover"
                              }
                            },
                            "required": [
                              "kind",
                              "media",
                              "fit"
                            ]
                          },
                          {
                            "description": "Nothing: the canvas starts fully transparent and the color is not drawn. Only exports\nthat keep alpha show it; the others see black.",
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "transparent"
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "width",
                  "height",
                  "frame_rate",
                  "sample_rate",
                  "color_space",
                  "background"
                ]
              },
              "duration": {
                "description": "End of the last item on any track.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "video_tracks": {
                "description": "Number of video tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "audio_tracks": {
                "description": "Number of audio tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "item_count": {
                "description": "Number of items on all its tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "format",
              "duration",
              "video_tracks",
              "audio_tracks",
              "item_count"
            ]
          },
          "description": "The sequences, ordered by ID."
        },
        "presets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "One aspect preset.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The ID `sequence.create` takes as `preset`.",
                "type": "string"
              },
              "aspect_w": {
                "description": "Aspect width (the `16` of 16:9).",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "aspect_h": {
                "description": "Aspect height (the `9` of 16:9).",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "width": {
                "description": "Canvas width in pixels.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "height": {
                "description": "Canvas height in pixels.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "use_for": {
                "description": "What it is used for.",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "aspect_w",
              "aspect_h",
              "width",
              "height",
              "use_for"
            ]
          },
          "description": "The aspect presets, when asked for."
        },
        "frame_rates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "description": "A frame rate as an exact fraction of frames per second, e.g. {\"num\": 30000, \"den\": 1001} for 29.97 fps.",
            "type": "object",
            "properties": {
              "num": {
                "description": "Frames.",
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "den": {
                "description": "Seconds.",
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          },
          "description": "The offered frame rates (`[num, den]` pairs), when presets are asked for."
        }
      },
      "required": [
        "sequences",
        "presets",
        "frame_rates"
      ],
      "description": "Result of `sequence.list`.",
      "title": "SequenceListOutput"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "presets": {
        "type": [
          "boolean",
