---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "keyframe.delete",
    "summary": "Delete keys of an item's properties",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The item."
        },
        "keys": {
          "type": "array",
          "items": {
            "description": "A key to address: its property and exact item time.",
            "type": "object",
            "properties": {
              "prop": {
                "description": "The property.",
                "type": "string",
                "enum": [
                  "transform.position",
                  "transform.scale",
                  "transform.rotation",
                  "transform.anchor",
                  "opacity",
                  "crop.left",
                  "crop.top",
                  "crop.right",
                  "crop.bottom",
                  "flip.horizontal",
                  "flip.vertical",
                  "audio_gain",
                  "audio_pan"
                ]
              },
              "t": {
                "description": "The key's stored item time in flicks, as `item.get` returns it.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "prop",
              "t"
            ]
          },
          "description": "The keys to delete, by property and exact item time."
        }
      },
      "required": [
        "item",
        "keys"
      ],
      "description": "Removes the keys at the exact item times given. Deleting every key of a property makes it\nstatic at its first key's value. `NotFound` if a key does not exist; `Locked` if the item's\ntrack is locked.",
      "title": "KeyframeDelete"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deleted": {
          "type": "array",
          "items": {
            "description": "A key to address: its property and exact item time.",
            "type": "object",
            "properties": {
              "prop": {
                "description": "The property.",
                "type": "string",
                "enum": [
                  "transform.position",
                  "transform.scale",
                  "transform.rotation",
                  "transform.anchor",
                  "opacity",
                  "crop.left",
                  "crop.top",
                  "crop.right",
                  "crop.bottom",
                  "flip.horizontal",
                  "flip.vertical",
                  "audio_gain",
                  "audio_pan"
                ]
              },
              "t": {
                "description": "The key's stored item time in flicks, as `item.get` returns it.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "required": [
              "prop",
              "t"
            ]
          },
          "description": "The keys removed."
        },
        "now_static": {
          "type": "array",
          "items": {
            "description": "An animatable property of an item. Text items also take text.size, text.letter_spacing and text.line_height.",
            "type": "string",
            "enum": [
              "transform.position",
              "transform.scale",
              "transform.rotation",
              "transform.anchor",
              "opacity",
              "crop.left",
              "crop.top",
              "crop.right",
              "crop.bottom",
              "flip.horizontal",
              "flip.vertical",
              "audio_gain",
              "audio_pan"
            ]
          },
          "description": "Properties that lost their last key and are static now (at their first key's value)."
        }
      },
      "required": [
        "deleted",
        "now_static"
      ],
      "description": "Result of `keyframe.delete`.",
      "title": "KeyframeDeleteOutput"
    }
  },
