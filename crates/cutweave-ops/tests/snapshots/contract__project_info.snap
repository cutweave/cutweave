---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "project.info",
    "summary": "Get project name, default format and a summary of its sequences",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "description": "Returns the project name, format, media count and a summary of each sequence.",
      "title": "ProjectInfo"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name."
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Document schema version."
        },
        "created": {
          "type": [
            "string",
            "null"
          ],
          "description": "Creation time (RFC 3339 UTC), if recorded."
        },
        "default_format": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas width in pixels."
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas height in pixels."
            },
            "frame_rate": {
              "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
