                    "format": "uint32",
                    "minimum": 0
                  },
                  "frame_rate": {
                    "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
                    "type": "object",
                    "properties": {
                      "num": {
                        "description": "Frames.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295
                      },
                      "den": {
                        "description": "Seconds.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295
                      }
                    },
                    "required": [
                      "num",
                      "den"
                    ],
                    "additionalProperties": false
                  },
                  "sample_rate": {
                    "description": "The mix rate.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 352800000
                  },
                  "color_space": {
                    "description": "Working color space.",
                    "oneOf": [
                      {
                        "description": "Rec.709 primaries, SDR.",
                        "type": "string",
                        "const": "rec709"
                      }
                    ]
                  },
                  "background": {
                    "description": "Canvas color behind all tracks.",
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  }
                },
                "required": [
                  "width",
                  "height",
                  "frame_rate",
                  "sample_rate",
                  "color_space",
                  "background"
                ]
              },
              "duration": {
                "description": "End of the last item on any track.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "video_tracks": {
                "description": "Number of video tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "audio_tracks": {
                "description": "Number of audio tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "item_count": {
                "description": "Number of items on all its tracks.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "format",
              "duration",
              "video_tracks",
              "audio_tracks",
              "item_count"
            ]
          },
          "description": "The sequences, ordered by ID."
        }
      },
      "required": [
