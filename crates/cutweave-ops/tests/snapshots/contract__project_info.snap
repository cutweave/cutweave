{
  "meta": {
    "name": "project.info",
    "summary": "Get project name, default format and a summary of its sequences",
    "kind": "query",
    "undoable": false,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "description": "Returns the project name, format, media count and a summary of each sequence.",
      "title": "ProjectInfo"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name."
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Document schema version."
        },
        "created": {
          "type": [
            "string",
            "null"
          ],
          "description": "Creation time (RFC 3339 UTC), if recorded."
        },
        "default_format": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas width in pixels."
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "Canvas height in pixels."
            },
            "frame_rate": {
              "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
              "type": "object",
              "properties": {
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Frames."
                },
                "den": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "description": "Seconds."
                }
              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "sample_rate": {
              "description": "The mix rate.",
              "type": "integer",
              "minimum": 1,
              "maximum": 352800000
            },
            "color_space": {
              "oneOf": [
                {
                  "type": "string",
                  "const": "rec709",
                  "description": "Rec.709 primaries, SDR."
                }
              ],
              "description": "Working color space."
            },
            "background": {
              "description": "Canvas color behind all tracks.",
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            }
          },
          "required": [
            "width",
            "height",
            "frame_rate",
            "sample_rate",
            "color_space",
            "background"
          ],
          "description": "Format of new sequences."
        },
        "media_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Number of media assets."
        },
        "sequences": {
          "type": "array",
          "items": {
            "description": "Summary of one sequence.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The sequence.",
                "type": "string",
                "pattern": "^seq_[0-9a-f]{32}$"
              },
              "name": {
                "description": "Its name.",
                "type": "string"
              },
              "format": {
                "description": "Its format.",
                "type": "object",
                "properties": {
                  "width": {
                    "description": "Canvas width in pixels.",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                  },
                  "height": {
                    "description": "Canvas height in pixels.",
