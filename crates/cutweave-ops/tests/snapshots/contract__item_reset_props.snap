              {
                "type": "string",
                "const": "audio",
                "description": "Clip gain and pan."
              }
            ],
            "description": "A group of properties, as the Inspector's sections show them."
          },
          {
            "type": "null"
          }
        ],
        "description": "A section of the Inspector.",
        "default": null
      },
      "props": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "description": "An animatable property (keyframes §7). The IDs match `item.set_props`'s patch paths, so\n`keyframe.*`, `item.set_props` and its `changed` output use the same names.\n\nLater properties (P3 text, P4 effect and composition parameters) register here through\ntheir work packages.",
          "oneOf": [
            {
              "description": "`visual.transform.position`: offset of the anchor from the canvas centre, canvas units.",
              "type": "string",
              "const": "transform.position"
            },
            {
              "description": "`visual.transform.scale`: multiplier of the aspect-fit size, per axis.",
              "type": "string",
              "const": "transform.scale"
            },
            {
              "description": "`visual.transform.rotation`: degrees, clockwise, accumulating.",
              "type": "string",
              "const": "transform.rotation"
            },
            {
              "description": "`visual.transform.anchor`: a point of the item in item units.",
              "type": "string",
              "const": "transform.anchor"
            },
            {
              "description": "`visual.opacity`: 0 transparent to 1 opaque.",
              "type": "string",
              "const": "opacity"
            },
            {
              "description": "`visual.crop.left`: fraction of the upright source removed from the left edge.",
              "type": "string",
              "const": "crop.left"
            },
            {
              "description": "`visual.crop.top`: fraction removed from the top edge.",
              "type": "string",
              "const": "crop.top"
            },
            {
              "description": "`visual.crop.right`: fraction removed from the right edge.",
              "type": "string",
              "const": "crop.right"
            },
            {
              "description": "`visual.crop.bottom`: fraction removed from the bottom edge.",
              "type": "string",
              "const": "crop.bottom"
            },
            {
              "description": "`visual.flip.horizontal`: mirror left-right (hold only).",
              "type": "string",
              "const": "flip.horizontal"
            },
            {
              "description": "`visual.flip.vertical`: mirror top-bottom (hold only).",
              "type": "string",
              "const": "flip.vertical"
            },
            {
              "description": "`audio.gain`: clip level in dB, interpolated in dB (UI label \"Volume\").",
              "type": "string",
              "const": "audio_gain"
            },
            {
              "description": "`audio.pan`: −1 left to 1 right, 0 centre.",
              "type": "string",
              "const": "audio_pan"
            }
          ]
        },
        "description": "Property IDs, as `keyframe.set` takes them.",
        "default": null
      }
    },
    "description": "Resets properties to their defaults: they become static (any keys are removed). Give\n`group` (`transform`, `crop`, `flip`, `compositing`, `audio`) or `props` (property IDs), not\nboth; with neither, every animatable property and the blend mode are reset. The name and\nenabled flag are never touched. `Locked` if the item's track is locked.",
    "title": "ItemResetProps"
  },
  "output": {
