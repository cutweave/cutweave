                    "pattern": {
                      "description": "The file name with the counter as `%0Nd` (zero-padded to `N` digits) or `%d`\n(`shot_%04d.exr`); a literal `%` is written `%%`. A name, not a path: the files are in\nthe directory of `path_abs`.",
                      "type": "string"
                    },
                    "first": {
                      "description": "The number of the first file.",
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "count": {
                      "description": "How many numbers the run covers, from `first` (missing ones included); at least 2.",
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "fps": {
                      "description": "The frame rate chosen at import; changing the app setting never changes it.",
                      "type": "object",
                      "properties": {
                        "num": {
                          "description": "Frames.",
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4294967295
                        },
                        "den": {
                          "description": "Seconds.",
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4294967295
                        }
                      },
                      "required": [
                        "num",
                        "den"
                      ],
                      "additionalProperties": false
                    },
                    "missing": {
                      "description": "The numbers with no file at import time, ascending. A missing frame shows the last\npicture before it.",
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "uint32",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "pattern",
                    "first",
                    "count",
                    "fps",
                    "missing"
                  ],
                  "default": null
                }
              },
              "additionalProperties": false,
              "required": [
                "path",
                "probe",
                "content_hash"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "dirs",
            "register"
          ]
        },
        "description": "The files (1..=2000)."
      }
    },
    "required": [
      "entries"
    ],
    "description": "Registers `entries` like `media.register` and puts each new asset into the bin folders named\nby its `dirs`, created inside `folder` as needed. Internal plumbing of `media.import`.",
    "title": "MediaRegisterTree"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "description": "Result of `media.register`.",
          "type": "object",
          "properties": {
            "media_id": {
              "description": "The asset: the new one, or the existing one with the same content hash.",
              "type": "string",
              "pattern": "^med_[0-9a-f]{32}$"
            },
            "kind": {
              "description": "What the asset is.",
              "oneOf": [
                {
                  "description": "A video file (may also carry audio).",
                  "type": "string",
                  "const": "video"
                },
                {
                  "description": "An audio-only file.",
                  "type": "string",
                  "const": "audio"
                },
                {
                  "description": "A still image (no duration).",
                  "type": "string",
                  "const": "image"
                },
                {
                  "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                  "type": "string",
                  "const": "image_sequence"
                },
                {
                  "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                  "type": "string",
                  "const": "sequence_ref"
                }
              ]
            },
            "created": {
              "description": "`false` when an asset with the same content hash already existed and nothing changed.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "media_id",
            "kind",
            "created"
          ]
        },
        "description": "One result per entry, in order."
      },
      "folders": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "description": "How many bin folders were created."
      }
    },
    "required": [
      "results",
      "folders"
    ],
    "description": "Result of `media.register_tree`.",
    "title": "MediaTreeRegistered"
  }
}
