---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.register_tree",
    "summary": "Register probed media files into bin folders that mirror a directory tree (used by import)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "hidden",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "The folder the tree goes into; absent: the top level.",
          "default": null
        },
        "entries": {
          "type": "array",
          "items": {
            "description": "One file of a tree and the directories above it.",
            "type": "object",
            "properties": {
              "dirs": {
                "description": "The names of the bin folders to put the file in, outermost first, inside `folder`; empty:\nstraight into `folder`.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "register": {
                "description": "The file. Its `folder` is ignored.",
                "type": "object",
                "properties": {
                  "media_id": {
                    "description": "ID for the new asset; minted by the engine when absent. Must not exist yet.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^med_[0-9a-f]{32}$",
                    "default": null
                  },
                  "path": {
                    "description": "Absolute path of the file.",
                    "type": "string"
                  },
                  "probe": {
                    "description": "What probing found.",
                    "type": "object",
                    "properties": {
                      "streams": {
                        "description": "Streams in container order.",
                        "type": "array",
                        "items": {
                          "description": "One stream of a media file.",
                          "type": "object",
                          "properties": {
                            "index": {
                              "description": "Index in the container.",
                              "type": "integer",
                              "format": "uint32",
                              "minimum": 0
                            },
                            "kind": {
                              "description": "Stream kind.",
                              "oneOf": [
                                {
                                  "description": "Pictures.",
                                  "type": "string",
                                  "const": "video"
                                },
                                {
                                  "description": "Sound.",
                                  "type": "string",
                                  "const": "audio"
                                },
                                {
                                  "description": "Subtitles or captions.",
                                  "type": "string",
                                  "const": "subtitle"
                                },
                                {
                                  "description": "Timed metadata or other data.",
                                  "type": "string",
                                  "const": "data"
                                },
                                {
                                  "description": "Attached files (fonts, cover art).",
                                  "type": "string",
                                  "const": "attachment"
                                }
                              ]
                            },
                            "codec": {
                              "description": "Codec name (FFmpeg naming, e.g. `h264`, `aac`).",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "profile": {
                              "description": "Codec profile (e.g. `High`, `Main 10`).",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "width": {
                              "description": "Coded width in pixels (video).",
                              "type": [
                                "integer",
                                "null"
                              ],
                              "format": "uint32",
                              "minimum": 0
                            },
                            "height": {
                              "description": "Coded height in pixels (video).",
                              "type": [
                                "integer",
                                "null"
                              ],
                              "format": "uint32",
                              "minimum": 0
                            },
                            "pixel_format": {
                              "description": "Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video).",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "sample_rate": {
                              "description": "Sample rate (audio).",
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1,
                              "maximum": 352800000
                            },
                            "channels": {
                              "description": "Channel count (audio).",
                              "type": [
                                "integer",
                                "null"
                              ],
                              "format": "uint16",
                              "minimum": 0,
                              "maximum": 65535
                            },
                            "language": {
                              "description": "Language tag (e.g. `eng`).",
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "index",
                            "kind"
                          ]
                        }
                      },
                      "duration": {
                        "description": "Playable length, if known (images have none).",
                        "anyOf": [
                          {
                            "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\").",
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "string",
                                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$"
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "fps": {
                        "description": "Frame rate of the main video stream, if constant or nominal.",
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "num": {
                            "description": "Frames.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          },
                          "den": {
                            "description": "Seconds.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "additionalProperties": false
                      },
                      "vfr": {
                        "description": "Variable frame rate: times map through the frame index, never through `fps` (arch §4.1).",
                        "type": "boolean"
                      },
                      "rotation": {
                        "description": "Display rotation in degrees clockwise: 0, 90, 180 or 270.",
                        "type": "integer",
                        "format": "uint16",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "color": {
                        "description": "Color tags of the main video stream.",
                        "type": "object",
                        "properties": {
                          "primaries": {
                            "description": "Color primaries.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "examples": [
                              "bt709",
                              "bt470m",
                              "bt470bg",
                              "smpte170m",
                              "smpte240m",
                              "film",
                              "bt2020",
                              "smpte428",
                              "smpte431",
                              "smpte432",
                              "ebu3213"
                            ]
                          },
                          "transfer": {
                            "description": "Transfer characteristics.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "examples": [
                              "bt709",
                              "gamma22",
                              "gamma28",
                              "smpte170m",
                              "smpte240m",
                              "linear",
                              "iec61966-2-1",
                              "bt2020-10",
                              "bt2020-12",
                              "smpte2084",
                              "arib-std-b67"
                            ]
                          },
                          "matrix": {
                            "description": "YUV matrix coefficients.",
                            "type": [
                              "string",
                              "null"
                            ],
                            "examples": [
                              "gbr",
                              "bt709",
                              "fcc",
                              "bt470bg",
                              "smpte170m",
                              "smpte240m",
                              "ycgco",
                              "bt2020nc",
                              "bt2020c",
                              "ictcp"
                            ]
                          },
                          "range": {
                            "description": "Sample range.",
                            "anyOf": [
                              {
                                "description": "Sample range of a video stream.",
                                "oneOf": [
                                  {
                                    "description": "Limited (\"TV\", 16–235 for 8-bit luma).",
                                    "type": "string",
                                    "const": "limited"
                                  },
                                  {
                                    "description": "Full (\"PC\", 0–255).",
                                    "type": "string",
                                    "const": "full"
                                  }
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "additionalProperties": false
                      },
                      "audio": {
                        "description": "Main audio stream format, if any.",
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "rate": {
                            "description": "Samples per second.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 352800000
                          },
                          "channels": {
                            "description": "Channel count.",
                            "type": "integer",
                            "format": "uint16",
                            "minimum": 0,
                            "maximum": 65535
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "rate",
                          "channels"
                        ]
                      }
                    },
                    "required": [
                      "streams",
                      "vfr",
                      "rotation",
                      "color"
                    ]
                  },
                  "content_hash": {
                    "description": "Content hash used to relink and deduplicate (non-empty, no whitespace).",
                    "type": "string"
                  },
                  "folder": {
                    "description": "The folder of the bin to put the new asset in; absent: the top level.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^fld_[0-9a-f]{32}$",
                    "default": null
                  },
                  "image_sequence": {
                    "description": "For an image sequence (ADR-0035): the run. `path` is then its first picture and `probe`\nthe picture with the run's duration and frame rate; the asset's kind is\n`image_sequence`. Absent for every other file.",
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "pattern": {
                        "description": "The file name with the counter as `%0Nd` (zero-padded to `N` digits) or `%d`\n(`shot_%04d.exr`); a literal `%` is written `%%`. A name, not a path: the files are in\nthe directory of `path_abs`.",
                        "type": "string"
                      },
                      "first": {
                        "description": "The number of the first file.",
                        "type": "integer",
                        "format": "uint32",
                        "minimum": 0
                      },
                      "count": {
                        "description": "How many numbers the run covers, from `first` (missing ones included); at least 2.",
                        "type": "integer",
                        "format": "uint32",
                        "minimum": 0
                      },
                      "fps": {
                        "description": "The frame rate chosen at import; changing the app setting never changes it.",
                        "type": "object",
                        "properties": {
                          "num": {
                            "description": "Frames.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          },
                          "den": {
                            "description": "Seconds.",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "additionalProperties": false
                      },
                      "missing": {
                        "description": "The numbers with no file at import time, ascending. A missing frame shows the last\npicture before it.",
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "format": "uint32",
                          "minimum": 0
                        }
                      }
                    },
                    "required": [
                      "pattern",
                      "first",
                      "count",
                      "fps",
                      "missing"
                    ],
                    "default": null
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "probe",
                  "content_hash"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "dirs",
              "register"
            ]
          },
          "description": "The files (1..=2000)."
        }
      },
      "required": [
        "entries"
      ],
      "description": "Registers `entries` like `media.register` and puts each new asset into the bin folders named\nby its `dirs`, created inside `folder` as needed. Internal plumbing of `media.import`.",
      "title": "MediaRegisterTree"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "description": "Result of `media.register`.",
            "type": "object",
            "properties": {
              "media_id": {
                "description": "The asset: the new one, or the existing one with the same content hash.",
                "type": "string",
                "pattern": "^med_[0-9a-f]{32}$"
              },
              "kind": {
                "description": "What the asset is.",
                "oneOf": [
                  {
                    "description": "A video file (may also carry audio).",
                    "type": "string",
                    "const": "video"
                  },
                  {
                    "description": "An audio-only file.",
                    "type": "string",
                    "const": "audio"
                  },
                  {
                    "description": "A still image (no duration).",
                    "type": "string",
                    "const": "image"
                  },
                  {
                    "description": "A numbered run of pictures that plays like video (ADR-0035); the asset's\n`image_sequence` field describes the run.",
                    "type": "string",
                    "const": "image_sequence"
                  },
                  {
                    "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                    "type": "string",
                    "const": "sequence_ref"
                  }
                ]
              },
              "created": {
                "description": "`false` when an asset with the same content hash already existed and nothing changed.",
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "media_id",
              "kind",
              "created"
            ]
          },
          "description": "One result per entry, in order."
        },
        "folders": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "How many bin folders were created."
        }
      },
      "required": [
        "results",
        "folders"
      ],
      "description": "Result of `media.register_tree`.",
      "title": "MediaTreeRegistered"
    }
  },
