        "description": "Space between cells, in sequence pixels (default 0).",
        "default": null
      },
      "order": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$"
        },
        "description": "The clips in cell order (default: top track first).",
        "default": null
      },
      "at": {
        "anyOf": [
          {
            "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
              }
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "Sequence time (the playhead) to key animated properties at.",
        "default": null
      }
    },
    "required": [
      "items",
      "layout"
    ],
    "description": "Places 2 to 4 clips in the cells of a layout, in one undo step. Example:\n`{items:[a,b], layout:\"side_by_side\"}`.\n\n`layout` is one of `item.layouts`. Only video clips count (the audio of a linked clip is\nignored); their number must be what the layout takes, else `Invalid`. `order` lists the clips\nfor the cells (without it the clip on the top track comes first, ties by start time).\n`fill` is `crop` (the default: every cell is filled, the overhang cropped) or `fit` (the\nwhole picture inside the cell). `gap` is the space between cells in sequence pixels (grid\nlayouts only). The result is ordinary properties (transform and crop) that can be adjusted\nafterwards; animated ones are keyed at `at`.",
    "title": "ItemApplyLayout"
  },
