---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "media.create_folder",
    "summary": "Create a folder in the media bin (top level or inside another folder)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "The folder to create it in; absent: the top level.",
          "default": null
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its name: 1 to 255 characters, no `/` or control characters (trimmed). Default \"New\nfolder\".",
          "default": null
        },
        "on_conflict": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "string",
                  "const": "fail",
                  "description": "Fail with `Invalid` (the default)."
                },
                {
                  "type": "string",
                  "const": "rename",
                  "description": "Use the next free name: \"Day 1 2\", \"Day 1 3\", …"
                }
              ],
              "description": "What to do when a folder's name is already taken where it goes."
            },
            {
              "type": "null"
            }
          ],
          "description": "When a sibling already has the name: `fail` (default) or `rename` (\"Day 1 2\").",
          "default": null
        }
      },
      "description": "Creates a folder in the media bin, at the top level or inside `parent` (at most 32 levels\ndeep). Without a name it is \"New folder\" (or \"New folder 2\", … when taken). A name that a\nsibling already has, ignoring case, fails with `Invalid` unless `on_conflict` is `rename`.",
      "title": "MediaCreateFolder"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder_id": {
          "type": "string",
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "The new folder."
        },
        "name": {
          "type": "string",
          "description": "Its name (the next free one with `on_conflict: rename` or without a name)."
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fld_[0-9a-f]{32}$",
          "description": "The folder it is in; absent at the top level."
        }
      },
      "required": [
        "folder_id",
        "name",
        "parent"
      ],
      "description": "Result of `media.create_folder`.",
      "title": "MediaFolderCreated"
    }
  },
  "input": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "parent": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^fld_[0-9a-f]{32}$",
        "description": "The folder to create it in; absent: the top level.",
        "default": null
      },
      "name": {
        "type": [
          "string",
          "null"
        ],
        "description": "Its name: 1 to 255 characters, no `/` or control characters (trimmed). Default \"New\nfolder\".",
        "default": null
      },
      "on_conflict": {
        "anyOf": [
          {
            "oneOf": [
              {
                "type": "string",
                "const": "fail",
                "description": "Fail with `Invalid` (the default)."
              },
              {
                "type": "string",
                "const": "rename",
                "description": "Use the next free name: \"Day 1 2\", \"Day 1 3\", …"
              }
            ],
            "description": "What to do when a folder's name is already taken where it goes."
          },
          {
            "type": "null"
          }
        ],
        "description": "When a sibling already has the name: `fail` (default) or `rename` (\"Day 1 2\").",
        "default": null
      }
    },
    "description": "Creates a folder in the media bin, at the top level or inside `parent` (at most 32 levels\ndeep). Without a name it is \"New folder\" (or \"New folder 2\", … when taken). A name that a\nsibling already has, ignoring case, fails with `Invalid` unless `on_conflict` is `rename`.",
    "title": "MediaCreateFolder"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "folder_id": {
        "type": "string",
        "pattern": "^fld_[0-9a-f]{32}$",
        "description": "The new folder."
      },
      "name": {
        "type": "string",
        "description": "Its name (the next free one with `on_conflict: rename` or without a name)."
      },
      "parent": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^fld_[0-9a-f]{32}$",
        "description": "The folder it is in; absent at the top level."
      }
    },
    "required": [
      "folder_id",
      "name",
      "parent"
    ],
    "description": "Result of `media.create_folder`.",
    "title": "MediaFolderCreated"
  }
}
