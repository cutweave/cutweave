---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "clip.trim",
    "summary": "Trim the start or end edge of a clip (linked partners follow; the main track closes up)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^itm_[0-9a-f]{32}$",
          "description": "The clip."
        },
        "edge": {
          "oneOf": [
            {
              "type": "string",
              "const": "start",
              "description": "The first frame (changes `start`, `source_in` and the length)."
            },
            {
              "type": "string",
              "const": "end",
              "description": "The last frame (changes the length)."
            }
          ],
          "description": "The edge to move."
        },
        "to": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Timeline time of the edge afterwards (frame-snapped).",
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Offset of the edge from where it is now (negative: earlier). Use seconds or flicks for\nnegative values.",
          "default": null
        },
        "unlink": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trim only this clip and remove it from its linked group (default `false`).",
          "default": null
        },
        "clamp": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Stop at the nearest limit instead of failing (default `false`).",
          "default": null
        },
        "fine": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Snap to the audio sample grid (audio clips only).",
          "default": null
        },
        "prune_keyframes": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Drop keyframes the trim leaves outside the clip, keeping the ones that bracket it\n(default `false`: trims keep every key).",
          "default": null
        }
      },
      "required": [
        "item",
        "edge"
      ],
      "description": "Moves one edge of a clip to a timeline time (`to`) or by an offset (`delta`, negative:\nearlier; give exactly one). Linked partners get the same edge; `unlink: true` trims only\nthis clip, which leaves its group. On free tracks nothing else moves, and the clip cannot\nbecome shorter than one frame, read outside its media or overlap a neighbour. On the\nmagnetic main track it is a ripple trim (`clip.ripple_trim`): what follows moves with the\nend. A request past a limit is `Invalid` at `/to` (or `/delta`) naming it; with `clamp:\ntrue` the edge stops there instead (`applied_delta`, `clamped`). Times snap to frames\n(`fine: true`: audio samples, for audio clips not linked to video). `Locked` if a track\ninvolved is locked.",
      "title": "ClipTrim"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "description": "A clip after trimming.",
            "type": "object",
            "properties": {
              "item": {
                "description": "The clip.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "start": {
                "description": "Its start.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "duration": {
                "description": "Its length.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source_in": {
                "description": "Its source position.",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "required": [
              "item",
              "start",
              "duration",
              "source_in"
            ]
          },
          "description": "The trimmed clips: the requested one first, then its linked partners."
        },
        "applied_delta": {
          "description": "How far the edge moved (flicks): the request, or under `clamp` the nearest one allowed.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "clamped": {
          "type": "boolean",
          "description": "Whether `applied_delta` differs from the request (only with `clamp: true`)."
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "New items, other than the right halves of splits."
            },
            "removed": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "Items that no longer exist."
            },
            "split": {
              "type": "array",
              "items": {
                "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                "type": "object",
                "properties": {
                  "left": {
                    "description": "The left half (keeps the original ID).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "right": {
                    "description": "The right half (new).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "at": {
                    "description": "The cut time.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "left",
                  "right",
                  "at"
                ]
              },
              "description": "Splits, sorted by `(left, at)`."
            },
            "moved": {
              "type": "array",
              "items": {
                "description": "An item whose track or start changed (duration and source did not).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "track": {
                    "description": "Its track now.",
                    "type": "string",
                    "pattern": "^trk_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "track",
                  "start"
                ]
              },
              "description": "Items whose track or start changed."
            },
            "trimmed": {
              "type": "array",
              "items": {
                "description": "An item whose duration or `source_in` changed (its start may have too).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "duration": {
                    "description": "Its duration now.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "source_in": {
                    "description": "Its `source_in` now (`0` for items that play no media).",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "start",
                  "duration",
                  "source_in"
                ]
              },
              "description": "Items whose duration or source position changed."
            },
            "relinked": {
              "type": "array",
              "items": {
                "description": "An item whose `linked_group` or `attached_to` changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "linked_group": {
                    "description": "Its linked group now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^grp_[0-9a-f]{32}$"
                  },
                  "attached_to": {
                    "description": "The item it is attached to now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^itm_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "linked_group",
                  "attached_to"
                ]
              },
              "description": "Items whose link or attachment changed."
            },
            "replaced": {
              "type": "array",
              "items": {
                "description": "An item whose media changed (`clip.replace`).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "media": {
                    "description": "Its media now.",
                    "type": "string",
                    "pattern": "^med_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "media"
                ]
              },
              "description": "Items whose media changed."
            },
            "toggled": {
              "type": "array",
              "items": {
                "description": "An item whose `enabled` flag changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "enabled": {
                    "description": "Its flag now.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "enabled"
                ]
              },
              "description": "Items whose `enabled` flag changed."
            },
            "created_tracks": {
              "type": "array",
              "items": {
                "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "description": "Tracks created, in creation order."
            }
          },
          "required": [
            "created",
            "removed",
            "split",
            "moved",
            "trimmed",
            "relinked",
            "replaced",
            "toggled",
            "created_tracks"
          ],
          "description": "What changed (timeline spec §3.1)."
        }
      },
      "required": [
        "items",
        "applied_delta",
        "clamped",
        "report"
      ],
      "description": "Result of `clip.trim`.",
      "title": "ClipTrimOutput"
    }
  },
