          "type": "boolean",
          "description": "Silenced."
        },
        "hidden": {
          "type": "boolean",
          "description": "Not rendered."
        },
        "locked": {
          "type": "boolean",
          "description": "Item edits fail with `Locked`."
        },
        "solo": {
          "type": "boolean",
          "description": "Solo."
        },
        "gain": {
          "type": "number",
          "format": "double",
          "description": "Gain in dB."
        }
      },
      "required": [
