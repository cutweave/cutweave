---
source: crates/cutweave-ops/tests/contract.rs
expression: "json!({\n    \"meta\": serde_json::to_value(meta).unwrap(), \"input\": meta.input_schema,\n    \"output\": meta.output_schema,\n})"
---
{
  "meta": {
    "name": "timeline.ripple_delete",
    "summary": "Delete items on one track and close the space they leave (partners follow)",
    "kind": "command",
    "undoable": true,
    "view": false,
    "scope": "any",
    "mcp": "catalog",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "secret_fields": [],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "The items to delete, at least one, all on one track."
        },
        "ripple_all_tracks": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Shift every track of the sequence, not only the item's track and its partners' tracks\n(default `false`).",
          "default": null
        }
      },
      "required": [
        "items"
      ],
      "description": "Deletes items and their linked partners and closes the space each given item leaves on its\ntrack: what follows on that track moves left by the length deleted before it, and so do the\ntracks of linked partners of what moves (or every track with `ripple_all_tracks`). All given\nitems must be on one track; gaps that were already there stay. Fails with `Invalid` if the\nshift would make items overlap on a rippled track, and with `Locked` if it would change a\nlocked track. On the magnetic main track it is the same as `item.delete`.",
      "title": "TimelineRippleDelete"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deleted": {
          "type": "array",
          "items": {
            "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
            "type": "string",
            "pattern": "^itm_[0-9a-f]{32}$"
          },
          "description": "Every deleted item: the requested ones in request order, then their linked partners."
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "New items, other than the right halves of splits."
            },
            "removed": {
              "type": "array",
              "items": {
                "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^itm_[0-9a-f]{32}$"
              },
              "description": "Items that no longer exist."
            },
            "split": {
              "type": "array",
              "items": {
                "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                "type": "object",
                "properties": {
                  "left": {
                    "description": "The left half (keeps the original ID).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "right": {
                    "description": "The right half (new).",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "at": {
                    "description": "The cut time.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "left",
                  "right",
                  "at"
                ]
              },
              "description": "Splits, sorted by `(left, at)`."
            },
            "moved": {
              "type": "array",
              "items": {
                "description": "An item whose track or start changed (duration and source did not).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "track": {
                    "description": "Its track now.",
                    "type": "string",
                    "pattern": "^trk_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "track",
                  "start"
                ]
              },
              "description": "Items whose track or start changed."
            },
            "trimmed": {
              "type": "array",
              "items": {
                "description": "An item whose duration or `source_in` changed (its start may have too).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "start": {
                    "description": "Its start now.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "duration": {
                    "description": "Its duration now.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "source_in": {
                    "description": "Its `source_in` now (`0` for items that play no media).",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "start",
                  "duration",
                  "source_in"
                ]
              },
              "description": "Items whose duration or source position changed."
            },
            "relinked": {
              "type": "array",
              "items": {
                "description": "An item whose `linked_group` or `attached_to` changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "linked_group": {
                    "description": "Its linked group now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^grp_[0-9a-f]{32}$"
                  },
                  "attached_to": {
                    "description": "The item it is attached to now.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^itm_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "linked_group",
                  "attached_to"
                ]
              },
              "description": "Items whose link or attachment changed."
            },
            "replaced": {
              "type": "array",
              "items": {
                "description": "An item whose media changed (`clip.replace`).",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "media": {
                    "description": "Its media now.",
                    "type": "string",
                    "pattern": "^med_[0-9a-f]{32}$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "media"
                ]
              },
              "description": "Items whose media changed."
            },
            "toggled": {
              "type": "array",
              "items": {
                "description": "An item whose `enabled` flag changed.",
                "type": "object",
                "properties": {
                  "item": {
                    "description": "The item.",
                    "type": "string",
                    "pattern": "^itm_[0-9a-f]{32}$"
                  },
                  "enabled": {
                    "description": "Its flag now.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "item",
                  "enabled"
                ]
              },
              "description": "Items whose `enabled` flag changed."
            },
            "created_tracks": {
              "type": "array",
              "items": {
                "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                "type": "string",
                "pattern": "^trk_[0-9a-f]{32}$"
              },
              "description": "Tracks created, in creation order."
            }
          },
          "required": [
            "created",
            "removed",
            "split",
            "moved",
            "trimmed",
            "relinked",
            "replaced",
            "toggled",
            "created_tracks"
          ],
          "description": "What changed (timeline spec §3.1)."
        }
      },
      "required": [
        "deleted",
        "report"
      ],
      "description": "Result of `timeline.ripple_delete`.",
      "title": "DeletedOutput"
    }
  },
