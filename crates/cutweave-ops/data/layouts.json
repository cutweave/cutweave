        { "x": 0.05, "y": 0.05, "w": 0.3, "h": 0.3 },
        { "x": 0.0, "y": 0.0, "w": 1.0, "h": 1.0 }
      ]
    },
    {
      "id": "pip_top_right",
      "label": "Picture in picture, top right",
