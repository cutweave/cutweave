      "cells": [
        { "col": 0, "row": 0 },
        { "col": 1, "row": 0 }
      ]
    },
    {
      "id": "top_bottom",
      "label": "Top and bottom",
      "columns": [1],
      "rows": [1, 1],
      "cells": [
        { "col": 0, "row": 0 },
        { "col": 0, "row": 1 }
      ]
    },
    {
      "id": "pip_top_left",
      "label": "Picture in picture, top left",
