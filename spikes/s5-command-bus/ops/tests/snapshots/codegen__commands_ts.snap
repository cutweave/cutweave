// GENERATED by `cargo run -p s5-ops --bin s5-codegen` from the s5 command registry.
// Do not edit. Snapshot-tested (ops/tests/snapshots) and typechecked (ops/tests/typescript.rs).

/** Flicks per second (1 flick = 1/705600000 s). `Time` values are integer flicks. */
export const FLICKS_PER_SECOND = 705600000;

/** Every registered command and query: wire name -> params/output types. */
export type Commands = {
  "clip.split": { kind: "command"; params: SplitClip; output: SplitClipOutput };
  "clip.trim": { kind: "command"; params: TrimClip; output: TrimClipOutput };
  "edit.redo": { kind: "command"; params: Redo; output: HistoryStep };
  "edit.undo": { kind: "command"; params: Undo; output: HistoryStep };
  "item.delete": { kind: "command"; params: DeleteItems; output: DeleteItemsOutput };
  "media.import": { kind: "command"; params: ImportMedia; output: ImportMediaOutput };
  "project.open": { kind: "command"; params: OpenProject; output: OpenProjectOutput };
  "render.frame": { kind: "query"; params: RenderFrame; output: RenderedFrame };
  "timeline.get": { kind: "query"; params: GetTimeline; output: TimelineView };
  "timeline.insert": { kind: "command"; params: InsertClip; output: InsertClipOutput };
};

/** Error payload: the typed error plus a human-readable message. */
export type WireError = CmdError & { message: string };

export type CommandName = keyof Commands;
export type Params<K extends CommandName> = Commands[K]["params"];
export type Output<K extends CommandName> = Commands[K]["output"];

/** Per-call envelope options (arch §5.1). The actor is derived from the credential, never sent. */
export type CallOptions = {
  /** Client-generated UUIDv7; a retry with the same id returns the original result. */
  requestId?: string;
  /** Fail with `conflict` unless the document is at this revision. */
  expectedRev?: number;
  /** Apply, return the result, roll back. */
  dryRun?: boolean;
};

export type RpcRequest = {
  name: CommandName;
  params: unknown;
  request_id?: string;
  expected_rev?: number;
  dry_run?: boolean;
};

export type RpcReply =
  | { ok: true; rev: number; result: unknown; dry_run: boolean; deduplicated: boolean }
  | { ok: false; error: WireError };

/** Moves one request to the engine (JSON-RPC over WebSocket, MCP, in-process, ...). */
export interface Transport {
  send(request: RpcRequest): Promise<RpcReply>;
}

export class CutweaveError extends Error {
  readonly error: WireError;
  constructor(error: WireError) {
    super(error.message);
    this.error = error;
  }
}

/** Typed client: `call("clip.split", { item, at })` is checked against the registry at compile time. */
export class CutweaveClient {
  readonly #transport: Transport;
  constructor(transport: Transport) {
    this.#transport = transport;
  }

  async call<K extends CommandName>(
    name: K,
    params: Params<K>,
    options: CallOptions = {},
  ): Promise<Output<K>> {
    const request: RpcRequest = { name, params };
    if (options.requestId !== undefined) request.request_id = options.requestId;
    if (options.expectedRev !== undefined) request.expected_rev = options.expectedRev;
    if (options.dryRun !== undefined) request.dry_run = options.dryRun;
    const reply = await this.#transport.send(request);
    if (!reply.ok) throw new CutweaveError(reply.error);
    return reply.result as Output<K>;
  }
}

/**  Every error a command, query or engine op can return. */
export type CmdError = 
/**  An id (or command name) does not exist. */
{ code: "not_found"; 
/**  Kind. */
entity: EntityKind; 
/**  The missing id. */
id: string } | 
/**  A param failed validation. `path` is a JSON Pointer into the request params. */
{ code: "invalid"; 
/**  JSON Pointer (RFC 6901), `""` for the params object itself. */
path: string; 
/**  What is wrong. */
msg: string } | 
/**  The request conflicts with the current state. */
{ code: "conflict"; 
/**  Machine reason. */
reason: ConflictReason; 
/**  Human detail. */
detail: string; 
/**  Revision at the time of the error (filled in by the engine). */
current_rev: Rev | null } | 
/**  Valid request the engine cannot do (yet). */
{ code: "unsupported"; 
/**  What is unsupported. */
msg: string };

/**  Machine-readable conflict reason. */
export type ConflictReason = 
/**  `expected_rev` did not match the current revision. */
"stale_rev" | 
/**  A `request_id` was reused with a different payload. */
"request_id_reused" | 
/**  The edit would overlap another item on the same track. */
"overlap" | 
/**  Undo/redo target was changed by a later transaction (another actor). */
"history_target_modified";

/**  Delete timeline items (all or nothing). */
export type DeleteItems = {
	/**  Items to delete (at least one, no duplicates). */
	items: ItemId[],
};

/**  Result of `item.delete`. */
export type DeleteItemsOutput = {
	/**  Deleted ids. */
	deleted: ItemId[],
};

/**  What kind of thing was not found. */
export type EntityKind = 
/**  A registry entry (unknown command name). */
"command" | 
/**  Media asset. */
"media" | 
/**  Sequence. */
"sequence" | 
/**  Track. */
"track" | 
/**  Timeline item. */
"item";

/**  A rational frame rate (e.g. 30000/1001). */
export type FrameRate = {
	/**  Numerator (frames). */
	num: number,
	/**  Denominator (seconds). */
	den: number,
};

/**  Get the timeline: tracks top to bottom with their items, plus the media they use. */
export type GetTimeline = Record<string, never>;

/**  Result of a history step. */
export type HistoryStep = {
	/**  The transaction that was undone/redone, or null if there was nothing to do. */
	step: TxSummary | null,
	/**  Document revision afterwards. */
	rev: Rev,
};

/**
 *  Import a media file by reference. Spike stub: nothing is probed; the kind comes from the file
 *  extension and duration/frame rate come from the optional overrides.
 */
export type ImportMedia = {
	/**  File path (absolute or project-relative). */
	path: string,
	/**  Stub probe override: duration (default 10 s). */
	duration?: Time | null,
	/**  Stub probe override: frame rate (default 30/1). */
	frame_rate?: FrameRate | null,
};

/**  Result of `media.import`. */
export type ImportMediaOutput = {
	/**  The new media id. */
	media: MediaId,
	/**  Detected kind. */
	kind: MediaKind,
	/**  Duration. */
	duration: Time,
};

/**
 *  Insert media as a clip. If the target range is occupied, a new track is created next to the
 *  target (above for video, below for audio) instead of overlapping (arch §4.3).
 */
export type InsertClip = {
	/**  Media to insert. */
	media: MediaId,
	/**  Timeline start. */
	at: Time,
	/**  Target track (default: the main track of the matching kind). */
	track?: TrackId | null,
	/**  Source in-point (default 0). */
	source_in?: Time | null,
	/**  Clip duration (default: rest of the media). */
	duration?: Time | null,
};

/**  Result of `timeline.insert`. */
export type InsertClipOutput = {
	/**  The new item. */
	item: ItemId,
	/**  Track it landed on. */
	track: TrackId,
	/**  Whether a track was created to avoid an overlap. */
	created_track: boolean,
};

/**  A timeline item id (`itm_…`). */
export type ItemId = string;

/**  One item in a [`TrackView`]. */
export type ItemView = {
	/**  Id. */
	id: ItemId,
	/**  Source media. */
	media: MediaId,
	/**  Timeline start. */
	start: Time,
	/**  Timeline end (exclusive). */
	end: Time,
	/**  Source in-point. */
	source_in: Time,
};

/**  An imported file (by reference). */
export type MediaAsset = {
	/**  Id. */
	id: MediaId,
	/**  Path as given at import. */
	path: string,
	/**  Content kind. */
	kind: MediaKind,
	/**  Duration (stub probe). */
	duration: Time,
	/**  Native frame rate (stub probe). */
	frame_rate: FrameRate,
};

/**  A media asset id (`med_…`). */
export type MediaId = string;

/**  What a media asset contains. */
export type MediaKind = 
/**  Video (possibly with audio). */
"video" | 
/**  Audio only. */
"audio" | 
/**  Still image. */
"image";

/**
 *  Open a new, empty in-memory project (spike stub: no file I/O). Replaces the current document
 *  and clears undo history, so it is not undoable.
 */
export type OpenProject = {
	/**  Project name. */
	name: string,
	/**  Sequence frame rate (default 30/1). */
	frame_rate?: FrameRate | null,
	/**  Frame width in pixels (default 1920). */
	width?: number | null,
	/**  Frame height in pixels (default 1080). */
	height?: number | null,
};

/**  Result of `project.open`. */
export type OpenProjectOutput = {
	/**  The new sequence. */
	sequence: SequenceId,
	/**  Its initial video track. */
	track: TrackId,
};

/**  Redo the caller's most recently undone change. */
export type Redo = Record<string, never>;

/**
 *  Render the sequence frame at a time as a PNG (spike stub: the top-most visible video clip is a
 *  flat colour derived from its media id, with a source-position bar along the bottom).
 */
export type RenderFrame = {
	/**  Timeline time. */
	at: Time,
	/**  Output width in pixels, 16..=768 (default 160); height follows the sequence aspect. */
	width?: number | null,
};

/**  Result of `render.frame`. MCP (0H.02) turns `data` into an image content block. */
export type RenderedFrame = {
	/**  Rendered time. */
	at: Time,
	/**  Width in pixels. */
	width: number,
	/**  Height in pixels. */
	height: number,
	/**  MIME type of `data`. */
	mime: string,
	/**  Base64-encoded image bytes. */
	data: string,
	/**  Items under the playhead, top track first. */
	visible: ItemId[],
};

/**  Document revision: +1 per applied transaction (including undo/redo). */
export type Rev = number;

/**  A sequence id (`seq_…`). */
export type SequenceId = string;

/**  Split a clip in two at a timeline time. The left part keeps the id. */
export type SplitClip = {
	/**  Clip to split. */
	item: ItemId,
	/**  Split point; must be strictly inside the clip. */
	at: Time,
};

/**  Result of `clip.split`. */
export type SplitClipOutput = {
	/**  Left part (same id as the input). */
	left: ItemId,
	/**  New right part. */
	right: ItemId,
};

/**  A timeline time or duration in flicks (1/705,600,000 s). JSON integer on the wire; TS `number`. */
export type Time = number;

/**  Result of `timeline.get`. */
export type TimelineView = {
	/**  Project name. */
	project: string,
	/**  Sequence id. */
	sequence: SequenceId,
	/**  Sequence frame rate. */
	frame_rate: FrameRate,
	/**  End of the last item. */
	duration: Time,
	/**  Tracks, top to bottom. */
	tracks: TrackView[],
	/**  Imported media. */
	media: MediaAsset[],
};

/**  A track id (`trk_…`). */
export type TrackId = string;

/**  Track kind. */
export type TrackKind = 
/**  Video track. */
"video" | 
/**  Audio track. */
"audio";

/**  One track in a [`TimelineView`]. */
export type TrackView = {
	/**  Id. */
	id: TrackId,
	/**  Kind. */
	kind: TrackKind,
	/**  Name. */
	name: string,
	/**  Items sorted by start. */
	items: ItemView[],
};

/**
 *  Move a clip's in-point and/or out-point on the timeline. The source in-point follows the new
 *  start; trimming past the media bounds or into a neighbour fails.
 */
export type TrimClip = {
	/**  Clip to trim. */
	item: ItemId,
	/**  New timeline start. */
	start?: Time | null,
	/**  New timeline end (exclusive). */
	end?: Time | null,
};

/**  Result of `clip.trim`. */
export type TrimClipOutput = {
	/**  The clip. */
	item: ItemId,
	/**  Its new start. */
	start: Time,
	/**  Its new end. */
	end: Time,
};

/**  A history entry as reported to callers. */
export type TxSummary = {
	/**  Revision that originally applied the transaction. */
	rev: Rev,
	/**  Label, e.g. `clip.split`. */
	label: string,
};

/**
 *  Undo the caller's most recent change. History is per actor (arch §5.2): an agent's undo never
 *  reverts the user's edits, and fails with `conflict` if a later edit touched the same entities.
 */
export type Undo = Record<string, never>;
