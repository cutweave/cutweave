---
source: ops/tests/codegen.rs
expression: "get(\"schema/queries.json\")"
---
{
  "$comment": "GENERATED by `cargo run -p s5-ops --bin s5-codegen`. Do not edit; snapshot-tested.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entries": [
    {
      "engine_op": false,
      "mcp": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "tier": "core",
        "tool": "render_frame"
      },
      "name": "render.frame",
      "output": {
        "additionalProperties": false,
        "description": "Result of `render.frame`. MCP (0H.02) turns `data` into an image content block.",
        "properties": {
          "at": {
            "description": "Rendered time.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "data": {
            "description": "Base64-encoded image bytes.",
            "type": "string"
          },
          "height": {
            "description": "Height in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "mime": {
            "description": "MIME type of `data`.",
            "type": "string"
          },
          "visible": {
            "description": "Items under the playhead, top track first.",
            "items": {
              "description": "A item id.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "width": {
            "description": "Width in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "at",
          "width",
          "height",
          "mime",
          "data",
          "visible"
        ],
        "title": "RenderedFrame",
        "type": "object"
      },
      "params": {
        "additionalProperties": false,
        "description": "Render the sequence frame at a time as a PNG (spike stub: the top-most visible video clip is a\nflat colour derived from its media id, with a source-position bar along the bottom).",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^(\\d+:[0-5]\\d:[0-5]\\d:\\d+|\\d+(\\.\\d+)?s|f:\\d+)$",
                "type": "string"
              }
            ],
            "description": "Timeline time."
          },
          "width": {
            "default": null,
            "description": "Output width in pixels, 16..=768 (default 160); height follows the sequence aspect.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "at"
        ],
        "title": "RenderFrame",
        "type": "object"
      },
      "summary": "Render the frame at a time as an image",
      "ui_only": false,
      "undoable": false
    },
    {
      "engine_op": false,
      "mcp": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "tier": "core",
        "tool": "timeline_get"
      },
      "name": "timeline.get",
      "output": {
        "additionalProperties": false,
        "description": "Result of `timeline.get`.",
        "properties": {
          "duration": {
            "description": "End of the last item.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "frame_rate": {
            "additionalProperties": false,
            "description": "Sequence frame rate.",
            "properties": {
              "den": {
                "description": "Denominator (seconds).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "num": {
                "description": "Numerator (frames).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "media": {
            "description": "Imported media.",
            "items": {
              "additionalProperties": false,
              "description": "An imported file (by reference).",
              "properties": {
                "duration": {
                  "description": "Duration (stub probe).",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "frame_rate": {
                  "additionalProperties": false,
                  "description": "Native frame rate (stub probe).",
                  "properties": {
                    "den": {
                      "description": "Denominator (seconds).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "num": {
                      "description": "Numerator (frames).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "type": "object"
                },
                "id": {
                  "description": "Id.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": "string"
                },
                "kind": {
                  "description": "Content kind.",
                  "oneOf": [
                    {
                      "const": "video",
                      "description": "Video (possibly with audio).",
                      "type": "string"
                    },
                    {
                      "const": "audio",
                      "description": "Audio only.",
                      "type": "string"
                    },
                    {
                      "const": "image",
                      "description": "Still image.",
                      "type": "string"
                    }
                  ]
                },
                "path": {
                  "description": "Path as given at import.",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "path",
                "kind",
                "duration",
                "frame_rate"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "project": {
            "description": "Project name.",
            "type": "string"
          },
          "sequence": {
            "description": "Sequence id.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "tracks": {
            "description": "Tracks, top to bottom.",
            "items": {
              "additionalProperties": false,
              "description": "One track in a [`TimelineView`].",
              "properties": {
                "id": {
                  "description": "Id.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "items": {
                  "description": "Items sorted by start.",
                  "items": {
                    "additionalProperties": false,
                    "description": "One item in a [`TrackView`].",
                    "properties": {
                      "end": {
                        "description": "Timeline end (exclusive).",
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      "id": {
                        "description": "Id.",
                        "pattern": "^itm_[0-9a-f]{32}$",
                        "type": "string"
                      },
                      "media": {
                        "description": "Source media.",
                        "pattern": "^med_[0-9a-f]{32}$",
                        "type": "string"
                      },
                      "source_in": {
                        "description": "Source in-point.",
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      "start": {
                        "description": "Timeline start.",
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "id",
                      "media",
                      "start",
                      "end",
                      "source_in"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "kind": {
                  "description": "Kind.",
                  "oneOf": [
                    {
                      "const": "video",
                      "description": "Video track.",
                      "type": "string"
                    },
                    {
                      "const": "audio",
                      "description": "Audio track.",
                      "type": "string"
                    }
                  ]
                },
                "name": {
                  "description": "Name.",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "name",
                "items"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "project",
          "sequence",
          "frame_rate",
          "duration",
          "tracks",
          "media"
        ],
        "title": "TimelineView",
        "type": "object"
      },
      "params": {
        "additionalProperties": false,
        "description": "Get the timeline: tracks top to bottom with their items, plus the media they use.",
        "title": "GetTimeline",
        "type": "object"
      },
      "summary": "Get the timeline (tracks, items, media)",
      "ui_only": false,
      "undoable": false
    }
  ],
  "error": {
    "allOf": [
      {
        "description": "Every error a command, query or engine op can return.",
        "oneOf": [
          {
            "description": "An id (or command name) does not exist.",
            "properties": {
              "code": {
                "const": "not_found",
                "type": "string"
              },
              "entity": {
                "description": "Kind.",
                "oneOf": [
                  {
                    "const": "command",
                    "description": "A registry entry (unknown command name).",
                    "type": "string"
                  },
                  {
                    "const": "media",
                    "description": "Media asset.",
                    "type": "string"
                  },
                  {
                    "const": "sequence",
                    "description": "Sequence.",
                    "type": "string"
                  },
                  {
                    "const": "track",
                    "description": "Track.",
                    "type": "string"
                  },
                  {
                    "const": "item",
                    "description": "Timeline item.",
                    "type": "string"
                  }
                ]
              },
              "id": {
                "description": "The missing id.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "entity",
              "id"
            ],
            "type": "object"
          },
          {
            "description": "A param failed validation. `path` is a JSON Pointer into the request params.",
            "properties": {
              "code": {
                "const": "invalid",
                "type": "string"
              },
              "msg": {
                "description": "What is wrong.",
                "type": "string"
              },
              "path": {
                "description": "JSON Pointer (RFC 6901), `\"\"` for the params object itself.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "path",
              "msg"
            ],
            "type": "object"
          },
          {
            "description": "The request conflicts with the current state.",
            "properties": {
              "code": {
                "const": "conflict",
                "type": "string"
              },
              "current_rev": {
                "description": "Revision at the time of the error (filled in by the engine).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "detail": {
                "description": "Human detail.",
                "type": "string"
              },
              "reason": {
                "description": "Machine reason.",
                "oneOf": [
                  {
                    "const": "stale_rev",
                    "description": "`expected_rev` did not match the current revision.",
                    "type": "string"
                  },
                  {
                    "const": "request_id_reused",
                    "description": "A `request_id` was reused with a different payload.",
                    "type": "string"
                  },
                  {
                    "const": "overlap",
                    "description": "The edit would overlap another item on the same track.",
                    "type": "string"
                  },
                  {
                    "const": "history_target_modified",
                    "description": "Undo/redo target was changed by a later transaction (another actor).",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "code",
              "reason",
              "detail",
              "current_rev"
            ],
            "type": "object"
          },
          {
            "description": "Valid request the engine cannot do (yet).",
            "properties": {
              "code": {
                "const": "unsupported",
                "type": "string"
              },
              "msg": {
                "description": "What is unsupported.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "msg"
            ],
            "type": "object"
          },
          {
            "description": "The caller's credential lacks the scope (e.g. an agent calling a UI-only command, arch §6).",
            "properties": {
              "code": {
                "const": "forbidden",
                "type": "string"
              },
              "msg": {
                "description": "What to do instead.",
                "type": "string"
              },
              "scope": {
                "description": "The missing scope, e.g. `ui`.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "scope",
              "msg"
            ],
            "type": "object"
          }
        ],
        "title": "CmdError"
      },
      {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    ]
  },
  "kind": "queries"
}
