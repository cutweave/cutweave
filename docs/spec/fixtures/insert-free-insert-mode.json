{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "insert-free-insert-mode",
  "title": "insert on a free track splits at the time and ripples the track and its partners' track, not the music",
  "command": "timeline.insert",
  "tags": ["free", "linked"],
