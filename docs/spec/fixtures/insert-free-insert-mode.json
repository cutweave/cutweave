    { "track": "A2", "kind": "audio", "items": [
      {"id": "x", "media": "mv", "start": 0, "dur": 10, "group": "gX"},
      {"id": "+n", "media": "mv", "start": 10, "dur": 10, "in": 200, "group": "+gN"},
      {"id": "+x2", "media": "mv", "start": 20, "dur": 10, "in": 10, "group": "+gX2"},
      {"id": "y", "media": "mv", "start": 50, "dur": 20, "in": 40, "group": "gY"}
