{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "overwrite-free-splits-spanning",
  "title": "Overwrite inside a longer clip splits it around the new one, partners too",
  "command": "timeline.overwrite",
  "tags": ["free", "linked"],
  "cites": ["INV-44", "INV-103"],
  "fps": 25,
  "media": {
    "mn": {"kind": "video", "frames": 250, "audio": false},
    "mv": {"kind": "video", "frames": 250, "audio": true}
  },
  "before": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mv", "start": 0, "dur": 60, "group": "gX"}
    ] },
    { "track": "A2", "kind": "audio", "items": [
      {"id": "x", "media": "mv", "start": 0, "dur": 60, "group": "gX"}
    ] }
  ],
  "params": {"sequence": "S", "track": "V2", "media": "mn", "at": "f:20", "duration": "f:10"},
  "after": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mv", "start": 0, "dur": 20, "group": "gX"},
      {"id": "+N", "media": "mn", "start": 20, "dur": 10},
      {"id": "+X2", "media": "mv", "start": 30, "dur": 30, "in": 30, "group": "+gX2"}
    ] },
    { "track": "A2", "kind": "audio", "items": [
      {"id": "x", "media": "mv", "start": 0, "dur": 20, "group": "gX"},
      {"id": "+x2", "media": "mv", "start": 30, "dur": 30, "in": 30, "group": "+gX2"}
    ] }
  ],
  "report": {
    "created": ["+N"],
    "split": [{"left": "X", "right": "+X2", "at": 30}, {"left": "x", "right": "+x2", "at": 30}],
    "trimmed": [{"item": "X", "start": 0, "dur": 20, "in": 0}, {"item": "x", "start": 0, "dur": 20, "in": 0}]
  }
}
