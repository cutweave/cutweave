{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "delete-magnetic-closes-gap",
  "title": "Deleting a main-track clip closes its space; its audio goes with it and the audio track follows",
  "command": "item.delete",
  "tags": ["magnetic", "linked"],
  "cites": ["INV-141", "INV-143", "INV-31"],
  "fps": 25,
  "media": {
    "mv": {"kind": "video", "frames": 250, "audio": true}
  },
  "before": [
    { "track": "V1", "kind": "video", "magnetic": true, "items": [
      {"id": "A", "media": "mv", "start": 0, "dur": 30, "group": "gA"},
      {"id": "B", "media": "mv", "start": 30, "dur": 30, "in": 30, "group": "gB"},
      {"id": "C", "media": "mv", "start": 60, "dur": 30, "in": 60, "group": "gC"}
    ] },
    { "track": "A1", "kind": "audio", "items": [
      {"id": "a", "media": "mv", "start": 0, "dur": 30, "group": "gA"},
      {"id": "b", "media": "mv", "start": 30, "dur": 30, "in": 30, "group": "gB"},
      {"id": "c", "media": "mv", "start": 60, "dur": 30, "in": 60, "group": "gC"}
    ] }
  ],
  "params": {"items": ["B"]},
  "after": [
    { "track": "V1", "kind": "video", "magnetic": true, "items": [
      {"id": "A", "media": "mv", "start": 0, "dur": 30, "group": "gA"},
      {"id": "C", "media": "mv", "start": 30, "dur": 30, "in": 60, "group": "gC"}
    ] },
    { "track": "A1", "kind": "audio", "items": [
      {"id": "a", "media": "mv", "start": 0, "dur": 30, "group": "gA"},
      {"id": "c", "media": "mv", "start": 30, "dur": 30, "in": 60, "group": "gC"}
    ] }
  ],
  "output": {"deleted": ["B", "b"]},
  "report": {
    "removed": ["B", "b"],
    "moved": [{"item": "C", "track": "V1", "start": 30}, {"item": "c", "track": "A1", "start": 30}]
  }
}
