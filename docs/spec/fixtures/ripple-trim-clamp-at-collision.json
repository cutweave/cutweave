{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "ripple-trim-clamp-at-collision",
  "title": "With clamp, a shortening ripple stops where a partner would hit unlinked music",
  "command": "clip.ripple_trim",
  "tags": ["free", "clamp", "linked"],
