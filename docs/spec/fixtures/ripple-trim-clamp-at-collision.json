  "before": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mn", "start": 0, "dur": 40},
      {"id": "Y", "media": "mv", "start": 60, "dur": 20, "in": 60, "group": "gY"}
    ] },
    { "track": "A2", "kind": "audio", "items": [
      {"id": "M", "media": "ma", "start": 0, "dur": 50},
      {"id": "y", "media": "mv", "start": 60, "dur": 20, "in": 60, "group": "gY"}
    ] }
  ],
  "params": {"item": "X", "edge": "end", "delta": "-1.2s", "clamp": true},
  "after": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mn", "start": 0, "dur": 30},
      {"id": "Y", "media": "mv", "start": 50, "dur": 20, "in": 60, "group": "gY"}
    ] },
    { "track": "A2", "kind": "audio", "items": [
      {"id": "M", "media": "ma", "start": 0, "dur": 50},
      {"id": "y", "media": "mv", "start": 50, "dur": 20, "in": 60, "group": "gY"}
    ] }
  ],
  "output": {"applied_delta": "-0.4s", "clamped": true}
}
