{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "replace-remove-old-audio",
  "title": "old_audio remove deletes the old sound when the new media has none",
  "command": "clip.replace",
  "tags": ["free", "linked"],
  "cites": ["INV-251", "INV-21"],
  "fps": 25,
  "media": {
    "mo": {"kind": "video", "frames": 250, "audio": false},
    "mv": {"kind": "video", "frames": 250, "audio": true}
  },
  "before": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mv", "start": 0, "dur": 30, "group": "gX"}
    ] },
    { "track": "A2", "kind": "audio", "items": [
      {"id": "x", "media": "mv", "start": 0, "dur": 30, "group": "gX"}
    ] }
  ],
  "params": {"item": "X", "media": "mo", "old_audio": "remove"},
  "after": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mo", "start": 0, "dur": 30}
    ] },
    { "track": "A2", "kind": "audio", "items": [] }
  ],
  "output": {"item": "X", "shortened": false},
  "report": {
    "removed": ["x"],
    "replaced": [{"item": "X", "media": "mo"}],
    "trimmed": [],
    "relinked": [{"item": "X", "group": null, "parent": null}]
  }
}
