{
  "$schema": "../fixture.schema.json",
  "kind": "edit",
  "id": "link-locked",
  "title": "Linking an item of a locked track is refused",
  "command": "item.link",
  "tags": ["locked", "linked"],
  "cites": ["INV-27"],
  "fps": 25,
  "media": {
    "ma": {"kind": "audio", "frames": 500},
    "mn": {"kind": "video", "frames": 250, "audio": false}
  },
  "before": [
    { "track": "V2", "kind": "video", "items": [
      {"id": "X", "media": "mn", "start": 10, "dur": 20}
    ] },
    { "track": "A2", "kind": "audio", "locked": true, "items": [
      {"id": "M", "media": "ma", "start": 10, "dur": 20}
    ] }
  ],
  "params": {"items": ["X", "M"]},
  "error": {"code": "locked", "id": "A2"}
}
