{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline edit-semantics fixture",
  "description": "One executable example of docs/spec/timeline-edit-semantics.md (WP-2A.01, spec section 9). Checked by `cargo xtask check-fixtures`, which supports exactly the keywords used here.",
  "oneOf": [
    { "$ref": "#/$defs/edit" },
    { "$ref": "#/$defs/snap" },
    { "$ref": "#/$defs/three_point" }
  ],
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "frames": { "type": "integer", "minimum": 0 },
    "flicks": { "type": "integer" },
    "cites": {
      "description": "INV-n ids of the spec that this fixture illustrates.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "command": {
      "enum": [
        "timeline.insert", "timeline.overwrite", "item.move", "item.delete",
        "timeline.ripple_delete", "timeline.lift", "timeline.extract", "timeline.delete_gap",
        "clip.split", "item.duplicate", "clip.trim", "clip.ripple_trim", "clip.roll",
        "clip.slip", "clip.slide", "clip.replace", "item.link", "item.unlink",
        "item.attach", "item.detach", "track.set_magnetic"
      ]
    },
    "tag": { "enum": ["magnetic", "free", "locked", "linked", "clamp"] },
    "media": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["video", "audio", "image"] },
        "frames": { "description": "Length in sequence frames; absent: unbounded.", "type": "integer", "minimum": 1 },
        "audio": { "description": "A video file with a sound stream.", "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "media", "start", "dur"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "media": { "$ref": "#/$defs/name" },
        "start": { "$ref": "#/$defs/frames" },
        "dur": { "type": "integer", "minimum": 1 },
        "in": { "$ref": "#/$defs/frames" },
        "group": { "$ref": "#/$defs/name" },
        "parent": { "$ref": "#/$defs/name" },
        "enabled": { "description": "Default true.", "type": "boolean" }
      }
    },
    "track": {
      "type": "object",
      "required": ["track", "kind", "items"],
      "additionalProperties": false,
      "properties": {
        "track": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["video", "audio"] },
        "magnetic": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/track" } },
    "error": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["invalid", "locked", "not_found", "unsupported", "conflict"] },
        "path": { "type": "string" },
        "id": { "$ref": "#/$defs/name" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created": { "$ref": "#/$defs/names" },
        "removed": { "$ref": "#/$defs/names" },
        "split": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["left", "right", "at"],
            "additionalProperties": false,
            "properties": {
              "left": { "$ref": "#/$defs/name" },
              "right": { "$ref": "#/$defs/name" },
              "at": { "$ref": "#/$defs/frames" }
            }
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "track", "start"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/name" },
              "track": { "$ref": "#/$defs/name" },
              "start": { "$ref": "#/$defs/frames" }
            }
          }
        },
        "trimmed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "start", "dur", "in"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/name" },
              "start": { "$ref": "#/$defs/frames" },
              "dur": { "type": "integer", "minimum": 1 },
              "in": { "$ref": "#/$defs/frames" }
            }
          }
        },
        "relinked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "group", "parent"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/name" },
              "group": { "anyOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
              "parent": { "anyOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
            }
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "media"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/name" },
              "media": { "$ref": "#/$defs/name" }
            }
          }
        },
        "toggled": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "enabled"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/name" },
              "enabled": { "type": "boolean" }
            }
          }
        },
        "created_tracks": { "$ref": "#/$defs/names" }
      }
    },
    "edit": {
      "type": "object",
      "required": ["kind", "id", "title", "cites", "fps", "command", "tags", "media", "before", "params"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["after"] }, { "required": ["error"] }],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "edit" },
        "id": { "$ref": "#/$defs/name" },
        "title": { "$ref": "#/$defs/name" },
        "cites": { "$ref": "#/$defs/cites" },
        "fps": { "type": "integer", "minimum": 1 },
        "command": { "$ref": "#/$defs/command" },
        "tags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tag" } },
        "media": { "type": "object", "additionalProperties": { "$ref": "#/$defs/media" } },
        "before": { "$ref": "#/$defs/tracks" },
        "params": { "description": "Command params: names instead of ids, times as TimeInput.", "type": "object" },
        "after": { "$ref": "#/$defs/tracks" },
        "error": { "$ref": "#/$defs/error" },
        "output": { "description": "Command-specific output fields to compare; times as TimeInput.", "type": "object" },
        "report": { "$ref": "#/$defs/report" }
      }
    },
    "snap_kind": { "enum": ["playhead", "edge", "marker", "beat", "in_out"] },
    "snap": {
      "type": "object",
      "required": ["kind", "id", "title", "cites", "fps", "px_per_second", "threshold_px", "offsets", "r", "candidates", "expected"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "snap" },
        "id": { "$ref": "#/$defs/name" },
        "title": { "$ref": "#/$defs/name" },
        "cites": { "$ref": "#/$defs/cites" },
        "fps": { "type": "integer", "minimum": 1 },
        "px_per_second": { "type": "number", "minimum": 0.001 },
        "threshold_px": { "type": "number", "minimum": 0 },
        "offsets": { "description": "Probe offsets in flicks.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/flicks" } },
        "r": { "description": "Raw time in flicks.", "$ref": "#/$defs/flicks" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "t"],
            "additionalProperties": false,
            "properties": { "kind": { "$ref": "#/$defs/snap_kind" }, "t": { "$ref": "#/$defs/flicks" } }
          }
        },
        "enabled": { "type": "array", "items": { "$ref": "#/$defs/snap_kind" } },
        "expected": {
          "type": "object",
          "required": ["t", "target"],
          "additionalProperties": false,
          "properties": {
            "t": { "$ref": "#/$defs/flicks" },
            "target": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["kind", "t"],
                  "additionalProperties": false,
                  "properties": { "kind": { "$ref": "#/$defs/snap_kind" }, "t": { "$ref": "#/$defs/flicks" } }
                }
              ]
            }
          }
        }
      }
    },
    "three_point": {
      "type": "object",
      "required": ["kind", "id", "title", "cites", "fps", "media", "playhead"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "three_point" },
        "id": { "$ref": "#/$defs/name" },
        "title": { "$ref": "#/$defs/name" },
        "cites": { "$ref": "#/$defs/cites" },
        "fps": { "type": "integer", "minimum": 1 },
        "media": { "$ref": "#/$defs/media" },
        "playhead": { "$ref": "#/$defs/frames" },
        "timeline_in": { "$ref": "#/$defs/frames" },
        "timeline_out": { "$ref": "#/$defs/frames" },
        "source_in": { "$ref": "#/$defs/frames" },
        "source_out": { "$ref": "#/$defs/frames" },
        "expected": {
          "type": "object",
          "required": ["at", "source_in", "duration", "shortened"],
          "additionalProperties": false,
          "properties": {
            "at": { "$ref": "#/$defs/frames" },
            "source_in": { "$ref": "#/$defs/frames" },
            "duration": { "type": "integer", "minimum": 1 },
            "shortened": { "type": "boolean" }
          }
        },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
