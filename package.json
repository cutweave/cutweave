{
  "name": "cutweave",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "storybook:build": "pnpm --filter @cutweave/ui run storybook:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
