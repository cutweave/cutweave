{
  "description": "Split, trim, move and delete linked clips, then undo and redo (the caller's own history, and `steps` of anyone's), checkpoint and restore.",
  "steps": [
    { "cmd": "project.new", "args": { "name": "Parity" } },
    { "cmd": "media.import", "args": { "paths": [{ "$media": "a.mp4" }, { "$media": "b.mp4" }] } },
    {
      "cmd": "timeline.insert",
      "args": {
        "sequence": { "$ref": "steps[0].output.sequence" },
        "track": { "$ref": "steps[0].output.video_track" },
        "media": { "$ref": "steps[1].output.media_ids[0]" },
        "at": 0
      }
    },
    { "cmd": "clip.split", "args": { "item": { "$ref": "steps[2].output.clips[0]" }, "at": "4s" } },
    { "cmd": "clip.trim", "args": { "item": { "$ref": "steps[3].output.right" }, "edge": "end", "to": "8s" } },
    { "cmd": "item.move", "args": { "item": { "$ref": "steps[3].output.right" }, "start": "12s" } },
    { "cmd": "clip.trim", "args": { "item": { "$ref": "steps[3].output.left" }, "edge": "start", "delta": "1s" } },
    { "cmd": "edit.checkpoint", "args": { "name": "before-delete" } },
    { "cmd": "item.delete", "args": { "items": [{ "$ref": "steps[3].output.left" }] } },
    {
      "cmd": "timeline.insert",
      "args": {
        "sequence": { "$ref": "steps[0].output.sequence" },
        "track": { "$ref": "steps[0].output.video_track" },
        "media": { "$ref": "steps[1].output.media_ids[1]" },
        "at": "20s",
        "duration": "3s",
        "link": false
      }
    },
    { "cmd": "edit.undo" },
    { "cmd": "edit.undo" },
    { "cmd": "edit.redo" },
    { "cmd": "edit.undo" },
    { "cmd": "edit.undo", "args": { "actor": "*", "steps": 2 } },
    { "cmd": "edit.redo", "args": { "actor": "*", "steps": 2 } },
    { "cmd": "item.set_props", "args": { "item": { "$ref": "steps[3].output.right" }, "props": { "enabled": false } } },
    { "cmd": "edit.restore", "args": { "checkpoint": "before-delete" } },
    { "cmd": "timeline.get", "args": { "sequence": { "$ref": "steps[0].output.sequence" }, "depth": 2 } },
    { "cmd": "item.get", "args": { "item": { "$ref": "steps[3].output.right" } } }
  ]
}
