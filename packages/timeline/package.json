{
  "name": "@cutweave/timeline",
  "version": "0.0.0",
  "private": true,
  "description": "Canvas2D virtualized timeline renderer and interaction state machine",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:machine": "vitest run --root ../.. --silent=false packages/timeline/src/interaction/coverage.test.ts",
    "bench": "node bench/run.mjs",
    "demo": "vite demo",
    "test:perf": "playwright test -c demo/playwright.config.ts"
  },
  "dependencies": {
    "@cutweave/protocol": "workspace:*",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "fast-check": "4.10.2",
    "vite": "8.3.8"
  }
}
