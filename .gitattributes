* text=auto eol=lf

# Golden frames and media fixtures live in Git LFS (docs/06-dev-process.md). Only the images:
# the READMEs and the update log next to them stay plain text.
testdata/golden/**/*.png filter=lfs diff=lfs merge=lfs -text
testdata/golden/**/*.exr filter=lfs diff=lfs merge=lfs -text
*.golden.png filter=lfs diff=lfs merge=lfs -text
*.golden.exr filter=lfs diff=lfs merge=lfs -text

# Binary files.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# UI visual-regression baselines (WP-0K.05): per adapter class, Linux software-rendered Chromium.
packages/ui/__screenshots__/** filter=lfs diff=lfs merge=lfs -text
