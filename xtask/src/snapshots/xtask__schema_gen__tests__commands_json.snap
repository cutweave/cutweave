    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Imports media files and returns their `media_ids` at once (arch §7, R21). Each file is\nprobed synchronously (up to 4 at a time, 5 s each by default) and every readable one is\nregistered in one transaction (one undo step); files that are missing, unsupported, corrupt\nor too slow to probe are listed in `failed` and get no asset. Files whose content is\nalready in the project are returned as duplicates. Background analysis (frame index,\nthumbnails, waveform) then runs as jobs whose ids are returned in `job_ids`. Agents and\nheadless callers may only import from the project folder and user-approved folders; any\nother path fails the call with `Invalid` at `/paths/<i>`.\n\nA path may also be a folder (WP-2F.09): the engine imports the files it can read inside it\n(up to 16 levels down, no links, no hidden files, at most 2,000 files per call; more fails\nwith `Invalid`), counts the rest in `skipped`, and with `keep_structure` (default true)\ncreates a bin folder for each directory that holds new media, named after it, inside\n`folder`. One undo removes the media and those folders; files already in the project stay\nwhere they are.",
        "properties": {
          "folder": {
            "default": null,
            "description": "Bin folder (default: top level).",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "keep_structure": {
            "default": null,
            "description": "For folders in `paths`: mirror their directories as bin folders (default true); false\nputs every file straight into `folder`.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "paths": {
            "description": "Absolute paths of files or folders (1..=256, no repeats).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "paths"
        ],
        "title": "MediaImport",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "core",
      "mcp_tool": "media_import",
      "name": "media.import",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.import`.",
        "properties": {
          "failed": {
            "description": "The paths that could not be imported, in request order.",
            "items": {
              "additionalProperties": false,
              "description": "A file that was not imported (no asset was created for it).",
              "properties": {
                "code": {
                  "description": "Machine-readable reason.",
                  "oneOf": [
                    {
                      "const": "not_found",
                      "description": "There is no readable file at the path.",
                      "type": "string"
                    },
                    {
                      "const": "unsupported",
                      "description": "The file holds no playable audio or video.",
                      "type": "string"
                    },
                    {
                      "const": "timed_out",
                      "description": "Probing took longer than the per-file timeout.",
                      "type": "string"
                    },
                    {
                      "const": "io",
                      "description": "Reading the file failed.",
                      "type": "string"
                    },
                    {
                      "const": "invalid",
                      "description": "The probe result cannot be registered (for example a zero duration).",
                      "type": "string"
                    }
                  ]
                },
                "error": {
                  "description": "Human-readable reason.",
                  "type": "string"
                },
                "path": {
                  "description": "The path as requested.",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "error"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "folders": {
            "description": "How many bin folders were created for the directories of imported folders.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "job_ids": {
            "description": "Background analysis jobs queued for the new assets (wait with `job.wait`); empty when\nno analysis stage is installed.",
            "items": {
              "description": "A job id: `^job_[0-9a-f]{32}$`.",
              "pattern": "^job_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "media": {
            "description": "One entry per imported path, in request order.",
            "items": {
              "additionalProperties": false,
              "description": "One imported file.",
              "properties": {
                "duplicate": {
                  "description": "`true` when the content was already in the project and nothing was added.",
                  "type": "boolean"
                },
                "kind": {
                  "description": "What the asset is.",
                  "oneOf": [
                    {
                      "const": "video",
                      "description": "A video file (may also carry audio).",
                      "type": "string"
                    },
                    {
                      "const": "audio",
                      "description": "An audio-only file.",
                      "type": "string"
                    },
                    {
                      "const": "image",
                      "description": "A still image (no duration).",
                      "type": "string"
                    },
                    {
                      "const": "sequence_ref",
                      "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                      "type": "string"
                    }
                  ]
                },
                "media_id": {
                  "description": "The asset; an existing one if the same content was imported before.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": "string"
                },
                "path": {
                  "description": "The path as requested.",
                  "type": "string"
                },
                "proxy": {
                  "description": "Whether a proxy (a small copy the preview scrubs, WP-2F.01) was queued for it, or is\nalready in the cache.",
                  "oneOf": [
                    {
                      "const": "none",
                      "description": "None is made (the policy does not want one, or the file cannot have one).",
                      "type": "string"
                    },
                    {
                      "const": "queued",
                      "description": "Its generation is queued (after the asset's analysis); `media.proxy_status` follows it.",
                      "type": "string"
                    },
                    {
                      "const": "ready",
                      "description": "One is already in the cache (the same content was imported before).",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "path",
                "media_id",
                "kind",
                "duplicate",
                "proxy"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "media_ids": {
            "description": "The assets of `media`, in the same order (duplicates name the existing asset).",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "skipped": {
            "additionalProperties": false,
            "description": "What was left out of the folders in the request.",
            "properties": {
              "too_deep": {
                "description": "Folders nested deeper than 16 levels below the one you gave, which were not entered.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "unreadable": {
                "description": "Files and folders that could not be read (or whose probe timed out).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "unsupported": {
                "description": "Files that hold no playable audio, video or picture.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "unsupported",
              "unreadable",
              "too_deep"
            ],
            "type": "object"
          }
        },
        "required": [
          "media",
          "media_ids",
          "failed",
          "job_ids",
          "skipped",
          "folders"
        ],
        "title": "MediaImportOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Import media files: probe and register them now, return media ids and analysis job ids",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Moves assets and folders (with everything inside them) into a folder, or to the top level\nwithout `to`. Moving a folder into itself or one of its subfolders, or so deep that\nsomething would be nested more than 32 levels, fails with `Invalid`. A moved folder whose\nname the destination already has, ignoring case, fails with `Invalid` unless `on_conflict`\nis `rename`. Timelines and files on disk never change.",
        "properties": {
          "folders": {
            "default": null,
            "description": "Folders to move, with their contents.",
            "items": {
              "description": "A Folder id: `^fld_[0-9a-f]{32}$`.",
              "pattern": "^fld_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "media": {
            "default": null,
            "description": "Assets to move.",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "on_conflict": {
            "anyOf": [
              {
                "description": "What to do when a folder's name is already taken where it goes.",
                "oneOf": [
                  {
                    "const": "fail",
                    "description": "Fail with `Invalid` (the default).",
                    "type": "string"
                  },
                  {
                    "const": "rename",
                    "description": "Use the next free name: \"Day 1 2\", \"Day 1 3\", …",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When a moved folder's name is taken in `to`: `fail` (default) or `rename`."
          },
          "to": {
            "default": null,
            "description": "The destination folder; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "MediaMove",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "media_move",
      "name": "media.move",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.move`.",
        "properties": {
          "folders": {
            "description": "The folders that changed parent (those already there are left out).",
            "items": {
              "description": "A Folder id: `^fld_[0-9a-f]{32}$`.",
              "pattern": "^fld_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "media": {
            "description": "The assets that changed folder (those already there are left out).",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "renamed": {
            "description": "Folders renamed because their name was taken (`on_conflict: rename`).",
            "items": {
              "additionalProperties": false,
              "description": "A folder that got a new name because its name was taken where it went.",
              "properties": {
                "folder": {
                  "description": "The folder.",
                  "pattern": "^fld_[0-9a-f]{32}$",
                  "type": "string"
                },
                "from": {
                  "description": "Its name before.",
                  "type": "string"
                },
                "to": {
                  "description": "Its name now.",
                  "type": "string"
                }
              },
              "required": [
                "folder",
                "from",
                "to"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "to": {
            "description": "Where everything went; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "to",
          "media",
          "folders",
          "renamed"
        ],
        "title": "MediaMoved",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Move media assets and folders into a folder of the bin, or to its top level",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Shows where the proxies of video assets are: none, queued, generating (with progress),\nready (path, size), incomplete, evicted or failed, and whether the policy wants one.",
        "properties": {
          "media": {
            "default": null,
            "description": "The assets; absent: every video asset of the project.",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "MediaProxyStatus",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_proxy_status",
      "name": "media.proxy_status",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of the proxy commands.",
        "properties": {
          "policy": {
            "description": "The policy that decides which assets get one automatically.",
            "oneOf": [
              {
                "const": "off",
                "description": "Never automatically (`media.generate_proxy` still makes one).",
                "type": "string"
              },
              {
                "const": "auto",
                "description": "For video that is slow to scrub ([`auto_reason`]); the default.",
                "type": "string"
              },
              {
                "const": "all",
                "description": "For every video file.",
                "type": "string"
              }
            ]
          },
          "proxies": {
            "description": "One entry per asset, in request order (`media.proxy_status` without `media`: every video\nasset, by id).",
            "items": {
              "additionalProperties": false,
              "description": "One asset's proxy (`ProxyRef` of WP-2F.01).",
              "properties": {
                "bytes": {
                  "description": "Its size in bytes while it is ready.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "error": {
                  "description": "Why the last generation failed.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "job_id": {
                  "description": "The job making it (queued or generating).",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "media_id": {
                  "description": "The asset.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": "string"
                },
                "path": {
                  "description": "The proxy file while it is ready.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "profile": {
                  "description": "How it is made (`prores_proxy-960`), once there is one.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "progress": {
                  "description": "Done fraction while generating.",
                  "format": "double",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "reason": {
                  "description": "Why the policy wants one, or why the asset cannot have one.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "size": {
                  "description": "Its picture size `[width, height]`.",
                  "items": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "status": {
                  "description": "Where its proxy is.",
                  "oneOf": [
                    {
                      "const": "none",
                      "description": "There is none and none is being made.",
                      "type": "string"
                    },
                    {
                      "const": "queued",
                      "description": "Waiting for its job to start.",
                      "type": "string"
                    },
                    {
                      "const": "generating",
                      "description": "Being made (see `progress`).",
                      "type": "string"
                    },
                    {
                      "const": "ready",
                      "description": "Ready: the preview scrubs it.",
                      "type": "string"
                    },
                    {
                      "const": "incomplete",
                      "description": "A generation stopped before the end (cancelled, or the engine stopped); the next one\ncontinues from where it got.",
                      "type": "string"
                    },
                    {
                      "const": "evicted",
                      "description": "It was removed from the cache (its limit, a clear, `media.delete_proxy`): the original\nis used; `media.generate_proxy` makes it again.",
                      "type": "string"
                    },
                    {
                      "const": "failed",
                      "description": "The last generation failed (see `error`).",
                      "type": "string"
                    }
                  ]
                },
                "wanted": {
                  "description": "Whether the project's policy wants one (it is made automatically).",
                  "type": "boolean"
                }
              },
              "required": [
                "media_id",
                "status",
                "wanted",
                "reason",
                "profile",
                "path",
                "bytes",
                "size",
                "job_id",
                "progress",
                "error"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "proxies",
          "policy"
        ],
        "title": "ProxiesOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Show the proxies of video assets: status, progress, file, size, policy",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Registers a probed media file. Internal plumbing of `media.import` and the import job\n(WP-1D.07): the kind (video, audio or image) derives from the probe streams. If an asset\nwith the same `content_hash` already exists it is returned unchanged (`created: false`,\nand it stays in its folder).",
        "properties": {
          "content_hash": {
            "description": "Content hash used to relink and deduplicate (non-empty, no whitespace).",
            "type": "string"
          },
          "folder": {
            "default": null,
            "description": "The folder of the bin to put the new asset in; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "media_id": {
            "default": null,
            "description": "ID for the new asset; minted by the engine when absent. Must not exist yet.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Absolute path of the file.",
            "type": "string"
          },
          "probe": {
            "description": "What probing found.",
            "properties": {
              "audio": {
                "additionalProperties": false,
                "description": "Main audio stream format, if any.",
                "properties": {
                  "channels": {
                    "description": "Channel count.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "rate": {
                    "description": "Samples per second.",
                    "maximum": 352800000,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "rate",
                  "channels"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "color": {
                "additionalProperties": false,
                "description": "Color tags of the main video stream.",
                "properties": {
                  "matrix": {
                    "description": "YUV matrix coefficients.",
                    "examples": [
                      "gbr",
                      "bt709",
                      "fcc",
                      "bt470bg",
                      "smpte170m",
                      "smpte240m",
                      "ycgco",
                      "bt2020nc",
                      "bt2020c",
                      "ictcp"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "primaries": {
                    "description": "Color primaries.",
                    "examples": [
                      "bt709",
                      "bt470m",
                      "bt470bg",
                      "smpte170m",
                      "smpte240m",
                      "film",
                      "bt2020",
                      "smpte428",
                      "smpte431",
                      "smpte432",
                      "ebu3213"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "range": {
                    "anyOf": [
                      {
                        "description": "Sample range of a video stream.",
                        "oneOf": [
                          {
                            "const": "limited",
                            "description": "Limited (\"TV\", 16–235 for 8-bit luma).",
                            "type": "string"
                          },
                          {
                            "const": "full",
                            "description": "Full (\"PC\", 0–255).",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Sample range."
                  },
                  "transfer": {
                    "description": "Transfer characteristics.",
                    "examples": [
                      "bt709",
                      "gamma22",
                      "gamma28",
                      "smpte170m",
                      "smpte240m",
                      "linear",
                      "iec61966-2-1",
                      "bt2020-10",
                      "bt2020-12",
                      "smpte2084",
                      "arib-std-b67"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "duration": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Playable length, if known (images have none)."
              },
              "fps": {
                "additionalProperties": false,
                "description": "Frame rate of the main video stream, if constant or nominal.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "rotation": {
                "description": "Display rotation in degrees clockwise: 0, 90, 180 or 270.",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "streams": {
                "description": "Streams in container order.",
                "items": {
                  "description": "One stream of a media file.",
                  "properties": {
                    "channels": {
                      "description": "Channel count (audio).",
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "codec": {
                      "description": "Codec name (FFmpeg naming, e.g. `h264`, `aac`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "height": {
                      "description": "Coded height in pixels (video).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "index": {
                      "description": "Index in the container.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "kind": {
                      "description": "Stream kind.",
                      "oneOf": [
                        {
                          "const": "video",
                          "description": "Pictures.",
                          "type": "string"
                        },
                        {
                          "const": "audio",
                          "description": "Sound.",
                          "type": "string"
                        },
                        {
                          "const": "subtitle",
                          "description": "Subtitles or captions.",
                          "type": "string"
                        },
                        {
                          "const": "data",
                          "description": "Timed metadata or other data.",
                          "type": "string"
                        },
                        {
                          "const": "attachment",
                          "description": "Attached files (fonts, cover art).",
                          "type": "string"
                        }
                      ]
                    },
                    "language": {
                      "description": "Language tag (e.g. `eng`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pixel_format": {
                      "description": "Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "profile": {
                      "description": "Codec profile (e.g. `High`, `Main 10`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sample_rate": {
                      "description": "Sample rate (audio).",
                      "maximum": 352800000,
                      "minimum": 1,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "width": {
                      "description": "Coded width in pixels (video).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "index",
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "vfr": {
                "description": "Variable frame rate: times map through the frame index, never through `fps` (arch §4.1).",
                "type": "boolean"
              }
            },
            "required": [
              "streams",
              "vfr",
              "rotation",
              "color"
            ],
            "type": "object"
          }
        },
        "required": [
          "path",
          "probe",
          "content_hash"
        ],
        "title": "MediaRegister",
        "type": "object"
      },
      "kind": "command",
      "mcp": "hidden",
      "mcp_tool": null,
      "name": "media.register",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.register`.",
        "properties": {
          "created": {
            "description": "`false` when an asset with the same content hash already existed and nothing changed.",
            "type": "boolean"
          },
          "kind": {
            "description": "What the asset is.",
            "oneOf": [
              {
                "const": "video",
                "description": "A video file (may also carry audio).",
                "type": "string"
              },
              {
                "const": "audio",
                "description": "An audio-only file.",
                "type": "string"
              },
              {
                "const": "image",
                "description": "A still image (no duration).",
                "type": "string"
              },
              {
                "const": "sequence_ref",
                "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                "type": "string"
              }
            ]
          },
          "media_id": {
            "description": "The asset: the new one, or the existing one with the same content hash.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "media_id",
          "kind",
          "created"
        ],
        "title": "MediaRegistered",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Register a probed media file (used by import; deduplicates by content hash)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Registers `entries` like `media.register` and puts each new asset into the bin folders named\nby its `dirs`, created inside `folder` as needed. Internal plumbing of `media.import`.",
        "properties": {
          "entries": {
            "description": "The files (1..=2000).",
            "items": {
              "additionalProperties": false,
              "description": "One file of a tree and the directories above it.",
              "properties": {
                "dirs": {
                  "description": "The names of the bin folders to put the file in, outermost first, inside `folder`; empty:\nstraight into `folder`.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "register": {
                  "additionalProperties": false,
                  "description": "The file. Its `folder` is ignored.",
                  "properties": {
                    "content_hash": {
                      "description": "Content hash used to relink and deduplicate (non-empty, no whitespace).",
                      "type": "string"
                    },
                    "folder": {
                      "default": null,
                      "description": "The folder of the bin to put the new asset in; absent: the top level.",
                      "pattern": "^fld_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "media_id": {
                      "default": null,
                      "description": "ID for the new asset; minted by the engine when absent. Must not exist yet.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "path": {
                      "description": "Absolute path of the file.",
                      "type": "string"
                    },
                    "probe": {
                      "description": "What probing found.",
                      "properties": {
                        "audio": {
                          "additionalProperties": false,
                          "description": "Main audio stream format, if any.",
                          "properties": {
                            "channels": {
                              "description": "Channel count.",
                              "format": "uint16",
                              "maximum": 65535,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "rate": {
                              "description": "Samples per second.",
                              "maximum": 352800000,
                              "minimum": 1,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "rate",
                            "channels"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "color": {
                          "additionalProperties": false,
                          "description": "Color tags of the main video stream.",
                          "properties": {
                            "matrix": {
                              "description": "YUV matrix coefficients.",
                              "examples": [
                                "gbr",
                                "bt709",
                                "fcc",
                                "bt470bg",
                                "smpte170m",
                                "smpte240m",
                                "ycgco",
                                "bt2020nc",
                                "bt2020c",
                                "ictcp"
                              ],
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "primaries": {
                              "description": "Color primaries.",
                              "examples": [
                                "bt709",
                                "bt470m",
                                "bt470bg",
                                "smpte170m",
                                "smpte240m",
                                "film",
                                "bt2020",
                                "smpte428",
                                "smpte431",
                                "smpte432",
                                "ebu3213"
                              ],
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "range": {
                              "anyOf": [
                                {
                                  "description": "Sample range of a video stream.",
                                  "oneOf": [
                                    {
                                      "const": "limited",
                                      "description": "Limited (\"TV\", 16–235 for 8-bit luma).",
                                      "type": "string"
                                    },
                                    {
                                      "const": "full",
                                      "description": "Full (\"PC\", 0–255).",
                                      "type": "string"
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "Sample range."
                            },
                            "transfer": {
                              "description": "Transfer characteristics.",
                              "examples": [
                                "bt709",
                                "gamma22",
                                "gamma28",
                                "smpte170m",
                                "smpte240m",
                                "linear",
                                "iec61966-2-1",
                                "bt2020-10",
                                "bt2020-12",
                                "smpte2084",
                                "arib-std-b67"
                              ],
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "type": "object"
                        },
                        "duration": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                {
                                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                  "type": "string"
                                }
                              ],
                              "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Playable length, if known (images have none)."
                        },
                        "fps": {
                          "additionalProperties": false,
                          "description": "Frame rate of the main video stream, if constant or nominal.",
                          "properties": {
                            "den": {
                              "description": "Seconds.",
                              "maximum": 4294967295,
                              "minimum": 1,
                              "type": "integer"
                            },
                            "num": {
                              "description": "Frames.",
                              "maximum": 4294967295,
                              "minimum": 1,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "num",
                            "den"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "rotation": {
                          "description": "Display rotation in degrees clockwise: 0, 90, 180 or 270.",
                          "format": "uint16",
                          "maximum": 65535,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "streams": {
                          "description": "Streams in container order.",
                          "items": {
                            "description": "One stream of a media file.",
                            "properties": {
                              "channels": {
                                "description": "Channel count (audio).",
                                "format": "uint16",
                                "maximum": 65535,
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "codec": {
                                "description": "Codec name (FFmpeg naming, e.g. `h264`, `aac`).",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "height": {
                                "description": "Coded height in pixels (video).",
                                "format": "uint32",
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "index": {
                                "description": "Index in the container.",
                                "format": "uint32",
                                "minimum": 0,
                                "type": "integer"
                              },
                              "kind": {
                                "description": "Stream kind.",
                                "oneOf": [
                                  {
                                    "const": "video",
                                    "description": "Pictures.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "audio",
                                    "description": "Sound.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "subtitle",
                                    "description": "Subtitles or captions.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "data",
                                    "description": "Timed metadata or other data.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "attachment",
                                    "description": "Attached files (fonts, cover art).",
                                    "type": "string"
                                  }
                                ]
                              },
                              "language": {
                                "description": "Language tag (e.g. `eng`).",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "pixel_format": {
                                "description": "Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video).",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "profile": {
                                "description": "Codec profile (e.g. `High`, `Main 10`).",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "sample_rate": {
                                "description": "Sample rate (audio).",
                                "maximum": 352800000,
                                "minimum": 1,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "width": {
                                "description": "Coded width in pixels (video).",
                                "format": "uint32",
                                "minimum": 0,
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "index",
                              "kind"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "vfr": {
                          "description": "Variable frame rate: times map through the frame index, never through `fps` (arch §4.1).",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "streams",
                        "vfr",
                        "rotation",
                        "color"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "path",
                    "probe",
                    "content_hash"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "dirs",
                "register"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "folder": {
            "default": null,
            "description": "The folder the tree goes into; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entries"
        ],
        "title": "MediaRegisterTree",
        "type": "object"
      },
      "kind": "command",
      "mcp": "hidden",
      "mcp_tool": null,
      "name": "media.register_tree",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.register_tree`.",
