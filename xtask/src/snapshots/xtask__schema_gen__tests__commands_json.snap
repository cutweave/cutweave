    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Overwrites a range of a track with a media clip: `timeline.insert` with mode `overwrite`.\nWhatever is under `[at, at + duration)` on the track is cut out first (items inside are\nremoved, items across an edge are trimmed, an item across the whole range is split around\nit), and their linked partners get the same cut. Nothing ripples. On the magnetic main track\n`at` is clamped to its end.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Timeline position of the clip's first frame, `>= 0`."
          },
          "audio_track": {
            "default": null,
            "description": "The audio track for the linked sound (default: the first unlocked free one).",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clip length, `> 0` (default: the rest of the media)."
          },
          "link": {
            "default": null,
            "description": "Also place the audio of a video file as a linked clip (default `true`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "media": {
            "description": "The media to place.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "source_in": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Position in the media to start from (default 0)."
          },
          "track": {
            "description": "The target track.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "track",
          "media",
          "at"
        ],
        "title": "TimelineOverwrite",
        "type": "object"
      },
