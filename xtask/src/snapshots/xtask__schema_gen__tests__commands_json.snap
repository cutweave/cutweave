        },
        "required": [
          "marker"
        ],
        "title": "TimelineRemoveMarker",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_remove_marker",
      "name": "timeline.remove_marker",
