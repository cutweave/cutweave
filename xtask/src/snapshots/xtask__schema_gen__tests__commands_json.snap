              },
              {
                "const": "hevc",
                "description": "H.265 / HEVC.",
                "type": "string"
              },
              {
                "const": "av1",
                "description": "AV1.",
                "type": "string"
              },
              {
                "const": "prores",
                "description": "Apple ProRes.",
                "type": "string"
              },
              {
                "const": "gif",
                "description": "GIF (palette).",
                "type": "string"
              }
            ]
          },
          "container": {
            "anyOf": [
              {
                "description": "The file format of the output.",
                "oneOf": [
                  {
                    "const": "mp4",
                    "description": "MP4.",
                    "type": "string"
                  },
                  {
                    "const": "mov",
