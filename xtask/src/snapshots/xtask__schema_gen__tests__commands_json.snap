    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists the open transactions (oldest first) and the items each soft-locks: a `gesture` or\n`proposal` locks every item it touched for other actors until it closes; a `batch` locks\nnothing. Gestures carry their idle deadline (`expires_at`); `mine` marks your connection's.",
        "title": "ListLocks",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_locks",
      "name": "edit.locks",
      "namespace": "edit",
      "output_schema": {
        "description": "What `edit.locks` returns.",
        "properties": {
          "committed_rev": {
            "description": "The committed revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "rev": {
            "description": "The live revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "transactions": {
            "description": "Every open transaction, oldest first.",
            "items": {
              "description": "An open transaction and the items it soft-locks, as `edit.locks` reports it.",
              "properties": {
                "actor": {
                  "description": "Who opened it.",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "conflicted": {
                  "description": "A commit by another transaction overlapped its changes: it can only be cancelled.",
                  "type": "boolean"
                },
                "expires_at": {
                  "description": "A gesture's idle deadline: the engine cancels it then unless a request names it first.\n`null` for proposals and batches (no idle timeout).",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "items": {
                  "description": "The items it soft-locks, in id order. Only gestures and proposals lock; a batch's\nchanges are invisible until it commits, so it locks nothing.",
                  "items": {
                    "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                    "pattern": "^itm_[0-9a-f]{32}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "kind": {
                  "description": "`batch`, `gesture` or `proposal`.",
                  "oneOf": [
                    {
                      "const": "batch",
                      "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                      "type": "string"
                    },
                    {
                      "const": "gesture",
                      "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                      "type": "string"
                    },
                    {
                      "const": "proposal",
                      "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                      "type": "string"
                    }
                  ]
                },
                "label": {
                  "description": "Its label (the undo entry's name).",
                  "type": "string"
                },
                "last_activity": {
                  "description": "When a request last named it.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "mine": {
                  "description": "Whether the caller's connection owns it.",
                  "type": "boolean"
                },
                "opened_at": {
                  "description": "When it was opened.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "tx": {
                  "description": "The transaction.",
                  "pattern": "^tx_[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "tx",
                "kind",
                "label",
                "actor",
                "mine",
                "items",
                "opened_at",
                "last_activity",
                "expires_at",
                "conflicted"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "transactions",
          "rev",
          "committed_rev"
        ],
        "title": "LockList",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List open transactions and the items they soft-lock (who is editing what)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Redoes the most recently undone change of an actor (default: yours). A new change by that\nactor clears its redo stack. Refused with `Conflict` when the same things changed since the\nundo.",
        "properties": {
          "actor": {
            "default": null,
            "description": "Whose change (see `edit.undo`). Default: the caller's own.",
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Redo",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_redo",
      "name": "edit.redo",
      "namespace": "edit",
      "output_schema": {
        "description": "The result of `edit.undo` / `edit.redo`.",
        "properties": {
          "actor": {
            "description": "Whose entry it is.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": "string"
          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "entry": {
            "description": "The entry undone or redone (its original transaction).",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          },
          "label": {
            "description": "Its label.",
            "type": "string"
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "The new transaction that undid or redid it.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "entry",
          "actor",
          "label",
          "rev",
          "committed_rev"
        ],
        "title": "HistoryMoved",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Redo the last undone change of yours, or of another actor (`actor`; `*` = anyone)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Brings the document back to a checkpoint as one new, undoable change by you (history is\nnot truncated; `edit.undo` reverts the restore). Without `force`, refused with `Conflict`\nwhen it would also revert other actors' changes made since the checkpoint.",
        "properties": {
          "checkpoint": {
            "description": "The checkpoint: its id (`cp_<n>`) or name.",
            "type": "string"
          },
          "force": {
            "default": false,
            "description": "Also revert other actors' changes made since the checkpoint.",
            "type": "boolean"
          }
        },
        "required": [
          "checkpoint"
        ],
        "title": "Restore",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_restore",
      "name": "edit.restore",
      "namespace": "edit",
      "output_schema": {
        "description": "The result of `edit.restore`.",
        "properties": {
          "checkpoint": {
            "description": "The checkpoint.",
            "pattern": "^cp_[0-9]+$",
            "type": "string"
          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "reverted": {
            "description": "Whose changes since the checkpoint it reverted.",
            "items": {
              "description": "Changes a checkpoint restore reverted, by actor.",
              "properties": {
                "actor": {
                  "description": "The actor.",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "txs": {
                  "description": "Its transactions (since the checkpoint) whose changes were reverted, oldest first.",
                  "items": {
                    "description": "A transaction id.",
                    "pattern": "^tx_[0-9]+$",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "actor",
                "txs"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "reverted_unknown": {
            "description": "It also reverted changes that are no longer in the history (authors unknown).",
            "type": "boolean"
          },
          "tx": {
            "description": "The restoring transaction (undo it with `edit.undo`); `None` if the document already\nequalled the checkpoint.",
            "pattern": "^tx_[0-9]+$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "checkpoint",
          "tx",
          "rev",
          "committed_rev",
          "reverted",
          "reverted_unknown"
        ],
        "title": "Restored",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Restore a checkpoint as one undoable change",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Undoes the latest change of an actor (default: yours) as a new transaction. History is per\nactor: undoing the agent's change leaves your later edits alone. Refused with\n`Conflict{reason: history_target_modified}` when someone changed the same things since (the\ndetail names them) or the result would be invalid; nothing changes then.",
        "properties": {
          "actor": {
            "default": null,
            "description": "Whose change: `user`, `agent:<label>`, `plugin:<id>`, `system`, or `*` for the most\nrecent change by anyone. Default: the caller's own.",
            "pattern": "^(\\*|user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Undo",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "core",
      "mcp_tool": "edit_undo",
      "name": "edit.undo",
      "namespace": "edit",
      "output_schema": {
        "description": "The result of `edit.undo` / `edit.redo`.",
        "properties": {
          "actor": {
            "description": "Whose entry it is.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": "string"
          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "entry": {
            "description": "The entry undone or redone (its original transaction).",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          },
          "label": {
            "description": "Its label.",
            "type": "string"
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "The new transaction that undid or redid it.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "entry",
          "actor",
          "label",
          "rev",
          "committed_rev"
        ],
        "title": "HistoryMoved",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Undo your last change, or another actor's (`actor`; `*` = anyone's latest)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Deletes items and their linked partners. Gaps stay (no ripple). All or nothing: if any\naffected track is locked the call fails with `Locked` and nothing is deleted. Unknown items\nare `NotFound`; repeated IDs are deleted once.",
        "properties": {
          "items": {
            "description": "The items to delete, at least one.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ItemDelete",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "item_delete",
      "name": "item.delete",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.delete`.",
        "properties": {
          "deleted": {
            "description": "Every deleted item: the requested ones in request order, then their linked partners.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "ItemDeleteOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Delete items and their linked partners (no ripple; fails if a track is locked)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Moves an item to a new start, optionally onto another track of the same kind and sequence.\nThe item's linked partners move by the same amount on their own tracks (`unlink: true`\nmoves only this item and removes it from its group). Overlap is `Invalid{path:\"/start\"}`\nby default; `overlap: \"new_track\"` puts the item on a new track directly above the target.\n`Locked` if the source, the target or a partner's track is locked. `start` is snapped to\nthe sequence's frame grid and must be `>= 0`.",
        "properties": {
          "item": {
            "description": "The item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "overlap": {
            "anyOf": [
              {
                "description": "What to do when the clip would overlap another clip on the target track.",
                "oneOf": [
                  {
                    "const": "reject",
                    "description": "Fail with `Invalid{path:\"/at\"}` (default).",
                    "type": "string"
                  },
                  {
                    "const": "new_track",
                    "description": "Create a new track of the same kind directly above the target and insert there.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Overlap handling (default `reject`)."
          },
          "start": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "New timeline position of the item's first frame, `>= 0`."
          },
          "to_track": {
            "default": null,
            "description": "Target track of the same sequence and kind (default: stay on the current track).",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "unlink": {
            "default": null,
            "description": "Move only this item and remove it from its linked group (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "item",
          "start"
        ],
        "title": "ItemMove",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "item_move",
      "name": "item.move",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.move`.",
        "properties": {
          "created_tracks": {
            "description": "Tracks created by `overlap: \"new_track\"`, in creation order.",
            "items": {
              "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
              "pattern": "^trk_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "items": {
            "description": "The moved items: the requested one first, then its linked partners.",
            "items": {
              "additionalProperties": false,
              "description": "Where one item ended up.",
              "properties": {
                "item": {
                  "description": "The item.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "start": {
                  "description": "Its new start.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "track": {
                  "description": "The track it is on now.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "required": [
                "item",
                "track",
                "start"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "created_tracks"
        ],
        "title": "ItemMoveOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Move an item in time and/or to another track (linked partners follow)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Changes an item's name, enabled flag, opacity, clip gain or transform; absent fields keep\ntheir value and setting a value it already has is a no-op. `Locked` if the item's track is\nlocked.",
        "properties": {
          "item": {
            "description": "The item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "props": {
            "additionalProperties": false,
            "description": "The properties to change; at least one.",
            "properties": {
              "audio_gain": {
                "description": "Clip gain in dB, `-144..=48` (0 = unchanged).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "enabled": {
                "description": "Rendered and heard (`true`) or kept but skipped (`false`).",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "name": {
                "description": "Display name; an empty string clears it (the media name is shown again).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "opacity": {
                "description": "Opacity `0.0..=1.0`.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "transform": {
                "additionalProperties": false,
                "description": "Placement on the canvas (partial).",
                "properties": {
                  "anchor": {
                    "additionalProperties": false,
                    "description": "The item point `position` places and rotation turns around, in item units.",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "position": {
                    "additionalProperties": false,
                    "description": "Offset of the anchor from the canvas center, in canvas units (+y is down).",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "rotation": {
                    "description": "Clockwise rotation in degrees.",
                    "format": "double",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "scale": {
                    "additionalProperties": false,
                    "description": "Size multiplier per axis (1.0 = aspect-fit); finite and `>= 0`.",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "required": [
          "item",
          "props"
        ],
        "title": "ItemSetProps",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "item_set_props",
      "name": "item.set_props",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.set_props`.",
        "properties": {
          "changed": {
            "description": "The props whose value actually changed (`name`, `enabled`, `opacity`, `audio_gain`,\n`transform.position`, ...); empty if everything was already as requested.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "item": {
            "description": "The item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "item",
          "changed"
        ],
        "title": "ItemSetPropsOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Set an item's name, enabled, opacity, audio_gain or transform (partial)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Imports media files: probes each one synchronously and registers it, returning `media_ids`\nat once. All or nothing: if any file cannot be probed, nothing is imported and the error\nnames that file's index (`/paths/<i>`). Files whose content is already in the project are\nreturned as duplicates. Analysis (thumbnails, waveform, index) continues in background jobs.",
        "properties": {
          "paths": {
            "description": "Absolute paths of the files (1..=256, no repeats).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "paths"
        ],
        "title": "MediaImport",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "core",
      "mcp_tool": "media_import",
      "name": "media.import",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.import`.",
        "properties": {
          "media": {
            "description": "One entry per requested path, in request order.",
            "items": {
              "additionalProperties": false,
              "description": "One imported file.",
              "properties": {
                "duplicate": {
                  "description": "`true` when the content was already in the project and nothing was added.",
                  "type": "boolean"
                },
                "kind": {
                  "description": "What the asset is.",
                  "oneOf": [
                    {
                      "const": "video",
                      "description": "A video file (may also carry audio).",
                      "type": "string"
                    },
                    {
                      "const": "audio",
                      "description": "An audio-only file.",
                      "type": "string"
                    },
                    {
                      "const": "image",
                      "description": "A still image (no duration).",
                      "type": "string"
                    },
                    {
                      "const": "sequence_ref",
                      "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                      "type": "string"
                    }
                  ]
                },
                "media_id": {
                  "description": "The asset; an existing one if the same content was imported before.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": "string"
                },
                "path": {
                  "description": "The path as requested.",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "media_id",
                "kind",
                "duplicate"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "media"
        ],
        "title": "MediaImportOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Import media files; probes synchronously and returns the media ids",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Registers a probed media file. Internal plumbing of `media.import` and the import job\n(WP-1D.07): the kind (video, audio or image) derives from the probe streams. If an asset\nwith the same `content_hash` already exists it is returned unchanged (`created: false`).",
        "properties": {
          "content_hash": {
            "description": "Content hash used to relink and deduplicate (non-empty, no whitespace).",
            "type": "string"
          },
          "media_id": {
            "default": null,
            "description": "ID for the new asset; minted by the engine when absent. Must not exist yet.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Absolute path of the file.",
            "type": "string"
          },
          "probe": {
            "description": "What probing found.",
            "properties": {
              "audio": {
                "additionalProperties": false,
                "description": "Main audio stream format, if any.",
                "properties": {
                  "channels": {
                    "description": "Channel count.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "rate": {
                    "description": "Samples per second.",
                    "maximum": 352800000,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "rate",
                  "channels"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "color": {
                "additionalProperties": false,
                "description": "Color tags of the main video stream.",
                "properties": {
                  "matrix": {
                    "description": "YUV matrix coefficients.",
                    "examples": [
                      "gbr",
                      "bt709",
                      "fcc",
                      "bt470bg",
                      "smpte170m",
                      "smpte240m",
                      "ycgco",
                      "bt2020nc",
                      "bt2020c",
                      "ictcp"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "primaries": {
                    "description": "Color primaries.",
                    "examples": [
                      "bt709",
                      "bt470m",
                      "bt470bg",
                      "smpte170m",
                      "smpte240m",
                      "film",
                      "bt2020",
                      "smpte428",
                      "smpte431",
                      "smpte432",
                      "ebu3213"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "range": {
                    "anyOf": [
                      {
                        "description": "Sample range of a video stream.",
                        "oneOf": [
                          {
                            "const": "limited",
                            "description": "Limited (\"TV\", 16–235 for 8-bit luma).",
                            "type": "string"
                          },
                          {
                            "const": "full",
                            "description": "Full (\"PC\", 0–255).",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Sample range."
                  },
                  "transfer": {
                    "description": "Transfer characteristics.",
                    "examples": [
                      "bt709",
                      "gamma22",
                      "gamma28",
                      "smpte170m",
                      "smpte240m",
                      "linear",
                      "iec61966-2-1",
                      "bt2020-10",
                      "bt2020-12",
                      "smpte2084",
                      "arib-std-b67"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "duration": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Playable length, if known (images have none)."
              },
              "fps": {
                "additionalProperties": false,
                "description": "Frame rate of the main video stream, if constant or nominal.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "rotation": {
                "description": "Display rotation in degrees clockwise: 0, 90, 180 or 270.",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "streams": {
                "description": "Streams in container order.",
                "items": {
                  "description": "One stream of a media file.",
                  "properties": {
                    "channels": {
                      "description": "Channel count (audio).",
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "codec": {
                      "description": "Codec name (FFmpeg naming, e.g. `h264`, `aac`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "height": {
                      "description": "Coded height in pixels (video).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "index": {
                      "description": "Index in the container.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "kind": {
                      "description": "Stream kind.",
                      "oneOf": [
                        {
                          "const": "video",
                          "description": "Pictures.",
                          "type": "string"
                        },
                        {
                          "const": "audio",
                          "description": "Sound.",
                          "type": "string"
                        },
                        {
                          "const": "subtitle",
                          "description": "Subtitles or captions.",
                          "type": "string"
                        },
                        {
                          "const": "data",
                          "description": "Timed metadata or other data.",
                          "type": "string"
                        },
                        {
                          "const": "attachment",
                          "description": "Attached files (fonts, cover art).",
                          "type": "string"
                        }
                      ]
                    },
                    "language": {
                      "description": "Language tag (e.g. `eng`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pixel_format": {
                      "description": "Pixel format (FFmpeg naming, e.g. `yuv420p10le`; video).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "profile": {
                      "description": "Codec profile (e.g. `High`, `Main 10`).",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sample_rate": {
                      "description": "Sample rate (audio).",
                      "maximum": 352800000,
                      "minimum": 1,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "width": {
                      "description": "Coded width in pixels (video).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "index",
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "vfr": {
                "description": "Variable frame rate: times map through the frame index, never through `fps` (arch §4.1).",
                "type": "boolean"
              }
            },
            "required": [
              "streams",
              "vfr",
              "rotation",
              "color"
            ],
            "type": "object"
          }
        },
        "required": [
          "path",
          "probe",
          "content_hash"
        ],
        "title": "MediaRegister",
        "type": "object"
      },
      "kind": "command",
      "mcp": "hidden",
      "mcp_tool": null,
      "name": "media.register",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.register`.",
        "properties": {
          "created": {
            "description": "`false` when an asset with the same content hash already existed and nothing changed.",
            "type": "boolean"
          },
          "kind": {
            "description": "What the asset is.",
            "oneOf": [
              {
                "const": "video",
                "description": "A video file (may also carry audio).",
                "type": "string"
              },
              {
                "const": "audio",
                "description": "An audio-only file.",
                "type": "string"
              },
              {
                "const": "image",
                "description": "A still image (no duration).",
                "type": "string"
              },
              {
                "const": "sequence_ref",
                "description": "Another sequence of this project, used as a compound clip (arch §4.3).",
                "type": "string"
              }
            ]
          },
          "media_id": {
            "description": "The asset: the new one, or the existing one with the same content hash.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "media_id",
          "kind",
          "created"
        ],
        "title": "MediaRegistered",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Register a probed media file (used by import; deduplicates by content hash)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Removes a media asset from the project (the file on disk is untouched). Fails with\n`Invalid` while any clip uses it; delete those clips first.",
        "properties": {
          "id": {
            "description": "The asset to remove.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "MediaRemove",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "media_remove",
      "name": "media.remove",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.remove`.",
        "properties": {
          "media_id": {
            "description": "The removed asset.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "media_id"
        ],
        "title": "MediaRemoveOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Remove an unused media asset from the project",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Initializes an empty project: sets the project name and default format and creates one\nsequence with a video track `V1` on top of an audio track `A1`. Fails with `Invalid` if the\nproject already has media or sequences.",
        "properties": {
          "format": {
            "additionalProperties": false,
            "default": null,
            "description": "Format of the first sequence; also the default for new sequences.",
            "properties": {
              "frame_rate": {
                "additionalProperties": false,
                "description": "The edit grid, `1..=1000` fps and a whole number of flicks per frame.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "height": {
                "description": "Canvas height in pixels, `1..=16384`.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sample_rate": {
                "description": "The mix rate in Hz, `8000..=384000`.",
                "maximum": 352800000,
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "width": {
                "description": "Canvas width in pixels, `1..=16384`.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "description": "Project name (1..=200 characters).",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectNew",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "project_new",
      "name": "project.new",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.new`.",
        "properties": {
          "audio_track": {
            "description": "Its audio track `A1`.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          },
          "sequence": {
            "description": "The created sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "video_track": {
            "description": "Its video track `V1`.",
