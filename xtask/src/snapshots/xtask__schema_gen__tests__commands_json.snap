    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Removes the keys at the exact item times given. Deleting every key of a property makes it\nstatic at its first key's value. `NotFound` if a key does not exist; `Locked` if the item's\ntrack is locked.",
        "properties": {
          "item": {
            "description": "The item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "keys": {
            "description": "The keys to delete, by property and exact item time.",
            "items": {
              "additionalProperties": false,
              "description": "A key to address: its property and exact item time.",
              "properties": {
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                      "type": "string"
                    }
                  ],
                  "description": "The key's stored item time in flicks, as `item.get` returns it."
                }
              },
              "required": [
                "prop",
                "t"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "item",
          "keys"
        ],
        "title": "KeyframeDelete",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "keyframe_delete",
      "name": "keyframe.delete",
      "namespace": "keyframe",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `keyframe.delete`.",
        "properties": {
          "deleted": {
            "description": "The keys removed.",
            "items": {
              "additionalProperties": false,
              "description": "A key to address: its property and exact item time.",
              "properties": {
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "description": "The key's stored item time in flicks, as `item.get` returns it.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "prop",
                "t"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "now_static": {
            "description": "Properties that lost their last key and are static now (at their first key's value).",
            "items": {
              "description": "An animatable property of an item.",
              "enum": [
                "transform.position",
                "transform.scale",
                "transform.rotation",
                "transform.anchor",
                "opacity",
                "crop.left",
                "crop.top",
                "crop.right",
                "crop.bottom",
                "flip.horizontal",
                "flip.vertical",
                "audio_gain",
                "audio_pan"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
