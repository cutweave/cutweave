        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Describe the advanced export options of a codec or encoder as a JSON Schema",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Adds an export of a sequence (or a range of it) to an MP4 file (H.264 + AAC) to the end of\nthe export queue and returns its job. It runs when its turn comes; while the queue is paused\nit waits (`export.start` adds and resumes). It renders the project as it is now; later edits\ndo not change it. The same params and path rules as `export.start`.",
        "properties": {
          "advanced": {
            "default": null,
            "description": "Fine control (rate control, GOP, encoder, color tags, audio), as in export.start.",
            "properties": {
              "audio": {
                "type": "object"
              },
              "color": {
                "type": "object"
              },
              "video": {
                "type": "object"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "collision": {
            "anyOf": [
              {
                "description": "What to do when the output file exists.",
                "oneOf": [
                  {
                    "const": "rename",
                    "description": "Pick a free name (`name (1).mp4`).",
                    "type": "string"
                  },
                  {
                    "const": "overwrite",
                    "description": "Replace the file once the export has succeeded.",
                    "type": "string"
                  },
                  {
                    "const": "fail",
                    "description": "Refuse (the default).",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "An existing file: \"fail\" (default), \"rename\" or \"overwrite\"."
          },
          "hw": {
            "anyOf": [
              {
                "description": "Whether to use a hardware video encoder.",
                "oneOf": [
                  {
                    "const": "auto",
                    "description": "The first hardware encoder of the codec that works here (`export.list_encoders`), else\nsoftware; if it fails during the export, the export starts again in software.",
                    "type": "string"
                  },
                  {
                    "const": "off",
                    "description": "Software (x264, x265, SVT-AV1) only.",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "description": "This hardware encoder and no other, e.g. \"hevc_nvenc\" (the `implementation` names of\nthe machine's hardware encoders, `export.list_encoders`); fails instead of falling back.",
                    "properties": {
                      "force": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "force"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hardware encoder: \"auto\" (default), \"off\", or {\"force\": \"h264_nvenc\"}."
          },
          "overwrite": {
            "default": null,
            "description": "Replace an existing file at `path` (default false); same as `collision: \"overwrite\"`.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "path": {
            "description": "Absolute path of the output file (`.mp4`).",
            "type": "string"
          },
          "preset": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "h264-mp4-1080p",
                    "description": "MP4, H.264 + AAC, fit into 1920x1080 (1080x1920 portrait), not upscaled, high quality.",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "description": "MP4, H.264 + AAC at a custom size, frame rate and quality.",
                    "properties": {
                      "custom": {
                        "additionalProperties": false,
                        "description": "Custom output settings; absent fields take the sequence's value (quality: high).",
                        "properties": {
                          "fps": {
                            "additionalProperties": false,
                            "default": null,
                            "description": "Frame rate, e.g. {\"num\": 30, \"den\": 1}: at most 240 fps, a whole number of flicks per\nframe.",
                            "properties": {
                              "den": {
                                "description": "Seconds.",
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                              },
                              "num": {
                                "description": "Frames.",
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "num",
                              "den"
                            ],
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "height": {
                            "default": null,
                            "description": "Frame height in pixels: even, 16-8192.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "preset": {
                            "default": null,
                            "description": "Base preset id; the other fields replace its values.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "quality": {
                            "anyOf": [
                              {
                                "description": "How hard the encoder works for picture quality (and file size).",
                                "oneOf": [
                                  {
                                    "const": "low",
                                    "description": "Small files, visible compression.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "medium",
                                    "description": "Balanced.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "high",
                                    "description": "Close to the original (the default).",
                                    "type": "string"
                                  }
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "description": "\"low\", \"medium\" or \"high\"."
                          },
                          "width": {
                            "default": null,
                            "description": "Frame width in pixels: even, 16-8192.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          }
                        },
                        "type": "object"
                      }
                    },
                    "required": [
                      "custom"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "A preset id (export.list_presets).",
                    "type": "string"
                  }
                ],
                "description": "What to make: the preset, or custom settings."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "\"h264-mp4-1080p\" (default), a preset id or {\"custom\": {...}}, as in export.start."
          },
          "range": {
            "additionalProperties": false,
            "default": null,
            "description": "Part of the sequence to export (default: all of it): {kind: \"sequence\" | \"in_out\" |\n\"custom\" | \"markers\", in, out, markers: [ids], pair_mode: \"duration\" | \"pairs\"}, as in\nexport.start.",
            "properties": {
              "in": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom start: flicks, \"2.5s\", \"f:60\" or a timecode."
              },
              "kind": {
                "anyOf": [
                  {
                    "description": "Which part of the sequence to export.",
                    "oneOf": [
                      {
                        "const": "sequence",
                        "description": "The whole sequence.",
                        "type": "string"
                      },
                      {
                        "const": "in_out",
                        "description": "Between the sequence's in and out points.",
                        "type": "string"
                      },
                      {
                        "const": "custom",
                        "description": "`in` to `out`.",
                        "type": "string"
                      },
                      {
                        "const": "markers",
                        "description": "One file per marker.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "\"sequence\", \"in_out\", \"custom\" or \"markers\" (default: from the other fields)."
              },
              "markers": {
                "default": null,
                "description": "Marker kind: the markers to export (default: all of the sequence's markers).",
                "items": {
                  "description": "A Marker id: `^mrk_[0-9a-f]{32}$`.",
                  "pattern": "^mrk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "out": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom end, exclusive: at most the sequence end."
              },
              "pair_mode": {
                "anyOf": [
                  {
                    "description": "How markers become regions.",
                    "oneOf": [
                      {
                        "const": "duration",
                        "description": "Each marker's own `duration` (the default).",
                        "type": "string"
                      },
                      {
                        "const": "pairs",
                        "description": "Each marker to the next one.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Marker kind: \"duration\" (default; each marker's own duration) or \"pairs\" (each marker to\nthe next)."
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "sequence": {
            "default": null,
            "description": "Sequence; optional when the project has one.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "title": "ExportEnqueue",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "export_enqueue",
      "name": "export.enqueue",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.start`: the job and what it will write.",
        "properties": {
          "duration": {
            "description": "Length of the file.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "estimated_kib": {
            "description": "Estimated file size in KiB when the rate control fixes a bitrate (`vbr`, `cbr`, a\nbitrate preset); absent for a quality (`crf`).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "frame_rate": {
            "additionalProperties": false,
            "description": "Frame rate of the file.",
            "properties": {
              "den": {
                "description": "Seconds.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Frames.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "frames": {
            "description": "Video frames the file will hold.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "height": {
            "description": "Frame height in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "in": {
            "description": "Exported range start (sequence time, flicks).",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "job_id": {
            "description": "The export job: follow it with `job.wait` or `job.status`, stop it with `job.cancel`.",
            "pattern": "^job_[0-9a-f]{32}$",
            "type": "string"
          },
          "jobs": {
            "description": "Every export of a marker set, in time order (empty for any other range). The fields\nabove describe the first of them.",
            "items": {
              "additionalProperties": false,
              "description": "One file of a marker-set export.",
              "properties": {
                "duration": {
                  "description": "Length of the file.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "frames": {
                  "description": "Video frames the file will hold.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "in": {
                  "description": "Range start (sequence time, flicks).",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "job_id": {
                  "description": "Its export job.",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": "string"
                },
                "label": {
                  "description": "The marker's label.",
                  "type": "string"
                },
                "out": {
                  "description": "Range end, exclusive.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "path": {
                  "description": "The output file (after `rename`).",
                  "type": "string"
                }
              },
              "required": [
                "job_id",
                "path",
                "label",
                "in",
                "out",
                "frames",
                "duration"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "out": {
            "description": "Exported range end, exclusive.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "path": {
            "description": "The output file.",
            "type": "string"
          },
          "rev": {
            "description": "The document revision exported (edits made later are not in the file).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "sequence": {
            "description": "The exported sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "warnings": {
            "description": "Platform-limit and fit warnings of a preset (never errors; the export runs).",
            "items": {
              "additionalProperties": false,
              "description": "One warning about a preset on a sequence.",
              "properties": {
                "code": {
                  "description": "What kind.",
                  "oneOf": [
                    {
                      "const": "AspectMismatch",
                      "description": "The sequence's aspect is not the preset's.",
                      "type": "string"
                    },
                    {
                      "const": "DurationOverLimit",
                      "description": "The exported part is longer than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "SizeOverLimit",
                      "description": "The estimated file is larger than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "FrameRateCapped",
                      "description": "The sequence's frame rate is above the platform's maximum, so the file uses a lower one.",
                      "type": "string"
                    },
                    {
                      "const": "SoftwareEncoder",
                      "description": "An advanced setting needs the software encoder, so the export does not use the hardware one.",
                      "type": "string"
                    }
                  ]
                },
                "message": {
                  "description": "A sentence for the person.",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "width": {
            "description": "Frame width in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "path",
          "sequence",
          "in",
          "out",
          "width",
          "height",
          "frame_rate",
          "frames",
          "duration",
          "rev",
          "warnings"
        ],
        "title": "ExportStartOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Add an export to the export queue (waits while the queue is paused); returns job_id",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists the video codecs this machine exports (H.264, HEVC, AV1, ProRes) with their software\nencoder, the hardware encoders that passed an 8-frame trial encode (what `hw: \"auto\"` uses\nand `hw: {\"force\": ...}` names), and the containers, bit depths and profiles each takes.",
        "title": "ListEncoders",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "export_list_encoders",
      "name": "export.list_encoders",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.list_encoders`.",
        "properties": {
          "codecs": {
            "description": "H.264, HEVC, AV1 and ProRes, in that order.",
            "items": {
              "additionalProperties": false,
              "description": "One codec and how it can be exported here.",
              "properties": {
                "available": {
                  "description": "Whether any encoder (software or hardware) is available.",
                  "type": "boolean"
                },
                "bit_depths": {
                  "description": "The bit depths of the coded video.",
                  "items": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                },
                "codec": {
                  "description": "The codec.",
                  "oneOf": [
                    {
                      "const": "h264",
                      "description": "H.264 / AVC.",
                      "type": "string"
                    },
                    {
                      "const": "hevc",
                      "description": "H.265 / HEVC.",
                      "type": "string"
                    },
                    {
                      "const": "av1",
                      "description": "AV1.",
                      "type": "string"
                    },
                    {
                      "const": "prores",
                      "description": "Apple ProRes.",
                      "type": "string"
                    },
                    {
                      "const": "gif",
                      "description": "GIF (palette).",
                      "type": "string"
                    }
                  ]
                },
                "containers": {
                  "description": "The containers the codec goes into.",
                  "items": {
                    "description": "The file format of the output.",
                    "oneOf": [
                      {
                        "const": "mp4",
                        "description": "MP4.",
                        "type": "string"
                      },
                      {
                        "const": "mov",
                        "description": "QuickTime MOV.",
                        "type": "string"
                      },
                      {
                        "const": "gif",
                        "description": "Animated GIF.",
                        "type": "string"
                      },
                      {
                        "const": "wav",
                        "description": "WAV (audio only).",
                        "type": "string"
                      },
                      {
                        "const": "mp3",
                        "description": "MP3 (audio only).",
                        "type": "string"
                      },
                      {
                        "const": "m4a",
                        "description": "M4A (AAC audio only).",
                        "type": "string"
                      },
                      {
                        "const": "flac",
                        "description": "FLAC (audio only).",
                        "type": "string"
                      },
                      {
                        "const": "ogg",
                        "description": "Ogg (Opus audio only).",
                        "type": "string"
                      }
                    ]
                  },
                  "type": "array"
                },
                "hardware": {
                  "description": "Hardware encoders verified on this machine, in the order `auto` tries them.",
                  "items": {
                    "additionalProperties": false,
                    "description": "A hardware encoder that passed the trial encode.",
                    "properties": {
                      "device": {
                        "description": "The device type it runs on (`cuda`, `amf`, `qsv`, `videotoolbox`, `vaapi`).",
                        "type": "string"
                      },
                      "implementation": {
                        "description": "The name for `hw: {\"force\": ...}` (`hevc_nvenc`).",
                        "type": "string"
                      }
                    },
                    "required": [
                      "implementation",
                      "device"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "profiles": {
                  "description": "The profile names a preset's `video.profile` or `advanced.video.profile` takes (empty when\nthe codec has none).",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "software": {
                  "default": null,
                  "description": "The software encoder (`libx265`), when this FFmpeg build has it.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "codec",
                "available",
                "software",
                "hardware",
                "containers",
                "bit_depths",
                "profiles"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "codecs"
        ],
        "title": "ListEncodersOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List the video encoders this machine exports with: H.264, HEVC, AV1, ProRes, hardware ones verified",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists the export presets (built-in and the user's): the platform presets (YouTube,\nInstagram, TikTok, X) with their sources and `checked` dates, and the general formats. Give\n`platform` to list one platform's presets. `export.start{preset: \"<id>\"}` exports with one.",
        "properties": {
          "platform": {
            "default": null,
            "description": "Only the presets of this platform id (`youtube`, `instagram-reels`, `tiktok`, `x`).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ListPresets",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "export_list_presets",
      "name": "export.list_presets",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.list_presets`.",
        "properties": {
          "presets": {
            "description": "The presets: built-in first (pack order), then the user's by id.",
            "items": {
              "additionalProperties": false,
              "description": "A preset in a listing.",
              "properties": {
                "preset": {
                  "additionalProperties": false,
                  "description": "The preset.",
                  "properties": {
                    "advanced": {
                      "default": null,
                      "description": "Advanced encoder settings (rate control, GOP, color tags, audio) the preset applies on top\nof the fields above; a request's own `advanced` overrides them.",
                      "properties": {
                        "audio": {
                          "type": "object"
                        },
                        "color": {
                          "type": "object"
                        },
                        "video": {
                          "type": "object"
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "audio": {
