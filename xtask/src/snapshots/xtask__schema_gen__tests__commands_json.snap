    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets the folders agents and other non-UI callers may use (import media from, open projects\nin, save projects and exports into) besides the open project's folder: the desktop app's\nSettings > Agents and MCP. The list replaces the engine's approved folders, those given with\n`--allow-root` included, and applies at once, also to agent connections that are already\nopen. Each folder must be an absolute path without `..` that names an existing folder; it is\nstored canonical, with symlinks resolved (`project.info` reports the result as\n`allowed_roots`). UI credential only: agents get `forbidden`. Not undoable, not journaled,\nnever marks the project dirty.",
        "properties": {
          "roots": {
            "description": "Absolute paths of existing folders (at most 64); an empty list leaves only the project.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "roots"
        ],
        "title": "ProjectSetAllowedRoots",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "project_set_allowed_roots",
      "name": "project.set_allowed_roots",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.set_allowed_roots`.",
        "properties": {
          "roots": {
            "description": "The approved folders now in force: canonical (symlinks resolved), in the order given,\nwithout duplicates.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "roots"
        ],
        "title": "ProjectSetAllowedRootsOutput",
        "type": "object"
      },
      "scope": "ui",
      "secret_fields": [],
      "summary": "Set the folders agents may use besides the open project's (the app's own setting)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets how this engine autosaves, for the open project and every project it opens later: the\neditor's own preference wins over the project's `settings.autosave` (arch §17). It takes\neffect at once, also for a project that is already dirty, and the 2 s idle save stays.\nNot undoable, not journaled and never marks the project dirty; it is not written to the\nproject. An engine nobody sent it to keeps the project's own setting, then the defaults.\nUI credential only (ADR-0016): it is the app applying the person's preference to its own\nengine, which an agent must not override (agents get `forbidden`).",
        "properties": {
          "enabled": {
            "description": "Save automatically (the idle save and the interval save), or not at all.",
            "type": "boolean"
          },
          "interval_s": {
            "description": "Save at least this often, in seconds, while edits continue (1 to 86400).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "keep_backups": {
            "description": "Backups to keep in `.cutweave/backups/` (1 to 100).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "interval_s",
          "keep_backups"
        ],
        "title": "ProjectSetAutosave",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "project_set_autosave",
      "name": "project.set_autosave",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.set_autosave`: the preference now in force.",
        "properties": {
          "enabled": {
            "description": "Whether autosave runs.",
            "type": "boolean"
          },
          "interval_s": {
            "description": "The longest time, in seconds, a dirty project goes unsaved while edits continue.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "keep_backups": {
            "description": "Backups kept in the project's `.cutweave/backups/` folder.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "interval_s",
          "keep_backups"
        ],
        "title": "ProjectSetAutosaveOutput",
        "type": "object"
      },
      "scope": "ui",
      "secret_fields": [],
      "summary": "Set whether, how often and with how many backups the engine autosaves",
      "undoable": false,
      "view": false
    },
