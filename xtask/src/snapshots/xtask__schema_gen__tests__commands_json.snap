    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Moves a clip by `delta` between its neighbours, keeping what it shows: the clip and its\nlinked partners move; the clip just before it (if it touches it) gets a later or earlier\nend and the clip just after it (if it touches it) a later or earlier start (its source\nposition follows), with their partners. A side with a gap stops the clip at the next item\n(or time 0); the empty end of a track does not. The neighbours keep at least one frame and\nstay inside their media. On the magnetic main track the first clip cannot slide. Children\nattached to the clip move with it. Limits as in `clip.trim` (`clamp: true` stops at them).\n`Locked` if a track involved is locked.",
        "properties": {
          "clamp": {
            "default": null,
            "description": "Stop at the nearest limit instead of failing (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "delta": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "How far the clip moves (negative: earlier). Use seconds or flicks for negative values."
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "prune_keyframes": {
            "default": null,
            "description": "Drop keyframes the slide leaves outside the neighbours (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "item",
          "delta"
        ],
        "title": "ClipSlide",
        "type": "object"
      },
