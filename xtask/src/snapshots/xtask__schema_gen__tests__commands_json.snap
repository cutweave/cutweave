          "sequence": {
            "description": "The sequence to copy.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence"
        ],
        "title": "SequenceDuplicate",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "sequence_duplicate",
      "name": "sequence.duplicate",
      "namespace": "sequence",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `sequence.duplicate`.",
        "properties": {
          "item_count": {
            "description": "How many items it holds.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "Its name.",
            "type": "string"
          },
          "sequence": {
            "description": "The copy.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "name",
          "item_count"
        ],
        "title": "SequenceDuplicateOutput",
        "type": "object"
      },
      "scope": "any",
