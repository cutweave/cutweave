    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Freezes the frame a clip shows at timeline time `at` (frame-snapped, inside the clip): the clip\nand its linked partners are split there, what follows on their tracks moves later by\n`duration` (default 3 s, frame-snapped), and a still of that frame goes in between (a clip of\nthe same media with `freeze`, silent, unlinked, each animated property at its value at `at`).\nOn the main track it stays gapless. At the clip's first frame nothing is split. Clips without\na picture, stills and freeze frames are `Unsupported`; `Locked` if a track involved is locked.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Timeline time of the frame to freeze, inside the clip (frame-snapped)."
          },
          "duration": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Length of the still (default 3 s; frame-snapped, at least one frame)."
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "item",
          "at"
        ],
        "title": "ClipFreezeFrame",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "clip_freeze_frame",
      "name": "clip.freeze_frame",
      "namespace": "clip",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `clip.freeze_frame`.",
        "properties": {
          "after": {
            "description": "The part after the still: the right half of the split, or the whole clip when frozen at\nits first frame.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "at": {
            "description": "The timeline time frozen (frame-snapped), where the still starts.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "at_source": {
            "description": "The media position of the frozen frame.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "before": {
            "description": "The part of the clip before the still (keeps the clip's ID); `None` when frozen at the\nclip's first frame.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "description": "The still's length.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "freeze": {
            "description": "The new still.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
