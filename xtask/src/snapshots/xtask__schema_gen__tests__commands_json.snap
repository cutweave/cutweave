                        "properties": {
                          "den": {
                            "description": "Seconds.",
                            "maximum": 4294967295,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "num": {
                            "description": "Frames.",
                            "maximum": 4294967295,
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "type": [
