                "description": "The format version (1).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "size": {
                "description": "The output size rule.",
                "oneOf": [
                  {
                    "description": "Exactly this size for a sequence of the same aspect; a different aspect is fitted into\nthe frame without stretching, with an `AspectMismatch` warning.",
                    "properties": {
                      "height": {
                        "description": "Frame height in pixels.",
                        "format": "uint32",
                        "minimum": 0,
