    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Inserts a media clip on a track at a time. `source_in` is the position in the media the clip\nstarts from and `duration` its length (defaults: the start of the media and the rest of it;\nstills default to five seconds). Times accept flicks, `\"1.5s\"`, `\"f:45\"` and timecodes,\nresolved against the sequence's frame rate. See the module docs for overlap and linked\naudio behaviour. Fails with `Locked` if the target track is locked.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Timeline position of the clip's first frame, `>= 0`."
          },
          "duration": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clip length, `> 0`."
          },
          "link": {
            "default": null,
            "description": "Also insert the audio of a video file as a linked clip (default `true`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "media": {
            "description": "The media to place.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          },
          "overlap": {
            "anyOf": [
              {
                "description": "What to do when the clip would overlap another clip on the target track.",
                "oneOf": [
                  {
                    "const": "reject",
                    "description": "Fail with `Invalid{path:\"/at\"}` (default).",
                    "type": "string"
                  },
                  {
                    "const": "new_track",
                    "description": "Create a new track of the same kind directly above the target and insert there.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Overlap handling (default `reject`)."
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "source_in": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Position in the media to start from (default 0)."
          },
          "track": {
            "description": "The target track (of that sequence): a video track for pictures, an audio track for\nsound.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "track",
          "media",
          "at"
        ],
        "title": "TimelineInsert",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "timeline_insert",
      "name": "timeline.insert",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.insert`.",
        "properties": {
          "clips": {
            "description": "The inserted clips: the one on the target track first, then the linked audio clip.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "created_tracks": {
            "description": "Tracks created by `overlap: \"new_track\"`, in creation order.",
            "items": {
              "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
              "pattern": "^trk_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "linked_group": {
            "description": "The group shared by the clips when audio was linked.",
            "pattern": "^grp_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "clips",
          "linked_group",
          "created_tracks"
        ],
        "title": "TimelineInsertOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Insert a media clip at a time on a track (adds linked audio for video with sound)",
      "undoable": true,
      "view": false
    },
