        "description": "Links items into one group, so they move, trim, split, are deleted and duplicated together.\nThe items must be in one sequence, on other tracks than each other, and aligned (identical\nstart and duration; trim first, or use `item.attach`). Every member of the items' current\ngroups joins the new group, and the old groups no longer exist. All members must be attached\nto the same parent, or none to any. Nothing moves.",
        "properties": {
          "items": {
            "description": "The items to link, at least two distinct ones.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
