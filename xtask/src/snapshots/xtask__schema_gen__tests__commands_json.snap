    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Plays a clip (`item`), or several (`items`), and their linked partners backwards over the same\nmedia range, or forwards again: `reverse: true` or `false`, or omitted to toggle each clip.\nNothing moves and keyframes stay. Stills and freeze frames are `Unsupported`; `Locked` if a\ntrack involved is locked. Reversed long-GOP video without a proxy scrubs slowly (WP-2D.01b).",
        "properties": {
          "item": {
            "default": null,
            "description": "The clip (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Clips to change at once.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "reverse": {
            "default": null,
            "description": "`true` backwards, `false` forwards; omitted: toggle.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "ClipReverse",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "clip_reverse",
      "name": "clip.reverse",
      "namespace": "clip",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `clip.set_speed`, `clip.reverse` and `clip.reset_speed`.",
        "properties": {
          "items": {
            "description": "The clips changed: each requested clip (in request order) followed by its linked\npartners.",
            "items": {
              "additionalProperties": false,
              "description": "A clip after a speed change, a reverse or a reset.",
              "properties": {
                "duration": {
                  "description": "Its length.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "item": {
                  "description": "The clip.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "reverse": {
                  "description": "Whether it plays backwards.",
                  "type": "boolean"
                },
                "source_in": {
                  "description": "Its source position.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "speed": {
                  "additionalProperties": false,
                  "description": "Its speed.",
                  "properties": {
                    "den": {
                      "description": "Denominator.",
                      "maximum": 100000,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "num": {
                      "description": "Numerator.",
                      "maximum": 100000,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "type": "object"
                },
                "start": {
                  "description": "Its start.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "start",
                "duration",
                "source_in",
                "speed",
                "reverse"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1). A change of speed or direction alone (same length and\nsource position) shows only in `items`.",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
