      "name": "export.pause_queue",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "The export queue: result of `export.queue` and the queue commands.",
        "properties": {
          "jobs": {
            "description": "The exports, first in line first; finished ones stay until `export.remove`.",
            "items": {
              "additionalProperties": false,
              "description": "One export of the queue.",
              "properties": {
                "cancel_requested": {
                  "description": "Whether a cancel was asked and the export has not stopped yet.",
                  "type": "boolean"
                },
                "duration": {
                  "description": "Length of the file.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "error": {
                  "description": "Why it failed or was cancelled.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "frame_rate": {
                  "additionalProperties": false,
                  "description": "Frame rate of the file.",
                  "properties": {
                    "den": {
                      "description": "Seconds.",
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "num": {
                      "description": "Frames.",
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "type": "object"
                },
                "frames": {
                  "description": "Video frames the file will hold.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "height": {
                  "description": "Frame height in pixels.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "id": {
                  "description": "The job (`job.status`, `job.wait`, `export.cancel`, …).",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": "string"
                },
                "in": {
                  "description": "Range start (sequence time, flicks).",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "out": {
                  "description": "Range end, exclusive.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "path": {
                  "description": "The output file.",
                  "type": "string"
                },
                "progress": {
                  "additionalProperties": false,
                  "description": "Done fraction, frames, speed, time left and bytes written.",
                  "properties": {
                    "bytes": {
                      "description": "Bytes written so far.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "eta_ms": {
                      "description": "Estimated time left, in milliseconds.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "fps": {
                      "description": "Speed in units per second.",
                      "format": "double",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "fraction": {
                      "description": "Done fraction, `0..=1` (1 once the job succeeded).",
                      "format": "double",
                      "type": "number"
                    },
                    "frame": {
                      "description": "Units done so far (an export: frames handed to the encoder).",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "frames": {
                      "description": "Units in all (an export: frames in the file).",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "message": {
                      "description": "What it is doing, for status lines.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "fraction",
                    "message"
                  ],
                  "type": "object"
                },
                "rev": {
                  "description": "The document revision it renders (later edits are not in the file).",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "sequence": {
                  "description": "The exported sequence.",
                  "pattern": "^seq_[0-9a-f]{32}$",
                  "type": "string"
                },
                "state": {
                  "description": "`queued`, `running`, `succeeded`, `failed` or `cancelled`.",
                  "oneOf": [
                    {
                      "const": "queued",
                      "description": "Waiting for the jobs it depends on or for a budget slot.",
                      "type": "string"
                    },
                    {
                      "const": "running",
                      "description": "Running.",
                      "type": "string"
                    },
                    {
                      "const": "succeeded",
                      "description": "Finished its work.",
                      "type": "string"
                    },
                    {
                      "const": "failed",
