      "input_schema": {
        "additionalProperties": false,
        "description": "Plays a clip (`item`), or several (`items`), and their linked partners forwards at normal speed\nagain, keeping the media they play (their length changes as in `clip.set_speed` with `keep:\n\"in_point\"`; `ripple` and `keyframes` as there).",
        "properties": {
          "item": {
            "default": null,
            "description": "The clip (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Clips to reset at once.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "keyframes": {
            "default": null,
            "description": "`keep` (default): keys stay at their item times; `scale`: they stretch with the speed.",
            "enum": [
              "keep",
              "scale",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "ripple": {
            "default": null,
            "description": "On a free track, move what follows instead of failing at the next item (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
