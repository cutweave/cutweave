                      }
                    },
                    "required": [
                      "kind",
                      "width",
                      "height"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "The sequence's own size.",
                    "properties": {
                      "kind": {
                        "const": "follow_sequence",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  }
                ]
              },
              "summary": {
                "default": "",
                "description": "One line for the picker.",
                "type": "string"
              },
              "video": {
                "additionalProperties": false,
                "default": null,
                "description": "Video settings; absent for audio-only presets.",
                "properties": {
                  "codec": {
                    "description": "The codec.",
                    "oneOf": [
                      {
                        "const": "h264",
                        "description": "H.264 / AVC.",
                        "type": "string"
                      },
                      {
                        "const": "hevc",
                        "description": "H.265 / HEVC.",
                        "type": "string"
                      },
                      {
                        "const": "av1",
                        "description": "AV1.",
                        "type": "string"
                      },
                      {
                        "const": "prores",
                        "description": "Apple ProRes.",
                        "type": "string"
                      },
                      {
                        "const": "gif",
                        "description": "GIF (palette).",
                        "type": "string"
                      }
                    ]
                  },
                  "hw_preferred": {
                    "description": "Use a hardware encoder when one works here (software otherwise); `false` always uses\nsoftware, for quality-first presets.",
                    "type": "boolean"
                  },
                  "pix_fmt": {
                    "default": null,
                    "description": "Pixel format (`yuv420p`).",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "preset": {
                    "default": null,
                    "description": "Encoder speed preset (`medium`, `slow`).",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "profile": {
                    "default": null,
                    "description": "Codec profile (`high`, `main10`, `422hq`).",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rate_control": {
                    "description": "How bits are spent.",
                    "oneOf": [
                      {
                        "description": "Constant quality on the x264 CRF scale (0-51, lower is better; AV1 maps it onto its own).",
                        "properties": {
                          "crf": {
                            "description": "The CRF value.",
                            "format": "uint8",
                            "maximum": 255,
                            "minimum": 0,
                            "type": "integer"
                          },
                          "mode": {
                            "const": "crf",
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode",
                          "crf"
                        ],
                        "type": "object"
                      },
                      {
                        "description": "Constant bitrate.",
                        "properties": {
                          "bitrate_kbps": {
                            "description": "Video bitrate in kilobits per second.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "mode": {
                            "const": "cbr",
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode",
                          "bitrate_kbps"
                        ],
                        "type": "object"
                      },
                      {
                        "description": "Variable bitrate around a target.",
                        "properties": {
                          "bitrate_kbps": {
                            "description": "Target video bitrate in kilobits per second.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "mode": {
                            "const": "vbr",
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode",
                          "bitrate_kbps"
                        ],
                        "type": "object"
                      },
                      {
                        "description": "Set by the codec profile (ProRes, GIF).",
                        "properties": {
                          "mode": {
                            "const": "profile",
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode"
                        ],
                        "type": "object"
                      }
                    ]
                  }
                },
                "required": [
                  "codec",
                  "rate_control",
                  "hw_preferred"
                ],
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "schema_version",
              "id",
              "name",
              "container",
              "size",
              "fps"
            ],
            "type": "object"
          }
        },
        "required": [
          "preset"
        ],
        "title": "SavePreset",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "export_save_preset",
      "name": "export.save_preset",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.save_preset`.",
        "properties": {
          "id": {
            "description": "The saved preset's id.",
            "type": "string"
          },
          "replaced": {
            "description": "Whether it replaced an earlier preset of yours.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "replaced"
        ],
        "title": "SavePresetOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Save your own export preset (replaces your preset with the same id)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Exports a sequence (or a range of it) to a file (MP4, H.264 + AAC by default; a preset id\npicks HEVC, AV1 or ProRes) as a background job and returns the job id at once; wait with\n`job.wait`, stop with `job.cancel` (the partial file is deleted). Exports queue and run one at a time; this one\nalso resumes a paused queue (`export.queue` lists it). The export uses the project as it is\nnow; later edits do not change it. Agents and headless callers may only write inside the\nproject folder and folders the user approved. `range.kind` picks the part: \"sequence\",\n\"in_out\" (the sequence's in/out points), \"custom\" (`in`, `out`) or \"markers\" (one file per\nmarker: `path` is a folder or a name template ending in the container's extension (.mp4;\n.mov for ProRes) with {seq}, {marker_label}, {n}; the\noutput lists every job). `collision` says what happens to an existing file: \"fail\"\n(default), \"rename\" (pick a free name) or \"overwrite\" (replace it when the export\nsucceeds). Fails with `Invalid` when the drive has too little free space.",
        "properties": {
          "advanced": {
            "default": null,
            "description": "Fine control (export.describe_options{codec} gives a codec's options as a JSON Schema):\nvideo{rate_control{mode crf|cbr|vbr|cq, crf, bitrate_kbps, max_bitrate_kbps, buffer_kbit},\ngop{keyint|keyint_seconds, keyint_min, bframes, closed_gop, scenecut}, preset, tune,\nprofile, level, pix_fmt, threads}, color{primaries, transfer, matrix, range, tag_only},\naudio{codec, bitrate_kbps, sample_rate, channels}. Impossible combinations fail with\nInvalid and a hint.",
            "properties": {
              "audio": {
                "type": "object"
              },
              "color": {
                "type": "object"
              },
              "video": {
                "type": "object"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "collision": {
            "anyOf": [
              {
                "description": "What to do when the output file exists.",
                "oneOf": [
                  {
                    "const": "rename",
                    "description": "Pick a free name (`name (1).mp4`).",
                    "type": "string"
                  },
                  {
                    "const": "overwrite",
                    "description": "Replace the file once the export has succeeded.",
                    "type": "string"
                  },
                  {
                    "const": "fail",
                    "description": "Refuse (the default).",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "An existing file: \"fail\" (default), \"rename\" or \"overwrite\"."
          },
          "hw": {
            "anyOf": [
              {
                "description": "Whether to use a hardware video encoder.",
                "oneOf": [
                  {
                    "const": "auto",
                    "description": "The first hardware encoder of the codec that works here (`export.list_encoders`), else\nsoftware; if it fails during the export, the export starts again in software.",
                    "type": "string"
                  },
                  {
                    "const": "off",
                    "description": "Software (x264, x265, SVT-AV1) only.",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "description": "This hardware encoder and no other, e.g. \"hevc_nvenc\" (the `implementation` names of\nthe machine's hardware encoders, `export.list_encoders`); fails instead of falling back.",
                    "properties": {
                      "force": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "force"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hardware encoder: \"auto\" (default), \"off\", or {\"force\": \"hevc_nvenc\"}."
          },
          "overwrite": {
            "default": null,
            "description": "Replace an existing file at `path` (default false); same as `collision: \"overwrite\"`.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "path": {
            "description": "Absolute path of the output file (`.mp4`; `.mov` for ProRes presets).",
            "type": "string"
          },
          "preset": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "const": "h264-mp4-1080p",
                    "description": "MP4, H.264 + AAC, fit into 1920x1080 (1080x1920 portrait), not upscaled, high quality.",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "description": "MP4, H.264 + AAC at a custom size, frame rate and quality.",
                    "properties": {
                      "custom": {
                        "additionalProperties": false,
                        "description": "Custom output settings; absent fields take the sequence's value (quality: high).",
                        "properties": {
                          "fps": {
                            "additionalProperties": false,
                            "default": null,
                            "description": "Frame rate, e.g. {\"num\": 30, \"den\": 1}: at most 240 fps, a whole number of flicks per\nframe.",
                            "properties": {
                              "den": {
                                "description": "Seconds.",
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                              },
                              "num": {
                                "description": "Frames.",
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "num",
                              "den"
                            ],
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "height": {
                            "default": null,
                            "description": "Frame height in pixels: even, 16-8192.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "preset": {
                            "default": null,
                            "description": "Base preset id; the other fields replace its values.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "quality": {
                            "anyOf": [
                              {
                                "description": "How hard the encoder works for picture quality (and file size).",
                                "oneOf": [
                                  {
                                    "const": "low",
                                    "description": "Small files, visible compression.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "medium",
                                    "description": "Balanced.",
                                    "type": "string"
                                  },
                                  {
                                    "const": "high",
                                    "description": "Close to the original (the default).",
                                    "type": "string"
                                  }
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "description": "\"low\", \"medium\" or \"high\"."
                          },
                          "width": {
                            "default": null,
                            "description": "Frame width in pixels: even, 16-8192.",
                            "format": "uint32",
                            "minimum": 0,
                            "type": [
                              "integer",
                              "null"
                            ]
                          }
                        },
                        "type": "object"
                      }
                    },
                    "required": [
                      "custom"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "A preset id (export.list_presets).",
                    "type": "string"
                  }
                ],
                "description": "What to make: the preset, or custom settings."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "\"h264-mp4-1080p\" (default), a preset id (\"youtube-1080p\") or {\"custom\": {width, height,\nfps, quality, preset}}."
          },
          "range": {
            "additionalProperties": false,
            "default": null,
            "description": "Part of the sequence to export (default: all of it): {kind: \"sequence\" | \"in_out\" |\n\"custom\" | \"markers\", in, out, markers: [ids], pair_mode: \"duration\" | \"pairs\"}.",
            "properties": {
              "in": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom start: flicks, \"2.5s\", \"f:60\" or a timecode."
              },
              "kind": {
                "anyOf": [
                  {
                    "description": "Which part of the sequence to export.",
                    "oneOf": [
                      {
                        "const": "sequence",
                        "description": "The whole sequence.",
                        "type": "string"
                      },
                      {
                        "const": "in_out",
                        "description": "Between the sequence's in and out points.",
                        "type": "string"
                      },
                      {
                        "const": "custom",
                        "description": "`in` to `out`.",
                        "type": "string"
                      },
                      {
                        "const": "markers",
                        "description": "One file per marker.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "\"sequence\", \"in_out\", \"custom\" or \"markers\" (default: from the other fields)."
              },
              "markers": {
                "default": null,
                "description": "Marker kind: the markers to export (default: all of the sequence's markers).",
                "items": {
                  "description": "A Marker id: `^mrk_[0-9a-f]{32}$`.",
                  "pattern": "^mrk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "out": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom end, exclusive: at most the sequence end."
              },
              "pair_mode": {
                "anyOf": [
                  {
                    "description": "How markers become regions.",
                    "oneOf": [
                      {
                        "const": "duration",
                        "description": "Each marker's own `duration` (the default).",
                        "type": "string"
                      },
                      {
                        "const": "pairs",
                        "description": "Each marker to the next one.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Marker kind: \"duration\" (default; each marker's own duration) or \"pairs\" (each marker to\nthe next)."
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "sequence": {
            "default": null,
            "description": "Sequence; optional when the project has one.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "title": "ExportStart",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "core",
      "mcp_tool": "export_start",
      "name": "export.start",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.start`: the job and what it will write.",
        "properties": {
          "duration": {
            "description": "Length of the file.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "estimated_kib": {
            "description": "Estimated file size in KiB when the rate control fixes a bitrate (`vbr`, `cbr`, a\nbitrate preset); absent for a quality (`crf`).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "frame_rate": {
            "additionalProperties": false,
            "description": "Frame rate of the file.",
            "properties": {
              "den": {
                "description": "Seconds.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Frames.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "frames": {
            "description": "Video frames the file will hold.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "height": {
            "description": "Frame height in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "in": {
            "description": "Exported range start (sequence time, flicks).",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "job_id": {
            "description": "The export job: follow it with `job.wait` or `job.status`, stop it with `job.cancel`.",
            "pattern": "^job_[0-9a-f]{32}$",
            "type": "string"
          },
          "jobs": {
            "description": "Every export of a marker set, in time order (empty for any other range). The fields\nabove describe the first of them.",
            "items": {
              "additionalProperties": false,
              "description": "One file of a marker-set export.",
              "properties": {
                "duration": {
                  "description": "Length of the file.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "frames": {
                  "description": "Video frames the file will hold.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "in": {
                  "description": "Range start (sequence time, flicks).",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "job_id": {
                  "description": "Its export job.",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": "string"
                },
                "label": {
                  "description": "The marker's label.",
                  "type": "string"
                },
                "out": {
                  "description": "Range end, exclusive.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "path": {
                  "description": "The output file (after `rename`).",
                  "type": "string"
                }
              },
              "required": [
                "job_id",
                "path",
                "label",
                "in",
                "out",
                "frames",
                "duration"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "out": {
            "description": "Exported range end, exclusive.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "path": {
            "description": "The output file.",
            "type": "string"
          },
          "rev": {
            "description": "The document revision exported (edits made later are not in the file).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "sequence": {
            "description": "The exported sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "warnings": {
            "description": "Platform-limit and fit warnings of a preset (never errors; the export runs).",
            "items": {
              "additionalProperties": false,
              "description": "One warning about a preset on a sequence.",
              "properties": {
                "code": {
                  "description": "What kind.",
                  "oneOf": [
                    {
                      "const": "AspectMismatch",
                      "description": "The sequence's aspect is not the preset's.",
                      "type": "string"
                    },
                    {
                      "const": "DurationOverLimit",
                      "description": "The exported part is longer than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "SizeOverLimit",
                      "description": "The estimated file is larger than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "FrameRateCapped",
                      "description": "The sequence's frame rate is above the platform's maximum, so the file uses a lower one.",
                      "type": "string"
                    },
                    {
                      "const": "SoftwareEncoder",
                      "description": "An advanced setting needs the software encoder, so the export does not use the hardware one.",
                      "type": "string"
                    }
                  ]
                },
                "message": {
                  "description": "A sentence for the person.",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "width": {
            "description": "Frame width in pixels.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "path",
          "sequence",
          "in",
          "out",
          "width",
          "height",
          "frame_rate",
          "frames",
          "duration",
          "rev",
          "warnings"
        ],
        "title": "ExportStartOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Export a sequence to a video file (H.264, HEVC, AV1, ProRes) as a background job; returns job_id",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Places 2 to 4 clips in the cells of a layout, in one undo step. Example:\n`{items:[a,b], layout:\"side_by_side\"}`.\n\n`layout` is one of `item.layouts`. Only video clips count (the audio of a linked clip is\nignored); their number must be what the layout takes, else `Invalid`. `order` lists the clips\nfor the cells (without it the clip on the top track comes first, ties by start time).\n`fill` is `crop` (the default: every cell is filled, the overhang cropped) or `fit` (the\nwhole picture inside the cell). `gap` is the space between cells in sequence pixels (grid\nlayouts only). The result is ordinary properties (transform and crop) that can be adjusted\nafterwards; animated ones are keyed at `at`.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Sequence time (the playhead) to key animated properties at."
          },
          "fill": {
            "anyOf": [
              {
                "description": "How a picture meets its cell.",
                "oneOf": [
                  {
                    "const": "crop",
                    "description": "Fill the cell: the picture covers it and a centred crop removes the overhang.",
                    "type": "string"
                  },
                  {
                    "const": "fit",
                    "description": "Fit the picture whole inside the cell (bars where the shapes differ).",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`crop` (default) or `fit`."
          },
          "gap": {
            "default": null,
            "description": "Space between cells, in sequence pixels (default 0).",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "items": {
            "description": "The clips to arrange.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
