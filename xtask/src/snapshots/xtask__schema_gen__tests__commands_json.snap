      "input_schema": {
        "additionalProperties": false,
        "description": "Attaches items (and their linked partners) to a parent item, so they follow it when it moves\n(timeline spec §1.4). Every child must start inside the parent, be on another track than it\nand not in its linked group; the parent must not be attached itself, and a child must not be\na parent. A child is never moved to make it fit. Attaching again replaces the old parent.",
        "properties": {
          "items": {
            "description": "The children, at least one.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "description": "The parent item, in the same sequence.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "items",
          "parent"
        ],
        "title": "ItemAttach",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "item_attach",
      "name": "item.attach",
