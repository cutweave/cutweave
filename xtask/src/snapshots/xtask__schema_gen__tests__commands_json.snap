      "input_schema": {
        "additionalProperties": false,
        "description": "Moves items to a new start (`start`, or `delta` from where the first one is), optionally\nonto another track of the same kind and sequence. Give `item`, or `items` (the first is the\nprimary; the others keep their offsets to it). Linked partners move by the same amount on\ntheir own tracks (`unlink: true` moves only the given items and takes them out of their\ngroups). On the magnetic main track the space an item leaves closes, and an item moved onto\nit is inserted (default; the start is read after the lift and clamped to the track's end).\nElsewhere an overlap is `Invalid` by default; `mode` (or its alias `overlap`) picks\n`new_track`, `overwrite` or `insert`. Children attached to a moved item follow it. Times\nsnap to the frame grid (`fine: true`: the audio sample grid, audio-only moves).",
        "properties": {
          "delta": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Offset of the start."
          },
          "fine": {
            "default": null,
            "description": "Audio sample grid.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "item": {
            "default": null,
            "description": "The item (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Items; the first leads.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "mode": {
            "default": null,
            "description": "Default: `insert` on the main track, else `reject`.",
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "overlap": {
            "default": null,
            "description": "Alias of `mode`.",
            "enum": [
              "reject",
              "new_track",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "ripple_all_tracks": {
            "default": null,
            "description": "Ripples reach every track.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "start": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "New start, `>= 0` (or `delta`)."
          },
          "to_track": {
            "default": null,
            "description": "Target track (default: stay).",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "unlink": {
            "default": null,
            "description": "Move only the given items, unlinked.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "ItemMove",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "item_move",
      "name": "item.move",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.move`.",
        "properties": {
          "created_tracks": {
            "description": "Tracks created by the placement, in creation order.",
            "items": {
              "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
              "pattern": "^trk_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "items": {
            "description": "The moved items: the given ones in order, each followed by its linked partners.",
            "items": {
              "additionalProperties": false,
              "description": "Where one item ended up.",
              "properties": {
                "item": {
                  "description": "The item.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "start": {
                  "description": "Its new start.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "track": {
                  "description": "The track it is on now.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "required": [
                "item",
                "track",
                "start"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "item",
                    "start",
                    "duration",
                    "source_in"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "created",
              "removed",
              "split",
              "moved",
              "trimmed",
              "relinked",
              "replaced",
              "toggled",
              "created_tracks"
            ],
            "type": "object"
          }
        },
        "required": [
          "items",
          "created_tracks",
          "report"
        ],
        "title": "ItemMoveOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Move items in time and/or to another track (linked partners follow)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Resets properties to their defaults: they become static (any keys are removed). Give\n`group` (`transform`, `crop`, `flip`, `compositing`, `audio`) or `props` (property IDs), not\nboth; with neither, every animatable property and the blend mode are reset. The name and\nenabled flag are never touched. `Locked` if the item's track is locked.",
        "properties": {
          "group": {
            "anyOf": [
              {
                "description": "A group of properties, as the Inspector's sections show them.",
                "oneOf": [
                  {
                    "const": "transform",
                    "description": "Position, scale, rotation and anchor.",
                    "type": "string"
                  },
                  {
                    "const": "crop",
                    "description": "The four crop edges.",
                    "type": "string"
                  },
                  {
                    "const": "flip",
                    "description": "Flip horizontal and vertical.",
                    "type": "string"
                  },
                  {
                    "const": "compositing",
                    "description": "Opacity and blend mode.",
                    "type": "string"
                  },
                  {
                    "const": "audio",
                    "description": "Clip gain, pan and fades.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A section of the Inspector."
          },
          "item": {
            "default": null,
            "description": "The item (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Items to reset.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "props": {
            "default": null,
            "description": "Property IDs, as `keyframe.set` takes them.",
            "items": {
              "description": "An animatable property of an item.",
              "enum": [
                "transform.position",
                "transform.scale",
                "transform.rotation",
                "transform.anchor",
                "opacity",
                "crop.left",
                "crop.top",
                "crop.right",
                "crop.bottom",
                "flip.horizontal",
                "flip.vertical",
                "audio_gain",
                "audio_pan"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "ItemResetProps",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "item_reset_props",
      "name": "item.reset_props",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.reset_props`.",
        "properties": {
          "changed": {
            "description": "The properties whose value changed on any item (`opacity`, `crop.left`, `blend_mode`,\n...); empty when everything already had its default.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "item": {
            "description": "The first item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "item",
          "changed"
        ],
        "title": "ItemResetPropsOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Reset an item's properties (a group, some properties, or all) to their defaults",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Set item properties (partial). An animated property is keyed at `at` (sequence time,\nrequired then). Example: `{item, props:{opacity:0.5, crop:{left:0.25}}}`.\n\nAbsent fields keep their value; setting a value it already has is a no-op. Static properties\nare set as before and `at` is ignored. With `auto_key: false` an animated property is\n`Invalid`: `keyframe_clear` makes it static first. `Locked` if the track is locked.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Sequence time (the playhead) to key animated properties at."
          },
          "auto_key": {
            "default": null,
            "description": "Key animated properties at `at` (default true).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "item": {
            "default": null,
            "description": "The item (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Items to give the same properties.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "props": {
            "additionalProperties": false,
            "description": "The properties to change; at least one.",
            "properties": {
              "audio_gain": {
                "description": "Clip gain in dB, `-144..=48` (0 = unchanged).",
                "format": "double",
                "maximum": 48.0,
                "minimum": -144.0,
                "type": [
                  "number",
                  "null"
                ],
                "x-ui": {
                  "group": "audio",
                  "keyframeable": true,
                  "order": 0,
                  "precision": 1,
                  "step": 0.5,
                  "unit": "dB"
                }
              },
              "audio_pan": {
                "description": "Stereo position, `-1` (left) to `1` (right).",
                "format": "double",
                "maximum": 1.0,
                "minimum": -1.0,
                "type": [
                  "number",
                  "null"
                ],
                "x-ui": {
                  "group": "audio",
                  "keyframeable": true,
                  "order": 1,
                  "step": 0.05
                }
              },
              "blend_mode": {
                "description": "How the item combines with what is below.",
                "enum": [
                  "normal",
                  "multiply",
                  "screen",
                  "overlay",
                  "darken",
                  "lighten",
                  "add",
                  "soft_light",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "group": "compositing",
                  "order": 1
                }
              },
              "crop": {
                "additionalProperties": false,
                "description": "Edges of the source picture cut away (partial).",
                "properties": {
                  "bottom": {
                    "description": "Fraction removed from the bottom edge.",
                    "format": "double",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": [
                      "number",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "scale": 100.0,
                      "step": 0.01,
                      "unit": "%",
                      "widget": "number"
                    }
                  },
                  "left": {
                    "description": "Fraction removed from the left edge.",
                    "format": "double",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": [
                      "number",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "scale": 100.0,
                      "step": 0.01,
                      "unit": "%",
                      "widget": "number"
                    }
                  },
                  "right": {
                    "description": "Fraction removed from the right edge.",
                    "format": "double",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": [
                      "number",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "scale": 100.0,
                      "step": 0.01,
                      "unit": "%",
                      "widget": "number"
                    }
                  },
                  "top": {
                    "description": "Fraction removed from the top edge.",
                    "format": "double",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": [
                      "number",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "scale": 100.0,
                      "step": 0.01,
                      "unit": "%",
                      "widget": "number"
                    }
                  }
                },
                "type": [
                  "object",
                  "null"
                ],
                "x-ui": {
                  "group": "crop",
                  "order": 2
                }
              },
              "enabled": {
                "description": "Rendered and heard (`true`) or kept but skipped (`false`).",
                "type": [
                  "boolean",
                  "null"
                ],
                "x-ui": {
                  "group": "clip",
                  "order": 1
                }
              },
              "flip": {
                "additionalProperties": false,
                "description": "Mirroring (partial).",
                "properties": {
                  "horizontal": {
                    "description": "Mirror left-right.",
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true
                    }
                  },
                  "vertical": {
                    "description": "Mirror top-bottom.",
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true
                    }
                  }
                },
                "type": [
                  "object",
                  "null"
                ],
                "x-ui": {
                  "group": "flip",
                  "order": 3
                }
              },
              "name": {
                "description": "Display name; an empty string clears it (the media name is shown again).",
                "type": [
                  "string",
                  "null"
                ],
                "x-ui": {
                  "group": "clip",
                  "order": 0
                }
              },
              "opacity": {
                "description": "Opacity `0.0..=1.0`.",
                "format": "double",
                "maximum": 1.0,
                "minimum": 0.0,
                "type": [
                  "number",
                  "null"
                ],
                "x-ui": {
                  "group": "compositing",
                  "keyframeable": true,
                  "order": 0,
                  "scale": 100.0,
                  "step": 0.01,
                  "unit": "%",
                  "widget": "slider"
                }
              },
              "transform": {
                "additionalProperties": false,
                "description": "Placement on the canvas (partial).",
                "properties": {
                  "anchor": {
                    "additionalProperties": false,
                    "description": "The item point `position` places and rotation turns around, in item units.",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ],
                    "x-ui": {
                      "advanced": true,
                      "keyframeable": true,
                      "step": 1.0,
                      "widget": "vec2"
                    }
                  },
                  "position": {
                    "additionalProperties": false,
                    "description": "Offset of the anchor from the canvas center, in canvas units (+y is down).",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "step": 1.0,
                      "unit": "px",
                      "widget": "vec2"
                    }
                  },
                  "rotation": {
                    "description": "Clockwise rotation in degrees.",
                    "format": "double",
                    "type": [
                      "number",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "step": 1.0,
                      "unit": "°",
                      "widget": "number"
                    }
                  },
                  "scale": {
                    "additionalProperties": false,
                    "description": "Size multiplier per axis (1.0 = aspect-fit); finite and `>= 0`.",
                    "properties": {
                      "x": {
                        "description": "Horizontal component.",
                        "format": "double",
                        "type": "number"
                      },
                      "y": {
                        "description": "Vertical component (down is positive).",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": [
                      "object",
                      "null"
                    ],
                    "x-ui": {
                      "keyframeable": true,
                      "linked": true,
                      "min": 0.0,
                      "scale": 100.0,
                      "step": 0.01,
                      "unit": "%",
                      "widget": "vec2"
                    }
                  }
                },
                "type": [
                  "object",
                  "null"
                ],
                "x-ui": {
                  "group": "transform",
                  "order": 1
                }
              }
            },
            "type": "object"
          }
        },
        "required": [
          "props"
        ],
        "title": "ItemSetProps",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "item_set_props",
      "name": "item.set_props",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.set_props`.",
        "properties": {
          "changed": {
            "description": "The props whose value actually changed on any item (`name`, `enabled`, `opacity`,\n`audio_gain`, `transform.position`, ...); empty if everything was already as requested.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "item": {
            "description": "The item (the first of `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "keyed": {
            "description": "The keys written on animated properties.",
            "items": {
              "additionalProperties": false,
              "description": "A key `item.set_props` wrote on an animated property.",
              "properties": {
                "at": {
                  "description": "Sequence time of the key, after snapping.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "item": {
                  "description": "The item.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "description": "Item time of the key, after snapping.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "prop",
                "t",
                "at"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "item",
          "changed",
          "keyed"
        ],
        "title": "ItemSetPropsOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Set an item's name, enabled, opacity, audio, transform, crop, flip or blend mode (partial)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Takes the given items (only them) out of their linked groups. A group left with one member\nis dissolved. Items that are not linked are left as they are. Nothing moves.",
        "properties": {
          "items": {
            "description": "The items to unlink.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ItemUnlink",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "item_unlink",
      "name": "item.unlink",
      "namespace": "item",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `item.unlink`.",
        "properties": {
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "item",
                    "start",
                    "duration",
                    "source_in"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "created",
              "removed",
              "split",
              "moved",
              "trimmed",
              "relinked",
              "replaced",
              "toggled",
              "created_tracks"
            ],
            "type": "object"
          }
        },
        "required": [
          "report"
        ],
        "title": "ItemUnlinkOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Take items out of their linked groups",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Cancels a background job. A queued job is cancelled at once; a running one stops within\n500 ms (`running` with `cancel_requested` until then; `job.wait` to see it end). Cancelling\na finished job changes nothing. Returns the job's state.",
        "properties": {
          "id": {
            "description": "The job.",
            "pattern": "^job_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "JobCancel",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "job_cancel",
      "name": "job.cancel",
      "namespace": "job",
      "output_schema": {
        "additionalProperties": false,
        "description": "A job as reported by `job.status`, `job.list`, `job.wait`, `job.cancel` and the\n`job.progress` event.",
        "properties": {
          "cancel_requested": {
            "description": "Whether cancellation was requested; a running job stops when it next checks.",
            "type": "boolean"
          },
          "error": {
            "description": "Why it failed, was skipped or was cancelled.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The job.",
            "pattern": "^job_[0-9a-f]{32}$",
            "type": "string"
          },
          "kind": {
            "description": "What kind of work it is.",
            "oneOf": [
              {
                "const": "analysis",
                "description": "Background analysis of an imported asset (index, thumbnails, waveform): decodes media.",
                "type": "string"
              },
              {
                "const": "export",
                "description": "Rendering and encoding a sequence to a file (WP-1E.03).",
                "type": "string"
              },
              {
                "const": "proxy",
                "description": "Making a media asset's proxy (WP-2F.01): decodes the original and encodes a smaller\nintra-frame copy.",
                "type": "string"
              }
            ]
          },
          "label": {
            "description": "What it does, e.g. the analysis stage (`index`, `thumbnails`, `waveform`).",
            "type": "string"
          },
          "media_id": {
            "description": "The media asset it works on, if any.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "additionalProperties": false,
            "description": "How far it got.",
            "properties": {
              "bytes": {
                "description": "Bytes written so far.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "eta_ms": {
                "description": "Estimated time left, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "fps": {
                "description": "Speed in units per second.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "fraction": {
                "description": "Done fraction, `0..=1` (1 once the job succeeded).",
                "format": "double",
                "type": "number"
              },
              "frame": {
                "description": "Units done so far (an export: frames handed to the encoder).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "frames": {
                "description": "Units in all (an export: frames in the file).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "message": {
                "description": "What it is doing, for status lines.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "fraction",
              "message"
            ],
            "type": "object"
          },
          "state": {
            "description": "Where it is in its lifecycle.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for the jobs it depends on or for a budget slot.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "Running.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Finished its work.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Stopped with an error (see `error`), or skipped because a job it needs failed.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or while running.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "media_id",
          "state",
          "progress",
          "cancel_requested",
          "error"
        ],
        "title": "JobInfo",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Cancel a background job (stops within 500 ms; no effect once it finished)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists background jobs, newest first: unfinished ones and recently finished ones, optionally\nonly those of one asset, state or kind.",
        "properties": {
          "kind": {
            "anyOf": [
              {
                "description": "What kind of work a job does. The kind decides which [`Budget`] it runs under.",
                "oneOf": [
                  {
                    "const": "analysis",
                    "description": "Background analysis of an imported asset (index, thumbnails, waveform): decodes media.",
                    "type": "string"
                  },
                  {
                    "const": "export",
                    "description": "Rendering and encoding a sequence to a file (WP-1E.03).",
                    "type": "string"
                  },
                  {
                    "const": "proxy",
                    "description": "Making a media asset's proxy (WP-2F.01): decodes the original and encodes a smaller\nintra-frame copy.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only jobs of this kind."
          },
          "limit": {
            "default": null,
            "description": "Most jobs returned, `1..=500` (default 50).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "media_id": {
            "default": null,
            "description": "Only jobs working on this media asset.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "anyOf": [
              {
                "description": "Where a job is in its lifecycle. `succeeded`, `failed` and `cancelled` are final.",
                "oneOf": [
                  {
                    "const": "queued",
                    "description": "Waiting for the jobs it depends on or for a budget slot.",
                    "type": "string"
                  },
                  {
                    "const": "running",
                    "description": "Running.",
                    "type": "string"
                  },
                  {
                    "const": "succeeded",
                    "description": "Finished its work.",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "description": "Stopped with an error (see `error`), or skipped because a job it needs failed.",
                    "type": "string"
                  },
                  {
                    "const": "cancelled",
                    "description": "Cancelled before or while running.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only jobs in this state (e.g. `running`)."
          }
        },
        "title": "JobList",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "job_list",
      "name": "job.list",
      "namespace": "job",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `job.list`.",
        "properties": {
          "active": {
            "description": "How many jobs are unfinished (queued or running) in total, whatever the filter.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "jobs": {
            "description": "The jobs, newest first.",
            "items": {
              "additionalProperties": false,
              "description": "A job as reported by `job.status`, `job.list`, `job.wait`, `job.cancel` and the\n`job.progress` event.",
              "properties": {
                "cancel_requested": {
                  "description": "Whether cancellation was requested; a running job stops when it next checks.",
                  "type": "boolean"
                },
                "error": {
                  "description": "Why it failed, was skipped or was cancelled.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id": {
                  "description": "The job.",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": "string"
                },
                "kind": {
                  "description": "What kind of work it is.",
                  "oneOf": [
                    {
                      "const": "analysis",
                      "description": "Background analysis of an imported asset (index, thumbnails, waveform): decodes media.",
                      "type": "string"
                    },
                    {
                      "const": "export",
                      "description": "Rendering and encoding a sequence to a file (WP-1E.03).",
                      "type": "string"
                    },
                    {
                      "const": "proxy",
                      "description": "Making a media asset's proxy (WP-2F.01): decodes the original and encodes a smaller\nintra-frame copy.",
                      "type": "string"
                    }
                  ]
                },
                "label": {
                  "description": "What it does, e.g. the analysis stage (`index`, `thumbnails`, `waveform`).",
                  "type": "string"
                },
                "media_id": {
                  "description": "The media asset it works on, if any.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "progress": {
                  "additionalProperties": false,
                  "description": "How far it got.",
                  "properties": {
                    "bytes": {
                      "description": "Bytes written so far.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "eta_ms": {
                      "description": "Estimated time left, in milliseconds.",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "fps": {
                      "description": "Speed in units per second.",
                      "format": "double",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "fraction": {
                      "description": "Done fraction, `0..=1` (1 once the job succeeded).",
                      "format": "double",
                      "type": "number"
                    },
                    "frame": {
                      "description": "Units done so far (an export: frames handed to the encoder).",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "frames": {
                      "description": "Units in all (an export: frames in the file).",
                      "format": "uint64",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "message": {
                      "description": "What it is doing, for status lines.",
                      "type": [
                        "string",
