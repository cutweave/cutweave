                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "item",
                    "start",
                    "duration",
                    "source_in"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "created",
              "removed",
              "split",
              "moved",
              "trimmed",
              "relinked",
              "replaced",
              "toggled",
              "created_tracks"
            ],
            "type": "object"
          }
        },
        "required": [
          "at",
          "duration",
          "clips",
          "linked_group",
          "created_tracks",
          "report"
        ],
        "title": "TimelineInsertOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Place a media clip over a range of a track, cutting out what is there",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Pastes a clipboard payload at `at`. Every item and group gets a new ID and links are\nremapped; media references are kept, so it works across sequences. `track` is where the\ntop-most payload track goes (the others keep their rows and need the same kind); without it\nthe items return to their source tracks. `mode` picks the placement (default `insert` with\nitems on the magnetic main track, else `reject`). `Locked` if a track it would change is\nlocked; nothing changes then.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Where the earliest copied item goes."
          },
          "mode": {
            "default": null,
            "description": "Placement mode.",
            "enum": [
              "insert",
              "overwrite",
              "new_track",
              "reject",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "additionalProperties": false,
            "description": "The payload `timeline.copy` returned.",
            "properties": {
              "frame_rate": {
                "additionalProperties": false,
                "description": "Its frame rate: pasting into a sequence with another one snaps to the frame grid.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": "object"
              },
              "items": {
                "description": "The items, by source track (display order), then start, then ID.",
                "items": {
                  "additionalProperties": false,
                  "description": "One copied item.",
                  "properties": {
                    "item": {
                      "description": "The item as copied, with its `start` relative to the earliest copied item. Its `id`,\n`linked_group` and `attached_to` only relate the items of the payload to each other.",
                      "oneOf": [
                        {
                          "description": "A media clip.",
                          "properties": {
                            "attached_to": {
                              "description": "The item this one follows when it moves (schema v2, timeline spec §1.4): an overlay\nattached to a main-track clip. `None` when free.",
                              "pattern": "^itm_[0-9a-f]{32}$",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "audio": {
                              "description": "Audio properties.",
                              "properties": {
                                "fade_in": {
                                  "default": {
                                    "curve": "linear",
                                    "duration": 0
                                  },
                                  "description": "Fade from silence at the start of the clip (WP-2E.01). Absent in documents written\nbefore it: no fade.",
                                  "properties": {
                                    "curve": {
                                      "description": "Its shape.",
                                      "oneOf": [
                                        {
                                          "const": "linear",
                                          "description": "Gain rises in a straight line (the default).",
                                          "type": "string"
                                        },
                                        {
                                          "const": "log",
                                          "description": "Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in.",
                                          "type": "string"
                                        },
                                        {
                                          "const": "equal_power",
                                          "description": "Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`.",
                                          "type": "string"
                                        },
                                        {
                                          "const": "s_curve",
                                          "description": "Gentle at both ends: `(1 - cos(x*pi)) / 2`.",
                                          "type": "string"
                                        }
                                      ]
                                    },
                                    "duration": {
                                      "anyOf": [
                                        {
                                          "maximum": 9007199254740991,
                                          "minimum": 0,
                                          "type": "integer"
                                        },
                                        {
                                          "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                          "type": "string"
                                        }
                                      ],
                                      "description": "Length of the fade."
                                    }
                                  },
                                  "required": [
                                    "duration",
                                    "curve"
                                  ],
                                  "type": "object"
                                },
                                "fade_out": {
                                  "default": {
                                    "curve": "linear",
                                    "duration": 0
                                  },
                                  "description": "Fade to silence at the end of the clip (WP-2E.01). Absent in older documents: no fade.",
                                  "properties": {
                                    "curve": {
                                      "description": "Its shape.",
                                      "oneOf": [
                                        {
                                          "const": "linear",
                                          "description": "Gain rises in a straight line (the default).",
                                          "type": "string"
                                        },
                                        {
                                          "const": "log",
                                          "description": "Gain rises quickly then flattens (`log10(1 + 9x)`): a fast, natural-sounding fade in.",
                                          "type": "string"
                                        },
                                        {
                                          "const": "equal_power",
                                          "description": "Constant power with a matching fade of the same shape on the other clip: `sin(x*pi/2)`.",
                                          "type": "string"
                                        },
                                        {
                                          "const": "s_curve",
                                          "description": "Gentle at both ends: `(1 - cos(x*pi)) / 2`.",
                                          "type": "string"
                                        }
                                      ]
                                    },
                                    "duration": {
                                      "anyOf": [
                                        {
                                          "maximum": 9007199254740991,
                                          "minimum": 0,
                                          "type": "integer"
                                        },
                                        {
                                          "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                          "type": "string"
                                        }
                                      ],
                                      "description": "Length of the fade."
                                    }
                                  },
                                  "required": [
                                    "duration",
                                    "curve"
                                  ],
                                  "type": "object"
                                },
                                "gain": {
                                  "description": "Gain in decibels (0.0 = unchanged).",
                                  "oneOf": [
                                    {
                                      "format": "double",
                                      "type": "number"
                                    },
                                    {
                                      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                      "properties": {
                                        "keyframes": {
                                          "items": {
                                            "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                            "properties": {
                                              "interp": {
                                                "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                                "oneOf": [
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "The key's value until the next key, then a jump (§4.2).",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "hold",
                                                        "type": "string"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "`p = u` (§4.3).",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "linear",
                                                        "type": "string"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "bezier",
                                                        "type": "string"
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ]
                                                      },
                                                      "x1": {
                                                        "description": "First control point, time axis, in `[0, 1]`.",
                                                        "format": "double",
                                                        "maximum": 1.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "x2": {
                                                        "description": "Second control point, time axis, in `[0, 1]`.",
                                                        "format": "double",
                                                        "maximum": 1.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "y1": {
                                                        "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                        "format": "double",
                                                        "maximum": 10.0,
                                                        "minimum": -10.0,
                                                        "type": "number"
                                                      },
                                                      "y2": {
                                                        "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                        "format": "double",
                                                        "maximum": 10.0,
                                                        "minimum": -10.0,
                                                        "type": "number"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind",
                                                      "x1",
                                                      "y1",
                                                      "x2",
                                                      "y2"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                    "properties": {
                                                      "bounce": {
                                                        "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                        "type": "boolean"
                                                      },
                                                      "damping": {
                                                        "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                        "format": "double",
                                                        "maximum": 1000.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "kind": {
                                                        "const": "spring",
                                                        "type": "string"
                                                      },
                                                      "mass": {
                                                        "description": "Mass, kg, in `[0.1, 100]`.",
                                                        "format": "double",
                                                        "maximum": 100.0,
                                                        "minimum": 0.1,
                                                        "type": "number"
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ]
                                                      },
                                                      "stiffness": {
                                                        "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                        "format": "double",
                                                        "maximum": 10000.0,
                                                        "minimum": 1.0,
                                                        "type": "number"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind",
                                                      "stiffness",
                                                      "damping",
                                                      "mass",
                                                      "bounce"
                                                    ],
                                                    "type": "object"
                                                  }
                                                ]
                                              },
                                              "t": {
                                                "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                                "maximum": 9007199254740991,
                                                "minimum": -9007199254740991,
                                                "type": "integer"
                                              },
                                              "value": {
                                                "format": "double",
                                                "type": "number"
                                              }
                                            },
                                            "required": [
                                              "t",
                                              "value",
                                              "interp"
                                            ],
                                            "type": "object"
                                          },
                                          "maxItems": 100000,
                                          "minItems": 1,
                                          "type": "array"
                                        }
                                      },
                                      "required": [
                                        "keyframes"
                                      ],
                                      "type": "object"
                                    }
                                  ]
                                },
                                "pan": {
                                  "description": "Stereo position, -1.0 (left) to 1.0 (right), 0.0 = centre.",
                                  "oneOf": [
                                    {
                                      "format": "double",
                                      "type": "number"
                                    },
                                    {
                                      "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                      "properties": {
                                        "keyframes": {
                                          "items": {
                                            "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                            "properties": {
                                              "interp": {
                                                "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                                "oneOf": [
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "The key's value until the next key, then a jump (§4.2).",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "hold",
                                                        "type": "string"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "`p = u` (§4.3).",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "linear",
                                                        "type": "string"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                    "properties": {
                                                      "kind": {
                                                        "const": "bezier",
                                                        "type": "string"
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ]
                                                      },
                                                      "x1": {
                                                        "description": "First control point, time axis, in `[0, 1]`.",
                                                        "format": "double",
                                                        "maximum": 1.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "x2": {
                                                        "description": "Second control point, time axis, in `[0, 1]`.",
                                                        "format": "double",
                                                        "maximum": 1.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "y1": {
                                                        "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                        "format": "double",
                                                        "maximum": 10.0,
                                                        "minimum": -10.0,
                                                        "type": "number"
                                                      },
                                                      "y2": {
                                                        "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                        "format": "double",
                                                        "maximum": 10.0,
                                                        "minimum": -10.0,
                                                        "type": "number"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind",
                                                      "x1",
                                                      "y1",
                                                      "x2",
                                                      "y2"
                                                    ],
                                                    "type": "object"
                                                  },
                                                  {
                                                    "additionalProperties": false,
                                                    "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                    "properties": {
                                                      "bounce": {
                                                        "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                        "type": "boolean"
                                                      },
                                                      "damping": {
                                                        "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                        "format": "double",
                                                        "maximum": 1000.0,
                                                        "minimum": 0.0,
                                                        "type": "number"
                                                      },
                                                      "kind": {
                                                        "const": "spring",
                                                        "type": "string"
                                                      },
                                                      "mass": {
                                                        "description": "Mass, kg, in `[0.1, 100]`.",
                                                        "format": "double",
                                                        "maximum": 100.0,
                                                        "minimum": 0.1,
                                                        "type": "number"
                                                      },
                                                      "preset": {
                                                        "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                        "type": [
                                                          "string",
                                                          "null"
                                                        ]
                                                      },
                                                      "stiffness": {
                                                        "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                        "format": "double",
                                                        "maximum": 10000.0,
                                                        "minimum": 1.0,
                                                        "type": "number"
                                                      }
                                                    },
                                                    "required": [
                                                      "kind",
                                                      "stiffness",
                                                      "damping",
                                                      "mass",
                                                      "bounce"
                                                    ],
                                                    "type": "object"
                                                  }
                                                ]
                                              },
                                              "t": {
                                                "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                                "maximum": 9007199254740991,
                                                "minimum": -9007199254740991,
                                                "type": "integer"
                                              },
                                              "value": {
                                                "format": "double",
                                                "type": "number"
                                              }
                                            },
                                            "required": [
                                              "t",
                                              "value",
                                              "interp"
                                            ],
                                            "type": "object"
                                          },
                                          "maxItems": 100000,
                                          "minItems": 1,
                                          "type": "array"
                                        }
                                      },
                                      "required": [
                                        "keyframes"
                                      ],
                                      "type": "object"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "gain",
                                "pan"
                              ],
                              "type": "object"
                            },
                            "custom": {
                              "additionalProperties": true,
                              "description": "Plugin data (arch §4.3).",
                              "propertyNames": {
                                "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
                              },
                              "type": "object"
                            },
                            "duration": {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                {
                                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                  "type": "string"
                                }
                              ],
                              "description": "Length on the timeline (positive)."
                            },
                            "enabled": {
                              "description": "Disabled items are kept but neither rendered nor heard.",
                              "type": "boolean"
                            },
                            "freeze": {
                              "additionalProperties": false,
                              "default": null,
                              "description": "A freeze frame (WP-2D.01): shows the frame at `at_source` for its whole length, silent.\nAbsent in older documents: not a freeze frame.",
                              "properties": {
                                "at_source": {
                                  "anyOf": [
                                    {
                                      "maximum": 9007199254740991,
                                      "minimum": -9007199254740991,
                                      "type": "integer"
                                    },
                                    {
                                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                      "type": "string"
                                    }
                                  ],
                                  "description": "The media position of the frame shown."
                                }
                              },
                              "required": [
                                "at_source"
                              ],
                              "type": [
                                "object",
                                "null"
                              ]
                            },
                            "id": {
                              "description": "The item ID (also its key in the track's `items`).",
                              "pattern": "^itm_[0-9a-f]{32}$",
                              "type": "string"
                            },
                            "kind": {
                              "const": "clip",
                              "type": "string"
                            },
                            "linked_group": {
                              "description": "Items with the same group move, trim and delete together (e.g. linked video and audio).",
                              "pattern": "^grp_[0-9a-f]{32}$",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "markers": {
                              "additionalProperties": false,
                              "description": "Markers in item-relative time; they move with the item.",
                              "patternProperties": {
                                "^mrk_[0-9a-f]{32}$": {
                                  "description": "A marker on a sequence (sequence time) or an item (item-relative time).",
                                  "properties": {
                                    "color": {
                                      "description": "Display color.",
                                      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                                      "type": "string"
                                    },
                                    "duration": {
                                      "anyOf": [
                                        {
                                          "anyOf": [
                                            {
                                              "maximum": 9007199254740991,
                                              "minimum": 0,
                                              "type": "integer"
                                            },
                                            {
                                              "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                              "type": "string"
                                            }
                                          ],
                                          "description": "A non-negative duration in flicks (1/705600000 s) as an integer, or a string: seconds (\"62.5s\") or raw flicks (\"123\")."
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "The length of a range marker; `None` for a point marker."
                                    },
                                    "id": {
                                      "description": "The marker ID (also its key in the owner's `markers`).",
                                      "pattern": "^mrk_[0-9a-f]{32}$",
                                      "type": "string"
                                    },
                                    "kind": {
                                      "description": "What the marker means.",
                                      "oneOf": [
                                        {
                                          "const": "user",
                                          "description": "Placed by a person or an agent.",
                                          "type": "string"
                                        },
                                        {
                                          "const": "beat",
                                          "description": "A beat found by analysis (snaps like a marker, spec §6).",
                                          "type": "string"
                                        },
                                        {
                                          "const": "chapter",
                                          "description": "A chapter start (exported to chaptered formats).",
                                          "type": "string"
                                        }
                                      ]
                                    },
                                    "label": {
                                      "description": "Text shown with the marker (may be empty).",
                                      "type": "string"
                                    },
                                    "t": {
                                      "anyOf": [
                                        {
                                          "maximum": 9007199254740991,
                                          "minimum": -9007199254740991,
                                          "type": "integer"
                                        },
                                        {
                                          "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                          "type": "string"
                                        }
                                      ],
                                      "description": "Where the marker is (`>= 0`)."
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "t",
                                    "label",
                                    "color",
                                    "kind"
                                  ],
                                  "type": "object"
                                }
                              },
                              "type": "object"
                            },
                            "media": {
                              "description": "The media this clip plays.",
                              "pattern": "^med_[0-9a-f]{32}$",
                              "type": "string"
                            },
                            "name": {
                              "description": "Display name; `None` shows the media name.",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "reverse": {
                              "default": false,
                              "description": "Plays its source range backwards (WP-2D.01). Absent in older documents: forwards.",
                              "type": "boolean"
                            },
                            "source_in": {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer"
                                },
                                {
                                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                  "type": "string"
                                }
                              ],
                              "description": "Source position (from the start of the media) of the first frame (of the last frame\nshown, when reversed)."
                            },
                            "speed": {
                              "additionalProperties": false,
                              "default": {
                                "den": 1,
                                "num": 1
                              },
                              "description": "Playback speed (WP-2D.01): a timeline span `d` plays `d × speed` of media (INV-47).\nAbsent in documents written before it (the v2 fill-in adds it): normal speed.",
                              "properties": {
                                "den": {
                                  "description": "Denominator.",
                                  "maximum": 100000,
                                  "minimum": 1,
                                  "type": "integer"
                                },
                                "num": {
                                  "description": "Numerator.",
                                  "maximum": 100000,
                                  "minimum": 1,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "num",
                                "den"
                              ],
                              "type": "object"
                            },
                            "start": {
                              "anyOf": [
                                {
                                  "maximum": 9007199254740991,
                                  "minimum": -9007199254740991,
                                  "type": "integer"
                                },
                                {
                                  "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                                  "type": "string"
                                }
                              ],
                              "description": "Timeline position of the first frame."
                            },
                            "visual": {
                              "description": "Visual properties.",
                              "properties": {
                                "blend_mode": {
                                  "description": "How the item combines with what is below.",
                                  "enum": [
                                    "normal",
                                    "multiply",
                                    "screen",
                                    "overlay",
                                    "darken",
                                    "lighten",
                                    "add",
                                    "soft_light"
                                  ],
                                  "type": "string"
                                },
                                "crop": {
                                  "description": "Edges of the source picture cut away.",
                                  "properties": {
                                    "bottom": {
                                      "description": "Fraction removed from the bottom edge.",
                                      "oneOf": [
                                        {
                                          "format": "double",
                                          "type": "number"
                                        },
                                        {
                                          "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                          "properties": {
                                            "keyframes": {
                                              "items": {
                                                "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                                "properties": {
                                                  "interp": {
                                                    "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                                    "oneOf": [
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "The key's value until the next key, then a jump (§4.2).",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "hold",
                                                            "type": "string"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind"
                                                        ],
                                                        "type": "object"
                                                      },
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "`p = u` (§4.3).",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "linear",
                                                            "type": "string"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind"
                                                        ],
                                                        "type": "object"
                                                      },
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "bezier",
                                                            "type": "string"
                                                          },
                                                          "preset": {
                                                            "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                            "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                            "type": [
                                                              "string",
                                                              "null"
                                                            ]
                                                          },
                                                          "x1": {
                                                            "description": "First control point, time axis, in `[0, 1]`.",
                                                            "format": "double",
                                                            "maximum": 1.0,
                                                            "minimum": 0.0,
                                                            "type": "number"
                                                          },
                                                          "x2": {
                                                            "description": "Second control point, time axis, in `[0, 1]`.",
                                                            "format": "double",
                                                            "maximum": 1.0,
                                                            "minimum": 0.0,
                                                            "type": "number"
                                                          },
                                                          "y1": {
                                                            "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                            "format": "double",
                                                            "maximum": 10.0,
                                                            "minimum": -10.0,
                                                            "type": "number"
                                                          },
                                                          "y2": {
