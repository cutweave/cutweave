                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "description": "A media asset.",
                  "properties": {
                    "id": {
                      "description": "The asset.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "kind": {
                      "const": "media",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
