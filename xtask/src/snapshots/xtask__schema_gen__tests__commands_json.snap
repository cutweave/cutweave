        ],
        "title": "TimelineRemoveMarkerOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Remove a marker",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Deletes items and their linked partners and closes the space each given item leaves on its\ntrack: what follows on that track moves left by the length deleted before it, and so do the\ntracks of linked partners of what moves (or every track with `ripple_all_tracks`). All given\nitems must be on one track; gaps that were already there stay. Fails with `Invalid` if the\nshift would make items overlap on a rippled track, and with `Locked` if it would change a\nlocked track. On the magnetic main track it is the same as `item.delete`.",
        "properties": {
          "items": {
            "description": "The items to delete, at least one, all on one track.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "ripple_all_tracks": {
            "default": null,
            "description": "Shift every track of the sequence, not only the item's track and its partners' tracks\n(default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "title": "TimelineRippleDelete",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_ripple_delete",
      "name": "timeline.ripple_delete",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.ripple_delete`.",
        "properties": {
          "deleted": {
            "description": "Every deleted item: the requested ones in request order, then their linked partners.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "item",
                    "start",
                    "duration",
                    "source_in"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "created",
              "removed",
              "split",
              "moved",
              "trimmed",
              "relinked",
              "replaced",
              "toggled",
              "created_tracks"
            ],
            "type": "object"
          }
        },
        "required": [
          "deleted",
          "report"
        ],
        "title": "DeletedOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Delete items on one track and close the space they leave (partners follow)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets the sequence's in and out points: the half-open range `[start, end)` that lift,\nextract and three-point edits act on. Both ends are given (a range always has both). Times\nsnap to the frame grid and `end` must follow `start`. The range never moves with a ripple.",
        "properties": {
          "end": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "The out point, after the in point."
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "The in point, `>= 0`."
          }
        },
        "required": [
          "sequence",
          "start",
          "end"
        ],
        "title": "TimelineSetInOut",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_set_in_out",
      "name": "timeline.set_in_out",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.set_in_out`.",
        "properties": {
          "end": {
            "description": "The out point, snapped to the frame grid.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "start": {
            "description": "The in point, snapped to the frame grid.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "start",
          "end"
        ],
        "title": "TimelineSetInOutOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Set the sequence's in and out points",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Adds an empty track to a sequence. New video tracks go on top of the stack, new audio\ntracks at the bottom, unless `index` says otherwise.",
        "properties": {
          "index": {
            "default": null,
            "description": "Display position, 0 = top (clamped to the end).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "description": "`video` or `audio`.",
            "oneOf": [
              {
                "const": "video",
                "description": "Picture layers.",
                "type": "string"
              },
              {
                "const": "audio",
                "description": "Sound.",
                "type": "string"
              },
              {
                "const": "text",
                "description": "Titles (later versions).",
                "type": "string"
              },
              {
                "const": "caption",
                "description": "Captions (later versions).",
                "type": "string"
              },
              {
                "const": "adjustment",
                "description": "Adjustment layers (later versions).",
                "type": "string"
              }
            ]
          },
          "name": {
            "default": null,
            "description": "Display name; defaults to `V<n>` / `A<n>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "kind"
        ],
        "title": "TrackAdd",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "track_add",
