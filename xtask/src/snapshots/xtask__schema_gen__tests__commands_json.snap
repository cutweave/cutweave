      "output_schema": {
        "additionalProperties": false,
        "description": "A cancelled transaction.",
        "properties": {
          "kind": {
            "description": "Its kind.",
            "oneOf": [
              {
                "const": "batch",
                "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                "type": "string"
              },
              {
                "const": "gesture",
                "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                "type": "string"
              }
            ]
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "Its id.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "kind",
          "rev"
        ],
        "title": "TxCancelled",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Cancel your open transaction and roll back its changes",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Captures the committed document as a restore point (cheap: snapshots share structure).\nOpen transactions are not included. At most 50 are kept, 20 of them named (least recently\nused first out); reusing a name moves it to the new checkpoint. Checkpoints are saved in the\nproject's journal: they survive a crash, saves and reopening the project.",
        "properties": {
          "name": {
            "default": null,
            "description": "A name to restore it by (1..=64 characters, not `cp_<n>`).",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "default": null,
            "description": "A note (at most 1000 characters).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Checkpoint",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_checkpoint",
      "name": "edit.checkpoint",
      "namespace": "edit",
      "output_schema": {
        "description": "A checkpoint, as `edit.checkpoint` and `edit.list_checkpoints` report it.",
        "properties": {
          "actor": {
            "description": "Who made it.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": "string"
          },
          "at": {
            "description": "When.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "checkpoint": {
            "description": "Its id.",
            "pattern": "^cp_[0-9]+$",
            "type": "string"
          },
          "name": {
            "description": "Its name, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "description": "A free-form note.",
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "description": "The committed revision it captured.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "checkpoint",
          "name",
          "note",
          "rev",
          "actor",
          "at"
        ],
        "title": "CheckpointInfo",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Save a restore point of the committed document (cheap; optional name)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Commits this connection's open transaction: its changes become one committed transaction\nand one undo entry. Fails with `Conflict` (and closes it) if another transaction committed\noverlapping changes first.",
        "properties": {
          "tx": {
            "default": null,
            "description": "The transaction (default: this connection's open one).",
            "pattern": "^tx_[0-9]+$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CommitTx",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_commit_tx",
      "name": "edit.commit_tx",
      "namespace": "edit",
      "output_schema": {
        "additionalProperties": false,
        "description": "A committed transaction.",
        "properties": {
          "changed": {
            "description": "Whether it changed the document (and made an undo entry).",
            "type": "boolean"
          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "description": "Its kind.",
            "oneOf": [
              {
                "const": "batch",
                "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                "type": "string"
              },
              {
                "const": "gesture",
                "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                "type": "string"
              }
            ]
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "Its id.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "kind",
          "changed",
          "rev",
          "committed_rev"
        ],
        "title": "TxCommitted",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Commit your open transaction as one undo step",
      "undoable": false,
      "view": false
    },
    {
