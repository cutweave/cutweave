                    "type": "string"
                  },
                  {
                    "const": "mp3",
                    "description": "MP3 (audio only).",
                    "type": "string"
                  },
                  {
                    "const": "m4a",
                    "description": "M4A (AAC audio only).",
                    "type": "string"
                  },
                  {
                    "const": "flac",
                    "description": "FLAC (audio only).",
                    "type": "string"
                  },
                  {
                    "const": "ogg",
                    "description": "Ogg (Opus audio only).",
                    "type": "string"
                  }
                ]
              },
              "fps": {
                "description": "The frame-rate rule.",
                "oneOf": [
                  {
                    "description": "The sequence's rate, capped at `max` when given.",
