      "input_schema": {
        "additionalProperties": false,
        "description": "Pauses the export queue (no export starts; a running one finishes) or resumes it. The pause\nis kept with the project. Returns the queue.",
        "properties": {
          "paused": {
            "description": "true pauses, false resumes.",
            "type": "boolean"
          }
        },
