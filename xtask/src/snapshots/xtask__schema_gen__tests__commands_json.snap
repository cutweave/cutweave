        "additionalProperties": false,
        "description": "Result of `track.add`.",
        "properties": {
          "index": {
            "description": "Where it is in the display order now (0 = top).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "track": {
            "description": "The new track.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          },
          "track_count": {
            "description": "How many tracks the sequence has now.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "warnings": {
            "description": "Soft warnings (more than [`SOFT_TRACK_LIMIT`] tracks), empty normally.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "track",
          "index",
          "track_count",
          "warnings"
        ],
        "title": "TrackAddOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Add an empty video or audio track to a sequence",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Removes a track together with its items. Fails with `Locked` if the track is locked, if a\nlinked partner that would be left alone in its group is on a locked track, or if an item\nattached to a removed item is on a locked track. Linked partners of the removed items stay;\na partner left alone in its group is unlinked. Items attached to a removed item are\ndetached and keep their place (spec INV-38).",
        "properties": {
          "track": {
            "description": "The track.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "track"
        ],
