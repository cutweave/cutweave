      "summary": "Trim a clip's edge and move what follows by the same amount (ripple)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Moves the cut between two adjacent clips of one track (`right` starts where `left` ends) to\na timeline time (`to`) or by an offset (`delta`; exactly one): `left` gets a later or\nearlier end, `right` the same start (its source position follows), and so do their linked\npartners. Nothing else moves and the track keeps its length. Both clips keep at least one\nframe and stay inside their media; a partner stops at an item of its track that is not the\nother side's partner. `Invalid{path:\"/right\"}` for clips that do not touch; limits as in\n`clip.trim` (`clamp: true` stops at them). `Locked` if a track involved is locked.",
        "properties": {
          "clamp": {
            "default": null,
            "description": "Stop at the nearest limit instead of failing (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "delta": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Offset of the cut (negative: earlier). Use seconds or flicks for negative values."
          },
          "left": {
            "description": "The clip before the cut.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "prune_keyframes": {
            "default": null,
            "description": "Drop keyframes the roll leaves outside the clips (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "right": {
            "description": "The clip after the cut: it starts where `left` ends, on the same track.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "to": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Timeline time of the cut afterwards (frame-snapped)."
          }
        },
        "required": [
          "left",
          "right"
        ],
        "title": "ClipRoll",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "clip_roll",
      "name": "clip.roll",
      "namespace": "clip",
      "output_schema": {
        "additionalProperties": false,
