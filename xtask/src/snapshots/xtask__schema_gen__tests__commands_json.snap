        "title": "KeyframePasteOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Paste copied keys onto an item at a time",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Add or replace keys on one property. `t` = item time, `at` = sequence time; both snap to\nframes. A key's `easing` shapes the move to the next key. Example: `{item, prop:\"opacity\",\nkeys:[{at:\"10s\", value:0, easing:\"ease_out\"}, {at:\"12s\", value:1}]}`.\n\nA static property becomes animated with exactly these keys; a key at an occupied time is\nreplaced; a new key inherits the previous key's easing; `replace` makes the result exactly\nthese keys; `fine` snaps audio properties to samples. `Locked` if the track is locked.",
        "properties": {
          "fine": {
            "default": null,
            "description": "Snap to audio samples (audio properties).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "item": {
            "default": null,
            "description": "The item (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Items to give the same keys.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "keys": {
            "description": "The keys, 1 to 10,000.",
            "items": {
              "additionalProperties": false,
              "description": "A key to write.",
              "properties": {
                "at": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer"
                        },
                        {
                          "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                          "type": "string"
                        }
                      ],
                      "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Sequence time. Give `t` or `at`; both snap to frames."
                },
                "easing": {
                  "description": "A preset name, `linear` or `hold`.",
                  "enum": [
                    "hold",
                    "linear",
                    "ease_in",
                    "ease_out",
                    "ease_in_out",
                    "sine_in",
                    "sine_out",
                    "sine_in_out",
                    "cubic_in",
                    "cubic_out",
                    "cubic_in_out",
                    "expo_in",
                    "expo_out",
                    "expo_in_out",
                    "back_in",
                    "back_out",
                    "back_in_out",
                    "spring",
                    "spring_gentle",
                    "spring_wobbly",
                    "spring_stiff",
                    "elastic",
                    "bounce",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "interp": {
                  "anyOf": [
                    {
                      "description": "How a key's segment moves to the next key (stored form; `bounce` may be omitted). Prefer\n`easing` for the presets.",
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "description": "Jump at the next key.",
                          "properties": {
                            "kind": {
                              "const": "hold",
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Constant speed.",
                          "properties": {
                            "kind": {
                              "const": "linear",
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "CSS cubic Bezier: `x1`, `x2` in 0..1, `y1`, `y2` in -10..10.",
                          "properties": {
                            "kind": {
                              "const": "bezier",
                              "type": "string"
                            },
                            "preset": {
                              "default": null,
                              "description": "Preset name hint.",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "x1": {
                              "description": "Control point 1 x.",
                              "format": "double",
                              "type": "number"
                            },
                            "x2": {
                              "description": "Control point 2 x.",
                              "format": "double",
                              "type": "number"
                            },
                            "y1": {
                              "description": "Control point 1 y.",
                              "format": "double",
                              "type": "number"
                            },
                            "y2": {
                              "description": "Control point 2 y.",
                              "format": "double",
                              "type": "number"
                            }
                          },
                          "required": [
                            "kind",
                            "x1",
                            "y1",
                            "x2",
                            "y2"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Damped spring: stiffness 1..10000, damping 0..1000, mass 0.1..100.",
                          "properties": {
                            "bounce": {
                              "default": null,
                              "description": "Hard stop at the target (default false).",
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "damping": {
                              "description": "Damping.",
                              "format": "double",
                              "type": "number"
                            },
                            "kind": {
                              "const": "spring",
                              "type": "string"
                            },
                            "mass": {
                              "description": "Mass.",
                              "format": "double",
                              "type": "number"
                            },
                            "preset": {
                              "default": null,
                              "description": "Preset name hint.",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "stiffness": {
                              "description": "Stiffness.",
                              "format": "double",
                              "type": "number"
                            }
                          },
                          "required": [
                            "kind",
                            "stiffness",
                            "damping",
                            "mass"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Shapes the move to the next key; or use `easing`."
                },
                "preset": {
                  "description": "Preset name hint for `interp`.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "t": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer"
                        },
                        {
                          "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                          "type": "string"
                        }
                      ],
                      "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Item time (flicks, seconds like \"1.5s\", or \"f:N\" frames from the item's start)."
                },
                "value": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "description": "A boolean.",
                          "type": "boolean"
                        },
                        {
                          "description": "A number.",
                          "format": "double",
                          "type": "number"
                        },
                        {
                          "additionalProperties": false,
                          "description": "A 2D vector.",
                          "properties": {
                            "x": {
                              "description": "Horizontal component.",
                              "format": "double",
                              "type": "number"
                            },
                            "y": {
                              "description": "Vertical component (down is positive).",
                              "format": "double",
                              "type": "number"
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "type": "object"
                        }
                      ],
                      "description": "A property value: a number, `{x, y}` (position, scale, anchor) or a boolean (flip); the\nproperty decides which."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The value; omitted: the property's current value there."
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "prop": {
            "description": "The property.",
            "enum": [
              "transform.position",
              "transform.scale",
              "transform.rotation",
              "transform.anchor",
              "opacity",
              "crop.left",
              "crop.top",
              "crop.right",
              "crop.bottom",
              "flip.horizontal",
              "flip.vertical",
              "audio_gain",
              "audio_pan"
            ],
            "type": "string"
          },
          "replace": {
            "default": null,
            "description": "Make the result exactly these keys.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "prop",
          "keys"
        ],
        "title": "KeyframeSet",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "keyframe_set",
      "name": "keyframe.set",
      "namespace": "keyframe",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `keyframe.set`.",
        "properties": {
          "keys": {
            "description": "The keys written, per item and key in request order.",
            "items": {
              "additionalProperties": false,
              "description": "One key `keyframe.set` wrote.",
              "properties": {
                "at": {
                  "description": "Sequence time after snapping.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "created": {
                  "description": "A new key (`false`: an existing key's value changed).",
                  "type": "boolean"
                },
                "item": {
                  "description": "The item.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "outside": {
                  "description": "The key lies outside the item's `[0, duration)`.",
                  "type": "boolean"
                },
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "description": "Item time after snapping.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "value": {
                  "anyOf": [
                    {
                      "description": "A boolean.",
                      "type": "boolean"
                    },
                    {
                      "description": "A number.",
                      "format": "double",
                      "type": "number"
                    },
                    {
                      "additionalProperties": false,
                      "description": "A 2D vector.",
                      "properties": {
                        "x": {
                          "description": "Horizontal component.",
                          "format": "double",
                          "type": "number"
                        },
                        "y": {
                          "description": "Vertical component (down is positive).",
                          "format": "double",
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "type": "object"
                    }
                  ],
                  "description": "The value the key holds."
                }
              },
              "required": [
                "item",
                "prop",
                "t",
                "at",
                "value",
                "created",
                "outside"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "title": "KeyframeSetOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Add or replace keys on one property of an item",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets how the segments that start at the given keys move to the next key: `interp` (stored\nform) or `easing` (a preset name, `linear` or `hold`), not both. An explicit `interp`\ncarries no preset hint unless it gives one. Flips accept only hold. `NotFound` if a key does\nnot exist; `Locked` if the item's track is locked.",
        "properties": {
          "easing": {
            "default": null,
            "description": "A preset name, `linear` or `hold`.",
            "enum": [
              "hold",
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "sine_in",
              "sine_out",
              "sine_in_out",
              "cubic_in",
              "cubic_out",
              "cubic_in_out",
              "expo_in",
              "expo_out",
              "expo_in_out",
              "back_in",
              "back_out",
              "back_in_out",
              "spring",
              "spring_gentle",
              "spring_wobbly",
              "spring_stiff",
              "elastic",
              "bounce",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "interp": {
            "anyOf": [
              {
                "description": "How a key's segment moves to the next key (stored form; `bounce` may be omitted). Prefer\n`easing` for the presets.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "Jump at the next key.",
                    "properties": {
                      "kind": {
                        "const": "hold",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Constant speed.",
                    "properties": {
                      "kind": {
                        "const": "linear",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "CSS cubic Bezier: `x1`, `x2` in 0..1, `y1`, `y2` in -10..10.",
                    "properties": {
                      "kind": {
                        "const": "bezier",
                        "type": "string"
                      },
                      "preset": {
                        "default": null,
                        "description": "Preset name hint.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "x1": {
                        "description": "Control point 1 x.",
                        "format": "double",
                        "type": "number"
                      },
                      "x2": {
                        "description": "Control point 2 x.",
                        "format": "double",
                        "type": "number"
                      },
                      "y1": {
                        "description": "Control point 1 y.",
                        "format": "double",
                        "type": "number"
                      },
                      "y2": {
                        "description": "Control point 2 y.",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "kind",
                      "x1",
                      "y1",
                      "x2",
                      "y2"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "Damped spring: stiffness 1..10000, damping 0..1000, mass 0.1..100.",
                    "properties": {
                      "bounce": {
                        "default": null,
                        "description": "Hard stop at the target (default false).",
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "damping": {
                        "description": "Damping.",
                        "format": "double",
                        "type": "number"
                      },
                      "kind": {
                        "const": "spring",
                        "type": "string"
                      },
                      "mass": {
                        "description": "Mass.",
                        "format": "double",
                        "type": "number"
                      },
                      "preset": {
                        "default": null,
                        "description": "Preset name hint.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "stiffness": {
                        "description": "Stiffness.",
                        "format": "double",
                        "type": "number"
                      }
                    },
                    "required": [
                      "kind",
                      "stiffness",
                      "damping",
                      "mass"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The interpolation (stored form)."
          },
          "item": {
            "description": "The item.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "keys": {
            "description": "The keys, by property and exact item time.",
            "items": {
              "additionalProperties": false,
              "description": "A key to address: its property and exact item time.",
              "properties": {
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                      "type": "string"
                    }
                  ],
                  "description": "The key's stored item time in flicks, as `item.get` returns it."
                }
              },
              "required": [
                "prop",
                "t"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "item",
          "keys"
        ],
        "title": "KeyframeSetInterp",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "keyframe_set_interp",
      "name": "keyframe.set_interp",
      "namespace": "keyframe",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `keyframe.set_interp`.",
        "properties": {
          "changed": {
            "description": "The keys whose segment changed.",
            "items": {
              "additionalProperties": false,
              "description": "A key to address: its property and exact item time.",
              "properties": {
                "prop": {
                  "description": "The property.",
                  "enum": [
                    "transform.position",
                    "transform.scale",
                    "transform.rotation",
                    "transform.anchor",
                    "opacity",
                    "crop.left",
                    "crop.top",
                    "crop.right",
                    "crop.bottom",
                    "flip.horizontal",
                    "flip.vertical",
                    "audio_gain",
                    "audio_pan"
                  ],
                  "type": "string"
                },
                "t": {
                  "description": "The key's stored item time in flicks, as `item.get` returns it.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "prop",
                "t"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "changed"
        ],
        "title": "KeyframeSetInterpOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Set the easing of the segments starting at keys",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Returns the media caches: the folder they live in, each disk cache's usage and limit, the\nhardware decoding policy and the memory the decoded-frame cache may use. Agents may read it;\nchanging any of it is the desktop app's.",
        "title": "MediaCacheStatus",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_cache_status",
      "name": "media.cache_status",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "What `media.cache_status` and `media.set_cache_config` report.",
        "properties": {
          "decode_hw": {
            "description": "The hardware decoding policy in force.",
            "oneOf": [
              {
                "const": "auto",
                "description": "A verified hardware decoder when the machine has one for the stream (the default).",
                "type": "string"
              },
              {
                "const": "off",
                "description": "Software decoding only.",
                "type": "string"
              }
            ]
          },
          "folder": {
            "description": "The folder the caches live in (`--cache-dir`, else the OS cache folder); `null` when\nthe engine has none.",
            "type": [
              "string",
              "null"
            ]
          },
          "frame_cache_bytes": {
            "description": "Bytes of decoded frames the RAM frame cache may hold.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kinds": {
            "description": "Each disk cache, in a fixed order (thumbnails, waveforms, proxies).",
            "items": {
              "additionalProperties": false,
              "description": "One disk cache's usage and limit.",
              "properties": {
                "bytes": {
                  "description": "Bytes it holds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "entries": {
                  "description": "Entries it holds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "kind": {
                  "description": "Which cache.",
                  "oneOf": [
                    {
                      "const": "thumbnails",
                      "description": "Thumbnails and filmstrips (JPEG files, accounted in `cache.sqlite`).",
                      "type": "string"
                    },
                    {
                      "const": "waveforms",
                      "description": "Waveform pyramids (one file per audio stream).",
                      "type": "string"
                    },
                    {
                      "const": "proxies",
                      "description": "Proxies: small intra-frame copies of video files the preview scrubs (WP-2F.01). Clearing\nthem makes the preview use the originals; `media.generate_proxy` makes them again.",
                      "type": "string"
                    }
                  ]
                },
                "limit_bytes": {
                  "description": "Bytes it may hold before the least recently used entries are deleted.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "bytes",
                "limit_bytes",
                "entries"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "folder",
          "kinds",
          "decode_hw",
          "frame_cache_bytes"
        ],
        "title": "MediaCacheStatusOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Show the media caches: folder, usage and limits, hardware decoding, frame memory",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Returns what this engine's media backend can decode and encode: software codecs with their\nimplementations, the hardware encoders in the order `export.start{hw: \"auto\"}` tries them,\nand the hardware decode paths, and the graphics adapter in use (`gpu`). `available` is\nfalse when the engine has no media backend.",
        "title": "MediaCapabilities",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_capabilities",
      "name": "media.capabilities",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.capabilities`.",
        "properties": {
          "available": {
            "description": "Whether the engine has a media backend at all.",
            "type": "boolean"
          },
          "codecs": {
            "description": "Software codecs, sorted by name.",
            "items": {
              "additionalProperties": false,
              "description": "A software codec and its implementations.",
              "properties": {
                "decoders": {
                  "description": "Decoder implementations (empty: cannot decode).",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "encoders": {
                  "description": "Encoder implementations (empty: cannot encode).",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "kind": {
                  "description": "What it carries.",
                  "oneOf": [
                    {
                      "const": "video",
                      "description": "Pictures.",
                      "type": "string"
                    },
                    {
                      "const": "audio",
                      "description": "Sound.",
                      "type": "string"
                    },
                    {
                      "const": "subtitle",
                      "description": "Subtitles or captions.",
                      "type": "string"
                    },
                    {
                      "const": "data",
                      "description": "Timed metadata or other data.",
                      "type": "string"
                    },
                    {
                      "const": "attachment",
                      "description": "Attached files (fonts, cover art).",
                      "type": "string"
                    }
                  ]
                },
                "name": {
                  "description": "Codec name (`h264`, `hevc`, `aac`), as the probe reports it.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "kind",
                "decoders",
                "encoders"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "gpu": {
            "additionalProperties": false,
            "description": "The graphics adapter the renderer runs on; absent while the device is still opening and\nwhen the engine renders on the CPU.",
            "properties": {
              "backend": {
                "description": "The graphics API (`dx12`, `vulkan`, `metal`).",
                "type": "string"
              },
              "device_type": {
                "description": "`DiscreteGpu`, `IntegratedGpu`, `VirtualGpu`, `Cpu` or `Other`.",
                "type": "string"
              },
              "name": {
                "description": "The adapter's name (`NVIDIA GeForce RTX 3060`).",
                "type": "string"
              },
              "software": {
                "description": "Whether this is a software rasterizer (WARP, lavapipe).",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "backend",
              "device_type",
              "software"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "hw_decode": {
            "description": "Hardware decode paths verified on this machine.",
            "items": {
              "additionalProperties": false,
              "description": "A codec a hardware API handles on this machine.",
              "properties": {
                "codec": {
                  "description": "Codec name (`h264`).",
                  "type": "string"
                },
                "device": {
                  "description": "Hardware device type (`d3d11va`, `cuda`, `amf`, `videotoolbox`, `vaapi`, `qsv`).",
                  "type": "string"
                },
                "implementation": {
                  "description": "The implementation, as `export.start{hw: {force}}` takes it (`h264_nvenc`).",
                  "type": "string"
                }
              },
              "required": [
                "device",
                "codec",
                "implementation"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "hw_encode": {
            "description": "Hardware encoders that passed a test encode, in the order `auto` tries them.",
            "items": {
              "additionalProperties": false,
              "description": "A codec a hardware API handles on this machine.",
              "properties": {
                "codec": {
                  "description": "Codec name (`h264`).",
                  "type": "string"
                },
                "device": {
                  "description": "Hardware device type (`d3d11va`, `cuda`, `amf`, `videotoolbox`, `vaapi`, `qsv`).",
                  "type": "string"
                },
                "implementation": {
                  "description": "The implementation, as `export.start{hw: {force}}` takes it (`h264_nvenc`).",
                  "type": "string"
                }
              },
              "required": [
                "device",
                "codec",
                "implementation"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "available",
          "codecs",
          "hw_encode",
          "hw_decode"
        ],
        "title": "MediaCapabilitiesOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List the codecs and hardware encoders/decoders the media backend supports",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Deletes every entry of the named caches. Projects and `generated/` media are never touched:\nonly files the engine can rebuild from the media. Not undoable, not journaled, never marks\nthe project dirty; UI credential only.",
        "properties": {
          "kinds": {
            "description": "The caches to empty (`thumbnails`, `waveforms`, `proxies`).",
            "items": {
              "description": "A kind of disk cache.",
              "oneOf": [
                {
                  "const": "thumbnails",
                  "description": "Thumbnails and filmstrips (JPEG files, accounted in `cache.sqlite`).",
                  "type": "string"
                },
                {
                  "const": "waveforms",
                  "description": "Waveform pyramids (one file per audio stream).",
                  "type": "string"
                },
                {
                  "const": "proxies",
                  "description": "Proxies: small intra-frame copies of video files the preview scrubs (WP-2F.01). Clearing\nthem makes the preview use the originals; `media.generate_proxy` makes them again.",
                  "type": "string"
                }
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "kinds"
        ],
        "title": "MediaClearCache",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_clear_cache",
      "name": "media.clear_cache",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.clear_cache`.",
        "properties": {
          "cleared": {
            "description": "What each requested kind lost.",
            "items": {
              "additionalProperties": false,
              "description": "What clearing one kind removed.",
              "properties": {
                "freed_bytes": {
                  "description": "Bytes freed.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "kind": {
                  "description": "Which cache.",
                  "oneOf": [
                    {
                      "const": "thumbnails",
                      "description": "Thumbnails and filmstrips (JPEG files, accounted in `cache.sqlite`).",
                      "type": "string"
                    },
                    {
                      "const": "waveforms",
                      "description": "Waveform pyramids (one file per audio stream).",
                      "type": "string"
                    },
                    {
                      "const": "proxies",
                      "description": "Proxies: small intra-frame copies of video files the preview scrubs (WP-2F.01). Clearing\nthem makes the preview use the originals; `media.generate_proxy` makes them again.",
                      "type": "string"
                    }
                  ]
                },
                "removed": {
                  "description": "Entries deleted.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "removed",
                "freed_bytes"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "cleared"
        ],
        "title": "MediaClearCacheOutput",
        "type": "object"
      },
      "scope": "ui",
      "secret_fields": [],
      "summary": "Delete everything in the named media caches (they rebuild on demand)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Creates a folder in the media bin, at the top level or inside `parent` (at most 32 levels\ndeep). Without a name it is \"New folder\" (or \"New folder 2\", … when taken). A name that a\nsibling already has, ignoring case, fails with `Invalid` unless `on_conflict` is `rename`.",
        "properties": {
          "name": {
            "default": null,
            "description": "Its name: 1 to 255 characters, no `/` or control characters (trimmed). Default \"New\nfolder\".",
            "type": [
              "string",
              "null"
            ]
          },
          "on_conflict": {
            "anyOf": [
              {
                "description": "What to do when a folder's name is already taken where it goes.",
                "oneOf": [
                  {
                    "const": "fail",
                    "description": "Fail with `Invalid` (the default).",
                    "type": "string"
                  },
                  {
                    "const": "rename",
                    "description": "Use the next free name: \"Day 1 2\", \"Day 1 3\", …",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When a sibling already has the name: `fail` (default) or `rename` (\"Day 1 2\")."
          },
          "parent": {
            "default": null,
            "description": "The folder to create it in; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "MediaCreateFolder",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "media_create_folder",
      "name": "media.create_folder",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.create_folder`.",
        "properties": {
          "folder_id": {
            "description": "The new folder.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": "string"
          },
          "name": {
            "description": "Its name (the next free one with `on_conflict: rename` or without a name).",
            "type": "string"
          },
          "parent": {
            "description": "The folder it is in; absent at the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "folder_id",
          "name",
          "parent"
        ],
        "title": "MediaFolderCreated",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Create a folder in the media bin (top level or inside another folder)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Deletes a folder of the media bin. `contents: move_up` lifts its assets and subfolders one\nlevel (a subfolder whose name the parent already has gets the next free name);\n`contents: remove` also removes its subfolders and every asset inside that no timeline\nuses, and moves the used assets to the deleted folder's parent. Timelines and files on disk\nnever change; one undo restores everything.",
        "properties": {
          "contents": {
            "description": "`move_up` (lift the contents one level) or `remove` (remove the unused media in it).",
            "oneOf": [
              {
                "const": "move_up",
                "description": "Lift the folder's assets and subfolders one level, into its parent.",
                "type": "string"
              },
              {
                "const": "remove",
                "description": "Remove its subfolders and every asset inside that no timeline uses; the used ones move\nto the deleted folder's parent.",
                "type": "string"
              }
            ]
          },
          "folder": {
            "description": "The folder.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "folder",
          "contents"
        ],
        "title": "MediaDeleteFolder",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "media_delete_folder",
      "name": "media.delete_folder",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.delete_folder`.",
        "properties": {
          "folder_id": {
            "description": "The deleted folder.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": "string"
          },
          "kept": {
            "description": "Assets that were inside and are now in `parent`: with `remove` the ones a timeline uses,\nwith `move_up` every asset the folder held.",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "moved_folders": {
            "description": "Subfolders now in `parent` (`move_up` only).",
            "items": {
              "description": "A Folder id: `^fld_[0-9a-f]{32}$`.",
              "pattern": "^fld_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "description": "Where its kept contents went; absent: the top level.",
            "pattern": "^fld_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "removed": {
            "description": "Assets removed from the project (`remove` only; the files stay on disk).",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "removed_folders": {
            "description": "Every folder deleted: the folder, and with `remove` its subfolders.",
            "items": {
              "description": "A Folder id: `^fld_[0-9a-f]{32}$`.",
              "pattern": "^fld_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "renamed": {
            "description": "Subfolders renamed because `parent` already had their name.",
            "items": {
              "additionalProperties": false,
              "description": "A folder that got a new name because its name was taken where it went.",
              "properties": {
                "folder": {
                  "description": "The folder.",
                  "pattern": "^fld_[0-9a-f]{32}$",
                  "type": "string"
                },
                "from": {
                  "description": "Its name before.",
                  "type": "string"
                },
                "to": {
                  "description": "Its name now.",
                  "type": "string"
                }
              },
              "required": [
                "folder",
                "from",
                "to"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "folder_id",
          "parent",
          "removed_folders",
          "removed",
          "kept",
          "moved_folders",
          "renamed"
        ],
        "title": "MediaFolderDeleted",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Delete a media bin folder: lift its contents one level, or remove unused media in it",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Removes the proxies of video assets from the cache (cancelling a generation in progress):\nthe preview uses the originals again. The assets and their files are untouched; a proxy is\nnot made again automatically until `media.generate_proxy` asks for it.",
        "properties": {
          "media": {
            "description": "The video assets (1..=256, no repeats).",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "media"
        ],
        "title": "MediaDeleteProxy",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_delete_proxy",
      "name": "media.delete_proxy",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of the proxy commands.",
        "properties": {
          "policy": {
            "description": "The policy that decides which assets get one automatically.",
            "oneOf": [
              {
                "const": "off",
                "description": "Never automatically (`media.generate_proxy` still makes one).",
                "type": "string"
              },
              {
                "const": "auto",
                "description": "For video that is slow to scrub ([`auto_reason`]); the default.",
                "type": "string"
              },
              {
                "const": "all",
                "description": "For every video file.",
                "type": "string"
              }
            ]
          },
          "proxies": {
            "description": "One entry per asset, in request order (`media.proxy_status` without `media`: every video\nasset, by id).",
            "items": {
              "additionalProperties": false,
              "description": "One asset's proxy (`ProxyRef` of WP-2F.01).",
              "properties": {
                "bytes": {
                  "description": "Its size in bytes while it is ready.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "error": {
                  "description": "Why the last generation failed.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "job_id": {
                  "description": "The job making it (queued or generating).",
                  "pattern": "^job_[0-9a-f]{32}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "media_id": {
                  "description": "The asset.",
                  "pattern": "^med_[0-9a-f]{32}$",
                  "type": "string"
                },
                "path": {
                  "description": "The proxy file while it is ready.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "profile": {
                  "description": "How it is made (`prores_proxy-960`), once there is one.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "progress": {
                  "description": "Done fraction while generating.",
                  "format": "double",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "reason": {
                  "description": "Why the policy wants one, or why the asset cannot have one.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "size": {
                  "description": "Its picture size `[width, height]`.",
                  "items": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "status": {
                  "description": "Where its proxy is.",
                  "oneOf": [
                    {
                      "const": "none",
                      "description": "There is none and none is being made.",
                      "type": "string"
                    },
                    {
                      "const": "queued",
                      "description": "Waiting for its job to start.",
                      "type": "string"
                    },
                    {
                      "const": "generating",
                      "description": "Being made (see `progress`).",
                      "type": "string"
                    },
                    {
                      "const": "ready",
                      "description": "Ready: the preview scrubs it.",
                      "type": "string"
                    },
                    {
                      "const": "incomplete",
                      "description": "A generation stopped before the end (cancelled, or the engine stopped); the next one\ncontinues from where it got.",
                      "type": "string"
                    },
                    {
                      "const": "evicted",
                      "description": "It was removed from the cache (its limit, a clear, `media.delete_proxy`): the original\nis used; `media.generate_proxy` makes it again.",
                      "type": "string"
                    },
                    {
                      "const": "failed",
                      "description": "The last generation failed (see `error`).",
                      "type": "string"
                    }
                  ]
                },
                "wanted": {
                  "description": "Whether the project's policy wants one (it is made automatically).",
                  "type": "boolean"
                }
              },
              "required": [
                "media_id",
                "status",
                "wanted",
                "reason",
                "profile",
                "path",
                "bytes",
                "size",
                "job_id",
                "progress",
                "error"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "proxies",
          "policy"
        ],
        "title": "ProxiesOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Remove the proxies of video assets (the preview uses the originals again)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Makes proxies of video assets now, whatever the policy: one background job each (two run\nat a time, one while an export runs), resumed from its finished parts if an earlier one was\ninterrupted. Assets whose proxy is ready or being made are left alone. Returns their status;\nfollow it with `media.proxy_status` or `job.wait`.",
        "properties": {
