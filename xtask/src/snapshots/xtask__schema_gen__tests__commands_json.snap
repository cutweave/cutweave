                          "null"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "Always this rate.",
                    "properties": {
                      "kind": {
                        "const": "fixed",
                        "type": "string"
                      },
                      "rate": {
                        "additionalProperties": false,
                        "description": "The rate.",
                        "properties": {
                          "den": {
                            "description": "Seconds.",
                            "maximum": 4294967295,
                            "minimum": 1,
