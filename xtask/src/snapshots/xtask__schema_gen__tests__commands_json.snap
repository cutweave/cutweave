        "additionalProperties": false,
        "description": "Result of `project.report_focus`.",
        "properties": {
          "focused_at": {
            "description": "When the engine recorded the focus, milliseconds since the Unix epoch (the run-file's\n`focused_at`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "focused_at"
        ],
        "title": "ProjectReportFocusOutput",
        "type": "object"
      },
      "scope": "ui",
