                                                            "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                            "format": "double",
                                                            "maximum": 10000.0,
                                                            "minimum": 1.0,
                                                            "type": "number"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind",
                                                          "stiffness",
                                                          "damping",
                                                          "mass",
                                                          "bounce"
                                                        ],
                                                        "type": "object"
                                                      }
                                                    ]
                                                  },
                                                  "t": {
                                                    "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                                    "maximum": 9007199254740991,
                                                    "minimum": -9007199254740991,
                                                    "type": "integer"
                                                  },
                                                  "value": {
                                                    "format": "double",
                                                    "type": "number"
                                                  }
                                                },
                                                "required": [
                                                  "t",
                                                  "value",
                                                  "interp"
                                                ],
                                                "type": "object"
                                              },
                                              "maxItems": 100000,
                                              "minItems": 1,
                                              "type": "array"
                                            }
                                          },
                                          "required": [
                                            "keyframes"
                                          ],
                                          "type": "object"
                                        }
                                      ]
                                    },
                                    "scale": {
                                      "description": "Size multiplier per axis (1.0 = aspect-fit).",
                                      "oneOf": [
                                        {
                                          "additionalProperties": false,
                                          "description": "A 2D vector (positions, scales, anchors).",
                                          "properties": {
                                            "x": {
                                              "description": "Horizontal component.",
                                              "format": "double",
                                              "type": "number"
                                            },
                                            "y": {
                                              "description": "Vertical component (down is positive).",
                                              "format": "double",
                                              "type": "number"
                                            }
                                          },
                                          "required": [
                                            "x",
                                            "y"
                                          ],
                                          "type": "object"
                                        },
                                        {
                                          "description": "A keyed (animated) value: keys sorted by strictly increasing t (keyframes §3).",
                                          "properties": {
                                            "keyframes": {
                                              "items": {
                                                "description": "A key: a value at an item-relative time (flicks), and the easing of the segment to the next key (keyframes §3.1).",
                                                "properties": {
                                                  "interp": {
                                                    "description": "How the segment that starts at a key moves to the next key (keyframes §4). It is a closed\nset: a new kind is a schema change.\n\nEvery kind except `hold` is an easing `p(u)` with `p(0) = 0` and `p(u) → 1` as `u → 1`,\nfed into one lerp per value type (§5). On the wire it is an object tagged by `kind`\n(`{\"kind\": \"bezier\", \"x1\": 0.42, \"y1\": 0, \"x2\": 0.58, \"y2\": 1, \"preset\": \"ease_in_out\"}`)\nwith exactly its fields; construction checks their ranges (KF-5) and the hint (KF-7).",
                                                    "oneOf": [
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "The key's value until the next key, then a jump (§4.2).",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "hold",
                                                            "type": "string"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind"
                                                        ],
                                                        "type": "object"
                                                      },
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "`p = u` (§4.3).",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "linear",
                                                            "type": "string"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind"
                                                        ],
                                                        "type": "object"
                                                      },
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "A CSS-style cubic Bézier from (0, 0) to (1, 1), normalized to the segment (§4.4).\n(`x1`, `y1`) shapes the speed leaving the key, (`x2`, `y2`) the speed arriving at the\nnext one.",
                                                        "properties": {
                                                          "kind": {
                                                            "const": "bezier",
                                                            "type": "string"
                                                          },
                                                          "preset": {
                                                            "description": "The preset these numbers came from, a hint for the UI and agents (§4.6). Never read\nby evaluation.",
                                                            "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                            "type": [
                                                              "string",
                                                              "null"
                                                            ]
                                                          },
                                                          "x1": {
                                                            "description": "First control point, time axis, in `[0, 1]`.",
                                                            "format": "double",
                                                            "maximum": 1.0,
                                                            "minimum": 0.0,
                                                            "type": "number"
                                                          },
                                                          "x2": {
                                                            "description": "Second control point, time axis, in `[0, 1]`.",
                                                            "format": "double",
                                                            "maximum": 1.0,
                                                            "minimum": 0.0,
                                                            "type": "number"
                                                          },
                                                          "y1": {
                                                            "description": "First control point, progress axis, in `[−10, 10]` (beyond `[0, 1]` overshoots).",
                                                            "format": "double",
                                                            "maximum": 10.0,
                                                            "minimum": -10.0,
                                                            "type": "number"
                                                          },
                                                          "y2": {
                                                            "description": "Second control point, progress axis, in `[−10, 10]`.",
                                                            "format": "double",
                                                            "maximum": 10.0,
                                                            "minimum": -10.0,
                                                            "type": "number"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind",
                                                          "x1",
                                                          "y1",
                                                          "x2",
                                                          "y2"
                                                        ],
                                                        "type": "object"
                                                      },
                                                      {
                                                        "additionalProperties": false,
                                                        "description": "A damped spring in real seconds, released from rest, plus a residual that lands it\nexactly on the next key (§4.5).",
                                                        "properties": {
                                                          "bounce": {
                                                            "description": "A hard stop at the target: the motion reflects instead of passing it.",
                                                            "type": "boolean"
                                                          },
                                                          "damping": {
                                                            "description": "Damping, N·s/m, in `[0, 1000]` (0 never settles).",
                                                            "format": "double",
                                                            "maximum": 1000.0,
                                                            "minimum": 0.0,
                                                            "type": "number"
                                                          },
                                                          "kind": {
                                                            "const": "spring",
                                                            "type": "string"
                                                          },
                                                          "mass": {
                                                            "description": "Mass, kg, in `[0.1, 100]`.",
                                                            "format": "double",
                                                            "maximum": 100.0,
                                                            "minimum": 0.1,
                                                            "type": "number"
                                                          },
                                                          "preset": {
                                                            "description": "The preset these numbers came from (§4.6). Never read by evaluation.",
                                                            "pattern": "^[a-z][a-z0-9_]{0,63}$",
                                                            "type": [
                                                              "string",
                                                              "null"
                                                            ]
                                                          },
                                                          "stiffness": {
                                                            "description": "Stiffness, N/m, in `[1, 10000]`.",
                                                            "format": "double",
                                                            "maximum": 10000.0,
                                                            "minimum": 1.0,
                                                            "type": "number"
                                                          }
                                                        },
                                                        "required": [
                                                          "kind",
                                                          "stiffness",
                                                          "damping",
                                                          "mass",
                                                          "bounce"
                                                        ],
                                                        "type": "object"
                                                      }
                                                    ]
                                                  },
                                                  "t": {
                                                    "description": "Item-relative time in flicks (1/705600000 s); 0 is the item's first frame.",
                                                    "maximum": 9007199254740991,
                                                    "minimum": -9007199254740991,
                                                    "type": "integer"
                                                  },
                                                  "value": {
                                                    "additionalProperties": false,
                                                    "description": "A 2D vector (positions, scales, anchors).",
                                                    "properties": {
                                                      "x": {
                                                        "description": "Horizontal component.",
                                                        "format": "double",
                                                        "type": "number"
                                                      },
                                                      "y": {
                                                        "description": "Vertical component (down is positive).",
                                                        "format": "double",
                                                        "type": "number"
                                                      }
                                                    },
                                                    "required": [
                                                      "x",
                                                      "y"
                                                    ],
                                                    "type": "object"
                                                  }
                                                },
                                                "required": [
                                                  "t",
                                                  "value",
                                                  "interp"
                                                ],
                                                "type": "object"
                                              },
                                              "maxItems": 100000,
                                              "minItems": 1,
                                              "type": "array"
                                            }
                                          },
                                          "required": [
                                            "keyframes"
                                          ],
                                          "type": "object"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "position",
                                    "scale",
                                    "rotation",
                                    "anchor"
                                  ],
                                  "type": "object"
                                }
                              },
                              "required": [
                                "transform",
                                "opacity",
                                "crop",
                                "flip",
                                "blend_mode"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "kind",
                            "id",
                            "start",
                            "duration",
                            "enabled",
                            "markers",
                            "media",
                            "source_in",
                            "audio",
                            "visual",
                            "custom"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "track": {
                      "description": "Index into the payload's `tracks`.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "track",
                    "item"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "sequence": {
                "description": "The sequence the items came from.",
                "pattern": "^seq_[0-9a-f]{32}$",
                "type": "string"
              },
              "span": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "Length of the copied range: the latest end minus the earliest start."
              },
              "tracks": {
                "description": "The source tracks in display order, top first.",
                "items": {
                  "additionalProperties": false,
                  "description": "One track of a payload: the kind it had and where it was.",
                  "properties": {
                    "kind": {
                      "description": "What the track holds; pasted items go only to tracks of this kind.",
                      "oneOf": [
                        {
                          "const": "video",
                          "description": "Picture layers.",
                          "type": "string"
                        },
                        {
                          "const": "audio",
                          "description": "Sound.",
                          "type": "string"
                        },
                        {
                          "const": "text",
                          "description": "Titles (later versions).",
                          "type": "string"
                        },
                        {
                          "const": "caption",
                          "description": "Captions (later versions).",
                          "type": "string"
                        },
                        {
                          "const": "adjustment",
                          "description": "Adjustment layers (later versions).",
                          "type": "string"
                        }
                      ]
                    },
                    "row": {
                      "description": "Display-order distance from the top-most track of the payload (0 for the first).",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "source": {
                      "description": "The track the items were copied from (where `timeline.paste` goes without `track`).",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "row",
                    "source"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "version": {
                "description": "Always 1.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "version",
              "sequence",
              "frame_rate",
              "span",
              "tracks",
              "items"
            ],
            "type": "object"
          },
          "track": {
            "default": null,
            "description": "The track for the top-most payload track (default: the source tracks).",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "payload",
          "at"
        ],
        "title": "TimelinePaste",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_paste",
      "name": "timeline.paste",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.paste`.",
        "properties": {
          "copies": {
            "description": "The new items: each payload item's ID (`source`) and the ID of its copy.",
            "items": {
              "additionalProperties": false,
              "description": "One copy.",
              "properties": {
                "copy": {
                  "description": "Its copy.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "source": {
                  "description": "The copied item.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "required": [
                "source",
                "copy"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "created_tracks": {
            "description": "Tracks created by the placement, in creation order.",
            "items": {
              "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
              "pattern": "^trk_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "item",
                    "start",
                    "duration",
                    "source_in"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "created",
              "removed",
              "split",
              "moved",
              "trimmed",
              "relinked",
              "replaced",
              "toggled",
              "created_tracks"
            ],
            "type": "object"
          }
        },
        "required": [
          "copies",
          "created_tracks",
          "report"
        ],
        "title": "TimelinePasteOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Paste a clipboard payload from timeline.copy at a time and track",
      "undoable": true,
      "view": false
    },
