                      "type": "string"
                    },
                    {
                      "const": "cancelled",
                      "description": "Cancelled before or while running.",
                      "type": "string"
                    }
                  ]
                },
                "width": {
                  "description": "Frame width in pixels.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
