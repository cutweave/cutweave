    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Shows what a preset does to a sequence without exporting: the output size, frame rate,\nestimated size and the warnings (`AspectMismatch`, `DurationOverLimit`, `SizeOverLimit`,\n`FrameRateCapped`). Changes nothing.",
        "properties": {
          "overrides": {
            "additionalProperties": false,
            "default": null,
            "description": "Size, frame rate or quality to use instead of the preset's.",
            "properties": {
              "fps": {
                "additionalProperties": false,
                "default": null,
                "description": "Frame rate, e.g. {\"num\": 30, \"den\": 1}: at most 240 fps, a whole number of flicks per\nframe.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "height": {
                "default": null,
                "description": "Frame height in pixels: even, 16-8192.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "preset": {
                "default": null,
                "description": "Base preset id; the other fields replace its values.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "anyOf": [
                  {
                    "description": "How hard the encoder works for picture quality (and file size).",
                    "oneOf": [
                      {
                        "const": "low",
                        "description": "Small files, visible compression.",
                        "type": "string"
                      },
                      {
                        "const": "medium",
                        "description": "Balanced.",
                        "type": "string"
                      },
                      {
                        "const": "high",
                        "description": "Close to the original (the default).",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "\"low\", \"medium\" or \"high\"."
              },
              "width": {
                "default": null,
                "description": "Frame width in pixels: even, 16-8192.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "preset": {
            "description": "The preset id.",
            "type": "string"
          },
          "range": {
            "additionalProperties": false,
            "default": null,
            "description": "Part of the sequence (default: all of it).",
            "properties": {
              "in": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom start: flicks, \"2.5s\", \"f:60\" or a timecode."
              },
              "kind": {
                "anyOf": [
                  {
                    "description": "Which part of the sequence to export.",
                    "oneOf": [
                      {
                        "const": "sequence",
                        "description": "The whole sequence.",
                        "type": "string"
                      },
                      {
                        "const": "in_out",
                        "description": "Between the sequence's in and out points.",
                        "type": "string"
                      },
                      {
                        "const": "custom",
                        "description": "`in` to `out`.",
                        "type": "string"
                      },
                      {
                        "const": "markers",
                        "description": "One file per marker.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "\"sequence\", \"in_out\", \"custom\" or \"markers\" (default: from the other fields)."
              },
              "markers": {
                "default": null,
                "description": "Marker kind: the markers to export (default: all of the sequence's markers).",
                "items": {
                  "description": "A Marker id: `^mrk_[0-9a-f]{32}$`.",
                  "pattern": "^mrk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "out": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Custom end, exclusive: at most the sequence end."
              },
              "pair_mode": {
                "anyOf": [
                  {
                    "description": "How markers become regions.",
                    "oneOf": [
                      {
                        "const": "duration",
                        "description": "Each marker's own `duration` (the default).",
                        "type": "string"
                      },
                      {
                        "const": "pairs",
                        "description": "Each marker to the next one.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Marker kind: \"duration\" (default; each marker's own duration) or \"pairs\" (each marker to\nthe next)."
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "sequence": {
            "default": null,
            "description": "Sequence; optional when the project has one.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "preset"
        ],
        "title": "ResolvePreset",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "export_resolve_preset",
      "name": "export.resolve_preset",
      "namespace": "export",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `export.resolve_preset`.",
        "properties": {
          "estimated_kib": {
            "description": "Estimated file size in KiB, when the preset has a bitrate.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "frame_rate": {
            "additionalProperties": false,
            "description": "Output frame rate.",
            "properties": {
              "den": {
                "description": "Seconds.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Frames.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "height": {
            "description": "Output height.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "preset": {
            "description": "The preset id.",
            "type": "string"
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "supported": {
            "description": "Whether this build can export it now.",
            "type": "boolean"
          },
          "unsupported_reason": {
            "description": "Why not, when unsupported.",
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "description": "Limit and fit warnings; the export would still run.",
            "items": {
              "additionalProperties": false,
              "description": "One warning about a preset on a sequence.",
              "properties": {
                "code": {
                  "description": "What kind.",
                  "oneOf": [
                    {
                      "const": "AspectMismatch",
                      "description": "The sequence's aspect is not the preset's.",
                      "type": "string"
                    },
                    {
                      "const": "DurationOverLimit",
                      "description": "The exported part is longer than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "SizeOverLimit",
                      "description": "The estimated file is larger than the platform accepts.",
                      "type": "string"
                    },
                    {
                      "const": "FrameRateCapped",
                      "description": "The sequence's frame rate is above the platform's maximum, so the file uses a lower one.",
                      "type": "string"
                    },
                    {
                      "const": "SoftwareEncoder",
                      "description": "An advanced setting needs the software encoder, so the export does not use the hardware one.",
                      "type": "string"
                    }
                  ]
                },
                "message": {
                  "description": "A sentence for the person.",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "width": {
            "description": "Output width.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "preset",
          "sequence",
          "width",
          "height",
          "frame_rate",
          "estimated_kib",
          "supported",
          "unsupported_reason",
          "warnings"
        ],
        "title": "ResolvePresetOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Show what an export preset does to a sequence (size, rate, warnings) without exporting",
      "undoable": false,
      "view": false
