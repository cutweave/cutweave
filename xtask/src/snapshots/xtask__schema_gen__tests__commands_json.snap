    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Trims an edge and closes or opens the space after the clip: the clip's start stays, and\neverything that starts at or after its old end moves by the change of its end, on the\ntracks of the clip and its linked partners, the tracks of partners of what moves, or every\ntrack with `ripple_all_tracks`. The end edge by `δ` lengthens the clip by `δ`; the start\nedge by `δ` (positive cuts frames from the head; `to` is read as if the clip did not move)\nshortens it by `δ`. Fails with `Invalid` if the shift would make items overlap on a moved\ntrack or move the magnetic main track from another track, and with `Locked` if it would\nchange a locked track. `clamp`, `fine` and `unlink` as in `clip.trim`.",
        "properties": {
          "clamp": {
            "default": null,
            "description": "Stop at the nearest limit instead of failing (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "delta": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Offset of the edge (negative: earlier). Use seconds or flicks for negative values."
          },
          "edge": {
            "description": "The edge to move.",
            "oneOf": [
              {
                "const": "start",
                "description": "The first frame (changes `start`, `source_in` and the length).",
                "type": "string"
              },
              {
                "const": "end",
                "description": "The last frame (changes the length).",
                "type": "string"
              }
            ]
          },
          "fine": {
            "default": null,
            "description": "Snap to the audio sample grid (audio clips only).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "prune_keyframes": {
            "default": null,
            "description": "Drop keyframes the trim leaves outside the clip (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "ripple_all_tracks": {
            "default": null,
            "description": "Move what follows on every track of the sequence (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "to": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Timeline time of the edge afterwards (frame-snapped; for the start edge, read as if the\nclip did not move)."
          },
          "unlink": {
            "default": null,
            "description": "Trim only this clip and remove it from its linked group (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "item",
          "edge"
        ],
        "title": "ClipRippleTrim",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
