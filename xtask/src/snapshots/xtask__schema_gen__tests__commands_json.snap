              "type": "object"
            },
            "type": "array"
          },
          "parallel": {
            "description": "How many exports run at once.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "paused": {
            "description": "Whether the queue is paused: no export starts (a running one finishes).",
            "type": "boolean"
          }
        },
        "required": [
          "paused",
          "parallel",
          "jobs"
        ],
