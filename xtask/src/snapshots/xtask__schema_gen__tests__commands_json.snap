    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets the disk cache limits and the memory for decoded frames. A lower limit deletes the\nleast recently used entries at once. Not undoable, not journaled, never marks the project\ndirty; UI credential only (the desktop app applies the person's machine preferences).",
        "properties": {
          "frame_cache_bytes": {
            "default": null,
            "description": "Memory for decoded frames in bytes (64 MiB to 64 GiB), or `0` for Auto (the smaller of\n1 GiB and a quarter of the machine's RAM). Left out: unchanged.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limits": {
            "additionalProperties": false,
            "default": null,
            "description": "New limits in bytes (`0` to `16 TiB`); a kind left out keeps its limit.",
            "properties": {
              "proxies": {
                "default": null,
                "description": "Cap on proxies, in bytes (50 GiB by default).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "thumbnails": {
                "description": "Cap on thumbnails and filmstrips, in bytes.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "waveforms": {
                "description": "Cap on waveforms, in bytes.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          }
        },
        "title": "MediaSetCacheConfig",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_set_cache_config",
      "name": "media.set_cache_config",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "What `media.cache_status` and `media.set_cache_config` report.",
        "properties": {
          "decode_hw": {
            "description": "The hardware decoding policy in force.",
            "oneOf": [
              {
                "const": "auto",
                "description": "A verified hardware decoder when the machine has one for the stream (the default).",
                "type": "string"
              },
              {
                "const": "off",
                "description": "Software decoding only.",
                "type": "string"
              }
            ]
          },
          "folder": {
            "description": "The folder the caches live in (`--cache-dir`, else the OS cache folder); `null` when\nthe engine has none.",
            "type": [
              "string",
              "null"
            ]
          },
          "frame_cache_bytes": {
            "description": "Bytes of decoded frames the RAM frame cache may hold.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kinds": {
            "description": "Each disk cache, in a fixed order (thumbnails, waveforms, proxies).",
            "items": {
              "additionalProperties": false,
              "description": "One disk cache's usage and limit.",
              "properties": {
                "bytes": {
                  "description": "Bytes it holds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "entries": {
                  "description": "Entries it holds.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "kind": {
                  "description": "Which cache.",
                  "oneOf": [
                    {
                      "const": "thumbnails",
                      "description": "Thumbnails and filmstrips (JPEG files, accounted in `cache.sqlite`).",
                      "type": "string"
                    },
                    {
                      "const": "waveforms",
                      "description": "Waveform pyramids (one file per audio stream).",
                      "type": "string"
                    },
                    {
                      "const": "proxies",
                      "description": "Proxies: small intra-frame copies of video files the preview scrubs (WP-2F.01). Clearing\nthem makes the preview use the originals; `media.generate_proxy` makes them again.",
                      "type": "string"
                    }
                  ]
                },
                "limit_bytes": {
                  "description": "Bytes it may hold before the least recently used entries are deleted.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "bytes",
                "limit_bytes",
                "entries"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "folder",
          "kinds",
          "decode_hw",
          "frame_cache_bytes"
        ],
        "title": "MediaCacheStatusOutput",
        "type": "object"
      },
      "scope": "ui",
      "secret_fields": [],
      "summary": "Set the cache limits and the memory for decoded frames",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Sets whether decoders may use the hardware. It applies to decoders opened from now on; idle\ndecoders are closed and the open pools reopen on their next seek. Exports and `render.frame`\nalways decode in software. Not undoable, not journaled, never marks the project dirty; UI\ncredential only.",
        "properties": {
          "hw": {
            "description": "`auto` (a verified hardware decoder when there is one) or `off` (software only).",
            "oneOf": [
              {
                "const": "auto",
                "description": "A verified hardware decoder when the machine has one for the stream (the default).",
                "type": "string"
              },
              {
                "const": "off",
                "description": "Software decoding only.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "hw"
        ],
        "title": "MediaSetDecodePolicy",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "media_set_decode_policy",
      "name": "media.set_decode_policy",
      "namespace": "media",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `media.set_decode_policy`.",
        "properties": {
          "hw": {
            "description": "The policy now in force.",
            "oneOf": [
              {
                "const": "auto",
                "description": "A verified hardware decoder when the machine has one for the stream (the default).",
                "type": "string"
              },
              {
                "const": "off",
