    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Plays a clip (`item`), or several (`items`), and their linked partners at `speed`: a number\n(`2`, `0.5`), text (`\"1/3\"`, `\"2x\"`, `\"50%\"`) or `{num, den}`, from 0.1 to 100, exact. With\n`keep: \"in_point\"` (default) the clip plays the same media and its length changes (snapped to\nframes); with `keep: \"duration\"` its length stays and it plays more or less media. On the main\ntrack what follows moves with the clip's end; on a free track the clip keeps its start and\nmay not grow into the next item (`Invalid` at `/speed`) unless `ripple: true`. `keyframes:\n\"scale\"` stretches keys with the speed (default `\"keep\"`). Stills and freeze frames are\n`Unsupported`; reading past the media is `Invalid`; `Locked` if a track involved is locked.",
        "properties": {
          "item": {
            "default": null,
            "description": "The clip (or `items`).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "default": null,
            "description": "Clips to change at once.",
            "items": {
              "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
              "pattern": "^itm_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "keep": {
            "default": null,
            "description": "`in_point` (default): same media, new length; `duration`: same length, more or less media.",
            "enum": [
              "in_point",
              "duration",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "keyframes": {
            "default": null,
            "description": "`keep` (default): keys stay at their item times; `scale`: they stretch with the speed.",
            "enum": [
              "keep",
              "scale",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "ripple": {
            "default": null,
            "description": "On a free track, move what follows instead of failing at the next item (default `false`;\nthe main track always ripples).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "speed": {
            "anyOf": [
              {
                "description": "A number, exact as written (`0.1` is 1/10).",
                "format": "double",
                "type": "number"
              },
              {
                "description": "`\"1/3\"`, `\"2x\"`, `\"0.5\"`, `\"50%\"`.",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "description": "An exact fraction.",
                "properties": {
                  "den": {
                    "description": "Denominator.",
                    "maximum": 100000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Numerator.",
                    "maximum": 100000,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": "object"
              }
            ],
            "description": "The speed: `2`, `0.5`, `\"1/3\"`, `\"2x\"`, `\"50%\"` or `{num, den}` (0.1 to 100)."
          }
        },
        "required": [
          "speed"
        ],
        "title": "ClipSetSpeed",
        "type": "object"
      },
