        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Saves the document as a new project folder (created; it must not hold a project yet) and\ncontinues there; the old folder keeps its last save. A journaled project keeps its undo\nhistory; an untitled or read-only document is written and reopened (history restarts, every\nclient resyncs on `doc.reset`). Agents and headless callers may only save inside the open\nproject's folder and the folders the user approved (`Invalid` at `/path` otherwise).",
        "properties": {
          "path": {
            "description": "Absolute path of the new project folder; the document is `<folder>/<folder name>.cutweave`.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "ProjectSaveAs",
        "type": "object"
      },
