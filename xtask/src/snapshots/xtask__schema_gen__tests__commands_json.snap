        "description": "Renames a folder of the media bin. Fails with `Invalid` when a sibling already has the\nname, ignoring case (changing only the case of the folder's own name is fine).",
        "properties": {
          "folder": {
            "description": "The folder.",
            "pattern": "^fld_[0-9a-f]{32}$",
