                      "kind": {
                        "const": "fixed",
                        "type": "string"
                      },
                      "width": {
                        "description": "Frame width in pixels.",
                        "format": "uint32",
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "width",
                      "height"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "The sequence fitted into this box, never upscaled (the box turns for portrait).",
                    "properties": {
                      "height": {
                        "description": "Box height in pixels.",
                        "format": "uint32",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "kind": {
                        "const": "fit",
                        "type": "string"
                      },
                      "width": {
                        "description": "Box width in pixels.",
                        "format": "uint32",
                        "minimum": 0,
