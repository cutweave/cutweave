      "input_schema": {
        "additionalProperties": false,
        "description": "Saves an export preset of your own (a new id, or replaces your earlier one). Built-in ids\ncannot be replaced; save a copy under another id.",
        "properties": {
          "preset": {
            "additionalProperties": false,
            "description": "The preset (see export.list_presets for examples).",
            "properties": {
              "advanced": {
                "default": null,
                "description": "Advanced encoder settings (rate control, GOP, color tags, audio) the preset applies on top\nof the fields above; a request's own `advanced` overrides them.",
                "properties": {
                  "audio": {
                    "type": "object"
                  },
                  "color": {
                    "type": "object"
                  },
                  "video": {
                    "type": "object"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "audio": {
                "additionalProperties": false,
                "default": null,
                "description": "Audio settings; absent for GIF.",
                "properties": {
                  "bitrate_kbps": {
                    "default": null,
                    "description": "Bitrate in kilobits per second (absent for lossless codecs).",
                    "format": "uint32",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "channels": {
                    "description": "Channel count.",
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "codec": {
                    "description": "The codec.",
                    "oneOf": [
                      {
                        "const": "aac",
                        "description": "AAC-LC.",
                        "type": "string"
                      },
                      {
                        "const": "mp3",
                        "description": "MP3.",
                        "type": "string"
                      },
                      {
                        "const": "pcm",
                        "description": "Uncompressed PCM.",
                        "type": "string"
                      },
                      {
                        "const": "flac",
                        "description": "FLAC.",
                        "type": "string"
                      },
                      {
                        "const": "opus",
                        "description": "Opus.",
                        "type": "string"
                      }
                    ]
                  },
                  "sample_rate": {
                    "description": "Sample rate in Hz.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
