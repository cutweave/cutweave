    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Opens a project (its folder or its `.cutweave` file), closing the current one first (saved\nwhen autosave is on, as `project.close` does). It never drops unsaved changes unasked\n(ADR-0029): when the open document has changes the close would not save (an untitled\ndocument, or a project with autosave off), it fails with `Conflict{reason:\nunsaved_changes}` and changes nothing, unless `discard_unsaved` is `true` (then the current\nproject closes without saving, as `project.close` with `save: false`). A project open in\nanother Cutweave process fails with `Invalid` at `/path` and leaves the current project\nopen. Unsaved work from a crashed session is reported in `project.recovery`; edits are\nrefused until `project.recover` or `project.discard_recovery`. Sends `project.opening`, then\n`project.opened` or `project.open_failed`; every client must resync (`doc.reset`). Agents\nand headless callers may only open projects inside the open project's folder and the\nfolders the user approved (`Invalid` at `/path` otherwise).",
        "properties": {
          "discard_unsaved": {
            "default": null,
            "description": "Drop the open document's unsaved changes (`true`); otherwise they make the open fail.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "path": {
            "description": "Absolute path of the project folder or of its `.cutweave` document.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "ProjectOpen",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "core",
      "mcp_tool": "project_open",
      "name": "project.open",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.open`.",
        "properties": {
          "migrated_from": {
            "description": "The schema version the document was migrated from, if it was.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "missing_media": {
            "description": "Media whose file was found at neither its absolute nor its project-relative path.",
            "items": {
              "description": "A Media id: `^med_[0-9a-f]{32}$`.",
              "pattern": "^med_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": "array"
          },
          "project": {
            "additionalProperties": false,
            "description": "The session now.",
            "properties": {
              "dirty": {
                "description": "Whether committed changes are not in the project file yet.",
                "type": "boolean"
              },
              "name": {
                "description": "The project name (from the document).",
                "type": "string"
              },
              "path": {
                "description": "The project document (`.cutweave`) path; absent for an untitled document.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "read_only": {
                "description": "Why the project is read-only (edits are refused), if it is.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "recovery": {
                "additionalProperties": false,
                "description": "Unsaved work from a previous session awaiting `project.recover` or\n`project.discard_recovery` (edits are refused until then).",
                "properties": {
                  "base_rev": {
                    "description": "The committed revision of the saved document.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "damaged": {
                    "description": "The journal ends with a damaged record (replay stops there).",
                    "type": "boolean"
                  },
                  "last_rev": {
                    "description": "The revision a restore reaches.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "last_ts": {
                    "description": "When the last of them was committed.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "records": {
                    "description": "Transactions a restore would replay.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "records",
                  "base_rev",
                  "last_rev",
                  "last_ts",
                  "damaged"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "rev": {
                "description": "The live document revision.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "saved_rev": {
                "description": "The committed revision last written to the project file; absent while untitled,\nread-only or awaiting a recovery decision.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "state": {
                "description": "`no_project` (an untitled document) or `open`.",
                "oneOf": [
                  {
                    "const": "no_project",
                    "description": "An untitled document, not backed by a project folder.",
                    "type": "string"
                  },
                  {
                    "const": "open",
                    "description": "A project folder is open.",
                    "type": "string"
                  },
                  {
                    "const": "closing",
                    "description": "The project is being closed (a swap or engine shutdown is under way).",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "state",
              "path",
              "name",
              "rev",
              "saved_rev",
              "dirty",
              "read_only",
              "recovery"
            ],
            "type": "object"
          }
        },
        "required": [
          "project",
          "missing_media",
          "migrated_from"
        ],
        "title": "ProjectOpenOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Open a project folder or .cutweave file (closes the current project)",
      "undoable": false,
      "view": false
    },
