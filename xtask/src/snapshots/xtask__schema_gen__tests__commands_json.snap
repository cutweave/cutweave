                "description": "Display name.",
                "type": "string"
              },
              "platform": {
                "additionalProperties": false,
                "default": null,
                "description": "Where the numbers come from (platform presets).",
                "properties": {
                  "checked": {
                    "description": "The date the values were checked against it (`YYYY-MM-DD`).",
                    "type": "string"
                  },
                  "id": {
                    "description": "Platform surface id (`youtube`, `instagram-reels`); shared with the safe-area ids.",
                    "type": "string"
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "spec_url": {
                    "description": "The platform's published upload specification (`https://`).",
                    "type": "string"
                  },
                  "unverified": {
                    "default": [],
