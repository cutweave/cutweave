    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Merges a partial update into the view state: present fields replace the current value,\nabsent ones are kept. Nothing is applied if any field is invalid. Not undoable; never\nchanges the document.",
        "properties": {
          "patch": {
            "additionalProperties": false,
            "description": "The fields to change.",
            "properties": {
              "active_sequence": {
                "default": null,
                "description": "The sequence to show; must exist.",
                "pattern": "^seq_[0-9a-f]{32}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "master_gain": {
                "default": null,
                "description": "New master gain (linear, `0..=4`).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "panel_layout": {
                "default": null,
                "description": "New panel layout (opaque JSON, replaces the whole value)."
              },
              "playhead": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                        "type": "string"
                      }
                    ],
                    "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "New playhead (flicks, seconds text; `>= 0`)."
              },
              "preview_quality": {
                "anyOf": [
                  {
                    "description": "Preview resolution (arch §8 quality ladder).",
                    "oneOf": [
                      {
                        "const": "full",
                        "description": "Full resolution.",
                        "type": "string"
                      },
                      {
                        "const": "half",
                        "description": "Half resolution.",
                        "type": "string"
                      },
                      {
                        "const": "quarter",
                        "description": "Quarter resolution.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "New preview resolution."
              },
              "scroll": {
                "additionalProperties": false,
                "default": null,
                "description": "New scroll offset.",
                "properties": {
                  "x": {
                    "description": "Horizontal offset, `>= 0`.",
                    "format": "double",
                    "type": "number"
                  },
                  "y": {
                    "description": "Vertical offset, `>= 0`.",
                    "format": "double",
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "selection": {
                "default": null,
                "description": "New selection (replaces the whole selection; every ID must exist).",
                "items": {
                  "description": "One selected entity, by ID (never by index).",
                  "oneOf": [
                    {
                      "description": "A timeline item.",
                      "properties": {
                        "id": {
                          "description": "The item.",
                          "pattern": "^itm_[0-9a-f]{32}$",
                          "type": "string"
                        },
                        "kind": {
                          "const": "item",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "A track.",
                      "properties": {
                        "id": {
                          "description": "The track.",
                          "pattern": "^trk_[0-9a-f]{32}$",
                          "type": "string"
                        },
                        "kind": {
                          "const": "track",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "A media asset.",
                      "properties": {
                        "id": {
                          "description": "The asset.",
                          "pattern": "^med_[0-9a-f]{32}$",
                          "type": "string"
                        },
                        "kind": {
                          "const": "media",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "A sequence.",
                      "properties": {
                        "id": {
                          "description": "The sequence.",
                          "pattern": "^seq_[0-9a-f]{32}$",
                          "type": "string"
                        },
                        "kind": {
                          "const": "sequence",
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "zoom": {
                "default": null,
                "description": "New zoom in pixels per second.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "required": [
