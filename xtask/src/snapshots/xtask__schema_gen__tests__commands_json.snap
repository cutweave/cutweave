                "type": [
                  "object",
                  "null"
                ]
              },
              "height": {
                "description": "Canvas height in pixels, `1..=16384`.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sample_rate": {
                "description": "The mix rate in Hz, `8000..=384000`.",
                "maximum": 352800000,
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "width": {
                "description": "Canvas width in pixels, `1..=16384`.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "description": "Name (1..=200 characters).",
            "type": "string"
          },
          "preset": {
            "default": null,
            "description": "Aspect preset ID: `16:9`, `16:9-4k`, `9:16`, `1:1`, `4:5` or `21:9`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
