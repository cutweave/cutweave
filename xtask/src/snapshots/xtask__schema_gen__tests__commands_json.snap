    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Returns the current view state: playhead, zoom, scroll, selection, panel layout, preview\nquality and master gain.",
        "title": "ViewGet",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "view_get",
      "name": "view.get",
      "namespace": "view",
      "output_schema": {
        "additionalProperties": false,
        "description": "The UI view state of a project (arch §5.1). Persisted in `.cutweave/ui-state.json`.",
        "properties": {
          "active_sequence": {
            "description": "The sequence the editor shows (WP-2B.01). `None` until one is chosen: the editor then\nshows the first sequence. Never names a sequence that no longer exists.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "master_gain": {
            "description": "Master output gain (linear, `0..=4`, 1 = unity).",
            "format": "double",
            "type": "number"
          },
          "panel_layout": {
            "description": "Dock/panel layout. Opaque to the engine (owned by the UI); `null` until the UI sets it."
          },
          "playhead": {
            "description": "Playhead position on the timeline, `>= 0`.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "preview_quality": {
            "description": "Preview resolution.",
            "oneOf": [
              {
                "const": "full",
                "description": "Full resolution.",
                "type": "string"
              },
              {
                "const": "half",
                "description": "Half resolution.",
                "type": "string"
              },
              {
                "const": "quarter",
                "description": "Quarter resolution.",
                "type": "string"
              }
            ]
          },
          "scroll": {
            "additionalProperties": false,
            "description": "Timeline scroll offset.",
            "properties": {
              "x": {
                "description": "Horizontal offset, `>= 0`.",
                "format": "double",
                "type": "number"
              },
              "y": {
                "description": "Vertical offset, `>= 0`.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "selection": {
            "description": "Selected entities, in selection order, without duplicates. Every ID existed when it was\nselected; IDs that no longer exist are dropped.",
            "items": {
              "description": "One selected entity, by ID (never by index).",
              "oneOf": [
                {
                  "description": "A timeline item.",
                  "properties": {
                    "id": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "kind": {
                      "const": "item",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "description": "A track.",
                  "properties": {
                    "id": {
                      "description": "The track.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "kind": {
                      "const": "track",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "description": "A media asset.",
                  "properties": {
                    "id": {
                      "description": "The asset.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "kind": {
                      "const": "media",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "description": "A sequence.",
                  "properties": {
                    "id": {
                      "description": "The sequence.",
                      "pattern": "^seq_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "kind": {
                      "const": "sequence",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "zoom": {
            "description": "Timeline zoom in pixels per second.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "playhead",
          "zoom",
          "scroll",
          "selection",
          "panel_layout",
          "preview_quality",
          "master_gain",
          "active_sequence"
        ],
        "title": "UiState",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Get the UI view state (playhead, zoom, selection, ...)",
      "undoable": false,
      "view": true
    },
    {
      "annotations": {
