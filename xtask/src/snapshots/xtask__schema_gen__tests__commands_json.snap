    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Closes the open project (releasing its lock) and starts an untitled document. With\n`save: true` the committed state is saved first; with `save: false` nothing is saved (a\nproject's unsaved work stays in the journal and is offered on the next open; an untitled\ndocument's is gone); by default it is saved when autosave is on. Changes the close would\nnot save make it fail with `Conflict{reason: unsaved_changes}` unless `save` is `false`\n(ADR-0029): an untitled document with changes (it has no file; `project.save_as` first),\nor, by default, a project with autosave off. A failed save keeps the project open. Every\nclient must resync.",
        "properties": {
          "save": {
            "default": null,
            "description": "Save before closing (`true`), never: drop unsaved changes (`false`), or as autosave\nwould (absent).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "ProjectClose",
        "type": "object"
      },
      "journaled": false,
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "project_close",
      "name": "project.close",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.close`.",
        "properties": {
          "closed": {
            "description": "The document path of the project that was closed (absent if none was open).",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "additionalProperties": false,
            "description": "The session now (an untitled document).",
            "properties": {
              "dirty": {
                "description": "Whether committed changes are not in the project file yet.",
                "type": "boolean"
              },
              "name": {
                "description": "The project name (from the document).",
                "type": "string"
              },
              "path": {
                "description": "The project document (`.cutweave`) path; absent for an untitled document.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "read_only": {
                "description": "Why the project is read-only (edits are refused), if it is.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "recovery": {
                "additionalProperties": false,
                "description": "Unsaved work from a previous session awaiting `project.recover` or\n`project.discard_recovery` (edits are refused until then).",
                "properties": {
                  "base_rev": {
                    "description": "The committed revision of the saved document.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "damaged": {
                    "description": "The journal ends with a damaged record (replay stops there).",
                    "type": "boolean"
                  },
                  "last_rev": {
                    "description": "The revision a restore reaches.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "last_ts": {
                    "description": "When the last of them was committed.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "records": {
                    "description": "Transactions a restore would replay.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "records",
                  "base_rev",
                  "last_rev",
                  "last_ts",
                  "damaged"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "rev": {
                "description": "The live document revision.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "saved_rev": {
                "description": "The committed revision last written to the project file; absent while untitled,\nread-only or awaiting a recovery decision.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "state": {
                "description": "`no_project` (an untitled document) or `open`.",
                "oneOf": [
                  {
                    "const": "no_project",
                    "description": "An untitled document, not backed by a project folder.",
                    "type": "string"
                  },
                  {
                    "const": "open",
                    "description": "A project folder is open.",
                    "type": "string"
                  },
                  {
                    "const": "closing",
                    "description": "The project is being closed (a swap or engine shutdown is under way).",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "state",
              "path",
              "name",
              "rev",
              "saved_rev",
              "dirty",
              "read_only",
              "recovery"
            ],
            "type": "object"
          }
        },
        "required": [
          "closed",
          "project"
        ],
        "title": "ProjectCloseOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Close the open project (saving first if asked or if autosave is on)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists the agent connections open on this engine: who (`agent:mcp`, `agent:cli`), since\nwhen, and the last command each called and when. The person's own editor is not listed.\n`project.connection_opened` and `project.connection_closed` announce changes. Read-only.",
        "title": "ProjectConnections",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "project_connections",
      "name": "project.connections",
      "namespace": "project",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `project.connections`.",
        "properties": {
          "connections": {
            "description": "The open agent connections, oldest first.",
            "items": {
              "additionalProperties": false,
              "description": "One agent connection open on the engine (`project.connections`, and the payload of\n`project.connection_opened` and `project.connection_closed`).",
              "properties": {
                "actor": {
                  "description": "Who it is: `agent:<label>` (`agent:mcp` for MCP clients, `agent:cli` for the command\nline) or `plugin:<id>`.",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "connected_at": {
                  "description": "When it opened, in milliseconds since the Unix epoch.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "id": {
                  "description": "The connection's number on this engine (never reused).",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "last_command": {
                  "description": "The last command or query it called (also one it was refused), if any.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_command_at": {
                  "description": "When it called it.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "actor",
                "connected_at",
                "last_command",
                "last_command_at"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "connections"
        ],
        "title": "ProjectConnectionsOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List the agent connections open on this engine, with their last command",
      "undoable": false,
      "view": false
    },
