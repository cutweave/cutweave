    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lifts time ranges out of tracks and leaves the space empty: items inside a range are\nremoved, items across an edge are trimmed to it, an item across a whole range is split\naround it, and linked partners get the same cut (also on tracks not listed). On the magnetic\nmain track the space closes (its partners' tracks follow). `ranges` default to the sequence\nin/out range, `tracks` to every track. Fails with `Locked` if it would change a locked\ntrack (pass `tracks` to leave one out).",
        "properties": {
          "ranges": {
            "default": null,
            "description": "The ranges to cut (default: the sequence in/out range).",
            "items": {
              "additionalProperties": false,
              "description": "A time range in the params: `[start, end)`, `end > start`.",
              "properties": {
                "end": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                      "type": "string"
                    }
                  ],
                  "description": "End of the range (exclusive), after `start`."
                },
                "start": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    {
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                      "type": "string"
                    }
                  ],
                  "description": "Start of the range, `>= 0`."
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": "object"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "tracks": {
            "default": null,
            "description": "The tracks to cut on (default: every track of the sequence).",
            "items": {
              "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
              "pattern": "^trk_[0-9a-f]{32}$",
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "sequence"
        ],
        "title": "TimelineLift",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_lift",
      "name": "timeline.lift",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.lift` and `timeline.extract`.",
        "properties": {
          "ranges": {
            "description": "The ranges used: snapped to the frame grid, sorted, overlapping and touching ones\nmerged.",
            "items": {
              "additionalProperties": false,
              "description": "A time range of a sequence, as used: `[start, end)` on the frame grid.",
              "properties": {
                "end": {
                  "description": "End of the range (exclusive).",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "start": {
                  "description": "First frame of the range.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
