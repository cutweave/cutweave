          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "done": {
            "default": 1,
            "description": "How many steps were applied (1 without `steps`). The other fields describe the last one.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "entry": {
            "description": "The entry undone or redone (its original transaction).",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          },
          "label": {
            "description": "Its label.",
            "type": "string"
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "stopped": {
            "description": "With `steps`: why the run stopped before `steps` (the engine's message, naming the later\nchange and its actor); absent when every step applied.",
            "type": [
              "string",
              "null"
            ]
          },
          "tx": {
            "description": "The new transaction that undid or redid it.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "entry",
          "actor",
          "label",
          "rev",
          "committed_rev",
          "done"
        ],
        "title": "HistoryMoved",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Undo your last change, or another actor's (`actor`; `*` = anyone's latest)",
      "undoable": false,
