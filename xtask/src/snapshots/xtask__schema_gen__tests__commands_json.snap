    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists committed transactions newest first (edits, undos, redos, restores; each batch,\ngesture or proposal is one entry), a page at a time, plus every actor's undo/redo stacks\n(what Undo/Redo buttons show) and the history's memory use.",
        "properties": {
          "actor": {
            "default": null,
            "description": "Only this actor's entries.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": [
              "string",
              "null"
            ]
          },
          "cursor": {
            "default": null,
            "description": "The previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Most entries (default 50, at most 500; 0 returns only the stacks).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "GetHistory",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_history",
      "name": "edit.history",
      "namespace": "edit",
      "output_schema": {
        "description": "A page of `edit.history`.",
        "properties": {
          "committed_rev": {
            "description": "The committed revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "entries": {
            "description": "Logged transactions, newest first.",
            "items": {
              "description": "One logged transaction, as `edit.history` lists it.",
              "properties": {
                "actor": {
                  "description": "Who committed it (for an undo or redo: who undid or redid).",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "at": {
                  "description": "When it committed (wall clock).",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "can_redo": {
                  "description": "It is on its actor's redo stack.",
                  "type": "boolean"
                },
                "can_undo": {
                  "description": "It is on its actor's undo stack (`edit.undo{actor}` reaches it).",
                  "type": "boolean"
                },
                "cause": {
                  "description": "Edit, undo, redo or restore.",
                  "oneOf": [
                    {
                      "description": "A change: an implicit command, or a committed batch, gesture or proposal.",
                      "properties": {
                        "type": {
                          "const": "edit",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Undid the entry of transaction `of`.",
                      "properties": {
                        "of": {
                          "description": "The undone transaction.",
                          "pattern": "^tx_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "undo",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "of"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Redid the entry of transaction `of`.",
                      "properties": {
                        "of": {
                          "description": "The redone transaction.",
                          "pattern": "^tx_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "redo",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "of"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Restored a checkpoint (an undoable change by the caller).",
                      "properties": {
                        "checkpoint": {
                          "description": "The checkpoint.",
                          "pattern": "^cp_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "restore",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "checkpoint"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "description": "What kind of open transaction (arch §5.2, ADR-0017).",
                      "oneOf": [
                        {
                          "const": "batch",
                          "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                          "type": "string"
                        },
                        {
                          "const": "gesture",
                          "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                          "type": "string"
                        },
                        {
                          "const": "proposal",
                          "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The open transaction's kind; `None` for a single command, an undo, redo or restore."
                },
                "label": {
                  "description": "The transaction's label, or the command name for a single command.",
                  "type": "string"
                },
                "ops": {
                  "description": "Number of patch ops.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "prev_rev": {
                  "description": "The committed revision it was built on.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "rev": {
                  "description": "The committed revision it created.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "description": "Whether its changes are currently applied.",
                  "oneOf": [
                    {
                      "const": "applied",
                      "description": "Applied (undo and redo records always are).",
                      "type": "string"
                    },
                    {
                      "const": "undone",
                      "description": "Undone.",
                      "type": "string"
                    }
                  ]
                },
                "tx_id": {
                  "description": "The transaction.",
                  "pattern": "^tx_[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "tx_id",
                "actor",
                "label",
                "kind",
                "cause",
                "prev_rev",
                "rev",
                "at",
                "status",
                "can_undo",
                "can_redo",
                "ops"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "latest": {
            "description": "What `*` would undo and redo next, over every actor (ADR-0019).",
            "properties": {
              "next_redo": {
                "description": "What `edit.redo{*}` would re-apply next.",
                "properties": {
                  "actor": {
                    "description": "For undo, the actor that made the change; for redo, the actor that undid it.",
                    "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Its label (\"Undo <label>\").",
                    "type": "string"
                  },
                  "tx_id": {
                    "description": "Its transaction.",
                    "pattern": "^tx_[0-9]+$",
                    "type": "string"
                  }
                },
                "required": [
                  "tx_id",
                  "label",
                  "actor"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "next_undo": {
                "description": "What `edit.undo{*}` would revert next.",
                "properties": {
                  "actor": {
                    "description": "For undo, the actor that made the change; for redo, the actor that undid it.",
                    "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Its label (\"Undo <label>\").",
                    "type": "string"
                  },
                  "tx_id": {
                    "description": "Its transaction.",
                    "pattern": "^tx_[0-9]+$",
                    "type": "string"
                  }
                },
                "required": [
                  "tx_id",
                  "label",
                  "actor"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "redo_depth": {
                "description": "Entries `*` can redo, over every actor (0 disables Redo).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "undo_depth": {
                "description": "Entries `*` can undo, over every actor (0 disables Undo).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "undo_depth",
              "redo_depth",
              "next_undo",
              "next_redo"
            ],
            "type": "object"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next (older) page; absent on the last page.",
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "description": "The live revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "stacks": {
            "description": "Every actor with something to undo or redo.",
            "items": {
              "description": "One actor's undo and redo stacks (what an Undo / Redo button needs).",
              "properties": {
                "actor": {
                  "description": "The actor.",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "next_redo": {
                  "description": "What `edit.redo{actor}` would re-apply next.",
                  "properties": {
                    "label": {
                      "description": "Its label (\"Undo <label>\").",
                      "type": "string"
                    },
                    "tx_id": {
                      "description": "Its transaction.",
                      "pattern": "^tx_[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tx_id",
                    "label"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "next_undo": {
                  "description": "What `edit.undo{actor}` would revert next.",
                  "properties": {
                    "label": {
                      "description": "Its label (\"Undo <label>\").",
                      "type": "string"
                    },
                    "tx_id": {
                      "description": "Its transaction.",
                      "pattern": "^tx_[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tx_id",
                    "label"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "redo_depth": {
                  "description": "Entries `edit.redo` can re-apply.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "undo_depth": {
                  "description": "Entries `edit.undo` can revert, newest first.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "actor",
                "undo_depth",
                "redo_depth",
                "next_undo",
                "next_redo"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "usage": {
            "description": "The log's size against its limits.",
            "properties": {
              "bytes": {
                "description": "Their estimated memory, in bytes.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "entries": {
                "description": "Logged transactions.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "evicted": {
                "description": "Entries evicted so far.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "max_bytes": {
                "description": "The byte limit.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "max_entries": {
                "description": "The entry limit.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "entries",
              "bytes",
              "max_entries",
              "max_bytes",
              "evicted"
            ],
            "type": "object"
          }
        },
        "required": [
          "entries",
          "next_cursor",
          "stacks",
          "latest",
          "rev",
          "committed_rev",
          "usage"
        ],
        "title": "HistoryPage",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List the undo history (newest first, paginated) and each actor's undo/redo stacks",
      "undoable": false,
      "view": false
    },
