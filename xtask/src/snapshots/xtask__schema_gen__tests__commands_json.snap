        ],
        "title": "ClipPasteAttributesOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Copy transform, crop, flip, compositing or audio settings of a clip onto other clips",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Swaps the media of a clip (`item`) for `media` and keeps everything else: position, name,\ntransform, crop, opacity, blend, keyframes, audio settings, markers, links. `mode`:\n`keep_duration` (default) plays the new media from `source_in` (default its start) for the\nold length, shortening the clip (`shortened: true`) if the media is shorter; `keep_source_in`\nstarts where the old media was played from; `fit_to_source` plays from `source_in` to the\nend of the new media, changing the length (the main track ripples, a free track may not grow\ninto the next item). Linked partners are replaced together; with no sound in the new media\nthey are unlinked and muted. Video may become a still (speed resets); audio and video\ncannot replace each other (`Invalid` at `/media`). `Locked` if a track involved is locked.",
        "properties": {
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "media": {
            "description": "The new media.",
            "pattern": "^med_[0-9a-f]{32}$",
            "type": "string"
          },
          "mode": {
            "default": null,
            "description": "`keep_duration` (default), `keep_source_in` or `fit_to_source`.",
            "enum": [
              "keep_duration",
              "keep_source_in",
              "fit_to_source",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "source_in": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Where the new media starts playing (default: its start). Not for `keep_source_in`, and\nnot for stills."
          }
        },
        "required": [
          "item",
          "media"
        ],
        "title": "ClipReplace",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "clip_replace",
      "name": "clip.replace",
