---
source: xtask/src/schema_gen.rs
expression: text
---
{
  "commands": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Splits a clip into two at a timeline time that lies strictly inside it (`Invalid{path:\"/at\"}`\nat or beyond the edges). The halves are contiguous: durations sum to the original and the\nright half's `source_in` continues where the left half ends. Linked partners that contain\nthe time are split too. `at` is snapped to the sequence's frame grid. `Locked` if the clip's\ntrack or a partner's track is locked.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Timeline time to split at: strictly inside the clip."
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "item",
          "at"
        ],
        "title": "ClipSplit",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "clip_split",
      "name": "clip.split",
      "namespace": "clip",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `clip.split`.",
        "properties": {
          "at": {
            "description": "The time that was split at, snapped to the frame grid.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "left": {
            "description": "The left half of the requested item (keeps its ID).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "linked": {
            "description": "The linked partners that were split too.",
            "items": {
              "additionalProperties": false,
              "description": "One split item.",
              "properties": {
                "left": {
                  "description": "The left half (keeps the original item ID).",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "right": {
                  "description": "The right half (new ID).",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "right": {
            "description": "The right half of the requested item (new ID).",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "right_group": {
            "description": "The new group shared by the right halves, if there were partners.",
            "pattern": "^grp_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "left",
          "right",
          "at",
          "linked",
          "right_group"
        ],
        "title": "ClipSplitOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Split a clip (and its linked partners) at a timeline time",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Moves one edge of a clip to a timeline time (`to`) or by an offset (`delta`, negative to\nmove the edge earlier; give exactly one). The clip cannot become empty, extend past the\nstart or end of its media, or overlap a neighbour: `Invalid{path:\"/to\"}` (or `/delta`).\nLinked partners get the same edge at the same time; `unlink: true` trims only this clip and\nremoves it from its group. Times are snapped to the sequence's frame grid. `Locked` if a\ntrack involved is locked.",
        "properties": {
          "delta": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Offset of the edge from where it is now (negative: earlier). Use seconds or flicks for\nnegative values."
          },
          "edge": {
            "description": "The edge to move.",
            "oneOf": [
              {
                "const": "start",
                "description": "The first frame (changes `start`, `source_in` and the length).",
                "type": "string"
              },
              {
                "const": "end",
                "description": "The last frame (changes the length).",
                "type": "string"
              }
            ]
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          },
          "to": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Timeline time of the edge afterwards (frame-snapped)."
          },
          "unlink": {
            "default": null,
            "description": "Trim only this clip and remove it from its linked group (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "item",
          "edge"
        ],
        "title": "ClipTrim",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "clip_trim",
      "name": "clip.trim",
      "namespace": "clip",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `clip.trim`.",
        "properties": {
          "items": {
            "description": "The trimmed clips: the requested one first, then its linked partners.",
            "items": {
              "additionalProperties": false,
              "description": "A clip after trimming.",
              "properties": {
                "duration": {
                  "description": "Its length.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "item": {
                  "description": "The clip.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "source_in": {
                  "description": "Its source position.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "start": {
                  "description": "Its start.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "start",
                "duration",
                "source_in"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ClipTrimOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Trim the start or end edge of a clip (linked partners follow; no ripple)",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Opens a transaction owned by this connection (one at a time). Run commands in it by naming\nit in the request envelope (`_meta.tx`). A `batch` stays invisible until committed; a\n`gesture` (dragging, scrubbing) and a `proposal` (copilot turn) update the document live\nand soft-lock the items they touch: other actors' commands on those items fail with\n`Conflict{reason: item_in_gesture}` until it closes. Each commits as one undo step; a\ngesture idle for 30 s is cancelled by the engine; closing the connection rolls it back.",
        "properties": {
          "kind": {
            "anyOf": [
              {
                "description": "What kind of open transaction (arch §5.2, ADR-0017).",
                "oneOf": [
                  {
                    "const": "batch",
                    "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                    "type": "string"
                  },
                  {
                    "const": "gesture",
                    "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                    "type": "string"
                  },
                  {
                    "const": "proposal",
                    "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`batch` (default), `gesture` or `proposal`."
          },
          "label": {
            "description": "The undo entry's label, e.g. `Move clip`.",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "BeginTx",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_begin_tx",
      "name": "edit.begin_tx",
      "namespace": "edit",
      "output_schema": {
        "additionalProperties": false,
        "description": "An opened transaction.",
        "properties": {
          "kind": {
            "description": "Its kind.",
            "oneOf": [
              {
                "const": "batch",
                "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                "type": "string"
              },
              {
                "const": "gesture",
                "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                "type": "string"
              }
            ]
          },
          "label": {
            "description": "Its label.",
            "type": "string"
          },
          "rev": {
            "description": "The live revision it was opened at.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "Its id (pass it as `_meta.tx`).",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "kind",
          "label",
          "rev"
        ],
        "title": "TxOpened",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Open a transaction (batch, gesture or proposal) that commits as one undo step",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Cancels this connection's open transaction and rolls back its live changes (nothing is\ncommitted, journaled or added to the history).",
        "properties": {
          "tx": {
            "default": null,
            "description": "The transaction (default: this connection's open one).",
            "pattern": "^tx_[0-9]+$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CancelTx",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_cancel_tx",
      "name": "edit.cancel_tx",
      "namespace": "edit",
      "output_schema": {
        "additionalProperties": false,
        "description": "A cancelled transaction.",
        "properties": {
          "kind": {
            "description": "Its kind.",
            "oneOf": [
              {
                "const": "batch",
                "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                "type": "string"
              },
              {
                "const": "gesture",
                "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                "type": "string"
              }
            ]
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "Its id.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "kind",
          "rev"
        ],
        "title": "TxCancelled",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Cancel your open transaction and roll back its changes",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Captures the committed document as a restore point (cheap: snapshots share structure).\nOpen transactions are not included. Kept in memory (at most 50, 20 named; least recently\nused first out); reusing a name moves it to the new checkpoint.",
        "properties": {
          "name": {
            "default": null,
            "description": "A name to restore it by (1..=64 characters, not `cp_<n>`).",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "default": null,
            "description": "A note (at most 1000 characters).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "Checkpoint",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_checkpoint",
      "name": "edit.checkpoint",
      "namespace": "edit",
      "output_schema": {
        "description": "A checkpoint, as `edit.checkpoint` and `edit.list_checkpoints` report it.",
        "properties": {
          "actor": {
            "description": "Who made it.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": "string"
          },
          "at": {
            "description": "When.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "checkpoint": {
            "description": "Its id.",
            "pattern": "^cp_[0-9]+$",
            "type": "string"
          },
          "name": {
            "description": "Its name, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "description": "A free-form note.",
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "description": "The committed revision it captured.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "checkpoint",
          "name",
          "note",
          "rev",
          "actor",
          "at"
        ],
        "title": "CheckpointInfo",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Save a restore point of the committed document (cheap; optional name)",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Commits this connection's open transaction: its changes become one committed transaction\nand one undo entry. Fails with `Conflict` (and closes it) if another transaction committed\noverlapping changes first.",
        "properties": {
          "tx": {
            "default": null,
            "description": "The transaction (default: this connection's open one).",
            "pattern": "^tx_[0-9]+$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CommitTx",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_commit_tx",
      "name": "edit.commit_tx",
      "namespace": "edit",
      "output_schema": {
        "additionalProperties": false,
        "description": "A committed transaction.",
        "properties": {
          "changed": {
            "description": "Whether it changed the document (and made an undo entry).",
            "type": "boolean"
          },
          "committed_rev": {
            "description": "The committed revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "description": "Its kind.",
            "oneOf": [
              {
                "const": "batch",
                "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                "type": "string"
              },
              {
                "const": "gesture",
                "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                "type": "string"
              }
            ]
          },
          "rev": {
            "description": "The live revision afterwards.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tx": {
            "description": "Its id.",
            "pattern": "^tx_[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "tx",
          "kind",
          "changed",
          "rev",
          "committed_rev"
        ],
        "title": "TxCommitted",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Commit your open transaction as one undo step",
      "undoable": false,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Lists committed transactions newest first (edits, undos, redos, restores; each batch,\ngesture or proposal is one entry), a page at a time, plus every actor's undo/redo stacks\n(what Undo/Redo buttons show) and the history's memory use.",
        "properties": {
          "actor": {
            "default": null,
            "description": "Only this actor's entries.",
            "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
            "type": [
              "string",
              "null"
            ]
          },
          "cursor": {
            "default": null,
            "description": "The previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Most entries (default 50, at most 500; 0 returns only the stacks).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "GetHistory",
        "type": "object"
      },
      "kind": "engine",
      "mcp": "catalog",
      "mcp_tool": "edit_history",
      "name": "edit.history",
      "namespace": "edit",
      "output_schema": {
        "description": "A page of `edit.history`.",
        "properties": {
          "committed_rev": {
            "description": "The committed revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "entries": {
            "description": "Logged transactions, newest first.",
            "items": {
              "description": "One logged transaction, as `edit.history` lists it.",
              "properties": {
                "actor": {
                  "description": "Who committed it (for an undo or redo: who undid or redid).",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "at": {
                  "description": "When it committed (wall clock).",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "can_redo": {
                  "description": "It is on its actor's redo stack.",
                  "type": "boolean"
                },
                "can_undo": {
                  "description": "It is on its actor's undo stack (`edit.undo{actor}` reaches it).",
                  "type": "boolean"
                },
                "cause": {
                  "description": "Edit, undo, redo or restore.",
                  "oneOf": [
                    {
                      "description": "A change: an implicit command, or a committed batch, gesture or proposal.",
                      "properties": {
                        "type": {
                          "const": "edit",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Undid the entry of transaction `of`.",
                      "properties": {
                        "of": {
                          "description": "The undone transaction.",
                          "pattern": "^tx_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "undo",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "of"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Redid the entry of transaction `of`.",
                      "properties": {
                        "of": {
                          "description": "The redone transaction.",
                          "pattern": "^tx_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "redo",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "of"
                      ],
                      "type": "object"
                    },
                    {
                      "description": "Restored a checkpoint (an undoable change by the caller).",
                      "properties": {
                        "checkpoint": {
                          "description": "The checkpoint.",
                          "pattern": "^cp_[0-9]+$",
                          "type": "string"
                        },
                        "type": {
                          "const": "restore",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "checkpoint"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "description": "What kind of open transaction (arch §5.2, ADR-0017).",
                      "oneOf": [
                        {
                          "const": "batch",
                          "description": "A batch (`edit.begin_tx` / `edit.commit_tx`): its changes become visible only when it\ncommits.",
                          "type": "string"
                        },
                        {
                          "const": "gesture",
                          "description": "A continuous gesture (dragging, scrubbing a slider): updates the document live, collapses\ninto one undo step on commit, rolls back on cancel, auto-cancels after\n[`GESTURE_IDLE_TIMEOUT`](crate::GESTURE_IDLE_TIMEOUT) without a request naming it.",
                          "type": "string"
                        },
                        {
                          "const": "proposal",
                          "description": "A copilot proposal (arch §14b): live like a gesture, no idle timeout.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The open transaction's kind; `None` for a single command, an undo, redo or restore."
                },
                "label": {
                  "description": "The transaction's label, or the command name for a single command.",
                  "type": "string"
                },
                "ops": {
                  "description": "Number of patch ops.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "prev_rev": {
                  "description": "The committed revision it was built on.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "rev": {
                  "description": "The committed revision it created.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "description": "Whether its changes are currently applied.",
                  "oneOf": [
                    {
                      "const": "applied",
                      "description": "Applied (undo and redo records always are).",
                      "type": "string"
                    },
                    {
                      "const": "undone",
                      "description": "Undone.",
                      "type": "string"
                    }
                  ]
                },
                "tx_id": {
                  "description": "The transaction.",
                  "pattern": "^tx_[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "tx_id",
                "actor",
                "label",
                "kind",
                "cause",
                "prev_rev",
                "rev",
                "at",
                "status",
                "can_undo",
                "can_redo",
                "ops"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Pass as `cursor` for the next (older) page; absent on the last page.",
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "description": "The live revision.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "stacks": {
            "description": "Every actor with something to undo or redo.",
            "items": {
              "description": "One actor's undo and redo stacks (what an Undo / Redo button needs).",
              "properties": {
                "actor": {
                  "description": "The actor.",
                  "pattern": "^(user|system|agent:.+|plugin:[A-Za-z0-9._@-]+)$",
                  "type": "string"
                },
                "next_redo": {
                  "description": "What `edit.redo{actor}` would re-apply next.",
                  "properties": {
                    "label": {
                      "description": "Its label (\"Undo <label>\").",
                      "type": "string"
                    },
                    "tx_id": {
                      "description": "Its transaction.",
                      "pattern": "^tx_[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tx_id",
                    "label"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "next_undo": {
                  "description": "What `edit.undo{actor}` would revert next.",
                  "properties": {
                    "label": {
                      "description": "Its label (\"Undo <label>\").",
                      "type": "string"
                    },
                    "tx_id": {
                      "description": "Its transaction.",
                      "pattern": "^tx_[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "tx_id",
                    "label"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "redo_depth": {
                  "description": "Entries `edit.redo` can re-apply.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "undo_depth": {
                  "description": "Entries `edit.undo` can revert, newest first.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "actor",
                "undo_depth",
                "redo_depth",
                "next_undo",
                "next_redo"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "usage": {
            "description": "The log's size against its limits.",
            "properties": {
              "bytes": {
                "description": "Their estimated memory, in bytes.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "entries": {
                "description": "Logged transactions.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "evicted": {
                "description": "Entries evicted so far.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "max_bytes": {
                "description": "The byte limit.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "max_entries": {
                "description": "The entry limit.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "entries",
              "bytes",
              "max_entries",
              "max_bytes",
              "evicted"
            ],
            "type": "object"
          }
        },
        "required": [
          "entries",
          "next_cursor",
          "stacks",
          "rev",
          "committed_rev",
          "usage"
        ],
        "title": "HistoryPage",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "List the undo history (newest first, paginated) and each actor's undo/redo stacks",
      "undoable": false,
      "view": false
    },
