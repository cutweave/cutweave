    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Changes a sequence's canvas size, frame rate, sample rate or background (absent fields stay).\nA new canvas size reframes every video clip by `reframe` (default `fit`: the whole composition\nshrinks to sit inside the new canvas; `fill` covers it; `keep_scale` keeps pixel sizes;\n`none` leaves transforms). A new frame rate moves every item edge to the nearest frame of\nthe new grid without creating overlaps or gaps. Fails with `Locked` if a locked track holds\nitems this would change.",
        "properties": {
          "background": {
            "default": null,
            "description": "Canvas color, `#rrggbb`.",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "type": [
              "string",
              "null"
            ]
          },
          "frame_rate": {
            "additionalProperties": false,
            "default": null,
            "description": "The edit grid.",
            "properties": {
              "den": {
                "description": "Seconds.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Frames.",
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "height": {
            "default": null,
            "description": "Canvas height in pixels, `1..=16384`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "reframe": {
            "anyOf": [
              {
                "description": "How clip transforms follow a new canvas (see the module docs).",
                "oneOf": [
                  {
                    "const": "keep_scale",
                    "description": "Keep each clip's pixel size and pixel offset from the centre.",
                    "type": "string"
                  },
                  {
                    "const": "fit",
                    "description": "Scale the composition to sit whole inside the new canvas.",
                    "type": "string"
                  },
                  {
                    "const": "fill",
                    "description": "Scale the composition to cover the new canvas.",
                    "type": "string"
                  },
                  {
                    "const": "none",
                    "description": "Leave transforms alone.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How clips follow a new canvas size (default `fit`)."
          },
          "sample_rate": {
            "default": null,
            "description": "The mix rate in Hz.",
            "maximum": 352800000,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "width": {
            "default": null,
            "description": "Canvas width in pixels, `1..=16384`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "sequence"
        ],
        "title": "SequenceSetFormat",
        "type": "object"
      },
      "kind": "command",
      "mcp": "core",
      "mcp_tool": "sequence_set_format",
      "name": "sequence.set_format",
      "namespace": "sequence",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `sequence.set_format`.",
        "properties": {
          "format": {
            "description": "Its format now.",
            "properties": {
              "background": {
                "description": "Canvas color behind all tracks.",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "type": "string"
              },
              "color_space": {
                "description": "Working color space.",
                "oneOf": [
                  {
                    "const": "rec709",
                    "description": "Rec.709 primaries, SDR.",
                    "type": "string"
                  }
                ]
              },
              "frame_rate": {
                "additionalProperties": false,
                "description": "The edit grid: timecodes and `\"f:N\"` inputs resolve against it.",
                "properties": {
                  "den": {
                    "description": "Seconds.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "num": {
                    "description": "Frames.",
                    "maximum": 4294967295,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "type": "object"
              },
              "height": {
                "description": "Canvas height in pixels.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "sample_rate": {
                "description": "The mix rate.",
                "maximum": 352800000,
                "minimum": 1,
                "type": "integer"
              },
              "width": {
                "description": "Canvas width in pixels.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "width",
              "height",
              "frame_rate",
              "sample_rate",
              "color_space",
              "background"
            ],
            "type": "object"
          },
          "reframed": {
            "description": "Clips whose position or scale changed to follow the new canvas.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "retimed": {
            "description": "Items whose start or length moved to the new frame grid.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "format",
          "reframed",
          "retimed"
        ],
        "title": "SequenceSetFormatOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Change a sequence's size, frame rate, sample rate or background",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Adds a marker to a sequence, or to an item of it when `item` is given (then `t` is relative\nto the item's start and the marker moves with it). `duration` makes a range marker. `kind`\nis `user` (default), `beat` or `chapter`; `color` is `#rrggbb`. Times snap to the frame\ngrid. Sequence markers never move with a ripple; an item marker on a locked track fails\nwith `Locked`.",
        "properties": {
          "color": {
            "default": null,
            "description": "Display color, `#rrggbb` (default marigold).",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                    "type": "string"
                  }
                ],
                "description": "A time: integer flicks (1/705600000 s), or a string: seconds (\"62.5s\"), a frame (\"f:1500\") or a timecode (\"00:01:02:03\", drop-frame \"00:01:02;03\"). Frames and timecodes use the frame rate of the target's sequence."
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Length of a range marker, `> 0` (snapped to whole frames)."
          },
          "item": {
            "default": null,
            "description": "Put the marker on this item of the sequence instead of on the sequence.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "anyOf": [
              {
                "description": "What a marker means.",
                "oneOf": [
                  {
                    "const": "user",
                    "description": "Placed by a person or an agent.",
                    "type": "string"
                  },
                  {
                    "const": "beat",
                    "description": "A beat found by analysis (snaps like a marker, spec §6).",
                    "type": "string"
                  },
                  {
                    "const": "chapter",
                    "description": "A chapter start (exported to chaptered formats).",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "`user` (default), `beat` or `chapter`."
          },
          "label": {
            "default": null,
            "description": "Text shown with the marker (default empty), at most 200 characters.",
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "t": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "Where, `>= 0` (snapped to the frame grid; relative to the item for an item marker)."
          }
        },
        "required": [
          "sequence",
          "t"
        ],
        "title": "TimelineAddMarker",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_add_marker",
      "name": "timeline.add_marker",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.add_marker`.",
        "properties": {
          "duration": {
            "description": "Its length, for a range marker.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "item": {
            "description": "The item it is on, for an item marker.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "marker": {
            "description": "The new marker.",
            "pattern": "^mrk_[0-9a-f]{32}$",
            "type": "string"
          },
          "sequence": {
            "description": "The sequence it is in.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          },
          "t": {
            "description": "Its time, snapped to the frame grid (item-relative for an item marker).",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "marker",
          "sequence",
          "t"
        ],
        "title": "TimelineAddMarkerOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Add a marker (or range marker) to a sequence or one of its items",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Clears the sequence's in and out points (nothing happens if none are set).",
        "properties": {
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence"
        ],
        "title": "TimelineClearInOut",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_clear_in_out",
      "name": "timeline.clear_in_out",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.clear_in_out`.",
        "properties": {
          "cleared": {
            "description": "Whether there was a range to clear.",
            "type": "boolean"
          },
          "sequence": {
            "description": "The sequence.",
            "pattern": "^seq_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "cleared"
        ],
        "title": "TimelineClearInOutOutput",
        "type": "object"
      },
      "scope": "any",
      "secret_fields": [],
      "summary": "Clear the sequence's in and out points",
      "undoable": true,
      "view": false
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input_schema": {
        "additionalProperties": false,
        "description": "Closes the gap of a track that contains `at`: the items from the gap's end on move left by\nits length, and so do the tracks of linked partners of what moves (or every track with\n`ripple_all_tracks`). A gap is the empty space between two items, or before the first one;\n`at` inside an item or after the last one is `Invalid` (the magnetic main track has no\ngaps). Fails with `Invalid` if the shift would make items overlap, and with `Locked` if it\nwould change a locked track.",
        "properties": {
          "at": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "A time inside the gap."
          },
          "ripple_all_tracks": {
            "default": null,
            "description": "Shift every track of the sequence, not only this one and its partners' tracks (default\n`false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "track": {
            "description": "The track.",
            "pattern": "^trk_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "track",
          "at"
        ],
        "title": "TimelineDeleteGap",
        "type": "object"
      },
      "kind": "command",
      "mcp": "catalog",
      "mcp_tool": "timeline_delete_gap",
      "name": "timeline.delete_gap",
      "namespace": "timeline",
      "output_schema": {
        "additionalProperties": false,
        "description": "Result of `timeline.delete_gap`.",
        "properties": {
          "gap": {
            "additionalProperties": false,
            "description": "The gap that was closed.",
            "properties": {
              "end": {
                "description": "End of the range (exclusive).",
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "start": {
                "description": "First frame of the range.",
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          },
          "report": {
            "additionalProperties": false,
            "description": "What changed (timeline spec §3.1).",
            "properties": {
              "created": {
                "description": "New items, other than the right halves of splits.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "created_tracks": {
                "description": "Tracks created, in creation order.",
                "items": {
                  "description": "A Track id: `^trk_[0-9a-f]{32}$`.",
                  "pattern": "^trk_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "moved": {
                "description": "Items whose track or start changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose track or start changed (duration and source did not).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "start": {
                      "description": "Its start now.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "track": {
                      "description": "Its track now.",
                      "pattern": "^trk_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "track",
                    "start"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "relinked": {
                "description": "Items whose link or attachment changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `linked_group` or `attached_to` changed.",
                  "properties": {
                    "attached_to": {
                      "description": "The item it is attached to now.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "linked_group": {
                      "description": "Its linked group now.",
                      "pattern": "^grp_[0-9a-f]{32}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "item",
                    "linked_group",
                    "attached_to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "removed": {
                "description": "Items that no longer exist.",
                "items": {
                  "description": "A Item id: `^itm_[0-9a-f]{32}$`.",
                  "pattern": "^itm_[0-9a-f]{32}$",
                  "type": "string"
                },
                "type": "array"
              },
              "replaced": {
                "description": "Items whose media changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose media changed (`clip.replace`).",
                  "properties": {
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "media": {
                      "description": "Its media now.",
                      "pattern": "^med_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "media"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "split": {
                "description": "Splits, sorted by `(left, at)`.",
                "items": {
                  "additionalProperties": false,
                  "description": "A split: `right` is new, `left` keeps its ID; `at` is the cut time before the edit.",
                  "properties": {
                    "at": {
                      "description": "The cut time.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "left": {
                      "description": "The left half (keeps the original ID).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "right": {
                      "description": "The right half (new).",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "left",
                    "right",
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "toggled": {
                "description": "Items whose `enabled` flag changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose `enabled` flag changed.",
                  "properties": {
                    "enabled": {
                      "description": "Its flag now.",
                      "type": "boolean"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "item",
                    "enabled"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "trimmed": {
                "description": "Items whose duration or source position changed.",
                "items": {
                  "additionalProperties": false,
                  "description": "An item whose duration or `source_in` changed (its start may have too).",
                  "properties": {
                    "duration": {
                      "description": "Its duration now.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "item": {
                      "description": "The item.",
                      "pattern": "^itm_[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "source_in": {
                      "description": "Its `source_in` now (`0` for items that play no media).",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "start": {
                      "description": "Its start now.",
