      "input_schema": {
        "additionalProperties": false,
        "description": "Changes which part of the media a clip shows without moving it: its `source_in` (and its\nlinked partners') moves by `delta`, in media time and whole frames (positive: later\nmaterial). Positions and lengths on the timeline never change. The source range stays inside\nthe media (`clamp: true` stops at its start or end). A still or media of unknown length has\nnothing to slip: `Invalid{path:\"/item\"}`. `fine: true` snaps to audio samples (audio clips\nnot linked to video). `Locked` if a track involved is locked.",
        "properties": {
          "clamp": {
            "default": null,
            "description": "Stop at the start or end of the media instead of failing (default `false`).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "delta": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?s$|^-?[0-9]+$|^f:[0-9]+$|^[0-9]+[:;][0-9]+[:;][0-9]+[:;][0-9]+$",
                "type": "string"
              }
            ],
            "description": "How far the media moves under the clip (positive: later material). Use seconds or\nflicks for negative values."
          },
          "fine": {
            "default": null,
            "description": "Snap to the audio sample grid (audio clips only).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "item": {
            "description": "The clip.",
            "pattern": "^itm_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "item",
          "delta"
        ],
        "title": "ClipSlip",
        "type": "object"
      },
